---
/**
 * PageBanner — banner reutilizable para páginas que no son inicio.
 * Muestra h1 + subtítulo abajo a la izquierda sobre una imagen recortada en
 * arco ancho («El umbral»). Incluye JSON-LD BreadcrumbList para SEO.
 */
interface BreadcrumbItem {
  label: string;
  url: string;
}

interface Props {
  title: string;
  subtitle: string;
  image?: string;
  imageAlt?: string;
  badge?: string;
  breadcrumb?: BreadcrumbItem[];
}

const {
  title,
  subtitle,
  image = 'https://picsum.photos/seed/varsana-banner/1600/600',
  imageAlt = title,
  badge,
  breadcrumb,
} = Astro.props;

const siteUrl = Astro.site?.origin || 'https://varsana.com';
---

<!-- Cúpula: la foto se mira a través de un arco ancho; el título se apoya
     abajo a la izquierda, como en el hero de inicio. -->
<div class="page-banner-frame">
<span class="page-banner-frame__rings ripple" aria-hidden="true"></span>
<header class="page-banner arch-wide shimmer">
  <img
    src={image}
    alt={imageAlt}
    class="page-banner__image"
    referrerpolicy="no-referrer"
    decoding="async"
  />

  <div class="page-banner__overlay" aria-hidden="true"></div>

  <div class="page-banner__content">
    {badge && (
      <span class="page-banner__badge">
        {badge}
      </span>
    )}
    <h1 class="display-lg font-bold font-display text-white">
      {title}
    </h1>
    <p class="mt-4 text-base md:text-xl text-white/85 max-w-2xl leading-relaxed">
      {subtitle}
    </p>
  </div>
</header>
</div>

<!-- JSON-LD BreadcrumbList structured data -->
{breadcrumb && breadcrumb.length > 0 && (
  <script type="application/ld+json">
    {JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumb.map((item, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: item.label,
        item: item.url.startsWith('http') ? item.url : `${siteUrl}${item.url}`,
      })),
    })}
  </script>
)}

<style>
  /* Halo: tres líneas azafrán acompañan la curva del arco sobre la arena,
     cada vez más tenues hacia afuera, y se desvanecen hacia la base. El
     margen del marco es el espacio que ocupan: nunca salen de la columna. */
  .page-banner-frame {
    --halo: clamp(0.875rem, 2.6vw, 2.25rem);
    --r: min(50cqw, 15rem);
    --k: 0.25;
    position: relative;
    container-type: inline-size;
    padding: var(--halo) var(--halo) 0;
  }

  .page-banner-frame__rings,
  .page-banner-frame__rings::before,
  .page-banner-frame__rings::after {
    position: absolute;
    inset: var(--i) var(--i) 0;
    border: 1.5px solid color-mix(in srgb, var(--color-saffron) var(--a), transparent);
    border-bottom: 0;
    border-radius: calc(var(--r) + var(--halo) - var(--i)) calc(var(--r) + var(--halo) - var(--i)) 0 0;
    pointer-events: none;
  }
  .page-banner-frame__rings {
    --i: calc(var(--w3) * var(--k));
    --a: 30%;
    mask-image: linear-gradient(to bottom, #000 30%, transparent 85%);
  }
  .page-banner-frame__rings::before {
    content: "";
    --i: calc(var(--halo) * 0.3 + var(--w2) * var(--k));
    --a: 55%;
  }
  .page-banner-frame__rings::after {
    content: "";
    --i: calc(var(--halo) * 0.62 + var(--w1) * var(--k));
    --a: 90%;
  }

  .page-banner-frame > .page-banner {
    border-radius: var(--r) var(--r) 0 0;
  }

  .page-banner {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: clamp(22rem, 58svh, 34rem);
    background-color: var(--color-forest-night);
  }

  .page-banner__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .page-banner__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(23 35 15 / 0.9) 0%, rgb(23 35 15 / 0.45) 40%, rgb(23 35 15 / 0.05) 75%);
  }

  .page-banner__content {
    position: relative;
    z-index: 1;
    width: 100%;
    padding: 6rem 1.5rem 2.25rem;
  }

  .page-banner__badge {
    display: inline-block;
    margin-bottom: 1rem;
    color: var(--color-saffron);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  @media (min-width: 768px) {
    .page-banner__content {
      padding: 8rem 3.5rem 3.5rem;
    }
  }

  /* Entrada: la foto se asienta y el texto sube. Solo al cargar. */
  @media (prefers-reduced-motion: no-preference) {
    .page-banner__image {
      animation: banner-settle 1.6s var(--ease-out) both;
    }
    .page-banner__content > * {
      animation: banner-rise 0.9s var(--ease-out) both;
      animation-delay: 0.15s;
    }
    .page-banner__content > :nth-child(2) { animation-delay: 0.25s; }
    .page-banner__content > :nth-child(3) { animation-delay: 0.35s; }
  }

  @keyframes banner-settle {
    from { transform: scale(1.08); }
    to { transform: none; }
  }

  @keyframes banner-rise {
    from { opacity: 0; transform: translateY(1.25rem); }
    to { opacity: 1; transform: none; }
  }
</style>
