---
/**
 * PageBanner — banner reutilizable para páginas que no son inicio.
 * Muestra h1 + subtítulo centrados sobre una imagen de fondo con overlay
 * oscuro y esquinas redondeadas. Incluye JSON-LD BreadcrumbList para SEO.
 */
interface BreadcrumbItem {
  label: string;
  url: string;
}

interface Props {
  title: string;
  subtitle: string;
  image?: string;
  imageAlt?: string;
  badge?: string;
  breadcrumb?: BreadcrumbItem[];
}

const {
  title,
  subtitle,
  image = 'https://picsum.photos/seed/varsana-banner/1600/600',
  imageAlt = title,
  badge,
  breadcrumb,
} = Astro.props;

const siteUrl = Astro.site?.origin || 'https://varsana.co';
---

<header
  class="relative h-48 md:h-64 rounded-[32px] overflow-hidden shadow-airbnb"
>
  <!-- Background image -->
  <img
    src={image}
    alt={imageAlt}
    class="absolute inset-0 w-full h-full object-cover"
    referrerpolicy="no-referrer"
    decoding="async"
  />

  <!-- Dark gradient overlay for text readability -->
  <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/30 to-transparent" aria-hidden="true"></div>

  <!-- Centered text content -->
  <div class="absolute inset-0 flex flex-col items-center justify-center text-center text-white px-6 md:px-12">
    {badge && (
      <span class="bg-saffron/20 text-saffron-light px-3 py-1 rounded-full text-xs font-bold mb-4 inline-block">
        {badge}
      </span>
    )}
    <h1 class="text-3xl md:text-5xl font-bold font-display tracking-tightest mb-3 text-white">
      {title}
    </h1>
    <p class="text-base md:text-lg text-white/80 max-w-2xl">
      {subtitle}
    </p>
  </div>
</header>

<!-- JSON-LD BreadcrumbList structured data -->
{breadcrumb && breadcrumb.length > 0 && (
  <script type="application/ld+json">
    {JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumb.map((item, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: item.label,
        item: item.url.startsWith('http') ? item.url : `${siteUrl}${item.url}`,
      })),
    })}
  </script>
)}

<style>
  h1 {
    letter-spacing: -0.02em;
  }
</style>
