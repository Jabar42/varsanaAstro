---
import type { CollectionEntry } from 'astro:content';
import { Instagram, Twitter, Linkedin, Facebook, Youtube, Mail, Phone, Globe } from 'lucide-react';
import { getLocale, localizePath } from '@/src/i18n/utils';

const locale = getLocale(Astro);
const l = (p: string) => localizePath(locale, p);

type Props = {
  member: CollectionEntry<'nosotros'>;
};

const { member } = Astro.props;
const { nombre, rol, descripcion, imagen, enlaces_sociales, correo, telefono } = member.data;

// Function to get appropriate icon for social platform
const getSocialIcon = (platform: string) => {
  const normalized = platform.toLowerCase();
  switch (normalized) {
    case 'instagram':
      return Instagram;
    case 'twitter':
    case 'x':
      return Twitter;
    case 'linkedin':
      return Linkedin;
    case 'facebook':
      return Facebook;
    case 'youtube':
      return Youtube;
    default:
      return Globe;
  }
};
---

<article class="bg-lotus-white rounded-lg shadow-airbnb overflow-hidden transition-transform duration-300 hover:scale-[1.02] cursor-pointer group">
  <a href={l(`/nosotros/${member.id}`)} class="block">
  <div class="aspect-square overflow-hidden relative shimmer">
    <img
      src={imagen}
      alt={nombre}
      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
      referrerpolicy="no-referrer"
      loading="lazy"
    />
  </div>

  <div class="p-6">
    <div class="space-y-1">
      <h3 class="text-2xl font-bold tracking-tightest leading-tight font-display">{nombre}</h3>
      <p class="text-sm text-saffron font-semibold uppercase tracking-wider truncate">{rol}</p>
    </div>

    <p class="text-gray-600 line-clamp-3 text-sm leading-relaxed mt-3">
      {descripcion.slice(0, 150)}{descripcion.length > 150 ? '...' : ''}
    </p>

    {/* Social links */}
    {enlaces_sociales && enlaces_sociales.length > 0 && (
      <div class="flex items-center gap-3 pt-2">
        {enlaces_sociales.map((enlace) => {
          const Icon = getSocialIcon(enlace.plataforma);
          return (
            <a
              href={enlace.url}
              target="_blank"
              rel="noopener noreferrer"
              class="text-gray-400 hover:text-saffron transition-colors"
              title={enlace.plataforma}
            >
              <Icon size={18} />
            </a>
          );
        })}
      </div>
    )}

    {/* Contact info */}
    {(correo || telefono) && (
    <div class="pt-3 mt-1 border-t border-sacred-sand space-y-2">
      {correo && (
        <div class="flex items-center gap-2 text-sm text-gray-600">
          <Mail size={14} className="text-saffron" />
          <a href={`mailto:${correo}`} class="hover:text-saffron">{correo}</a>
        </div>
      )}
      {telefono && (
        <div class="flex items-center gap-2 text-sm text-gray-600">
          <Phone size={14} className="text-saffron" />
          <a href={`tel:${telefono}`} class="hover:text-saffron">{telefono}</a>
        </div>
      )}
    </div>
    )}
  </div>
  </a>
</article>

<style>
  h3 {
    letter-spacing: -0.02em;
  }
</style>
