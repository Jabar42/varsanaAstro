---
import { type FeaturedItem } from '@/src/lib/slider';
import { getLocale, localizePath, useTranslations, formatDate } from '@/src/i18n/utils';

interface Props {
  items: FeaturedItem[];
  interval?: number; // ms, default 6000
}

const { items, interval = 6000 } = Astro.props;
const locale = getLocale(Astro);
const t = useTranslations(locale);
const l = (path: string) => localizePath(locale, path);

// Slides permanentes (textos en src/i18n/dictionaries/hero.ts)
const staticSlides: FeaturedItem[] = [
  {
    collection: 'static',
    slug: 'bienvenida-yoga-planetario',
    image: '/api/images/1787355699024-slide-nuevo.webp',
    title: t('hero.slides.bienvenida.title'),
    description: t('hero.slides.bienvenida.description'),
    url: l('/nuestra-historia'),
    ctaLabel: t('hero.slides.bienvenida.cta'),
    _orden: 996,
  },
  {
    collection: 'static',
    slug: 'hospedajes-con-proposito',
    image: '/api/images/1785287420355-slide-hospedaje.webp',
    title: t('hero.slides.hospedaje.title'),
    description: t('hero.slides.hospedaje.description'),
    url: l('/hospedaje'),
    ctaLabel: t('hero.slides.hospedaje.cta'),
    _orden: 998,
  },
  {
    collection: 'static',
    slug: 'experiencias-a-la-medida',
    image: '/api/images/1785287371423-slide-experiencias.webp',
    title: t('hero.slides.experiencias.title'),
    description: t('hero.slides.experiencias.description'),
    url: l('/experiencias'),
    ctaLabel: t('hero.slides.experiencias.cta'),
    _orden: 997,
  },
  {
    collection: 'static',
    slug: 'templo-aereo',
    image: '/api/images/1782335650801-templo-aereo.webp',
    title: t('hero.slides.templo.title'),
    description: t('hero.slides.templo.description'),
    url: l('/contacto'),
    ctaLabel: t('hero.slides.templo.cta'),
    _orden: 999,
  },
];

// Los destacados de contenido van primero; sus URLs se localizan aquí.
const dynamicSlides = items.map((item) => ({
  ...item,
  url: l(item.url),
  ctaLabel: item.ctaLabel === 'Reservar' ? t('hero.reserve') : item.ctaLabel,
}));

const allItems = [...dynamicSlides, ...staticSlides];
const hasMultiple = allItems.length > 1;
---

<section class="hero-banner shimmer" data-hero-banner data-interval={String(interval)} aria-roledescription="carousel">
  {allItems.map((item, i) => (
    <div
      class:list={['hero-banner__slide', { 'hero-banner__slide--active': i === 0 }]}
      data-hero-slide={i}
      role="group"
      aria-roledescription="slide"
      aria-label={`${i + 1} / ${allItems.length}`}
      aria-hidden={i === 0 ? 'false' : 'true'}
    >
      <img
        src={item.image}
        alt={item.title}
        class="hero-banner__image"
        loading={i === 0 ? 'eager' : 'lazy'}
        fetchpriority={i === 0 ? 'high' : 'auto'}
        decoding="async"
      />
      <div class="hero-banner__overlay">
        <div class="hero-banner__overlay-inner">
          <div class="hero-banner__content">
            {item.date && (
              <span class="hero-banner__date">
                {formatDate(item.date, locale)}
              </span>
            )}
            <h2 class="hero-banner__title">{item.title}</h2>
            <p class="hero-banner__desc">{item.description}</p>
            <a href={item.url} class="hero-banner__cta">
              {item.ctaLabel || t('hero.viewMore')}
            </a>
          </div>
        </div>
      </div>
    </div>
  ))}

  {hasMultiple && (
    <div class="hero-banner__controls">
      <button type="button" data-hero-prev class="hero-banner__arrow" aria-label={t('hero.prev')}>
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
      </button>
      <div class="hero-banner__dots" data-hero-dots role="tablist">
        {allItems.map((_, i) => (
          <button
            type="button"
            role="tab"
            data-hero-dot={i}
            class:list={['hero-banner__dot', { 'hero-banner__dot--active': i === 0 }]}
            aria-label={t('hero.goTo', { n: i + 1 })}
            aria-selected={i === 0 ? 'true' : 'false'}
          />
        ))}
      </div>
      <button type="button" data-hero-next class="hero-banner__arrow" aria-label={t('hero.next')}>
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
      </button>
    </div>
  )}
</section>

<script>
  /**
   * Carrusel del hero. Se (re)inicializa en `astro:page-load` porque con
   * <ClientRouter /> los módulos solo se ejecutan una vez por sesión, y se
   * limpia en `astro:before-swap` para no dejar timers huérfanos.
   */
  function initHeroBanner(el: HTMLElement): () => void {
    const slides = Array.from(el.querySelectorAll<HTMLElement>('[data-hero-slide]'));
    const dots = Array.from(el.querySelectorAll<HTMLButtonElement>('[data-hero-dot]'));
    const prev = el.querySelector<HTMLButtonElement>('[data-hero-prev]');
    const next = el.querySelector<HTMLButtonElement>('[data-hero-next]');
    const total = slides.length;
    if (total < 2) return () => {};

    const interval = Number(el.dataset.interval) || 6000;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let current = 0;
    let timer: ReturnType<typeof setInterval> | null = null;
    let paused = false;

    function show(index: number) {
      current = (index + total) % total;
      slides.forEach((s, i) => {
        const active = i === current;
        s.classList.toggle('hero-banner__slide--active', active);
        s.setAttribute('aria-hidden', active ? 'false' : 'true');
      });
      dots.forEach((d, i) => {
        const active = i === current;
        d.classList.toggle('hero-banner__dot--active', active);
        d.setAttribute('aria-selected', active ? 'true' : 'false');
      });
    }

    function stopTimer() {
      if (timer) { clearInterval(timer); timer = null; }
    }
    function startTimer() {
      stopTimer();
      if (reduced || paused || document.hidden) return;
      timer = setInterval(() => show(current + 1), interval);
    }
    const pause = () => { paused = true; stopTimer(); };
    const resume = () => { paused = false; startTimer(); };
    const onVisibility = () => startTimer();

    const onPrev = () => { show(current - 1); startTimer(); };
    const onNext = () => { show(current + 1); startTimer(); };
    const onKey = (e: KeyboardEvent) => {
      if (e.key === 'ArrowLeft') onPrev();
      if (e.key === 'ArrowRight') onNext();
    };
    const dotHandlers = dots.map((dot, i) => {
      const fn = () => { show(i); startTimer(); };
      dot.addEventListener('click', fn);
      return fn;
    });

    prev?.addEventListener('click', onPrev);
    next?.addEventListener('click', onNext);
    el.addEventListener('keydown', onKey);
    // Pausa al interactuar con cualquier slide (texto/CTA) o con los controles.
    el.addEventListener('mouseenter', pause);
    el.addEventListener('mouseleave', resume);
    el.addEventListener('focusin', pause);
    el.addEventListener('focusout', resume);
    document.addEventListener('visibilitychange', onVisibility);

    // Swipe táctil
    let touchX: number | null = null;
    const onTouchStart = (e: TouchEvent) => { touchX = e.touches[0]?.clientX ?? null; pause(); };
    const onTouchEnd = (e: TouchEvent) => {
      const endX = e.changedTouches[0]?.clientX;
      if (touchX !== null && endX !== undefined) {
        const dx = endX - touchX;
        if (Math.abs(dx) > 40) show(current + (dx < 0 ? 1 : -1));
      }
      touchX = null;
      resume();
    };
    el.addEventListener('touchstart', onTouchStart, { passive: true });
    el.addEventListener('touchend', onTouchEnd, { passive: true });

    startTimer();

    return () => {
      stopTimer();
      prev?.removeEventListener('click', onPrev);
      next?.removeEventListener('click', onNext);
      el.removeEventListener('keydown', onKey);
      el.removeEventListener('mouseenter', pause);
      el.removeEventListener('mouseleave', resume);
      el.removeEventListener('focusin', pause);
      el.removeEventListener('focusout', resume);
      el.removeEventListener('touchstart', onTouchStart);
      el.removeEventListener('touchend', onTouchEnd);
      document.removeEventListener('visibilitychange', onVisibility);
      dots.forEach((dot, i) => dot.removeEventListener('click', dotHandlers[i]));
    };
  }

  let cleaners: Array<() => void> = [];
  function setup() {
    cleaners.forEach((fn) => fn());
    cleaners = Array.from(document.querySelectorAll<HTMLElement>('[data-hero-banner]')).map(initHeroBanner);
  }
  document.addEventListener('astro:page-load', setup);
  document.addEventListener('astro:before-swap', () => { cleaners.forEach((fn) => fn()); cleaners = []; });
</script>

<style>
  .hero-banner {
    position: relative;
    width: 100%;
    height: 500px;
    overflow: hidden;
  }

  @media (min-width: 768px) {
    .hero-banner {
      height: 560px;
    }
  }

  @media (min-width: 1024px) {
    .hero-banner {
      height: 600px;
    }
  }

  .hero-banner__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.8s ease;
  }

  .hero-banner__slide--active {
    opacity: 1;
    pointer-events: auto;
  }

  .hero-banner__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s ease;
  }

  .hero-banner__slide--active .hero-banner__image {
    transform: scale(1.05);
    transition: transform 6s ease-in-out;
  }

  .hero-banner__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.65) 0%,
      rgba(0, 0, 0, 0.2) 40%,
      rgba(0, 0, 0, 0.05) 70%,
      transparent 100%
    );
    display: flex;
    align-items: flex-end;
    padding: 3rem 1.5rem 5rem;
  }

  @media (min-width: 768px) {
    .hero-banner__overlay {
      padding: 4rem 2rem 6rem;
    }
  }

  .hero-banner__overlay-inner {
    width: 100%;
    max-width: 80rem;
    margin: 0 auto;
  }


  .hero-banner__content {
    max-width: 42rem;
    text-align: left;
  }

  .hero-banner__date {
    display: inline-block;
    background: var(--color-saffron);
    color: white;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.375rem 0.875rem;
    border-radius: 9999px;
    margin-bottom: 1rem;
    letter-spacing: 0.02em;
  }

  .hero-banner__title {
    font-family: "Proza Libre", sans-serif;
    font-size: 2rem;
    font-weight: 700;
    color: white;
    line-height: 1.15;
    margin-bottom: 0.75rem;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);
    letter-spacing: -0.02em;
  }

  @media (min-width: 768px) {
    .hero-banner__title {
      font-size: 2.75rem;
    }
  }

  @media (min-width: 1024px) {
    .hero-banner__title {
      font-size: 3.25rem;
    }
  }

  .hero-banner__desc {
    font-size: 1.05rem;
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.6;
    margin-bottom: 1.5rem;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.3);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .hero-banner__cta {
    display: inline-block;
    background: var(--color-rausch);
    color: white;
    padding: 0.75rem 2rem;
    border-radius: var(--radius-DEFAULT);
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    transition: background 0.2s, transform 0.2s;
  }

  .hero-banner__cta:hover {
    background: var(--color-rausch-dark);
    transform: scale(1.02);
  }

  .hero-banner__controls {
    position: absolute;
    bottom: 1.25rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 1rem;
    z-index: 10;
  }

  .hero-banner__arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(6px);
    color: white;
    border: 1px solid rgba(255, 255, 255, 0.25);
    cursor: pointer;
    transition: background 0.2s, transform 0.2s;
  }

  .hero-banner__arrow:hover {
    background: rgba(255, 255, 255, 0.3);
    transform: scale(1.05);
  }

  .hero-banner__dots {
    display: flex;
    gap: 0.5rem;
  }

  .hero-banner__dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: none;
    cursor: pointer;
    padding: 0;
    background: rgba(255, 255, 255, 0.4);
    transition: all 0.3s ease;
  }

  .hero-banner__dot--active {
    background: white;
    width: 28px;
    border-radius: 5px;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-banner__slide--active .hero-banner__image {
      transform: scale(1);
      transition: none;
    }
  }
</style>
