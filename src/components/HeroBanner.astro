---
import { type FeaturedItem } from '@/src/lib/slider';
import { getLocale, localizePath, useTranslations, formatDate } from '@/src/i18n/utils';

interface Props {
  items: FeaturedItem[];
  interval?: number; // ms, default 6000
}

const { items, interval = 6000 } = Astro.props;
const locale = getLocale(Astro);
const t = useTranslations(locale);
const l = (path: string) => localizePath(locale, path);

// Slides permanentes (textos en src/i18n/dictionaries/hero.ts)
const staticSlides: FeaturedItem[] = [
  {
    collection: 'static',
    slug: 'bienvenida-yoga-planetario',
    image: '/api/images/1787355699024-slide-nuevo.webp',
    title: t('hero.slides.bienvenida.title'),
    description: t('hero.slides.bienvenida.description'),
    url: l('/nuestra-historia'),
    ctaLabel: t('hero.slides.bienvenida.cta'),
    _orden: 996,
  },
  {
    collection: 'static',
    slug: 'hospedajes-con-proposito',
    image: '/api/images/1785287420355-slide-hospedaje.webp',
    title: t('hero.slides.hospedaje.title'),
    description: t('hero.slides.hospedaje.description'),
    url: l('/hospedaje'),
    ctaLabel: t('hero.slides.hospedaje.cta'),
    _orden: 998,
  },
  {
    collection: 'static',
    slug: 'experiencias-a-la-medida',
    image: '/api/images/1785287371423-slide-experiencias.webp',
    title: t('hero.slides.experiencias.title'),
    description: t('hero.slides.experiencias.description'),
    url: l('/experiencias'),
    ctaLabel: t('hero.slides.experiencias.cta'),
    _orden: 997,
  },
  {
    collection: 'static',
    slug: 'templo-aereo',
    image: '/api/images/1782335650801-templo-aereo.webp',
    title: t('hero.slides.templo.title'),
    description: t('hero.slides.templo.description'),
    url: l('/contacto'),
    ctaLabel: t('hero.slides.templo.cta'),
    _orden: 999,
  },
];

// Los destacados de contenido van primero; sus URLs se localizan aquí.
const dynamicSlides = items.map((item) => ({
  ...item,
  url: l(item.url),
  ctaLabel: item.ctaLabel === 'Reservar' ? t('hero.reserve') : item.ctaLabel,
}));

const allItems = [...dynamicSlides, ...staticSlides];
const hasMultiple = allItems.length > 1;
---

<!-- El umbral: la foto se ve a través de un arco que se abre con el scroll.
     .hero es el recorrido, .hero__stage se fija bajo el header y --p (0→1,
     lo escribe el script) abre el recorte de .hero-banner. -->
<div class="hero" data-hero>
<div class="hero__stage">
<span class="hero__rings ripple" aria-hidden="true"></span>
<section class="hero-banner" data-hero-banner data-interval={String(interval)} aria-roledescription="carousel">
  {allItems.map((item, i) => (
    <div
      class:list={['hero-banner__slide', { 'hero-banner__slide--active': i === 0 }]}
      data-hero-slide={i}
      role="group"
      aria-roledescription="slide"
      aria-label={`${i + 1} / ${allItems.length}`}
      aria-hidden={i === 0 ? 'false' : 'true'}
    >
      <img
        src={item.image}
        alt={item.title}
        class="hero-banner__image"
        loading={i === 0 ? 'eager' : 'lazy'}
        fetchpriority={i === 0 ? 'high' : 'auto'}
        decoding="async"
      />
      <div class="hero-banner__overlay">
        <div class="hero-banner__overlay-inner">
          <div class="hero-banner__content">
            {item.date && (
              <span class="hero-banner__date">
                {formatDate(item.date, locale)}
              </span>
            )}
            <h2 class="hero-banner__title">{item.title}</h2>
            <p class="hero-banner__desc">{item.description}</p>
            <a href={item.url} class="btn btn-lg btn-arrow hero-banner__cta">
              {item.ctaLabel || t('hero.viewMore')}
            </a>
          </div>
        </div>
      </div>
    </div>
  ))}

  {hasMultiple && (
    <div class="hero-banner__controls">
      <button type="button" data-hero-prev class="hero-banner__arrow" aria-label={t('hero.prev')}>
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
      </button>
      <div class="hero-banner__dots" data-hero-dots role="tablist">
        {allItems.map((_, i) => (
          <button
            type="button"
            role="tab"
            data-hero-dot={i}
            class:list={['hero-banner__dot', { 'hero-banner__dot--active': i === 0 }]}
            aria-label={t('hero.goTo', { n: i + 1 })}
            aria-selected={i === 0 ? 'true' : 'false'}
          />
        ))}
      </div>
      <button type="button" data-hero-next class="hero-banner__arrow" aria-label={t('hero.next')}>
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
      </button>
    </div>
  )}
</section>
</div>
</div>

<script>
  /**
   * Carrusel del hero y apertura del arco con el scroll. Se (re)inicializa en `astro:page-load` porque con
   * <ClientRouter /> los módulos solo se ejecutan una vez por sesión, y se
   * limpia en `astro:before-swap` para no dejar timers huérfanos.
   */
  function initHeroBanner(el: HTMLElement): () => void {
    const slides = Array.from(el.querySelectorAll<HTMLElement>('[data-hero-slide]'));
    const dots = Array.from(el.querySelectorAll<HTMLButtonElement>('[data-hero-dot]'));
    const prev = el.querySelector<HTMLButtonElement>('[data-hero-prev]');
    const next = el.querySelector<HTMLButtonElement>('[data-hero-next]');
    const total = slides.length;

    // Apertura del arco: --p va de 0 a 1 mientras .hero__stage está fijo.
    const root = el.closest<HTMLElement>('[data-hero]');
    const stage = el.closest<HTMLElement>('.hero__stage');
    let frame = 0;
    const measure = () => {
      frame = 0;
      if (!root || !stage) return;
      const run = root.offsetHeight - stage.offsetHeight;
      const top = parseFloat(getComputedStyle(stage).top) || 0;
      const p = run > 1 ? Math.min(1, Math.max(0, (top - root.getBoundingClientRect().top) / run)) : 0;
      root.style.setProperty('--p', p.toFixed(4));
    };
    const onScroll = () => { if (!frame) frame = requestAnimationFrame(measure); };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    measure();
    const stopScroll = () => {
      cancelAnimationFrame(frame);
      window.removeEventListener('scroll', onScroll);
      window.removeEventListener('resize', onScroll);
    };

    if (total < 2) return stopScroll;

    const interval = Number(el.dataset.interval) || 6000;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let current = 0;
    let timer: ReturnType<typeof setInterval> | null = null;
    let paused = false;

    function show(index: number) {
      current = (index + total) % total;
      slides.forEach((s, i) => {
        const active = i === current;
        s.classList.toggle('hero-banner__slide--active', active);
        s.setAttribute('aria-hidden', active ? 'false' : 'true');
      });
      dots.forEach((d, i) => {
        const active = i === current;
        d.classList.toggle('hero-banner__dot--active', active);
        d.setAttribute('aria-selected', active ? 'true' : 'false');
      });
    }

    function stopTimer() {
      if (timer) { clearInterval(timer); timer = null; }
    }
    function startTimer() {
      stopTimer();
      if (reduced || paused || document.hidden) return;
      timer = setInterval(() => show(current + 1), interval);
    }
    const pause = () => { paused = true; stopTimer(); };
    const resume = () => { paused = false; startTimer(); };
    const onVisibility = () => startTimer();

    const onPrev = () => { show(current - 1); startTimer(); };
    const onNext = () => { show(current + 1); startTimer(); };
    const onKey = (e: KeyboardEvent) => {
      if (e.key === 'ArrowLeft') onPrev();
      if (e.key === 'ArrowRight') onNext();
    };
    const dotHandlers = dots.map((dot, i) => {
      const fn = () => { show(i); startTimer(); };
      dot.addEventListener('click', fn);
      return fn;
    });

    prev?.addEventListener('click', onPrev);
    next?.addEventListener('click', onNext);
    el.addEventListener('keydown', onKey);
    // Pausa al interactuar con cualquier slide (texto/CTA) o con los controles.
    el.addEventListener('mouseenter', pause);
    el.addEventListener('mouseleave', resume);
    el.addEventListener('focusin', pause);
    el.addEventListener('focusout', resume);
    document.addEventListener('visibilitychange', onVisibility);

    // Swipe táctil
    let touchX: number | null = null;
    const onTouchStart = (e: TouchEvent) => { touchX = e.touches[0]?.clientX ?? null; pause(); };
    const onTouchEnd = (e: TouchEvent) => {
      const endX = e.changedTouches[0]?.clientX;
      if (touchX !== null && endX !== undefined) {
        const dx = endX - touchX;
        if (Math.abs(dx) > 40) show(current + (dx < 0 ? 1 : -1));
      }
      touchX = null;
      resume();
    };
    el.addEventListener('touchstart', onTouchStart, { passive: true });
    el.addEventListener('touchend', onTouchEnd, { passive: true });

    startTimer();

    return () => {
      stopTimer();
      stopScroll();
      prev?.removeEventListener('click', onPrev);
      next?.removeEventListener('click', onNext);
      el.removeEventListener('keydown', onKey);
      el.removeEventListener('mouseenter', pause);
      el.removeEventListener('mouseleave', resume);
      el.removeEventListener('focusin', pause);
      el.removeEventListener('focusout', resume);
      el.removeEventListener('touchstart', onTouchStart);
      el.removeEventListener('touchend', onTouchEnd);
      document.removeEventListener('visibilitychange', onVisibility);
      dots.forEach((dot, i) => dot.removeEventListener('click', dotHandlers[i]));
    };
  }

  let cleaners: Array<() => void> = [];
  function setup() {
    cleaners.forEach((fn) => fn());
    cleaners = Array.from(document.querySelectorAll<HTMLElement>('[data-hero-banner]')).map(initHeroBanner);
  }
  document.addEventListener('astro:page-load', setup);
  document.addEventListener('astro:before-swap', () => { cleaners.forEach((fn) => fn()); cleaners = []; });
</script>

<style>
  .hero {
    --p: 0;
    position: relative;
  }

  .hero__stage {
    position: relative;
    container-type: inline-size;
    background: var(--color-forest-night);
    height: calc(100svh - var(--hh, 6.5rem));
    min-height: 32rem;
    max-height: 62rem;
  }

  /* Con JS y sin «reducir movimiento» el escenario se fija y el scroll
     abre el arco. En cualquier otro caso queda el arco estático. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .hero {
      height: calc(100svh - var(--hh, 6.5rem) + 55svh);
      min-height: calc(32rem + 55svh);
    }
    :global(html.js) .hero__stage {
      position: sticky;
      top: var(--hh, 6.5rem);
    }
  }

  /* Enjutas: anillos concéntricos al arco en las esquinas que deja libres.
     Se apagan a medida que el arco se abre. */
  .hero__rings {
    --r: calc(50cqw - 4vw);
    --ring: color-mix(in srgb, var(--color-saffron) 55%, transparent);
    --g1: clamp(0.9rem, 2.2cqw, 2rem);
    --g2: clamp(2.1rem, 5cqw, 4.5rem);
    --g3: clamp(3.6rem, 8.4cqw, 7.5rem);
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: calc(1 - var(--p) * 1.6);
    background: radial-gradient(
      circle at 50% calc(1rem + var(--r)),
      transparent calc(var(--r) + var(--g1) + var(--w1)),
      var(--ring) calc(var(--r) + var(--g1) + var(--w1) + 0.5px) calc(var(--r) + var(--g1) + var(--w1) + 1.5px),
      transparent calc(var(--r) + var(--g1) + var(--w1) + 2px) calc(var(--r) + var(--g2) + var(--w2)),
      var(--ring) calc(var(--r) + var(--g2) + var(--w2) + 0.5px) calc(var(--r) + var(--g2) + var(--w2) + 1.5px),
      transparent calc(var(--r) + var(--g2) + var(--w2) + 2px) calc(var(--r) + var(--g3) + var(--w3)),
      var(--ring) calc(var(--r) + var(--g3) + var(--w3) + 0.5px) calc(var(--r) + var(--g3) + var(--w3) + 1.5px),
      transparent calc(var(--r) + var(--g3) + var(--w3) + 2px)
    );
  }

  .hero-banner {
    --rest: calc(1 - var(--p));
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: var(--color-forest-night);
    clip-path: inset(
      calc(var(--rest) * 1rem) calc(var(--rest) * 4vw) 0
      round calc(var(--rest) * 50vw) calc(var(--rest) * 50vw) 0 0
    );
    will-change: clip-path;
  }

  .hero-banner__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 1.2s ease;
  }

  .hero-banner__slide--active {
    opacity: 1;
    pointer-events: auto;
  }

  .hero-banner__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.02);
    transition: transform 1.2s ease;
  }

  .hero-banner__slide--active .hero-banner__image {
    transform: scale(1.1);
    transition: transform 9s ease-out;
  }

  .hero-banner__overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, rgb(23 35 15 / 0.88) 0%, rgb(23 35 15 / 0.5) 32%, rgb(23 35 15 / 0) 62%),
      linear-gradient(to right, rgb(23 35 15 / 0.35) 0%, rgb(23 35 15 / 0) 55%);
    display: flex;
    align-items: flex-end;
    /* El contenido se aparta de los hombros del arco mientras está cerrado */
    padding: 3rem calc(1.5rem + var(--rest) * 4vw) 5.5rem;
  }

  @media (min-width: 768px) {
    .hero-banner__overlay {
      padding: 4rem calc(3rem + var(--rest) * 4vw) 4.5rem;
    }
  }

  @media (min-width: 1024px) {
    .hero-banner__overlay {
      padding-inline: calc(5rem + var(--rest) * 4vw);
    }
  }

  .hero-banner__overlay-inner {
    width: 100%;
    max-width: 80rem;
    margin: 0 auto;
  }

  .hero-banner__content {
    max-width: 46rem;
    text-align: left;
  }

  /* El texto de cada slide sube al activarse */
  .hero-banner__content > * {
    opacity: 0;
    transform: translateY(1.25rem);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }

  .hero-banner__slide--active .hero-banner__content > * {
    opacity: 1;
    transform: none;
    transition: opacity 0.9s var(--ease-out) 0.25s, transform 0.9s var(--ease-out) 0.25s;
  }

  .hero-banner__slide--active .hero-banner__content > :nth-child(2) { transition-delay: 0.35s; }
  .hero-banner__slide--active .hero-banner__content > :nth-child(3) { transition-delay: 0.45s; }
  .hero-banner__slide--active .hero-banner__content > :nth-child(4) { transition-delay: 0.55s; }

  .hero-banner__date {
    display: inline-block;
    color: var(--color-saffron);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }

  .hero-banner__title {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 1.1rem + 5vw, 5.25rem);
    font-weight: 700;
    color: white;
    line-height: 1.02;
    letter-spacing: -0.03em;
    margin-bottom: 1.25rem;
    text-wrap: balance;
  }

  .hero-banner__desc {
    font-size: 1.0625rem;
    color: rgb(255 255 255 / 0.88);
    line-height: 1.6;
    max-width: 34rem;
    margin-bottom: 2rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (min-width: 768px) {
    .hero-banner__desc {
      font-size: 1.1875rem;
      -webkit-line-clamp: 2;
    }
  }

  .hero-banner__controls {
    position: absolute;
    bottom: 1.25rem;
    left: calc(1.5rem + var(--rest) * 4vw);
    display: flex;
    align-items: center;
    gap: 0.75rem;
    z-index: 10;
  }

  @media (min-width: 768px) {
    .hero-banner__controls {
      left: auto;
      right: calc(3rem + var(--rest) * 4vw);
      bottom: 4.75rem;
    }
  }

  @media (min-width: 1024px) {
    .hero-banner__controls {
      right: calc(5rem + var(--rest) * 4vw);
    }
  }

  .hero-banner__arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.12);
    backdrop-filter: blur(6px);
    color: white;
    border: 1px solid rgb(255 255 255 / 0.3);
    cursor: pointer;
    transition: background 0.3s var(--ease-out), color 0.3s var(--ease-out);
  }

  .hero-banner__arrow:hover {
    background: white;
    color: var(--color-forest-night);
  }

  .hero-banner__arrow:focus-visible,
  .hero-banner__dot:focus-visible {
    outline-color: white;
  }

  .hero-banner__dots {
    display: flex;
    align-items: center;
    gap: 0.375rem;
  }

  /* Zona táctil de 24px con una barra fina dentro */
  .hero-banner__dot {
    position: relative;
    width: 22px;
    height: 24px;
    border: none;
    cursor: pointer;
    padding: 0;
    background: transparent;
    transition: width 0.5s var(--ease-out);
  }

  .hero-banner__dot::before {
    content: "";
    position: absolute;
    inset: 11px 0;
    border-radius: 2px;
    background: rgb(255 255 255 / 0.45);
    transition: background 0.5s var(--ease-out);
  }

  .hero-banner__dot--active {
    width: 44px;
  }

  .hero-banner__dot--active::before {
    background: var(--color-saffron);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-banner__slide,
    .hero-banner__content > *,
    .hero-banner__slide--active .hero-banner__content > * {
      transition: none;
    }
    .hero-banner__slide--active .hero-banner__image,
    .hero-banner__image {
      transform: none;
      transition: none;
    }
  }
</style>
