---
import { type FeaturedItem } from '@/src/lib/slider';

interface Props {
  items: FeaturedItem[];
  interval?: number; // ms, default 6000
}

const { items, interval = 6000 } = Astro.props;

// Permanent slide: Templo Aereo
const temploItem: FeaturedItem = {
  collection: 'static',
  slug: 'templo-aereo',
  image: 'https://varsana-co.iaforchange.workers.dev/api/images/1782335650801-templo-aereo.webp',
  title: 'Visita nuestro Yoga Planetario',
  description: 'Un espacio sagrado para la meditacion, el yoga y la conexion espiritual en las montañas del Sumapaz.',
  url: '/contacto',
  ctaLabel: 'Contactanos',
  _orden: 999,
};

// Permanent slide: Hospedajes
const hospedajeItem: FeaturedItem = {
  collection: 'static',
  slug: 'hospedajes-con-proposito',
  image: 'https://picsum.photos/seed/hospedaje-naturaleza/1200/600',
  title: 'Hospedajes con propósito',
  description: 'Descubre la magia de despertar rodeado de naturaleza sagrada.',
  url: '/hospedaje',
  ctaLabel: 'Ver hospedajes',
  _orden: 998,
};

// Permanent slide: Experiencias
const experienciasItem: FeaturedItem = {
  collection: 'static',
  slug: 'experiencias-a-la-medida',
  image: 'https://picsum.photos/seed/experiencias-yoga/1200/600',
  title: 'Experiencias a la medida',
  description: 'Tu renovación el día de la semana que prefieras.',
  url: '/experiencias',
  ctaLabel: 'Ver experiencias',
  _orden: 997,
};

const allItems = [...items, hospedajeItem, experienciasItem, temploItem];
const hasMultiple = allItems.length > 1;
---

<div class="hero-banner shimmer" data-hero-banner data-interval={String(interval)}>
  {allItems.map((item, i) => (
    <div
      class:list={['hero-banner__slide', { 'hero-banner__slide--active': i === 0 }]}
      data-hero-slide={i}
    >
      <img
        src={item.image}
        alt={item.title}
        class="hero-banner__image"
        loading={i === 0 ? 'eager' : 'lazy'}
      />
      <div class="hero-banner__overlay">
        <div class="hero-banner__overlay-inner">
          <div class="hero-banner__content">
            {item.date && (
              <span class="hero-banner__date">
                {item.date.toLocaleDateString('es-CO', {
                  day: 'numeric',
                  month: 'long',
                  year: 'numeric',
                })}
              </span>
            )}
            <h2 class="hero-banner__title">{item.title}</h2>
            <p class="hero-banner__desc">{item.description}</p>
            <a href={item.url} class="hero-banner__cta">
              {item.ctaLabel || 'Ver mas'}
            </a>
          </div>
        </div>
      </div>
    </div>
  ))}

  {hasMultiple && (
    <div class="hero-banner__controls">
      <button type="button" data-hero-prev class="hero-banner__arrow" aria-label="Anterior">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      </button>
      <div class="hero-banner__dots" data-hero-dots>
        {items.map((_, i) => (
          <button
            type="button"
            data-hero-dot={i}
            class:list={['hero-banner__dot', { 'hero-banner__dot--active': i === 0 }]}
            aria-label={`Ir al banner ${i + 1}`}
          />
        ))}
      </div>
      <button type="button" data-hero-next class="hero-banner__arrow" aria-label="Siguiente">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
      </button>
    </div>
  )}
</div>

<script>
  function initHeroBanner(el: HTMLElement) {
    const slides = el.querySelectorAll<HTMLElement>('[data-hero-slide]');
    const dots = el.querySelectorAll<HTMLButtonElement>('[data-hero-dot]');
    const prev = el.querySelector<HTMLButtonElement>('[data-hero-prev]');
    const next = el.querySelector<HTMLButtonElement>('[data-hero-next]');
    const total = slides.length;
    if (total < 2) return;

    const interval = Number(el.dataset.interval) || 6000;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let current = 0;
    let timer: ReturnType<typeof setInterval> | null = null;

    function show(index: number) {
      slides.forEach((s, i) => {
        s.classList.toggle('hero-banner__slide--active', i === index);
      });
      dots.forEach((d, i) => {
        d.classList.toggle('hero-banner__dot--active', i === index);
      });
      current = index;
    }

    function goNext() {
      show((current + 1) % total);
    }

    function goPrev() {
      show((current - 1 + total) % total);
    }

    function startTimer() {
      if (reduced) return;
      stopTimer();
      timer = setInterval(goNext, interval);
    }

    function stopTimer() {
      if (timer) { clearInterval(timer); timer = null; }
    }

    function resetTimer() {
      stopTimer();
      startTimer();
    }

    // Named handlers para poder removerlos correctamente
    function handlePrev() { goPrev(); resetTimer(); }
    function handleNext() { goNext(); resetTimer(); }
    const dotHandlers: Array<{ dot: HTMLButtonElement; fn: () => void }> = [];

    if (prev) prev.addEventListener('click', handlePrev);
    if (next) next.addEventListener('click', handleNext);

    dots.forEach((dot, i) => {
      const fn = () => { show(i); resetTimer(); };
      dot.addEventListener('click', fn);
      dotHandlers.push({ dot, fn });
    });

    const pauseZone = el.querySelector('.hero-banner__content');
    if (pauseZone) {
      pauseZone.addEventListener('mouseenter', stopTimer);
      pauseZone.addEventListener('mouseleave', startTimer);
      pauseZone.addEventListener('focusin', stopTimer);
      pauseZone.addEventListener('focusout', startTimer);
    }

    startTimer();

    return () => {
      stopTimer();
      if (prev) prev.removeEventListener('click', handlePrev);
      if (next) next.removeEventListener('click', handleNext);
      dotHandlers.forEach(({ dot, fn }) => dot.removeEventListener('click', fn));
      if (pauseZone) {
        pauseZone.removeEventListener('mouseenter', stopTimer);
        pauseZone.removeEventListener('mouseleave', startTimer);
        pauseZone.removeEventListener('focusin', stopTimer);
        pauseZone.removeEventListener('focusout', startTimer);
      }
    };
  }

  const cleaners: (() => void)[] = [];
  document.querySelectorAll<HTMLElement>('[data-hero-banner]').forEach((el) => {
    const clean = initHeroBanner(el);
    if (clean) cleaners.push(clean);
  });
  document.addEventListener('astro:before-swap', () => {
    cleaners.forEach(fn => fn());
    cleaners.length = 0;
  });
</script>

<style>
  .hero-banner {
    position: relative;
    width: 100%;
    height: 500px;
    overflow: hidden;
  }

  @media (min-width: 768px) {
    .hero-banner {
      height: 560px;
    }
  }

  @media (min-width: 1024px) {
    .hero-banner {
      height: 600px;
    }
  }

  .hero-banner__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.8s ease;
  }

  .hero-banner__slide--active {
    opacity: 1;
    pointer-events: auto;
  }

  .hero-banner__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s ease;
  }

  .hero-banner__slide--active .hero-banner__image {
    transform: scale(1.05);
    transition: transform 6s ease-in-out;
  }

  .hero-banner__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.65) 0%,
      rgba(0, 0, 0, 0.2) 40%,
      rgba(0, 0, 0, 0.05) 70%,
      transparent 100%
    );
    display: flex;
    align-items: flex-end;
    padding: 3rem 1.5rem 5rem;
  }

  @media (min-width: 768px) {
    .hero-banner__overlay {
      padding: 4rem 2rem 6rem;
    }
  }

  .hero-banner__overlay-inner {
    width: 100%;
    max-width: 80rem;
    margin: 0 auto;
  }


  .hero-banner__content {
    max-width: 42rem;
    text-align: left;
  }

  .hero-banner__date {
    display: inline-block;
    background: var(--color-saffron);
    color: white;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.375rem 0.875rem;
    border-radius: 9999px;
    margin-bottom: 1rem;
    letter-spacing: 0.02em;
  }

  .hero-banner__title {
    font-family: "Proza Libre", sans-serif;
    font-size: 2rem;
    font-weight: 700;
    color: white;
    line-height: 1.15;
    margin-bottom: 0.75rem;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);
    letter-spacing: -0.02em;
  }

  @media (min-width: 768px) {
    .hero-banner__title {
      font-size: 2.75rem;
    }
  }

  @media (min-width: 1024px) {
    .hero-banner__title {
      font-size: 3.25rem;
    }
  }

  .hero-banner__desc {
    font-size: 1.05rem;
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.6;
    margin-bottom: 1.5rem;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.3);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .hero-banner__cta {
    display: inline-block;
    background: var(--color-rausch);
    color: white;
    padding: 0.75rem 2rem;
    border-radius: var(--radius-DEFAULT);
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    transition: background 0.2s, transform 0.2s;
  }

  .hero-banner__cta:hover {
    background: var(--color-rausch-dark);
    transform: scale(1.02);
  }

  .hero-banner__controls {
    position: absolute;
    bottom: 1.25rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 1rem;
    z-index: 10;
  }

  .hero-banner__arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(6px);
    color: white;
    border: 1px solid rgba(255, 255, 255, 0.25);
    cursor: pointer;
    transition: background 0.2s, transform 0.2s;
  }

  .hero-banner__arrow:hover {
    background: rgba(255, 255, 255, 0.3);
    transform: scale(1.05);
  }

  .hero-banner__dots {
    display: flex;
    gap: 0.5rem;
  }

  .hero-banner__dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: none;
    cursor: pointer;
    padding: 0;
    background: rgba(255, 255, 255, 0.4);
    transition: all 0.3s ease;
  }

  .hero-banner__dot--active {
    background: white;
    width: 28px;
    border-radius: 5px;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-banner__slide--active .hero-banner__image {
      transform: scale(1);
      transition: none;
    }
  }
</style>
