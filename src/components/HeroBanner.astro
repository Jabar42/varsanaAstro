---
import { type FeaturedItem } from '@/src/lib/slider';

interface Props {
  items: FeaturedItem[];
  interval?: number; // ms, default 6000
}

const { items, interval = 6000 } = Astro.props;

if (items.length === 0) return;
const hasMultiple = items.length > 1;
---

<div class="hero-banner" data-hero-banner data-interval={String(interval)}>
  {items.map((item, i) => (
    <div
      class:list={['hero-banner__slide', { 'hero-banner__slide--active': i === 0 }]}
      data-hero-slide={i}
    >
      <img
        src={item.image}
        alt={item.title}
        class="hero-banner__image"
        loading={i === 0 ? 'eager' : 'lazy'}
      />
      <div class="hero-banner__overlay">
        <div class="hero-banner__content">
          {item.date && (
            <span class="hero-banner__date">
              {item.date.toLocaleDateString('es-CO', {
                day: 'numeric',
                month: 'long',
                year: 'numeric',
              })}
            </span>
          )}
          <h2 class="hero-banner__title">{item.title}</h2>
          <p class="hero-banner__desc">{item.description}</p>
          <div class="hero-banner__actions">
            {item.price && (
              <span class="hero-banner__price">
                {item.price.label ? `${item.price.label} · ` : ''}
                ${item.price.amount.toLocaleString('es-CO')} COP
              </span>
            )}
            <a href={item.url} class="hero-banner__cta">
              {item.ctaLabel || 'Ver mas'}
            </a>
          </div>
        </div>
      </div>
    </div>
  ))}

  {hasMultiple && (
    <div class="hero-banner__dots" data-hero-dots>
      {items.map((_, i) => (
        <button
          type="button"
          data-hero-dot={i}
          class:list={['hero-banner__dot', { 'hero-banner__dot--active': i === 0 }]}
          aria-label={`Ir al banner ${i + 1}`}
        />
      ))}
    </div>
  )}
</div>

<script>
  function initHeroBanner(el: HTMLElement) {
    const slides = el.querySelectorAll<HTMLElement>('[data-hero-slide]');
    const dots = el.querySelectorAll<HTMLButtonElement>('[data-hero-dot]');
    const total = slides.length;
    if (total < 2) return;

    const interval = Number(el.dataset.interval) || 6000;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let current = 0;
    let timer: ReturnType<typeof setInterval> | null = null;

    function show(index: number) {
      slides.forEach((s, i) => {
        s.classList.toggle('hero-banner__slide--active', i === index);
      });
      dots.forEach((d, i) => {
        d.classList.toggle('hero-banner__dot--active', i === index);
      });
      current = index;
    }

    function next() {
      show((current + 1) % total);
    }

    function startTimer() {
      if (reduced) return;
      stopTimer();
      timer = setInterval(next, interval);
    }

    function stopTimer() {
      if (timer) { clearInterval(timer); timer = null; }
    }

    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => { show(i); stopTimer(); startTimer(); });
    });

    const pauseZone = el.querySelector('.hero-banner__content');
    if (pauseZone) {
      pauseZone.addEventListener('mouseenter', stopTimer);
      pauseZone.addEventListener('mouseleave', startTimer);
      pauseZone.addEventListener('focusin', stopTimer);
      pauseZone.addEventListener('focusout', startTimer);
    }

    startTimer();
  }

  document.querySelectorAll<HTMLElement>('[data-hero-banner]').forEach(initHeroBanner);
</script>

<style>
  .hero-banner {
    position: relative;
    width: 100%;
    height: 500px;
    overflow: hidden;
    border-radius: 2rem;
  }

  @media (min-width: 768px) {
    .hero-banner {
      height: 560px;
    }
  }

  @media (min-width: 1024px) {
    .hero-banner {
      height: 600px;
    }
  }

  .hero-banner__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.8s ease;
  }

  .hero-banner__slide--active {
    opacity: 1;
  }

  .hero-banner__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-banner__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.65) 0%,
      rgba(0, 0, 0, 0.2) 40%,
      rgba(0, 0, 0, 0.05) 70%,
      transparent 100%
    );
    display: flex;
    align-items: flex-end;
    justify-content: center;
    text-align: center;
    padding: 3rem 1.5rem;
  }

  @media (min-width: 768px) {
    .hero-banner__overlay {
      padding: 4rem 2rem;
      justify-content: flex-start;
      text-align: left;
    }
  }

  .hero-banner__content {
    max-width: 42rem;
  }

  .hero-banner__date {
    display: inline-block;
    background: #F7941E;
    color: white;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.375rem 0.875rem;
    border-radius: 9999px;
    margin-bottom: 1rem;
    letter-spacing: 0.02em;
  }

  .hero-banner__title {
    font-family: var(--font-display, 'Proza Libre', sans-serif);
    font-size: 2rem;
    font-weight: 700;
    color: white;
    line-height: 1.15;
    margin-bottom: 0.75rem;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);
    letter-spacing: -0.02em;
  }

  @media (min-width: 768px) {
    .hero-banner__title {
      font-size: 2.75rem;
    }
  }

  @media (min-width: 1024px) {
    .hero-banner__title {
      font-size: 3.25rem;
    }
  }

  .hero-banner__desc {
    font-size: 1.05rem;
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.6;
    margin-bottom: 1.5rem;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.3);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .hero-banner__actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  @media (min-width: 768px) {
    .hero-banner__actions {
      justify-content: flex-start;
    }
  }

  .hero-banner__price {
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.8);
  }

  .hero-banner__cta {
    display: inline-block;
    background: #52185B;
    color: white;
    padding: 0.75rem 2rem;
    border-radius: 0.75rem;
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    transition: background 0.2s, transform 0.2s;
  }

  .hero-banner__cta:hover {
    background: #6a1f73;
    transform: scale(1.04);
  }

  .hero-banner__dots {
    position: absolute;
    bottom: 1.25rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 0.5rem;
    z-index: 10;
  }

  .hero-banner__dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: none;
    cursor: pointer;
    padding: 0;
    background: rgba(255, 255, 255, 0.4);
    transition: all 0.3s ease;
  }

  .hero-banner__dot--active {
    background: white;
    width: 28px;
    border-radius: 5px;
  }
</style>
