---
import { getLocale } from '@/src/i18n/utils';
import Layout from '@/src/layouts/Layout.astro';

interface Props {
  titleEs: string;
  titleEn: string;
  descriptionEs: string;
  descriptionEn: string;
  icon: string;
}

const { titleEs, titleEn, descriptionEs, descriptionEn, icon } = Astro.props;

const locale = getLocale(Astro);
const title = locale === 'en' ? titleEn : titleEs;
const description = locale === 'en' ? descriptionEn : descriptionEs;
const comingSoon = locale === 'en' ? 'Coming Soon' : 'Próximamente';
const backHome = locale === 'en' ? 'Back to Home' : 'Volver al inicio';
const stayTuned = locale === 'en'
  ? 'We are preparing something special. Stay tuned.'
  : 'Estamos preparando algo especial. Mantente al tanto.';

const icons: Record<string, string> = {
  sprout: `<path d="M12 2v8M8 6c0 0 4-4 8 0M6 14c0 0 3-2 6 0M18 14c0 0-3-2-6 0" stroke="currentColor" fill="none" stroke-width="2" stroke-linecap="round"/>`,
  store: `<path d="M3 9h18l-1 12H4L3 9ZM7 9V7a5 5 0 0 1 10 0v2M12 13v4" stroke="currentColor" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>`,
  sun: `<circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>`,
  flower: `<circle cx="12" cy="12" r="3" fill="none" stroke="currentColor" stroke-width="2"/><path d="M12 2v6M12 16v6M5.64 5.64l4.24 4.24M14.12 14.12l4.24 4.24M2 12h6M16 12h6M5.64 18.36l4.24-4.24M14.12 9.88l4.24-4.24" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>`,
  mountain: `<path d="M6 16 12 4l6 12H6ZM7 14.5 9 11l3 5.5" stroke="currentColor" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>`,
  utensils: `<path d="M18 2v20M6 2v20M6 10h12" stroke="currentColor" fill="none" stroke-width="2" stroke-linecap="round"/><circle cx="6" cy="5" r="3" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="18" cy="5" r="3" fill="none" stroke="currentColor" stroke-width="2"/>`,
  tree: `<path d="M12 22v-6M10 8l2-6 2 6M8 14l2-4 2 4M4 20l3-6h10l3 6H4Z" stroke="currentColor" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>`,
};

const iconSvg = icons[icon] || icons.sprout;
---

<Layout title={`${title} | Varsana Eco Yoga Aldea`}>
  <main class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 py-20 md:py-28">
    <div class="flex flex-col items-center text-center max-w-lg mx-auto">
      <div class="w-20 h-20 bg-saffron/10 rounded-full flex items-center justify-center mb-8">
        <svg width="36" height="36" viewBox="0 0 24 24" class="text-saffron" set:html={iconSvg} />
      </div>

      <span class="inline-block bg-saffron/10 text-saffron font-bold text-sm px-4 py-1.5 rounded-full mb-6 tracking-wide">
        {comingSoon}
      </span>

      <h1 class="text-3xl md:text-5xl font-bold font-display text-near-black leading-tight mb-6">
        {title}
      </h1>

      <p class="text-lg text-gray-500 leading-relaxed mb-4">
        {description}
      </p>
      <p class="text-base text-gray-400 leading-relaxed mb-10">
        {stayTuned}
      </p>

      <a
        href={locale === 'en' ? '/en/' : '/'}
        class="inline-block bg-rausch text-white px-10 py-4 rounded-2xl font-bold text-lg hover:bg-rausch-dark transition-all duration-300 hover:scale-105 shadow-lg"
      >
        {backHome}
      </a>
    </div>
  </main>
</Layout>
