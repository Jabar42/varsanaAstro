---
import { Globe, Facebook, Instagram, Youtube } from 'lucide-react';
---

<footer class="bg-light-surface border-t border-gray-200 mt-16 px-6 py-12 md:px-12 lg:px-20">
  <div class="max-w-7xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 pb-12 border-b border-gray-300">
      <div class="space-y-4">
        <h4 class="font-bold text-sm uppercase tracking-wider">Programas</h4>
        <ul class="space-y-3 text-sm text-secondary-gray">
          <li class="hover:underline cursor-pointer">Yoga y Meditación</li>
          <li class="hover:underline cursor-pointer">Voluntariado</li>
          <li class="hover:underline cursor-pointer">Pasadías Ecológicos</li>
          <li class="hover:underline cursor-pointer">Retiros Espirituales</li>
          <li class="hover:underline cursor-pointer">Talleres de Cocina</li>
        </ul>
      </div>
      <div class="space-y-4">
        <h4 class="font-bold text-sm uppercase tracking-wider">Comunidad</h4>
        <ul class="space-y-3 text-sm text-secondary-gray">
          <li class="hover:underline cursor-pointer">Varsana.org</li>
          <li class="hover:underline cursor-pointer">Proyectos Sociales</li>
          <li class="hover:underline cursor-pointer">Agricultura Orgánica</li>
          <li class="hover:underline cursor-pointer">Eco-Construcción</li>
        </ul>
      </div>
      <div class="space-y-4">
        <h4 class="font-bold text-sm uppercase tracking-wider">Sobre Nosotros</h4>
        <ul class="space-y-3 text-sm text-secondary-gray">
          <li class="hover:underline cursor-pointer">Nuestra Historia</li>
          <li class="hover:underline cursor-pointer">Filosofía</li>
          <li class="hover:underline cursor-pointer">Galería</li>
          <li class="hover:underline cursor-pointer">Preguntas Frecuentes</li>
        </ul>
      </div>
      <div class="space-y-4">
        <h4 class="font-bold text-sm uppercase tracking-wider">Contacto</h4>
        <ul class="space-y-3 text-sm text-secondary-gray">
          <li class="hover:underline cursor-pointer">+57 321 4538242</li>
          <li class="hover:underline cursor-pointer">contacto@varsana.com</li>
          <li class="hover:underline cursor-pointer">Granada, Cundinamarca</li>
          <li class="hover:underline cursor-pointer">Colombia</li>
        </ul>
      </div>
    </div>

    <div class="pt-8 flex flex-col md:flex-row justify-between items-center gap-4 text-sm">
      <div class="flex flex-wrap justify-center gap-2 text-secondary-gray">
        <span>© 2024 Varsana Eco Yoga Aldea</span>
        <span>·</span>
        <span class="hover:underline cursor-pointer">Privacidad</span>
        <span>·</span>
        <span class="hover:underline cursor-pointer">Condiciones</span>
        <span>·</span>
        <span class="hover:underline cursor-pointer">Mapa del sitio</span>
      </div>
      
      <div class="flex items-center gap-6 font-semibold">
        <div class="flex items-center gap-2 hover:underline cursor-pointer">
          <Globe size={16} />
          <span>Español (CO)</span>
        </div>
        <div class="flex items-center gap-2 hover:underline cursor-pointer">
          <span>$</span>
          <span>COP</span>
        </div>
        <div class="flex items-center gap-4">
          <Facebook size={18} />
          <Instagram size={18} />
          <Youtube size={18} />
        </div>
      </div>
    </div>
  </div>
</footer>
