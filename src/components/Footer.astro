---
import { Globe, Facebook, Instagram, Youtube } from 'lucide-react';
import { useTranslations } from '@/src/i18n/utils';
import { getRelativeLocaleUrl } from 'astro:i18n';

const locale = (Astro.locals as any)?.locale ?? Astro.currentLocale ?? 'es';
const otherLocale = locale === 'en' ? 'es' : 'en';
const t = useTranslations(locale);
const l = (path: string) => getRelativeLocaleUrl(locale, path);
const switchUrl = (() => {
  const p = Astro.url.pathname.replace(/^\/en(?=\/|$)/, '');
  return getRelativeLocaleUrl(otherLocale, p || '/');
})();
---

<footer class="bg-near-black mt-16 px-6 py-12 md:px-12 lg:px-20">
  <div class="max-w-7xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 pb-12 border-b border-near-black/30">
      <div class="flex flex-col gap-4">
        <img src="/logo/LogoPrincipal.svg" alt="Varsana" class="w-24" />
        <p class="text-sm text-gray-400 leading-relaxed max-w-52">
          {t('footer.tagline')}
        </p>
      </div>
      <div class="space-y-4">
        <h4 class="font-bold text-sm uppercase tracking-wider text-white">{t('footer.community')}</h4>
        <ul class="space-y-3 text-sm text-gray-400">
          <li class="hover:text-white hover:underline cursor-pointer transition-colors">{t('footer.varsanaOrg')}</li>
          <li class="hover:text-white hover:underline cursor-pointer transition-colors">{t('footer.socialProjects')}</li>
          <li class="hover:text-white hover:underline cursor-pointer transition-colors">{t('footer.organicAgriculture')}</li>
          <li class="hover:text-white hover:underline cursor-pointer transition-colors">{t('footer.ecoConstruction')}</li>
          <li><a href={l('/red-eco-aldeas')} class="hover:text-white hover:underline cursor-pointer transition-colors">{t('footer.ecoVillageNetwork')}</a></li>
        </ul>
      </div>
      <div class="space-y-4">
        <h4 class="font-bold text-sm uppercase tracking-wider text-white">{t('footer.about')}</h4>
        <ul class="space-y-3 text-sm text-gray-400">
          <li class="hover:text-white hover:underline cursor-pointer transition-colors">{t('footer.ourStory')}</li>
          <li class="hover:text-white hover:underline cursor-pointer transition-colors">{t('footer.philosophy')}</li>
          <li class="hover:text-white hover:underline cursor-pointer transition-colors">{t('footer.gallery')}</li>
          <li class="hover:text-white hover:underline cursor-pointer transition-colors">{t('footer.faq')}</li>
        </ul>
      </div>
      <div class="space-y-4">
        <h4 class="font-bold text-sm uppercase tracking-wider text-white">{t('footer.contact')}</h4>
        <ul class="space-y-3 text-sm text-gray-400">
          <li class="hover:text-white hover:underline cursor-pointer transition-colors">+57 321 4538242</li>
          <li class="hover:text-white hover:underline cursor-pointer transition-colors">contacto@varsana.com</li>
          <li class="hover:text-white hover:underline cursor-pointer transition-colors">{t('footer.location')}</li>
          <li class="hover:text-white hover:underline cursor-pointer transition-colors">{t('footer.colombia')}</li>
        </ul>
      </div>
    </div>

    <div class="pt-8 flex flex-col md:flex-row justify-between items-center gap-4 text-sm">
      <div class="flex flex-wrap justify-center gap-2 text-gray-500">
        <span>{t('footer.copyright')}</span>
        <span>·</span>
        <span class="hover:text-gray-300 hover:underline cursor-pointer transition-colors">{t('footer.privacy')}</span>
        <span>·</span>
        <span class="hover:text-gray-300 hover:underline cursor-pointer transition-colors">{t('footer.terms')}</span>
        <span>·</span>
        <a href={l('/mapa-del-sitio')} class="hover:text-gray-300 hover:underline cursor-pointer transition-colors">{t('footer.sitemap')}</a>
        <span>·</span>
        <a href={l('/design-system')} class="hover:text-gray-300 hover:underline cursor-pointer transition-colors">{t('footer.designSystem')}</a>
      </div>

      <div class="flex items-center gap-6 font-semibold text-gray-400">
        <a href={switchUrl} data-locale-switch={otherLocale} class="flex items-center gap-2 hover:text-white hover:underline cursor-pointer transition-colors">
          <Globe size={16} />
          <span>{t('footer.language')}</span>
        </a>
        <div class="flex items-center gap-2 hover:text-white hover:underline cursor-pointer transition-colors">
          <span>$</span>
          <span>COP</span>
        </div>
        <div class="flex items-center gap-4 text-gray-400">
          <Facebook size={18} class="hover:text-white cursor-pointer transition-colors" />
          <Instagram size={18} class="hover:text-white cursor-pointer transition-colors" />
          <Youtube size={18} class="hover:text-white cursor-pointer transition-colors" />
        </div>
      </div>
    </div>
  </div>
</footer>

<script>
  document.querySelectorAll('[data-locale-switch]').forEach((el) => {
    el.addEventListener('click', () => {
      const targetLocale = el.getAttribute('data-locale-switch');
      document.cookie = 'varsana_locale=' + targetLocale + '; Path=/; Max-Age=31536000; SameSite=Lax';
    });
  });
</script>
