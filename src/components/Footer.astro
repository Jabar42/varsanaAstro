---
import { Globe, Facebook, Instagram, Youtube } from 'lucide-react';
---

<footer class="bg-near-black mt-16 px-6 py-12 md:px-12 lg:px-20">
  <div class="max-w-7xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 pb-12 border-b border-near-black/30">
      <div class="flex flex-col gap-4">
        <img src="/logo/logoWhite.png" alt="Varsana" class="w-24" />
        <p class="text-sm text-gray-400 leading-relaxed max-w-52">
          Eco Yoga Aldea — bienestar, conciencia y conexión espiritual en Granada, Cundinamarca.
        </p>
      </div>
      <div class="space-y-4">
        <h4 class="font-bold text-sm uppercase tracking-wider text-white">Comunidad</h4>
        <ul class="space-y-3 text-sm text-gray-400">
          <li class="hover:text-white hover:underline cursor-pointer transition-colors">Varsana.org</li>
          <li class="hover:text-white hover:underline cursor-pointer transition-colors">Proyectos Sociales</li>
          <li class="hover:text-white hover:underline cursor-pointer transition-colors">Agricultura Orgánica</li>
          <li class="hover:text-white hover:underline cursor-pointer transition-colors">Eco-Construcción</li>
          <li><a href="/red-eco-aldeas" class="hover:text-white hover:underline cursor-pointer transition-colors">Red de eco aldeas</a></li>
        </ul>
      </div>
      <div class="space-y-4">
        <h4 class="font-bold text-sm uppercase tracking-wider text-white">Sobre Nosotros</h4>
        <ul class="space-y-3 text-sm text-gray-400">
          <li class="hover:text-white hover:underline cursor-pointer transition-colors">Nuestra Historia</li>
          <li class="hover:text-white hover:underline cursor-pointer transition-colors">Filosofía</li>
          <li class="hover:text-white hover:underline cursor-pointer transition-colors">Galería</li>
          <li class="hover:text-white hover:underline cursor-pointer transition-colors">Preguntas Frecuentes</li>
        </ul>
      </div>
      <div class="space-y-4">
        <h4 class="font-bold text-sm uppercase tracking-wider text-white">Contacto</h4>
        <ul class="space-y-3 text-sm text-gray-400">
          <li class="hover:text-white hover:underline cursor-pointer transition-colors">+57 321 4538242</li>
          <li class="hover:text-white hover:underline cursor-pointer transition-colors">contacto@varsana.com</li>
          <li class="hover:text-white hover:underline cursor-pointer transition-colors">Granada, Cundinamarca</li>
          <li class="hover:text-white hover:underline cursor-pointer transition-colors">Colombia</li>
        </ul>
      </div>
    </div>

    <div class="pt-8 flex flex-col md:flex-row justify-between items-center gap-4 text-sm">
      <div class="flex flex-wrap justify-center gap-2 text-gray-500">
        <span>© 2024 Varsana Eco Yoga Aldea</span>
        <span>·</span>
        <span class="hover:text-gray-300 hover:underline cursor-pointer transition-colors">Privacidad</span>
        <span>·</span>
        <span class="hover:text-gray-300 hover:underline cursor-pointer transition-colors">Condiciones</span>
        <span>·</span>
        <a href="/mapa-del-sitio" class="hover:text-gray-300 hover:underline cursor-pointer transition-colors">Mapa del sitio</a>
        <span>·</span>
        <a href="/design-system" class="hover:text-gray-300 hover:underline cursor-pointer transition-colors">Design System</a>
      </div>

      <div class="flex items-center gap-6 font-semibold text-gray-400">
        <div class="flex items-center gap-2 hover:text-white hover:underline cursor-pointer transition-colors">
          <Globe size={16} />
          <span>Español (CO)</span>
        </div>
        <div class="flex items-center gap-2 hover:text-white hover:underline cursor-pointer transition-colors">
          <span>$</span>
          <span>COP</span>
        </div>
        <div class="flex items-center gap-4 text-gray-400">
          <Facebook size={18} class="hover:text-white cursor-pointer transition-colors" />
          <Instagram size={18} class="hover:text-white cursor-pointer transition-colors" />
          <Youtube size={18} class="hover:text-white cursor-pointer transition-colors" />
        </div>
      </div>
    </div>
  </div>
</footer>
