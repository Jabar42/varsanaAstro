---
import { type FeaturedItem } from '@/src/lib/slider';

interface Props {
  items: FeaturedItem[];
  title?: string;
  subtitle?: string;
}

const { items, title, subtitle } = Astro.props;

if (items.length === 0) return;
const hasNav = items.length > 1;
---

<section class="py-16 bg-sacred-sand">
  <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20">
    {title && (
      <div class="text-center mb-10">
        <h2 class="font-display text-4xl md:text-5xl font-bold text-near-black tracking-tight">
          {title}
        </h2>
        {subtitle && (
          <p class="mt-4 text-lg text-gray-600 max-w-2xl mx-auto">{subtitle}</p>
        )}
      </div>
    )}

    <div class="slider-container" data-slider>
      {hasNav && (
        <button
          type="button"
          data-slider-prev
          class="slider-arrow slider-arrow--prev"
          aria-label="Anterior"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        </button>
      )}

      <div class="slider-track" data-slider-track>
        {items.map((item) => (
          <div class="slide-item">
            <a
              href={item.url}
              class="block bg-lotus-white rounded-lg shadow-airbnb overflow-hidden transition-transform duration-300 hover:scale-[1.02] group h-full"
            >
              <div class="aspect-16/10 overflow-hidden shimmer">
                <img
                  src={item.image}
                  alt={item.title}
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
                  loading="lazy"
                />
                {item.date && (
                  <span class="absolute top-4 left-4 bg-saffron text-white text-xs font-bold px-3 py-1.5 rounded-full">
                    {item.date.toLocaleDateString('es-CO', {
                      day: 'numeric',
                      month: 'short',
                      year: 'numeric',
                    })}
                  </span>
                )}
              </div>
              <div class="p-5 flex flex-col grow gap-3">
                <h3 class="font-display text-lg font-bold text-near-black leading-tight">
                  {item.title}
                </h3>
                <p class="text-sm text-gray-600 line-clamp-2">{item.description}</p>
                <div class="mt-auto pt-3 flex items-center justify-between">
                  {item.price && (
                    <span class="text-sm text-gray-500">
                      {item.price.label ? `${item.price.label} · ` : ''}
                      <span class="font-bold text-rausch">
                        ${item.price.amount.toLocaleString('es-CO')} COP
                      </span>
                    </span>
                  )}
                  <span class="ml-auto bg-rausch text-white px-4 py-2 rounded-xl text-sm font-bold hover:bg-rausch/90 transition-colors">
                    {item.ctaLabel || 'Ver mas'}
                  </span>
                </div>
              </div>
            </a>
          </div>
        ))}
      </div>

      {hasNav && (
        <button
          type="button"
          data-slider-next
          class="slider-arrow slider-arrow--next"
          aria-label="Siguiente"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
        </button>
      )}

      {hasNav && (
        <div class="slider-dots" data-slider-dots>
          {items.map((_, i) => (
            <button
              type="button"
              data-slider-dot={i}
              class:list={['slider-dot', { active: i === 0 }]}
              aria-label={`Ir al slide ${i + 1}`}
            />
          ))}
        </div>
      )}
    </div>
  </div>
</section>

<script>
  function initSlider(container: HTMLElement) {
    const track = container.querySelector<HTMLElement>('[data-slider-track]')!;
    const prev = container.querySelector<HTMLButtonElement>('[data-slider-prev]');
    const next = container.querySelector<HTMLButtonElement>('[data-slider-next]');
    const dots = container.querySelectorAll<HTMLButtonElement>('[data-slider-dot]');
    const slides = track.children;
    const total = slides.length;

    if (total < 2) return;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let current = 0;
    let timer: ReturnType<typeof setInterval> | null = null;
    const interval = 5000;

    function goTo(index: number) {
      const slide = slides[index] as HTMLElement;
      if (!slide) return;
      current = index;
      track.scrollTo({ left: slide.offsetLeft - track.offsetLeft, behavior: reduced ? 'auto' : 'smooth' });
      dots.forEach((d, i) => d.classList.toggle('active', i === current));
    }

    function goNext() {
      const next = (current + 1) % total;
      goTo(next);
    }

    function startTimer() {
      if (reduced || total < 3) return;
      stopTimer();
      timer = setInterval(goNext, interval);
    }

    function stopTimer() {
      if (timer) { clearInterval(timer); timer = null; }
    }

    if (prev) prev.addEventListener('click', () => { goTo((current - 1 + total) % total); stopTimer(); startTimer(); });
    if (next) next.addEventListener('click', () => { goTo((current + 1) % total); stopTimer(); startTimer(); });

    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => { goTo(i); stopTimer(); startTimer(); });
    });

    container.addEventListener('mouseenter', stopTimer);
    container.addEventListener('mouseleave', startTimer);
    container.addEventListener('focusin', stopTimer);
    container.addEventListener('focusout', startTimer);
    container.addEventListener('touchstart', stopTimer, { passive: true });
    container.addEventListener('touchend', () => { setTimeout(startTimer, 3000); });

    // Update active dot on scroll (for swipe/trackpad users)
    let scrollTimeout: ReturnType<typeof setTimeout>;
    track.addEventListener('scroll', () => {
      clearTimeout(scrollTimeout);
      scrollTimeout = setTimeout(() => {
        const x = track.scrollLeft + track.offsetWidth / 2;
        let closest = 0;
        let minDist = Infinity;
        for (let i = 0; i < slides.length; i++) {
          const s = slides[i] as HTMLElement;
          const dist = Math.abs(s.offsetLeft - track.offsetLeft - x + s.offsetWidth / 2);
          if (dist < minDist) { minDist = dist; closest = i; }
        }
        current = closest;
        dots.forEach((d, i) => d.classList.toggle('active', i === current));
      }, 100);
    }, { passive: true });

    startTimer();
  }

  document.querySelectorAll<HTMLElement>('[data-slider]').forEach(initSlider);
</script>

<style>
  .slider-container {
    position: relative;
  }

  .slider-track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    gap: 1.5rem;
    padding: 0.5rem;
  }

  .slider-track::-webkit-scrollbar {
    display: none;
  }

  .slide-item {
    flex: 0 0 calc(100% - 1rem);
    scroll-snap-align: start;
  }

  @media (min-width: 768px) {
    .slide-item {
      flex: 0 0 calc(50% - 0.75rem);
    }
  }

  @media (min-width: 1024px) {
    .slide-item {
      flex: 0 0 calc(33.333% - 1rem);
    }
  }

  .slider-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: white;
    box-shadow: 0 0 0 1px rgba(0,0,0,0.04), 0 2px 8px rgba(0,0,0,0.12);
    color: var(--color-near-black);
    transition: transform 0.2s, box-shadow 0.2s;
    cursor: pointer;
    border: none;
  }

  .slider-arrow:hover {
    transform: translateY(-50%) scale(1.1);
    box-shadow: 0 0 0 1px rgba(0,0,0,0.06), 0 4px 16px rgba(0,0,0,0.16);
    color: var(--color-rausch);
  }

  .slider-arrow--prev {
    left: -20px;
  }

  .slider-arrow--next {
    right: -20px;
  }

  @media (max-width: 767px) {
    .slider-arrow {
      display: none;
    }
  }

  .slider-dots {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 2rem;
  }

  .slider-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: none;
    cursor: pointer;
    padding: 0;
    background: var(--color-light-surface);
    transition: all 0.3s ease;
  }

  .slider-dot.active {
    background: var(--color-rausch);
    width: 28px;
    border-radius: 5px;
  }
</style>
