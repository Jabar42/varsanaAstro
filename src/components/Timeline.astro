---
import { Calendar, Building2, Flower2, Heart } from 'lucide-react';

interface TimelineItem {
  date: string;
  text: string;
  icon: string;
}

const items: TimelineItem[] = [
  {
    date: '1967',
    text: 'Inicio del yoga-monasterio. Una fraccion del terreno fue donado, dando inicio al proyecto Vaisnava, Vrinda Parivar en Colombia.',
    icon: 'calendar',
  },
  {
    date: 'Decada de 1980',
    text: 'En compania de maestros espirituales, se da inicio a la construccion del templo ecologico, inspirado en la arquitectura hindu.',
    icon: 'building2',
  },
  {
    date: 'Decada de 1990',
    text: 'Evoluciona a un santuario que integra practicas de meditacion, yoga, alimentacion consciente y vida comunitaria.',
    icon: 'flower2',
  },
  {
    date: 'Hoy',
    text: 'Seguimos cultivando comunidad, cuidando la tierra y compartiendo un camino de vida consciente con personas de todo el mundo.',
    icon: 'heart',
  },
];

const iconMap: Record<string, any> = {
  calendar: Calendar,
  building2: Building2,
  flower2: Flower2,
  heart: Heart,
};
---

<h2 class="text-3xl md:text-4xl font-display font-bold tracking-tightest text-near-black text-center mb-2">Varsana Ecoaldea en el tiempo</h2>
<p class="text-secondary-gray text-center mb-8 max-w-xl mx-auto">Casi seis decadas de comunidad, espiritualidad y conexion con la naturaleza</p>

<div class="timeline">
  <!-- Mobile: linea vertical -->
  <div class="timeline__line md:hidden" aria-hidden="true"></div>

  <div class="timeline__items">
    {items.map((item, i) => {
      const IconComponent = iconMap[item.icon];
      return (
        <div class="timeline__item">
          <div class="timeline__dot">
            <div class="timeline__icon">
              <IconComponent size={20} />
            </div>
          </div>
          <div class="timeline__content">
            <p class="timeline__date">{item.date}</p>
            <p class="timeline__text">{item.text}</p>
          </div>
        </div>
      );
    })}
  </div>
</div>

<style>
  .timeline {
    position: relative;
    padding: 1rem 0 2rem;
  }

  /* ========== Mobile (vertical) ========== */
  .timeline__line {
    position: absolute;
    left: 1.5rem;
    top: 0;
    bottom: 0;
    width: 2px;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      var(--color-saffron, #f7941e) 10%,
      var(--color-saffron, #f7941e) 90%,
      transparent 100%
    );
  }

  .timeline__items {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .timeline__item {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    position: relative;
    padding-left: 3rem;
  }

  .timeline__dot {
    position: absolute;
    left: 0;
    top: 0;
    width: 3rem;
    height: 3rem;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
  }

  .timeline__icon {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--color-lotus-white, #fff);
    border: 2px solid var(--color-saffron, #f7941e);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-saffron, #f7941e);
    transition: all 0.3s ease;
    box-shadow: 0 0 0 4px var(--color-sacred-sand, #faf9f6);
  }

  .timeline__item:hover .timeline__icon {
    background: var(--color-saffron, #f7941e);
    color: white;
    transform: scale(1.1);
  }

  .timeline__content {
    flex: 1;
    min-width: 0;
  }

  .timeline__date {
    font-family: "Proza Libre", sans-serif;
    font-weight: 700;
    font-size: 1.125rem;
    color: var(--color-rausch, #52185b);
    margin-bottom: 0.375rem;
    letter-spacing: -0.02em;
  }

  .timeline__text {
    font-size: 0.875rem;
    line-height: 1.625;
    color: var(--color-secondary-gray, #6a6a6a);
  }

  /* ========== Desktop (horizontal) ========== */
  @media (min-width: 768px) {
    .timeline {
      padding: 0 0 2rem;
    }

    .timeline__items {
      flex-direction: row;
      gap: 0;
      position: relative;
    }

    /* Linea horizontal que cruza por el centro de los dots */
    .timeline__items::before {
      content: '';
      position: absolute;
      left: 2.5%;
      right: 2.5%;
      top: 1.375rem; /* centro del dot (2.75rem / 2) */
      height: 2px;
      background: linear-gradient(
        to right,
        transparent 0%,
        var(--color-saffron, #f7941e) 5%,
        var(--color-saffron, #f7941e) 95%,
        transparent 100%
      );
      z-index: 0;
    }

    .timeline__item {
      flex: 1;
      flex-direction: column;
      align-items: center;
      padding-left: 0;
      text-align: center;
    }

    .timeline__dot {
      position: relative;
      left: auto;
      top: auto;
      z-index: 2;
    }

    .timeline__icon {
      box-shadow: 0 0 0 6px var(--color-sacred-sand, #faf9f6);
    }

    .timeline__date {
      margin-top: 0.75rem;
    }

    .timeline__text {
      max-width: 16rem;
      margin: 0 auto;
    }
  }
</style>
