---
import { getLocale, localizePath, useTranslations } from '@/src/i18n/utils';
import { getCurrentPrice } from '@/src/lib/pasadias';
import { Clock, MapPin } from 'lucide-react';

const locale = getLocale(Astro);
const t = useTranslations(locale);
const l = (path: string) => localizePath(locale, path);

interface Price {
  label: string;
  amount: number;
  deadline?: Date;
}

interface Props {
  title: string;
  description: string;
  image: string;
  prices: Price[];
  duration: string;
  meeting_point: string;
  category?: string;
  slug: string;
}

const { title, description, image, prices, duration, meeting_point, slug } = Astro.props;

const currentPrice = getCurrentPrice(prices);

const numberLocale = locale === 'en' ? 'en-US' : 'es-CO';
---

<a href={l(`/pasadias/${slug}`)} class="card group">
  <div class="aspect-4/3 overflow-hidden relative shimmer">
    <img
      src={image}
      alt={title}
      class="card__image"
      referrerpolicy="no-referrer"
      loading="lazy"
    />
    {currentPrice?.label && currentPrice.label !== 'General' && (
      <div class="absolute top-4 left-4 bg-lotus-white px-3 py-1 rounded-full text-xs font-bold text-forest-deep">
        {currentPrice.label}
      </div>
    )}
  </div>

  <div class="p-6 flex flex-col grow space-y-3">
    <div class="space-y-1">
      <h3 class="text-2xl font-bold tracking-tightest leading-tight font-display">{title}</h3>
    </div>

    {/* Metadata: duration and meeting point */}
    <div class="flex flex-col gap-1 text-sm text-secondary-gray">
      <div class="flex items-center gap-2">
        <Clock size={14} className="text-saffron-deep" />
        <span>{duration}</span>
      </div>
      <div class="flex items-center gap-2">
        <MapPin size={14} className="text-saffron-deep" />
        <span class="truncate">{meeting_point}</span>
      </div>
    </div>

    <p class="text-secondary-gray line-clamp-2 text-sm leading-relaxed">
      {description}
    </p>

    <div class="pt-4 mt-auto border-t border-near-black/10">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-xs text-saffron-deep uppercase font-bold tracking-widest">
            {currentPrice?.label || t('cards.price')}
          </p>
          <p class="text-xl font-bold tracking-tightest">
            ${currentPrice?.amount.toLocaleString(numberLocale) || '0'}
          </p>
        </div>
        <span class="btn btn-sm btn-arrow">
          {t('cards.reserve')}
        </span>
      </div>
    </div>
  </div>
</a>

<style>
  /* La tarjeta entera es el enlace: el «botón» interno solo acompaña el hover. */
  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--color-lotus-white);
    box-shadow: 0 0 0 1px rgb(34 34 34 / 0.06);
    transition: transform 0.5s var(--ease-out), box-shadow 0.5s var(--ease-out);
  }

  .card:hover {
    transform: translateY(-6px);
    box-shadow: 0 0 0 1px rgb(34 34 34 / 0.06), 0 28px 48px -28px rgb(23 35 15 / 0.45);
  }

  .card:hover :global(.btn) {
    background: var(--color-forest-deep);
  }

  .card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--ease-out);
  }

  .card:hover .card__image {
    transform: scale(1.06);
  }

  h3 {
    letter-spacing: -0.02em;
  }

  @media (prefers-reduced-motion: reduce) {
    .card,
    .card__image {
      transition: none;
    }
    .card:hover,
    .card:hover .card__image {
      transform: none;
    }
  }
</style>
