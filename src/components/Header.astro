---
import { Globe, Heart, MessageCircle } from 'lucide-react';
import CategoryBar from '@/src/components/CategoryBar.astro';
import { useTranslations, getLocale, localizePath, type Locale } from '@/src/i18n/utils';

const locale = getLocale(Astro);
const otherLocale: Locale = locale === 'en' ? 'es' : 'en';
const otherLabel = otherLocale === 'en' ? 'EN' : 'ES';
const t = useTranslations(locale);
const l = (path: string) => localizePath(locale, path);
// Cambio de idioma: misma página en el otro idioma. Es un enlace normal (sin JS):
// la URL manda y el servidor recuerda el idioma en la cookie.
const switchUrl = localizePath(otherLocale, Astro.originPathname + Astro.url.search);
---

<header data-site-header class="site-header sticky top-0 z-50 border-b border-near-black/5">
  <div class="max-w-7xl mx-auto px-4 pt-2 pb-0 md:px-16 lg:px-24 flex items-center gap-4 md:gap-8">
    <!-- Desktop logo: spans both rows, centered vertically -->
    <a href={l('/')} class="hidden min-[900px]:block shrink-0">
      <img
        src="/logo/LogoPrincipal.svg"
        alt="Varsana"
        width={85}
        height={55}
        class="h-14 w-auto object-contain"
        fetchpriority="high"
      />
    </a>

    <!-- Two-row content -->
    <div class="flex-1 min-w-0">
      <!-- Top row: contact info -->
      <div class="flex items-center justify-between">
        <!-- Mobile logo -->
        <a href={l('/')} class="flex items-center cursor-pointer group min-[900px]:hidden">
          <div class="h-6 w-auto overflow-hidden">
            <img
              src="/logo/logoMedio.svg"
              alt="Varsana Logo"
              width={92}
              height={72}
              loading="eager"
              fetchpriority="high"
              class="h-full w-auto object-contain group-hover:scale-105 group-hover:transition-transform group-hover:duration-700"
              referrerpolicy="no-referrer"
            />
          </div>
          <span class="text-2xl font-bold tracking-tightest block font-display text-forest">Varsana</span>
        </a>

        <!-- Contact Info -->
        <div class="flex items-center gap-4 md:gap-8 ml-auto">
          <div class="flex flex-row items-center gap-2 md:gap-6 text-sm font-semibold">
            <a href="https://wa.me/573214538242" target="_blank" rel="noopener" class="flex items-center gap-2 hover:text-forest-dark transition-colors duration-300">
              <span class="hidden sm:inline">+57 321 4538242</span>
            </a>

            <a href={l('/donar')} class="btn btn-sm site-header__donate">
              <Heart size={16} />
              <span>{t('nav.donate')}</span>
            </a>

            <!-- Language switcher -->
            <a
              href={switchUrl}
              hreflang={otherLocale}
              lang={otherLocale}
              data-astro-reload
              data-astro-prefetch="false"
              class="flex items-center gap-1.5 hover:bg-sand-deep rounded-full px-2 py-1 cursor-pointer transition-colors group"
              title={otherLabel === 'EN' ? 'Switch to English' : 'Cambiar a Español'}
              aria-label={otherLabel === 'EN' ? 'Switch to English' : 'Cambiar a Español'}
            >

              <Globe size={16} />
              <span class="text-xs font-bold opacity-70 group-hover:opacity-100 transition-opacity">{otherLabel}</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Bottom row: navigation -->
      <CategoryBar />
    </div>
  </div>
</header>


<style>
  /* Arena translúcida: el contenido se adivina al pasar por debajo. */
  .site-header {
    background: color-mix(in srgb, var(--color-sacred-sand) 88%, transparent);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
  }

  /* Píldora compacta: el header no debe crecer por el botón. */
  .site-header__donate {
    min-height: 2rem;
    padding: 0.25rem 1rem;
    border-radius: var(--radius-full);
  }
</style>
