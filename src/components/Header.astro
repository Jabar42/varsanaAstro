---
import { Globe, Heart, MessageCircle } from 'lucide-react';
import CategoryBar from '@/src/components/CategoryBar.astro';
import { useTranslations } from '@/src/i18n/utils';
import { getRelativeLocaleUrl } from 'astro:i18n';

const locale = (Astro.locals as any)?.locale ?? Astro.currentLocale ?? 'es';
const otherLocale = locale === 'en' ? 'es' : 'en';
const otherLabel = otherLocale === 'en' ? 'EN' : 'ES';
const t = useTranslations(locale);
const l = (path: string) => getRelativeLocaleUrl(locale, path);
// URL to switch language: go to current page in the other locale
const switchUrl = (() => {
  const p = Astro.url.pathname.replace(/^\/en(?=\/|$)/, '');
  return getRelativeLocaleUrl(otherLocale, p || '/');
})();
---

<header class="sticky top-0 z-50 bg-lotus-white border-b border-sacred-sand">
  <div class="max-w-7xl mx-auto px-4 pt-2 pb-0 md:px-16 lg:px-24 flex items-center gap-4 md:gap-8">
    <!-- Desktop logo: spans both rows, centered vertically -->
    <a href={l('/')} class="hidden min-[900px]:block shrink-0">
      <img
        src="/logo/LogoPrincipal.svg"
        alt="Varsana"
        width={85}
        height={55}
        class="h-14 w-auto object-contain"
        fetchpriority="high"
      />
    </a>

    <!-- Two-row content -->
    <div class="flex-1 min-w-0">
      <!-- Top row: contact info -->
      <div class="flex items-center justify-between">
        <!-- Mobile logo -->
        <a href={l('/')} class="flex items-center cursor-pointer group min-[900px]:hidden">
          <div class="h-6 w-auto overflow-hidden">
            <img
              src="/logo/logoMedio.svg"
              alt="Varsana Logo"
              width={92}
              height={72}
              loading="eager"
              fetchpriority="high"
              class="h-full w-auto object-contain group-hover:scale-105 group-hover:transition-transform group-hover:duration-700"
              referrerpolicy="no-referrer"
            />
          </div>
          <span class="text-2xl font-bold tracking-tightest block font-display text-forest">Varsana</span>
        </a>

        <!-- Contact Info -->
        <div class="flex items-center gap-4 md:gap-8 ml-auto">
          <div class="flex flex-row items-center gap-2 md:gap-6 text-sm font-semibold">
            <a href="https://wa.me/573214538242" target="_blank" rel="noopener" class="flex items-center gap-2 hover:text-rausch transition-colors">
              <span class="hidden sm:inline">+57 321 4538242</span>
            </a>

            <a href={l('/donar')} class="inline-flex items-center gap-2 bg-rausch text-white font-semibold rounded-2xl px-4 py-1 md:px-5 transition-all duration-300 hover:brightness-90 cursor-pointer">
              <Heart size={16} />
              <span>{t('nav.donate')}</span>
            </a>

            <!-- Language switcher -->
            <a
              href={switchUrl}
              data-locale-switch={otherLocale}
              class="flex items-center gap-1.5 hover:bg-sacred-sand rounded-full  py-1 cursor-pointer transition-colors group"
              title={otherLabel === 'EN' ? 'Switch to English' : 'Cambiar a Español'}
            >
              <Globe size={16} />
              <span class="text-xs font-bold opacity-70 group-hover:opacity-100 transition-opacity">{otherLabel}</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Bottom row: navigation -->
      <CategoryBar />
    </div>
  </div>
</header>

<script>
  // Clear locale cookie when switching FROM English TO Spanish
  // so the middleware doesn't redirect back to /en/
  document.querySelectorAll('[data-locale-switch]').forEach((el) => {
    el.addEventListener('click', () => {
      const targetLocale = el.getAttribute('data-locale-switch');
      document.cookie = 'varsana_locale=' + targetLocale + '; Path=/; Max-Age=31536000; SameSite=Lax';
    });
  });
</script>
