---
interface Props {
  type?: 'info' | 'tip' | 'warning';
  title?: string;
}

const { type = 'info', title } = Astro.props;

const variants = {
  info: {
    border: 'border-l-forest-night',
    bg: 'bg-sand-deep',
    icon: 'text-forest-night',
  },
  tip: {
    border: 'border-l-forest-dark',
    bg: 'bg-forest/10',
    icon: 'text-forest-deep',
  },
  warning: {
    border: 'border-l-saffron',
    bg: 'bg-saffron/10',
    icon: 'text-saffron-deep',
  },
};

const v = variants[type];
---

<div class={`border-l-2 ${v.border} ${v.bg} rounded-r-2xl p-6 md:p-8 my-8`}>
  {title && (
    <p class="font-bold font-display text-lg text-near-black mb-2">{title}</p>
  )}
  <div class="text-secondary-gray text-base leading-relaxed">
    <slot />
  </div>
</div>
