---
import { MapPin, Clock, Timer } from 'lucide-react';

interface Props {
  lugar: string;
  hora: string;
  duracion: string;
}

const { lugar, hora, duracion } = Astro.props;
---

<div class="bg-lotus-white rounded-3xl ring-1 ring-near-black/5 p-6 my-8 inline-flex flex-wrap items-center gap-x-6 gap-y-4">
  <div class="flex items-center gap-2 text-secondary-gray text-sm font-medium">
    <span class="flex items-center justify-center w-8 h-8 rounded-xl bg-forest/10 text-forest-deep shrink-0">
      <MapPin size={16} />
    </span>
    <span>{lugar}</span>
  </div>
  <span class="text-near-black/15 hidden sm:inline" aria-hidden="true">|</span>
  <div class="flex items-center gap-2 text-secondary-gray text-sm font-medium">
    <span class="flex items-center justify-center w-8 h-8 rounded-xl bg-saffron/10 text-saffron-deep shrink-0">
      <Clock size={16} />
    </span>
    <span>{hora}</span>
  </div>
  <span class="text-near-black/15 hidden sm:inline" aria-hidden="true">|</span>
  <div class="flex items-center gap-2 text-secondary-gray text-sm font-medium">
    <span class="flex items-center justify-center w-8 h-8 rounded-xl bg-forest/10 text-forest-deep shrink-0">
      <Timer size={16} />
    </span>
    <span>{duracion}</span>
  </div>
</div>
