---
import { getCurrentPrice } from '@/src/lib/events';
import { getRelativeLocaleUrl } from 'astro:i18n';

const locale = (Astro.locals as any)?.locale ?? Astro.currentLocale ?? 'es';
const l = (path: string) => getRelativeLocaleUrl(locale, path);

interface Price {
  label: string;
  amount: number;
  deadline?: Date;
}

interface Props {
  title: string;
  description: string;
  event_start: Date;
  image: string;
  prices: Price[];
  slug: string;
}

const { title, description, event_start, image, prices, slug } = Astro.props;

const currentPrice = getCurrentPrice(prices);

const formattedDate = event_start.toLocaleDateString('es-ES', {
  day: 'numeric',
  month: 'long',
  year: 'numeric'
});

const now = new Date();
now.setHours(0, 0, 0, 0);
const eventDate = new Date(event_start);
eventDate.setHours(0, 0, 0, 0);
const daysUntil = Math.ceil((eventDate.getTime() - now.getTime()) / (1000 * 60 * 60 * 24));
const showCountdown = daysUntil > 0 && daysUntil <= 90;
---

<a href={l(`/events/${slug}`)} class="bg-lotus-white rounded-lg shadow-airbnb overflow-hidden flex flex-col h-full transition-transform duration-300 hover:scale-[1.02] cursor-pointer group">
  <div class="aspect-16/10 overflow-hidden relative">
    <img 
      src={image} 
      alt={title} 
      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
      referrerpolicy="no-referrer"
    />
    {showCountdown && (
      <div class="absolute top-4 right-4 bg-rausch text-white px-3 py-1 rounded-full text-xs font-bold shadow-sm">
        {daysUntil === 1 ? '¡Mañana!' : `Faltan ${daysUntil} días`}
      </div>
    )}
    {currentPrice?.label && currentPrice.label !== 'General' && (
      <div class="absolute top-4 left-4 bg-lotus-white px-3 py-1 rounded-full text-xs font-bold shadow-sm text-rausch">
        {currentPrice.label}
      </div>
    )}
  </div>
  
  <div class="p-6 flex flex-col grow space-y-3">
    <div class="space-y-1">
      <p class="text-saffron font-semibold text-sm uppercase tracking-wider">{formattedDate}</p>
      <h3 class="text-2xl font-bold tracking-tightest leading-tight font-display">{title}</h3>
    </div>
    
    <p class="text-gray-600 line-clamp-2 text-sm leading-relaxed">
      {description}
    </p>
    
    <div class="pt-4 mt-auto border-t border-sacred-sand">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-xs text-saffron uppercase font-bold tracking-widest">
            {currentPrice?.label || 'Precio'}
          </p>
          <p class="text-xl font-bold tracking-tightest">
            ${currentPrice?.amount.toLocaleString('es-CO') || '0'}
          </p>
        </div>
        <button class="bg-rausch text-white px-6 py-2.5 rounded-xl font-bold text-sm hover:bg-rausch-dark transition-colors shadow-sm">
          Reservar
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  h3 {
    letter-spacing: -0.02em;
  }
</style>
