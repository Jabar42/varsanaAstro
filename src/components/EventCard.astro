---
import { getLocale, localizePath, useTranslations, formatDate } from '@/src/i18n/utils';
import { getCurrentPrice } from '@/src/lib/events';

const locale = getLocale(Astro);
const t = useTranslations(locale);
const l = (path: string) => localizePath(locale, path);

interface Price {
  label: string;
  amount: number;
  deadline?: Date;
}

interface Props {
  title: string;
  description: string;
  event_start: Date;
  image: string;
  prices: Price[];
  slug: string;
}

const { title, description, event_start, image, prices, slug } = Astro.props;

const currentPrice = getCurrentPrice(prices);

const formattedDate = formatDate(event_start, locale, {
  day: 'numeric',
  month: 'long',
  year: 'numeric'
});

const now = Date.now();
const eventTime = new Date(event_start).getTime();
const daysUntil = Math.ceil((eventTime - now) / (1000 * 60 * 60 * 24));
const showCountdown = daysUntil > 0 && daysUntil <= 90;

const numberLocale = locale === 'en' ? 'en-US' : 'es-CO';
---

<a href={l(`/events/${slug}`)} class="card group">
  <div class="aspect-4/3 overflow-hidden relative shimmer">
    <img
      src={image}
      alt={title}
      class="card__image"
      referrerpolicy="no-referrer"
      loading="lazy"
    />
    {showCountdown && (
      <div class="absolute top-4 right-4 bg-forest-night text-white px-3 py-1 rounded-full text-xs font-bold">
        {daysUntil === 1 ? t('cards.tomorrow') : t('cards.daysLeft', { n: daysUntil })}
      </div>
    )}
    {currentPrice?.label && currentPrice.label !== 'General' && (
      <div class="absolute top-4 left-4 bg-lotus-white px-3 py-1 rounded-full text-xs font-bold text-forest-deep">
        {currentPrice.label}
      </div>
    )}
  </div>

  <div class="p-6 flex flex-col grow space-y-3">
    <div class="space-y-1">
      <p class="text-saffron-deep font-semibold text-xs uppercase tracking-[0.14em]">{formattedDate}</p>
      <h3 class="text-2xl font-bold tracking-tightest leading-tight font-display">{title}</h3>
    </div>

    <p class="text-secondary-gray line-clamp-2 text-sm leading-relaxed">
      {description}
    </p>

    <div class="pt-4 mt-auto border-t border-near-black/10">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-xs text-saffron-deep uppercase font-bold tracking-widest">
            {currentPrice?.label || t('cards.price')}
          </p>
          <p class="text-xl font-bold tracking-tightest">
            ${currentPrice?.amount.toLocaleString(numberLocale) || '0'}
          </p>
        </div>
        <span class="btn btn-sm btn-arrow">
          {t('cards.reserve')}
        </span>
      </div>
    </div>
  </div>
</a>

<style>
  /* La tarjeta entera es el enlace: el «botón» interno solo acompaña el hover. */
  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--color-lotus-white);
    box-shadow: 0 0 0 1px rgb(34 34 34 / 0.06);
    transition: transform 0.5s var(--ease-out), box-shadow 0.5s var(--ease-out);
  }

  .card:hover {
    transform: translateY(-6px);
    box-shadow: 0 0 0 1px rgb(34 34 34 / 0.06), 0 28px 48px -28px rgb(23 35 15 / 0.45);
  }

  .card:hover :global(.btn) {
    background: var(--color-forest-deep);
  }

  .card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--ease-out);
  }

  .card:hover .card__image {
    transform: scale(1.06);
  }

  h3 {
    letter-spacing: -0.02em;
  }

  @media (prefers-reduced-motion: reduce) {
    .card,
    .card__image {
      transition: none;
    }
    .card:hover,
    .card:hover .card__image {
      transform: none;
    }
  }
</style>
