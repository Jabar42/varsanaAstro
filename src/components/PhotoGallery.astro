---
interface Photo {
  src: string;
  alt: string;
  className?: string;
}

const photos: Photo[] = [
  {
    src: "https://picsum.photos/seed/varsana-temple/1200/800",
    alt: "Templo principal de Varsana",
    className: "md:col-span-2 md:row-span-2"
  },
  {
    src: "https://picsum.photos/seed/varsana-yoga/800/600",
    alt: "Práctica de yoga al amanecer",
    className: "md:col-span-1 md:row-span-1"
  },
  {
    src: "https://picsum.photos/seed/varsana-nature/800/600",
    alt: "Senderos ecológicos",
    className: "md:col-span-1 md:row-span-1"
  },
  {
    src: "https://picsum.photos/seed/varsana-food/800/600",
    alt: "Comida vegetariana consciente",
    className: "md:col-span-1 md:row-span-1"
  },
  {
    src: "https://picsum.photos/seed/varsana-community/800/600",
    alt: "Comunidad y voluntariado",
    className: "md:col-span-1 md:row-span-1"
  }
];
---

<section class="mt-20">
  <div class="flex items-end justify-between mb-8">
    <div class="space-y-2">
      <h2 class="text-4xl font-bold tracking-tight font-display">Galería de Varsana</h2>
      <p class="text-secondary-gray text-lg">Explora la belleza y serenidad de nuestra aldea ecológica.</p>
    </div>
    <button class="hidden md:block text-near-black font-semibold underline underline-offset-4 hover:text-rausch transition-colors">
      Ver todas las fotos
    </button>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-4 md:grid-rows-2 gap-4 h-auto md:h-[500px] lg:h-[600px]">
    {photos.map((photo) => (
      <div class={`relative overflow-hidden rounded-2xl group cursor-pointer aspect-square md:aspect-auto ${photo.className || ''}`}>
        <img 
          src={photo.src} 
          alt={photo.alt} 
          class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
          referrerpolicy="no-referrer"
        />
        <div class="absolute inset-0 bg-black/20 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-6">
          <p class="text-white font-medium text-sm drop-shadow-md">{photo.alt}</p>
        </div>
      </div>
    ))}
  </div>
  
  <button class="md:hidden mt-6 w-full py-3 border border-near-black rounded-lg font-bold hover:bg-light-surface transition-colors">
    Ver todas las fotos
  </button>
</section>
