---
import { Star, Heart } from 'lucide-react';

interface Props {
  title: string;
  description: string;
  price?: string;
  rating?: string;
  image: string;
  tag?: string;
}

const { title, description, price, rating = "4.9", image, tag } = Astro.props;
---

<div class="group cursor-pointer">
  <div class="relative aspect-square overflow-hidden rounded-xl mb-3">
    <img 
      src={image} 
      alt={title} 
      class="object-cover w-full h-full group-hover:scale-105 transition-transform duration-500"
      referrerpolicy="no-referrer"
    />
    <button class="absolute top-3 right-3 text-white/70 hover:text-rausch transition-colors">
      <Heart size={24} fill="rgba(0,0,0,0.3)" strokeWidth={2} />
    </button>
    {tag && (
      <div class="absolute top-3 left-3 bg-lotus-white px-3 py-1 rounded-full text-xs font-bold shadow-sm">
        {tag}
      </div>
    )}
  </div>
  
  <div class="flex justify-between items-start">
    <h3 class="font-bold text-sm">{title}</h3>
    <div class="flex items-center gap-1 text-sm">
      <Star size={14} fill="currentColor" />
      <span>{rating}</span>
    </div>
  </div>
  
  <p class="text-secondary-gray text-sm leading-tight mt-0.5">{description}</p>
  
  {price && (
    <div class="mt-2 text-sm">
      <span class="font-bold">{price}</span>
      <span class="font-normal"> / persona</span>
    </div>
  )}
</div>
