---
type CtaVariant = 'rausch' | 'forest';
type Tone = 'light' | 'dark';

interface Props {
  title: string;
  description: string;
  ctaLabel?: string;
  ctaUrl?: string;
  imageSrc?: string;
  imageAlt?: string;
  images?: string[];
  videoUrl?: string;
  reversed?: boolean;
  background?: string;
  fullBleed?: boolean;
  /** Se conserva por compatibilidad: todos los botones son de la familia forest. */
  ctaVariant?: CtaVariant;
  /** `dark` pinta la sección sobre forest-night (texto claro, botón claro). */
  tone?: Tone;
}

const {
  title,
  description,
  ctaLabel,
  ctaUrl,
  imageSrc = '/images/about-hero.webp',
  imageAlt = '',
  images,
  videoUrl,
  reversed = false,
  background = '',
  fullBleed = false,
  tone = 'light',
} = Astro.props;

const hasImages = !!images && images.length > 0;
const dark = tone === 'dark';

// Igual que TextSection: los textos con varios párrafos (separados por línea en
// blanco) se renderizan como párrafos reales en vez de un bloque único.
const paragraphs = String(description ?? '')
  .split(/\n{2,}/)
  .map((p) => p.trim())
  .filter(Boolean);

function getYouTubeId(url: string): string | null {
  const match = url.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/|youtube\.com\/embed\/)([a-zA-Z0-9_-]{11})/);
  return match ? match[1] : null;
}

// Fachada ligera: el iframe de YouTube (~1 MB de JS) solo se carga al pulsar.
const videoId = videoUrl ? getYouTubeId(videoUrl) : null;
const isVideo = !!videoUrl;

const contained = (!!background && !fullBleed) || dark;
---
<section
  class:list={[
    'py-16 md:py-20',
    dark ? 'on-dark dome-top' : contained ? background : '',
  ]}
>
  <div class:list={[
    contained ? 'max-w-7xl mx-auto px-6 md:px-12 lg:px-20' : '',
  ]}>
    <div class:list={[
      'grid grid-cols-1 lg:grid-cols-2 items-center',
      fullBleed ? 'gap-0' : 'gap-12 lg:gap-20',
    ]}>

    {/* Media column */}
    <div
      class:list={[
        'relative',
        reversed ? 'lg:order-1' : 'lg:order-2',
      ]}
    >
      {isVideo ? (
        <div class="ss-video shimmer" data-reveal>
          {videoId ? (
            <button type="button" class="ss-video__facade" data-yt={videoId} aria-label={imageAlt || title}>
              <img
                src={`https://i.ytimg.com/vi/${videoId}/maxresdefault.jpg`}
                alt=""
                loading="lazy"
                decoding="async"
                onerror={`this.onerror=null;this.src='https://i.ytimg.com/vi/${videoId}/hqdefault.jpg'`}
              />
              <span class="ss-video__play" aria-hidden="true">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13l11-6.5z"/></svg>
              </span>
            </button>
          ) : (
            <iframe
              src={videoUrl}
              title={imageAlt || title}
              class="absolute inset-0 w-full h-full"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              loading="lazy"
            />
          )}
        </div>
      ) : hasImages ? (
        <div class="ss-slider" data-ss-slider data-reveal>
          <div class="ss-slider-track" data-ss-track>
            {images!.map((src, i) => (
              <div class="ss-slide">
                <img
                  src={src}
                  alt={`${imageAlt || title} — imagen ${i + 1}`}
                  class="w-full h-full object-cover"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            ))}
          </div>
          <div class="ss-slider-dots" data-ss-dots>
            {images!.map((_, i) => (
              <button
                type="button"
                data-ss-dot={i}
                class:list={['ss-slider-dot', { active: i === 0 }]}
                aria-label={`Ir a la imagen ${i + 1}`}
              />
            ))}
          </div>
        </div>
      ) : (
        <div class="ss-arch arch parallax shimmer" data-reveal="mask">
          <img
            src={imageSrc}
            alt={imageAlt || title}
            class="w-full h-full object-cover"
            loading="lazy"
            decoding="async"
            onerror="this.style.display='none'"
          />
        </div>
      )}
    </div>

    {/* Text column */}
    <div
      class:list={[
        'flex flex-col justify-center max-w-xl',
        fullBleed
          ? ['px-6 md:px-12 lg:px-20 py-16 lg:py-20', background]
          : '',
        reversed ? 'lg:order-2' : 'lg:order-1',
      ]}
      data-reveal-group
    >
      <span class="rule-saffron mb-8" data-reveal="draw" aria-hidden="true"></span>

      <h2 class:list={['display-md font-bold font-display', dark ? 'text-white' : 'text-near-black']}>
        {title}
      </h2>

      <div class:list={['mt-6 text-lg md:text-xl leading-relaxed space-y-4', dark ? 'text-sacred-sand/80' : 'text-secondary-gray']}>
        {paragraphs.map((p) => <p>{p}</p>)}
      </div>

      {ctaLabel && (
        <a
          href={ctaUrl || '#'}
          class:list={['btn btn-lg btn-arrow self-start mt-10', dark && 'btn-light']}
        >
          {ctaLabel}
        </a>
      )}
    </div>

  </div>
  </div>
</section>

<script>
  // Fachada de YouTube: un solo listener delegado cambia el póster por el
  // reproductor (sobrevive a las navegaciones de ClientRouter).
  document.addEventListener('click', (event) => {
    const facade = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-yt]');
    if (!facade) return;
    const frame = document.createElement('iframe');
    frame.src = `https://www.youtube.com/embed/${facade.dataset.yt}?autoplay=1&rel=0`;
    frame.title = facade.getAttribute('aria-label') ?? '';
    frame.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
    frame.allowFullscreen = true;
    frame.className = 'absolute inset-0 w-full h-full';
    facade.replaceWith(frame);
    frame.focus();
  });

  /**
   * Carrusel de imágenes de SplitSection (scroll-snap). Se re-inicializa en
   * `astro:page-load` (ClientRouter) y limpia sus timers en `astro:before-swap`.
   */
  function initSlider(container: HTMLElement): () => void {
    const trackEl = container.querySelector<HTMLElement>('[data-ss-track]');
    const dots = container.querySelectorAll<HTMLButtonElement>('[data-ss-dot]');
    if (!trackEl) return () => {};
    const track: HTMLElement = trackEl;

    const slides = track.children;
    const total = slides.length;

    if (total < 2) return () => {};

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let current = 0;
    let timer: ReturnType<typeof setInterval> | null = null;
    const interval = 5000;

    function goTo(index: number) {
      const slide = slides[index] as HTMLElement;
      if (!slide) return;
      current = index;
      track.scrollTo({ left: slide.offsetLeft - track.offsetLeft, behavior: reduced ? 'auto' : 'smooth' });
      dots.forEach((d, i) => d.classList.toggle('active', i === current));
    }

    function goNext() {
      goTo((current + 1) % total);
    }

    function startTimer() {
      if (reduced || total < 3) return;
      stopTimer();
      timer = setInterval(goNext, interval);
    }

    function stopTimer() {
      if (timer) { clearInterval(timer); timer = null; }
    }

    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => { goTo(i); stopTimer(); startTimer(); });
    });

    container.addEventListener('mouseenter', stopTimer);
    container.addEventListener('mouseleave', startTimer);
    container.addEventListener('focusin', stopTimer);
    container.addEventListener('focusout', startTimer);
    container.addEventListener('touchstart', stopTimer, { passive: true });
    container.addEventListener('touchend', () => { setTimeout(startTimer, 3000); });

    // Update active dot on scroll (swipe/trackpad users)
    let scrollTimeout: ReturnType<typeof setTimeout>;
    track.addEventListener('scroll', () => {
      clearTimeout(scrollTimeout);
      scrollTimeout = setTimeout(() => {
        const x = track.scrollLeft + track.offsetWidth / 2;
        let closest = 0;
        let minDist = Infinity;
        for (let i = 0; i < slides.length; i++) {
          const s = slides[i] as HTMLElement;
          const dist = Math.abs(s.offsetLeft - track.offsetLeft - x + s.offsetWidth / 2);
          if (dist < minDist) { minDist = dist; closest = i; }
        }
        current = closest;
        dots.forEach((d, i) => d.classList.toggle('active', i === current));
      }, 100);
    }, { passive: true });

    startTimer();

    return () => { stopTimer(); clearTimeout(scrollTimeout); };
  }

  let cleaners: Array<() => void> = [];
  document.addEventListener('astro:page-load', () => {
    cleaners.forEach((fn) => fn());
    cleaners = Array.from(document.querySelectorAll<HTMLElement>('[data-ss-slider]')).map(initSlider);
  });
  document.addEventListener('astro:before-swap', () => { cleaners.forEach((fn) => fn()); cleaners = []; });
</script>


<style>
  /* Imagen única: se mira a través del arco */
  .ss-arch {
    aspect-ratio: 4 / 5;
    width: 100%;
    max-width: 30rem;
    margin-inline: auto;
  }

  .ss-video {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius-md);
    background-color: var(--color-forest-night);
  }

  .ss-video__facade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    padding: 0;
    border: none;
    cursor: pointer;
    background: none;
  }

  .ss-video__facade img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s var(--ease-out), opacity 0.4s var(--ease-out);
  }

  .ss-video__facade:hover img {
    transform: scale(1.04);
    opacity: 0.85;
  }

  .ss-video__facade:focus-visible {
    outline: 2px solid var(--color-saffron);
    outline-offset: -4px;
  }

  .ss-video__play {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 4.5rem;
    height: 4.5rem;
    display: grid;
    place-items: center;
    padding-left: 3px;
    border-radius: 50%;
    background: var(--color-lotus-white);
    color: var(--color-forest-night);
    transform: translate(-50%, -50%);
    box-shadow: 0 12px 32px -8px rgb(0 0 0 / 0.5);
    transition: transform 0.3s var(--ease-out), background-color 0.3s var(--ease-out);
  }

  .ss-video__facade:hover .ss-video__play {
    transform: translate(-50%, -50%) scale(1.08);
    background: var(--color-saffron);
  }

  .ss-slider {
    position: relative;
    width: 100%;
  }

  .ss-slider-track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    border-radius: var(--radius-md);
  }

  .ss-slider-track::-webkit-scrollbar {
    display: none;
  }

  .ss-slide {
    flex: 0 0 100%;
    scroll-snap-align: start;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: var(--radius-md);
  }

  .ss-slider-dots {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }

  .ss-slider-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: none;
    cursor: pointer;
    padding: 0;
    background: var(--color-light-surface);
    transition: all 0.3s ease;
  }

  .ss-slider-dot.active {
    background: var(--color-forest-dark);
    width: 28px;
    border-radius: 5px;
  }

  @media (prefers-reduced-motion: reduce) {
    .ss-slider-track {
      scroll-behavior: auto;
    }
    .ss-video__facade img,
    .ss-video__play {
      transition: none;
    }
  }
</style>
