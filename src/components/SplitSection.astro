---
type CtaVariant = 'rausch' | 'forest';

interface Props {
  title: string;
  description: string;
  ctaLabel?: string;
  ctaUrl?: string;
  imageSrc?: string;
  imageAlt?: string;
  images?: string[];
  videoUrl?: string;
  reversed?: boolean;
  background?: string;
  fullBleed?: boolean;
  ctaVariant?: CtaVariant;
}

const {
  title,
  description,
  ctaLabel,
  ctaUrl,
  imageSrc = '/images/about-hero.webp',
  imageAlt = '',
  images,
  videoUrl,
  reversed = false,
  background = '',
  fullBleed = false,
  ctaVariant = 'rausch',
} = Astro.props;

const hasImages = !!images && images.length > 0;

function getYouTubeEmbed(url: string): string {
  const match = url.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/|youtube\.com\/embed\/)([a-zA-Z0-9_-]{11})/);
  return match ? `https://www.youtube.com/embed/${match[1]}` : url;
}

const embedUrl = videoUrl ? getYouTubeEmbed(videoUrl) : null;
const isVideo = !!embedUrl;

const ctaColors: Record<CtaVariant, { bg: string; hover: string }> = {
  rausch: { bg: 'bg-rausch', hover: 'hover:bg-rausch-dark' },
  forest: { bg: 'bg-forest', hover: 'hover:bg-forest-dark' },
};

const hasBackground = !!background && !fullBleed;
---
<section
  class:list={[
    'py-16 md:py-24',
    hasBackground ? background : '',
  ]}
>
  <div class:list={[
    hasBackground ? 'max-w-7xl mx-auto px-6 md:px-12 lg:px-20' : '',
  ]}>
    <div class:list={[
      'grid grid-cols-1 lg:grid-cols-2',
      fullBleed ? 'gap-0' : 'gap-12 lg:gap-16',
    ]}>

    {/* Media column */}
    <div
      class:list={[
        'relative',
        fullBleed ? 'min-h-70 lg:min-h-125' : 'min-h-70 lg:min-h-0',
        reversed ? 'lg:order-1' : 'lg:order-2',
      ]}
    >
      {!fullBleed && (
        <div class="absolute -inset-4 bg-saffron/5 rounded-[2rem] blur-2xl" aria-hidden="true"></div>
      )}

      {isVideo ? (
        <div class:list={[
          'relative h-full overflow-hidden shimmer transition-transform duration-700 ease-in-out',
          fullBleed ? '' : 'rounded-2xl shadow-airbnb hover:scale-[1.02]',
        ]}>
          <iframe
            src={embedUrl}
            title={imageAlt || title}
            class="absolute inset-0 w-full h-full"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
            loading="lazy"
          />
        </div>
      ) : hasImages ? (
        <div class="ss-slider" data-slider>
          <div class="ss-slider-track" data-slider-track>
            {images!.map((src, i) => (
              <div class="ss-slide">
                <img
                  src={src}
                  alt={`${imageAlt || title} — imagen ${i + 1}`}
                  class="w-full h-full object-cover rounded-2xl shadow-airbnb"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            ))}
          </div>
          <div class="ss-slider-dots" data-slider-dots>
            {images!.map((_, i) => (
              <button
                type="button"
                data-slider-dot={i}
                class:list={['ss-slider-dot', { active: i === 0 }]}
                aria-label={`Ir a la imagen ${i + 1}`}
              />
            ))}
          </div>
        </div>
      ) : (
        <div class:list={[
          'relative h-full overflow-hidden shimmer transition-transform duration-700 ease-in-out',
          fullBleed ? '' : 'rounded-2xl shadow-airbnb hover:scale-[1.02]',
        ]}>
          <div class="absolute inset-0 flex flex-col items-center justify-center text-gray-400">
            <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="mb-3 opacity-50">
              <path d="M6 16 12 4l6 12H6ZM7 14.5 9 11l3 5.5"/>
              <path d="M2 20h20"/>
            </svg>
            <span class="text-sm font-medium tracking-wide opacity-50">Imagen del santuario</span>
          </div>
          <img
            src={imageSrc}
            alt={imageAlt || title}
            class="relative w-full h-full object-cover"
            loading="lazy"
            decoding="async"
            onerror="this.style.display='none'"
          />
        </div>
      )}
    </div>

    {/* Text column */}
    <div
      class:list={[
        'flex flex-col justify-center space-y-6 max-w-xl',
        fullBleed
          ? ['px-6 md:px-12 lg:px-20 py-16 lg:py-20', background]
          : '',
        reversed ? 'lg:order-2' : 'lg:order-1',
      ]}
    >
      <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold font-display tracking-tightest text-near-black leading-tight">
        {title}
      </h2>

      <p class="text-lg md:text-xl text-secondary-gray leading-relaxed">
        {description}
      </p>

      {ctaLabel && (
        <a
          href={ctaUrl || '#'}
          class:list={[
            'self-start inline-block text-white px-10 py-4 rounded-2xl font-bold text-lg transition-all duration-300 hover:scale-105 shadow-lg',
            ctaColors[ctaVariant].bg,
            ctaColors[ctaVariant].hover,
          ]}
        >
          {ctaLabel}
        </a>
      )}
    </div>

  </div>
  </div>
</section>

<script>
  function initSlider(container: HTMLElement) {
    const track = container.querySelector<HTMLElement>('[data-slider-track]')!;
    const dots = container.querySelectorAll<HTMLButtonElement>('[data-slider-dot]');
    const slides = track.children;
    const total = slides.length;

    if (total < 2) return;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let current = 0;
    let timer: ReturnType<typeof setInterval> | null = null;
    const interval = 5000;

    function goTo(index: number) {
      const slide = slides[index] as HTMLElement;
      if (!slide) return;
      current = index;
      track.scrollTo({ left: slide.offsetLeft - track.offsetLeft, behavior: reduced ? 'auto' : 'smooth' });
      dots.forEach((d, i) => d.classList.toggle('active', i === current));
    }

    function goNext() {
      goTo((current + 1) % total);
    }

    function startTimer() {
      if (reduced || total < 3) return;
      stopTimer();
      timer = setInterval(goNext, interval);
    }

    function stopTimer() {
      if (timer) { clearInterval(timer); timer = null; }
    }

    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => { goTo(i); stopTimer(); startTimer(); });
    });

    container.addEventListener('mouseenter', stopTimer);
    container.addEventListener('mouseleave', startTimer);
    container.addEventListener('focusin', stopTimer);
    container.addEventListener('focusout', startTimer);
    container.addEventListener('touchstart', stopTimer, { passive: true });
    container.addEventListener('touchend', () => { setTimeout(startTimer, 3000); });

    // Update active dot on scroll (swipe/trackpad users)
    let scrollTimeout: ReturnType<typeof setTimeout>;
    track.addEventListener('scroll', () => {
      clearTimeout(scrollTimeout);
      scrollTimeout = setTimeout(() => {
        const x = track.scrollLeft + track.offsetWidth / 2;
        let closest = 0;
        let minDist = Infinity;
        for (let i = 0; i < slides.length; i++) {
          const s = slides[i] as HTMLElement;
          const dist = Math.abs(s.offsetLeft - track.offsetLeft - x + s.offsetWidth / 2);
          if (dist < minDist) { minDist = dist; closest = i; }
        }
        current = closest;
        dots.forEach((d, i) => d.classList.toggle('active', i === current));
      }, 100);
    }, { passive: true });

    startTimer();
  }

  document.querySelectorAll<HTMLElement>('[data-slider]').forEach(initSlider);
</script>

<style>
  .ss-slider {
    position: relative;
    width: 100%;
  }

  .ss-slider-track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    border-radius: 1rem;
  }

  .ss-slider-track::-webkit-scrollbar {
    display: none;
  }

  .ss-slide {
    flex: 0 0 100%;
    scroll-snap-align: start;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 1rem;
  }

  .ss-slider-dots {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }

  .ss-slider-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: none;
    cursor: pointer;
    padding: 0;
    background: var(--color-light-surface);
    transition: all 0.3s ease;
  }

  .ss-slider-dot.active {
    background: var(--color-rausch);
    width: 28px;
    border-radius: 5px;
  }
</style>
