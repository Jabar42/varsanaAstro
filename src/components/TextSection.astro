---
interface Props {
  text: string;
}

const { text } = Astro.props;

// Los textos del equipo llegan con varios párrafos separados por línea en blanco.
// Sin esto, HTML los colapsa en un solo bloque.
const paragraphs = String(text ?? '')
  .split(/\n{2,}/)
  .map((p) => p.trim())
  .filter(Boolean);
---

<section class="max-w-3xl mx-auto py-16 md:py-24 space-y-5">
  {paragraphs.map((p) => <p class="text-secondary-gray text-lg leading-relaxed">{p}</p>)}
</section>
