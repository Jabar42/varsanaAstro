---
import { Leaf, Flower2, Tent, Users, Info, Calendar, Heart, Map, Compass } from 'lucide-react';

const { align = 'end' }: { align?: 'start' | 'center' | 'end' } = Astro.props;
const alignmentClasses = {
  start: 'justify-start',
  center: 'justify-center',
  end: 'justify-end',
} as const;
const alignmentClass = alignmentClasses[align] || 'justify-end';
const containerClass = `max-w-7xl mx-auto flex flex-nowrap items-center ${alignmentClass} gap-8 md:gap-12`;

const categories = [
  { name: 'Yoga', icon: Heart, href: '/' },
  { name: 'Meditación', icon: Flower2, href: '/' },
  { name: 'Hospedaje', icon: Tent, href: '/' },
  { name: 'Nosotros', icon: Info, href: '/nosotros' },
  { name: 'Voluntariado', icon: Users, href: '/voluntariado' },
  { name: 'Pasadias', icon: Map, href: '/pasadias' },
  { name: 'Eventos', icon: Calendar, href: '/events' },
  { name: 'Naturaleza', icon: Leaf, href: '/' },
  { name: 'Retiros', icon: Compass, href: '/' },
];

const firstRootIndex = categories.findIndex(cat => cat.href === '/');
const currentPath = Astro.url.pathname;

const isActive = (href: string, index: number) => {
  if (href === '/') {
    // Only active if we're on the homepage and this is the first root category
    if (currentPath !== '/') return false;
    return index === firstRootIndex;
  }
  return currentPath.startsWith(href);
};
---

<div class="bg-white border-t border-gray-100 py-4 overflow-x-auto no-scrollbar scroll-smooth">
  <div class={containerClass}>
    {categories.map((cat, i) => (
      <a
        href={cat.href}
        class={`flex flex-col items-center gap-1 min-w-fit flex-shrink-0 group cursor-pointer border-b-2 transition-all duration-600 pb-1 ${
          isActive(cat.href, i)
            ? 'border-near-black opacity-100'
            : 'border-transparent opacity-60 hover:opacity-100 hover:border-saffron'
        }`}
      >
        <cat.icon size={20} strokeWidth={1.5} />
        <span class="text-xs font-medium whitespace-nowrap">{cat.name}</span>
      </a>
    ))}
  </div>
</div>

<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
</style>

<script>
  // @ts-nocheck
  // Auto‑scroll hint for mobile
  if (typeof window !== 'undefined' && window.innerWidth < 768) {
    const container = document.querySelector('.overflow-x-auto');
    if (!container) return;

    const scrollWidth = container.scrollWidth;
    const clientWidth = container.clientWidth;
    if (scrollWidth <= clientWidth) return; // No overflow

    let direction = 1;
    let position = 0;
    const step = 0.5;
    const limit = 40;
    let paused = false;

    function animate() {
      if (paused) {
        requestAnimationFrame(animate);
        return;
      }
      position += direction * step;
      if (position >= limit || position <= 0) {
        direction *= -1;
        paused = true;
        setTimeout(() => { paused = false; }, 2000);
      }
      container.scrollLeft = position;
      requestAnimationFrame(animate);
    }
    requestAnimationFrame(animate);

    // Pause on interaction
    const pause = () => { paused = true; };
    const resume = () => { setTimeout(() => { paused = false; }, 10000); };
    container.addEventListener('mouseenter', pause);
    container.addEventListener('touchstart', pause);
    container.addEventListener('touchend', resume);
  }
</script>
