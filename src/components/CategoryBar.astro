---
import {Send, Megaphone, Store, Tent, Users, Calendar, Map, Compass, House} from 'lucide-react';

const { align = 'end' }: { align?: 'start' | 'center' | 'end' } = Astro.props;
const alignmentClasses = {
  start: 'justify-start',
  center: 'justify-center',
  end: 'justify-end',
} as const;
const alignmentClass = alignmentClasses[align] || 'justify-end';
const containerClass = `max-w-none md:max-w-7xl mx-auto flex flex-nowrap items-center ${alignmentClass} gap-8 md:gap-12 w-max md:w-auto`;

const categories = [
  { name: 'Inicio', icon: House, href: '/' },
  { name: 'Nosotros', icon: Users, href: '/nosotros' },
  { name: 'Experiencias', icon: Calendar, href: '/events' },
  { name: 'Hospedaje', icon: Tent, href: '/' },
  { name: 'Tienda', icon: Store, href: '/tienda' },
  { name: 'Blog', icon: Megaphone, href: '/blog' },
  { name: 'Contacto', icon: Send, href: '/contacto' },
];

const firstRootIndex = categories.findIndex(cat => cat.href === '/');
const currentPath = Astro.url.pathname;

const isActive = (href: string, index: number) => {
  if (href === '/') {
    // Only active if we're on the homepage and this is the first root category
    if (currentPath !== '/') return false;
    return index === firstRootIndex;
  }
  return currentPath.startsWith(href);
};
---

<div class="bg-white border-t border-gray-100 py-2 overflow-x-auto no-scrollbar scroll-smooth">
  <div class={containerClass}>
    {categories.map((cat, i) => (
      <a
        href={cat.href}
        class={`flex flex-col items-center gap-0 min-w-fit flex-shrink-0 group cursor-pointer border-b transition-all duration-600 pb-0 ${
          isActive(cat.href, i)
            ? 'border-near-black opacity-100'
            : 'border-transparent opacity-60 hover:opacity-100 hover:border-saffron'
        }`}
      >
        <cat.icon size={20} strokeWidth={1.5} />
        <span class="text-xs font-medium whitespace-nowrap leading-none">{cat.name}</span>
      </a>
    ))}
  </div>
</div>

<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
</style>

<script>
  // @ts-nocheck
  // Auto‑scroll hint for mobile
  if (typeof window !== 'undefined' && window.innerWidth < 768) {
    const container = document.querySelector('.overflow-x-auto');
    if (container) {
      const scrollWidth = container.scrollWidth;
      const clientWidth = container.clientWidth;
      if (scrollWidth > clientWidth) {
        let direction = 1;
        let position = 0;
        const step = 0.2; // slower movement
        const limit = 100; // smaller distance
        let paused = false;
        let animationId = null;

        function animate() {
          if (paused) {
            animationId = requestAnimationFrame(animate);
            return;
          }
          position += direction * step;
          if (position >= limit || position <= 0) {
            direction *= -1;
            paused = true;
            setTimeout(() => { paused = false; }, 3000); // longer pause at ends
          }
          container.scrollLeft = position;
          animationId = requestAnimationFrame(animate);
        }
        animationId = requestAnimationFrame(animate);

        function stopAnimation() {
          if (animationId) {
            cancelAnimationFrame(animationId);
            animationId = null;
          }
          container.removeEventListener('mouseenter', stopAnimation);
          container.removeEventListener('touchstart', stopAnimation);
        }

        container.addEventListener('mouseenter', stopAnimation);
        container.addEventListener('touchstart', stopAnimation);
      }
    }
  }
</script>
