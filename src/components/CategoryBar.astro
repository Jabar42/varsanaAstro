---
import { Menu, Send, House, Megaphone, Store, Tent, Users, Sparkles, Salad, ChevronDown } from 'lucide-react';
import { useTranslations } from '@/src/i18n/utils';
import { getRelativeLocaleUrl } from 'astro:i18n';

const locale = (Astro.locals as any)?.locale ?? Astro.currentLocale ?? 'es';
const t = useTranslations(locale);
const l = (path: string) => getRelativeLocaleUrl(locale, path);

interface NavChild {
  name: string;
  href: string;
}

interface NavItem {
  name: string;
  icon: typeof House;
  href?: string;
  children?: NavChild[];
}

const categories: NavItem[] = [
  { name: t('nav.home'), icon: House, href: l('/') },
  { name: t('nav.about'), icon: Users, href: l('/nosotros') },
  {
    name: t('nav.experiences'),
    icon: Sparkles,
    children: [
      { name: t('nav.events'), href: l('/events') },
      { name: t('nav.pasadias'), href: l('/pasadias') },
      { name: t('nav.volunteering'), href: l('/voluntariado') },
    ],
  },
  { name: t('nav.shop'), icon: Store, href: l('/tienda') },
  { name: t('nav.lodging'), icon: Tent, href: l('/hospedaje') },
  { name: t('nav.food'), icon: Salad, href: l('/alimentacion') },
  { name: t('nav.blog'), icon: Megaphone, href: l('/blog') },
  { name: t('nav.contact'), icon: Send, href: l('/contacto') },
];

const mobilePrimary: NavItem[] = [
  categories[1], // Nosotros
  categories[2], // Experiencias
  categories[3], // Tienda
];
const mobileOverflow = categories.filter(c => !mobilePrimary.includes(c) && c.name !== 'Inicio');

const desktopCategories: NavItem[] = [
  categories[0], // Inicio
  categories[1], // Nosotros
  categories[2], // Experiencias
  categories[4], // Hospedaje
  categories[5], // Alimentacion
  categories[3], // Tienda
  categories[6], // Blog
  categories[7], // Contacto
];

const currentPath = Astro.url.pathname;

const isActive = (item: NavItem): boolean => {
  if (item.children) {
    return item.children.some((child) => currentPath.startsWith(child.href));
  }
  if (!item.href) return false;
  if (item.href === '/') return currentPath === '/';
  return currentPath.startsWith(item.href);
};

const triggerBase =
  'flex flex-col items-center gap-0 min-w-fit flex-shrink-0 cursor-pointer border-b transition-all duration-300 pb-0.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-saffron focus-visible:ring-offset-2 rounded-sm';

const iconClasses = 'size-5';
const labelClasses = 'text-xs font-medium whitespace-nowrap leading-none';

function menuItemClass(href: string) {
  const active = currentPath.startsWith(href);
  return `block px-4 py-2 text-sm whitespace-nowrap hover:bg-sacred-sand transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-saffron ${
    active ? 'text-rausch font-semibold' : 'text-near-black'
  }`;
}
---

<nav aria-label="Navegacion principal" class="bg-lotus-white border-t border-sacred-sand py-2">
  <!-- ========== Mobile ========== -->
  <div class="flex min-[900px]:hidden items-center justify-between">
    {mobilePrimary.map((item) => (
      item.children ? (
        <div class="relative">
          <button
            type="button"
            data-dropdown-trigger
            aria-expanded="false"
            aria-haspopup="true"
            class={`${triggerBase} ${
              isActive(item)
                ? 'border-near-black opacity-100'
                : 'border-transparent opacity-60'
            }`}
          >
            <item.icon class={iconClasses} strokeWidth={1.5} />
            <span class={`${labelClasses} inline-flex items-center gap-0.5`}>{item.name}<ChevronDown class="size-3" strokeWidth={1.5} /></span>
          </button>
          <div
            data-dropdown-menu
            class="hidden absolute top-full left-0 mt-1 bg-lotus-white border border-sacred-sand rounded-lg shadow-airbnb py-1 min-w-[140px] z-50"
            role="menu"
          >
            {item.children.map((child) => (
              <a href={child.href} role="menuitem" class={menuItemClass(child.href)}>
                {child.name}
              </a>
            ))}
          </div>
        </div>
      ) : (
        <a
          href={item.href}
          class={`${triggerBase} ${
            isActive(item)
              ? 'border-near-black opacity-100'
              : 'border-transparent opacity-60'
          }`}
        >
          <item.icon class={iconClasses} strokeWidth={1.5} />
          <span class={labelClasses}>{item.name}</span>
        </a>
      )
    ))}

    <div class="relative">
      <button
        type="button"
        data-dropdown-trigger
        aria-expanded="false"
        aria-haspopup="true"
        class={`${triggerBase} border-transparent opacity-60`}
      >
        <Menu class={iconClasses} strokeWidth={1.5} />
        <span class={labelClasses}>{t('nav.menu')}</span>
      </button>
      <div
        data-dropdown-menu
        class="hidden absolute top-full right-0 mt-1 bg-lotus-white border border-sacred-sand rounded-lg shadow-airbnb py-1 min-w-[140px] z-50"
        role="menu"
      >
        {mobileOverflow.map((item) => (
          <a href={item.href!} role="menuitem" class={menuItemClass(item.href!)}>
            {item.name}
          </a>
        ))}
      </div>
    </div>
  </div>

  <!-- ========== Desktop ========== -->
  <div class="hidden min-[900px]:flex items-center justify-end gap-8 lg:gap-12">
    {desktopCategories.map((item) => (
      item.children ? (
        <div class="relative">
          <button
            type="button"
            data-dropdown-trigger
            aria-expanded="false"
            aria-haspopup="true"
            class={`${triggerBase} ${
              isActive(item)
                ? 'border-near-black opacity-100'
                : 'border-transparent opacity-60 hover:opacity-100 hover:border-saffron'
            }`}
          >
            <item.icon class={iconClasses} strokeWidth={1.5} />
            <span class={`${labelClasses} inline-flex items-center gap-0.5`}>{item.name}<ChevronDown class="size-3" strokeWidth={1.5} /></span>
          </button>
          <div
            data-dropdown-menu
            class="hidden absolute top-full left-0 mt-1 bg-lotus-white border border-sacred-sand rounded-lg shadow-airbnb py-1 min-w-[160px] z-50"
            role="menu"
          >
            {item.children.map((child) => (
              <a href={child.href} role="menuitem" class={menuItemClass(child.href)}>
                {child.name}
              </a>
            ))}
          </div>
        </div>
      ) : (
        <a
          href={item.href}
          class={`${triggerBase} ${
            isActive(item)
              ? 'border-near-black opacity-100'
              : 'border-transparent opacity-60 hover:opacity-100 hover:border-saffron'
          }`}
        >
          <item.icon class={iconClasses} strokeWidth={1.5} />
          <span class={labelClasses}>{item.name}</span>
        </a>
      )
    ))}
  </div>
</nav>

<script>
  function toggleDropdown(trigger, menu) {
    const isHidden = menu.classList.contains('hidden');
    if (isHidden) {
      closeAllDropdowns();
      menu.classList.remove('hidden');
      trigger.setAttribute('aria-expanded', 'true');
    } else {
      menu.classList.add('hidden');
      trigger.setAttribute('aria-expanded', 'false');
    }
  }

  function closeAllDropdowns() {
    document.querySelectorAll('[data-dropdown-menu]').forEach((menu) => {
      menu.classList.add('hidden');
      const trigger = menu.previousElementSibling;
      if (trigger) {
        trigger.setAttribute('aria-expanded', 'false');
      }
    });
  }

  document.addEventListener('click', (e) => {
    const trigger = e.target.closest('[data-dropdown-trigger]');
    if (trigger) {
      const menu = trigger.nextElementSibling;
      if (menu) toggleDropdown(trigger, menu);
    } else {
      closeAllDropdowns();
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeAllDropdowns();
      return;
    }
    if (e.key === 'Enter' || e.key === ' ') {
      const trigger = e.target.closest('[data-dropdown-trigger]');
      if (trigger) {
        e.preventDefault();
        const menu = trigger.nextElementSibling;
        if (menu) toggleDropdown(trigger, menu);
      }
    }
  });
</script>
