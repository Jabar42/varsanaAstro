---
import { Leaf, Flower2, Tent, Users, Info, Calendar, Heart, Map, Compass } from 'lucide-react';

const { align = 'end' }: { align?: 'start' | 'center' | 'end' } = Astro.props;
const alignmentClasses = {
  start: 'justify-start',
  center: 'justify-center',
  end: 'justify-end',
} as const;
const alignmentClass = alignmentClasses[align] || 'justify-end';
const containerClass = `flex flex-nowrap items-center ${alignmentClass} gap-8 md:gap-12`;

const categories = [
  { name: 'Yoga', icon: Heart, href: '/' },
  { name: 'Meditación', icon: Flower2, href: '/' },
  { name: 'Hospedaje', icon: Tent, href: '/' },
  { name: 'Nosotros', icon: Info, href: '/nosotros' },
  { name: 'Voluntariado', icon: Users, href: '/voluntariado' },
  { name: 'Pasadias', icon: Map, href: '/pasadias' },
  { name: 'Eventos', icon: Calendar, href: '/events' },
  { name: 'Naturaleza', icon: Leaf, href: '/' },
  { name: 'Retiros', icon: Compass, href: '/' },
];

const firstRootIndex = categories.findIndex(cat => cat.href === '/');
const currentPath = Astro.url.pathname;

const isActive = (href: string, index: number) => {
  if (href === '/') {
    // Only active if we're on the homepage and this is the first root category
    if (currentPath !== '/') return false;
    return index === firstRootIndex;
  }
  return currentPath.startsWith(href);
};
---

<div class="bg-white border-t border-gray-100 py-4 overflow-x-auto no-scrollbar">
  <div class={containerClass}>
    {categories.map((cat, i) => (
      <a
        href={cat.href}
        class={`flex flex-col items-center gap-2 min-w-fit flex-shrink-0 group cursor-pointer border-b-2 transition-all duration-600 pb-2 ${
          isActive(cat.href, i)
            ? 'border-near-black opacity-100'
            : 'border-transparent opacity-60 hover:opacity-100 hover:border-saffron'
        }`}
      >
        <cat.icon size={24} strokeWidth={1.5} />
        <span class="text-xs font-semibold whitespace-nowrap">{cat.name}</span>
      </a>
    ))}
  </div>
</div>

<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
</style>
