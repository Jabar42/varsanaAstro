---
import '@/src/styles/global.css';
import Header from '@/src/components/Header.astro';
import Footer from '@/src/components/Footer.astro';
import SpeedInsights from '@vercel/speed-insights/astro';

export interface Props {
  title?: string;
  description?: string;
}

const { title = 'Varsana Eco Yoga Aldea', description = '' } = Astro.props;
---

<html lang="es">
  <head>
    <style is:inline>
      html, body {
        background-color: #FAF9F6;
        color: #222222;
        font-family: "Inter", ui-sans-serif, system-ui, sans-serif;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }
      h1, h2, h3, h4, h5, h6 {
        font-family: "Proza Libre", sans-serif;
        font-weight: 700;
      }
    </style>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="preload" as="font" type="font/woff2" href="/fonts/proza-libre/proza-libre-latin-700-normal.woff2" crossorigin />
    <link rel="preload" as="image" href="/logo/logovarsana.png" />
    <SpeedInsights />
    <slot name="head" />
  </head>
  <body class="bg-sacred-sand text-near-black font-sans antialiased">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>