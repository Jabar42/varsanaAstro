---
import '@/src/styles/global.css';
import AnnouncementBar from '@/src/components/AnnouncementBar.astro';
import Header from '@/src/components/Header.astro';
import Footer from '@/src/components/Footer.astro';
import ChatWidget from '@tp3/chat-widget';

import { ClientRouter } from 'astro:transitions';

export interface Props {
  title?: string;
  description?: string;
}

const { title = 'Varsana Eco Yoga Aldea', description = '' } = Astro.props;
---

<html lang={(Astro.locals as any)?.locale ?? Astro.currentLocale ?? 'es'}>
  <head>
    <style is:inline>
      html, body {
        background-color: #FAF9F6;
        color: #222222;
        font-family: "Inter", ui-sans-serif, system-ui, sans-serif;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }
      h1, h2, h3, h4, h5, h6 {
        font-family: "Proza Libre", sans-serif;
        font-weight: 700;
      }
    </style>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/logo/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="alternate" hreflang="es" href={new URL(Astro.url.pathname.replace(/^\/en\//, '/').replace(/^\/en$/, '/'), Astro.site).href} />
    <link rel="alternate" hreflang="en" href={new URL('/en' + Astro.url.pathname.replace(/^\/en\//, '/').replace(/^\/en$/, '/'), Astro.site).href} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="preload" as="font" type="font/woff2" href="/fonts/proza-libre/proza-libre-latin-700-normal.woff2" crossorigin />
    <link rel="preload" as="image" href="/logo/LogoPrincipal.svg" />
    <ClientRouter />
    <!-- Language switch: event delegation on document survives ClientRouter SPA navigations -->
    <script>
      document.addEventListener('click', (e) => {
        const switcher = e.target.closest('[data-locale-switch]');
        if (switcher) {
          const targetLocale = switcher.getAttribute('data-locale-switch');
          document.cookie = 'varsana_locale=' + targetLocale + '; Path=/; Max-Age=31536000; SameSite=Lax';
        }
      });
    </script>
    <script defer src='https://umami-beta-livid.vercel.app/script.js' data-website-id='ed874ce2-f14c-41ab-badb-0b7bc360bee7'></script>
    <slot name="head" />
  </head>
  <body class="bg-sacred-sand text-near-black font-sans antialiased">
    <AnnouncementBar />
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <ChatWidget
      hermesUrl="ws://localhost:8766"
      brandName="Varsana"
      brandSubtitle="Asistente virtual"
      welcomeMessage="🙏 ¡Bienvenida a Varsana Eco Yoga Aldea! Soy Ananda, tu asistente virtual. ¿En qué puedo ayudarte?"
      client:load />

    <!-- Grain texture overlay — SVG noise filter for handmade/earthy feel -->
    <svg aria-hidden="true" class="grain-overlay" transition:persist>
      <filter id="grain-filter">
        <feTurbulence type="fractalNoise" baseFrequency="0.65" numOctaves="3" stitchTiles="stitch" />
        <feColorMatrix type="saturate" values="0" />
      </filter>
      <rect width="100%" height="100%" filter="url(#grain-filter)" />
    </svg>
  </body>
</html>