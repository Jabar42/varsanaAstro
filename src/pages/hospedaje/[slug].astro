---
import { getLocale, useTranslations, localizePath, formatCOP } from '@/src/i18n/utils';

import Layout from '@/src/layouts/Layout.astro';
import { getEntry, render } from 'astro:content';
import { Check, Users, Clock, AlertTriangle, ChevronLeft, ChevronRight } from 'lucide-react';

const locale = getLocale(Astro);
const t = useTranslations(locale);
const l = (path: string) => localizePath(locale, path);

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/404');
const hospedaje = await getEntry('hospedaje', slug);
if (!hospedaje) return Astro.redirect('/404');

const { nombre, descripcion, num_huespedes, noches, servicios_incluidos, check_in_out, ten_en_cuenta, valor_por_persona_noche, fotos } = hospedaje.data;
const { Content } = await render(hospedaje);

/** "$140,000" → "$140.000 COP" / "$140,000 COP" según idioma; si no es numérico, deja el texto original. */
const priceNumber = Number(valor_por_persona_noche.replace(/[^\d]/g, ''));
const priceLabel = Number.isFinite(priceNumber) && priceNumber > 0 ? formatCOP(priceNumber, locale) : valor_por_persona_noche;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://varsana.com');
const host_name = 'Varsana';
---

<Layout title={t('hospedajeDetail.metaTitle', { name: nombre })} description={descripcion}>
  <Fragment slot="head">
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={nombre} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:image" content={fotos?.[0] || ''} />
    <meta name="twitter:card" content="summary_large_image" />
  </Fragment>

  <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 pt-6 md:pt-10 pb-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 lg:grid-rows-[auto_1fr] gap-x-12 xl:gap-x-16 gap-y-10">
      <!-- Photo Gallery: la habitación se mira a través del arco -->
      {fotos && fotos.length > 0 && (
        <div class="lg:col-start-8 lg:col-span-5 lg:row-start-1">
          <div class="arch shimmer relative aspect-4/5 max-h-[34rem] w-full mx-auto bg-forest-night" data-gallery>
            {fotos.map((foto, i) => (
              <img
                src={foto}
                alt={t('hospedajeDetail.gallery.photoAlt', { name: nombre, n: i + 1 })}
                class:list={['w-full h-full object-cover absolute inset-0 transition-opacity duration-500', { 'opacity-100 z-10': i === 0, 'opacity-0 z-0': i !== 0 }]}
                data-gallery-img={i}
                referrerpolicy="no-referrer"
              />
            ))}
            {fotos.length > 1 && (
              <>
                <button data-gallery-prev class="absolute left-3 top-[62%] -translate-y-1/2 z-20 w-11 h-11 rounded-full bg-lotus-white/85 text-forest-night backdrop-blur-sm flex items-center justify-center hover:bg-lotus-white transition-colors duration-300" aria-label={t('hospedajeDetail.gallery.prev')}>
                  <ChevronLeft size={20} />
                </button>
                <button data-gallery-next class="absolute right-3 top-[62%] -translate-y-1/2 z-20 w-11 h-11 rounded-full bg-lotus-white/85 text-forest-night backdrop-blur-sm flex items-center justify-center hover:bg-lotus-white transition-colors duration-300" aria-label={t('hospedajeDetail.gallery.next')}>
                  <ChevronRight size={20} />
                </button>
                <div class="absolute bottom-5 left-1/2 -translate-x-1/2 z-20 flex gap-2">
                  {fotos.map((_, i) => (
                    <button data-gallery-dot={i} class:list={['w-2.5 h-2.5 rounded-full transition-all', i === 0 ? 'bg-white w-6' : 'bg-white/60']} aria-label={t('hospedajeDetail.gallery.goTo', { n: i + 1 })} />
                  ))}
                </div>
              </>
            )}
          </div>
        </div>
      )}

      <!-- Main Content Column -->
      <div class="lg:col-start-1 lg:col-span-7 lg:row-start-1 lg:row-span-2 space-y-10">
        <div class="lg:pt-10">
          <span class="rule-saffron mb-8" aria-hidden="true"></span>
          <h1 class="display-xl font-bold font-display text-near-black">{nombre}</h1>
          <div class="mt-8 flex flex-wrap gap-x-8 gap-y-3 text-sm font-medium">
            <div class="flex items-start gap-2">
              <Users size={18} className="text-saffron-deep shrink-0" />
              <span>{num_huespedes}</span>
            </div>
            <div class="flex items-start gap-2">
              <Clock size={18} className="text-saffron-deep shrink-0" />
              <span>{check_in_out}</span>
            </div>
          </div>
        </div>

        <!-- Host Info -->
        <div class="flex items-center justify-between gap-6 border-y border-near-black/10 py-6">
          <div class="space-y-1">
            <h2 class="text-xl md:text-2xl font-bold font-display">{t('hospedajeDetail.host.offeredBy', { name: host_name })}</h2>
            <p class="text-secondary-gray text-sm">{t('hospedajeDetail.host.tagline')}</p>
          </div>
          <div class="w-14 h-14 shrink-0 bg-sand-deep rounded-full flex items-center justify-center overflow-hidden">
            <img src="/logo/LogoPrincipal.svg" alt={host_name} class="w-full h-full object-cover" />
          </div>
        </div>

        <!-- Description -->
        <div class="max-w-none">
          <Content />
        </div>

        <!-- Included Services -->
        {servicios_incluidos && servicios_incluidos.length > 0 && (
          <div class="border-t border-near-black/10 pt-10">
            <h3 class="display-md font-bold mb-8 font-display">{t('hospedajeDetail.includedServices')}</h3>
            <ul class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-4">
              {servicios_incluidos.map((service) => (
                <li class="flex items-start gap-3">
                  <Check size={18} className="text-forest-deep shrink-0 mt-1" />
                  <span>{service}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

        <!-- Important Note -->
        <div class="flex items-start gap-4 p-6 md:p-8 bg-sand-deep rounded-3xl">
          <AlertTriangle size={20} className="text-saffron-deep shrink-0 mt-1" />
          <div>
            <h3 class="font-bold text-lg mb-2 font-display">{t('hospedajeDetail.keepInMind')}</h3>
            <p class="text-secondary-gray whitespace-pre-line leading-relaxed">{ten_en_cuenta}</p>
          </div>
        </div>
      </div>

      <!-- Sticky Price Card Column -->
      <div class="relative lg:col-start-8 lg:col-span-5 lg:row-start-2">
        <div class="sticky top-28 bg-lotus-white ring-1 ring-near-black/5 rounded-3xl p-6 md:p-8 space-y-6">
          <div>
            <span class="text-3xl md:text-4xl font-bold font-display">{priceLabel}</span>
            <span class="text-secondary-gray text-base font-normal">{t('hospedajeDetail.price.perPersonNight')}</span>
          </div>

          <!-- Booking Details Box -->
          <div class="border border-near-black/10 rounded-2xl overflow-hidden">
            <div class="grid grid-cols-2 border-b border-near-black/10">
              <div class="p-4 border-r border-near-black/10">
                <p class="text-xs font-bold uppercase tracking-wide text-secondary-gray">{t('hospedajeDetail.price.guests')}</p>
                <p class="text-sm mt-1">{num_huespedes}</p>
              </div>
              <div class="p-4">
                <p class="text-xs font-bold uppercase tracking-wide text-secondary-gray">{t('hospedajeDetail.price.nights')}</p>
                <p class="text-sm mt-1">{noches}</p>
              </div>
            </div>
            <div class="p-4">
              <p class="text-xs font-bold uppercase tracking-wide text-secondary-gray">{t('hospedajeDetail.price.checkInOut')}</p>
              <p class="text-sm mt-1">{check_in_out}</p>
            </div>
          </div>

          <a href={l('/contacto')} class="btn btn-lg btn-block btn-arrow">
            {t('hospedajeDetail.price.cta')}
          </a>

          <p class="text-center text-secondary-gray text-xs">{t('hospedajeDetail.price.replyTime')}</p>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  // Galería simple. Con <ClientRouter /> este módulo corre una vez por sesión,
  // así que la inicialización se engancha a cada navegación vía astro:page-load.
  function initGallery(el: HTMLElement) {
    if (el.dataset.galleryReady === 'true') return;
    el.dataset.galleryReady = 'true';

    const imgs = el.querySelectorAll<HTMLImageElement>('[data-gallery-img]');
    const dots = el.querySelectorAll<HTMLButtonElement>('[data-gallery-dot]');
    const prev = el.querySelector<HTMLButtonElement>('[data-gallery-prev]');
    const next = el.querySelector<HTMLButtonElement>('[data-gallery-next]');
    const total = imgs.length;
    if (total < 2) return;

    let current = 0;

    function show(index: number) {
      imgs.forEach((img, i) => {
        img.classList.toggle('opacity-100', i === index);
        img.classList.toggle('z-10', i === index);
        img.classList.toggle('opacity-0', i !== index);
        img.classList.toggle('z-0', i !== index);
      });
      dots.forEach((dot, i) => {
        dot.classList.toggle('bg-white', i === index);
        dot.classList.toggle('w-6', i === index);
        dot.classList.toggle('bg-white/60', i !== index);
      });
      current = index;
    }

    prev?.addEventListener('click', () => show((current - 1 + total) % total));
    next?.addEventListener('click', () => show((current + 1) % total));
    dots.forEach((dot, i) => dot.addEventListener('click', () => show(i)));
  }

  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('[data-gallery]').forEach(initGallery);
  });
</script>

