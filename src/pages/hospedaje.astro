---
import { getLocale, useTranslations, localizePath, formatCOP } from '@/src/i18n/utils';
import { es as dict } from '@/src/i18n/dictionaries/hospedajePage';

import Layout from '@/src/layouts/Layout.astro';
import PageBanner from '@/src/components/PageBanner.astro';
import { getCollection } from 'astro:content';

const locale = getLocale(Astro);
const t = useTranslations(locale);
const l = (path: string) => localizePath(locale, path);

import {
  Home,
  CheckCircle2,
  Info,
  Sparkles,
  ChevronRight,
  Users,
} from 'lucide-react';

/** "$140,000" → 140000 (null si no es numérico). */
function parsePrice(raw: string): number | null {
  const n = Number(raw.replace(/[^\d]/g, ''));
  return Number.isFinite(n) && n > 0 ? n : null;
}

const allHospedajes = await getCollection('hospedaje');
const rooms = allHospedajes
  .sort((a, b) => a.data.orden - b.data.orden)
  .map((h) => {
    const price = parsePrice(h.data.valor_por_persona_noche);
    return {
      slug: h.id,
      name: h.data.nombre,
      description: h.data.descripcion,
      image: h.data.fotos?.[0] ?? 'https://picsum.photos/seed/default/800/600',
      capacity: h.data.num_huespedes,
      features: h.data.servicios_incluidos?.slice(0, 3) ?? [],
      priceLabel: price !== null ? formatCOP(price, locale) : h.data.valor_por_persona_noche,
      icon: Home,
      accent: 'forest' as const,
    };
  });

// Las listas se iteran por índice para que t() resuelva cada cadena en el idioma actual.
const amenities = dict.amenities.items.map((_, i) => t(`hospedajePage.amenities.items.${i}`));
const faqs = dict.faq.items.map((_, i) => ({
  question: t(`hospedajePage.faq.items.${i}.question`),
  answer: t(`hospedajePage.faq.items.${i}.answer`),
}));

const accentStyles: Record<string, { iconBg: string; iconText: string; border: string; btn: string; topBorder: string }> = {
  saffron: {
    iconBg: 'bg-saffron/10',
    iconText: 'text-saffron',
    border: 'border-saffron/30',
    btn: 'bg-saffron text-white',
    topBorder: 'border-t-saffron/20',
  },
  rausch: {
    iconBg: 'bg-rausch/10',
    iconText: 'text-rausch',
    border: 'border-rausch/30',
    btn: 'bg-rausch text-white',
    topBorder: 'border-t-rausch/20',
  },
  forest: {
    iconBg: 'bg-forest/10',
    iconText: 'text-forest',
    border: 'border-forest/30',
    btn: 'bg-forest text-white',
    topBorder: 'border-t-forest/20',
  },
};
---

<Layout title={t('hospedajePage.metaTitle')} description={t('hospedajePage.metaDescription')}>

  <main class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 pt-6 md:pt-8 pb-12">
    <!-- Page Banner -->
    <PageBanner
      title={t('hospedajePage.banner.title')}
      subtitle={t('hospedajePage.banner.subtitle')}
      badge={t('hospedajePage.banner.badge')}
      image="/api/images/1785281965958-banner-habitaciones.webp"
      imageAlt={t('hospedajePage.banner.imageAlt')}
      breadcrumb={[
        { label: t('hospedajePage.breadcrumb.home'), url: l('/') },
        { label: t('hospedajePage.breadcrumb.hospedaje'), url: l('/hospedaje') },
      ]}
    />

    <!-- CTA row -->
    <div class="flex flex-wrap justify-center gap-4 mt-8 mb-20">
      <a href="#habitaciones" class="bg-rausch text-white px-8 py-4 rounded-2xl font-bold text-lg hover:bg-rausch-dark hover:scale-105 transition-all duration-300 shadow-lg inline-flex items-center gap-2">
        {t('hospedajePage.cta.rooms')}
        <ChevronRight size={20} />
      </a>
      <a href="#faq" class="border-2 border-near-black px-8 py-4 rounded-2xl font-bold text-lg hover:bg-gray-50 transition-colors">
        {t('hospedajePage.cta.info')}
      </a>
    </div>

    <!-- Room Cards Grid -->
    <section id="habitaciones" class="py-20 md:py-28">
      <div class="mb-14 text-center max-w-2xl mx-auto">
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold font-display tracking-tightest mb-4">
          {t('hospedajePage.rooms.heading')}
        </h2>
        <p class="text-secondary-gray text-lg leading-relaxed">
          {t('hospedajePage.rooms.subtitle')}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {rooms.map((room) => {
          const styles = accentStyles[room.accent] ?? accentStyles.forest;
          return (
            <a href={l(`/hospedaje/${room.slug}`)} class="bg-lotus-white rounded-[24px] shadow-airbnb overflow-hidden flex flex-col h-full group hover:scale-[1.02] transition-all duration-600 cursor-pointer no-underline text-inherit">
              <div class="aspect-4/3 overflow-hidden relative">
                <img
                  src={room.image}
                  alt={room.name}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                  referrerpolicy="no-referrer"
                  loading="lazy"
                />
                <div
                  class="absolute top-4 left-4 flex items-center gap-2 bg-lotus-white/90 backdrop-blur-sm px-3 py-1.5 rounded-full text-xs font-bold shadow-sm"
                  aria-label={t('hospedajePage.rooms.capacityLabel', { n: room.capacity })}
                >
                  <Users size={14} />
                  <span>{room.capacity}</span>
                </div>
              </div>

              <div class="p-6 flex flex-col grow space-y-4">
                <div class="flex items-center gap-3">
                  <div class={`w-10 h-10 ${styles.iconBg} rounded-xl flex items-center justify-center ${styles.iconText} border ${styles.border}`}>
                    <Home size={20} />
                  </div>
                  <h3 class="text-xl font-bold font-display tracking-tightest">{room.name}</h3>
                </div>

                <p class="text-secondary-gray text-sm leading-relaxed grow">{room.description}</p>

                <div class={`border-t pt-4 space-y-2 ${styles.topBorder}`}>
                  <ul class="space-y-1.5">
                    {room.features.map((feat) => (
                      <li class="flex items-center gap-2 text-sm text-secondary-gray">
                        <CheckCircle2 size={14} className="text-forest shrink-0" />
                        <span>{feat}</span>
                      </li>
                    ))}
                  </ul>

                  <div class="pt-3 flex items-end justify-between">
                    <div>
                      <p class="text-xs text-secondary-gray">{t('hospedajePage.rooms.from')}</p>
                      <p class="text-2xl font-bold tracking-tightest">
                        {room.priceLabel}
                        <span class="text-sm font-normal text-secondary-gray">{t('hospedajePage.rooms.perNight')}</span>
                      </p>
                    </div>
                    <span
                      class={`${styles.btn} px-5 py-2.5 rounded-xl font-bold text-sm hover:brightness-90 transition-all duration-300 shadow-sm inline-flex items-center gap-1.5`}
                    >
                      {t('hospedajePage.rooms.viewMore')}
                      <ChevronRight size={14} />
                    </span>
                  </div>
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </section>

    <!-- Amenities Section -->
    <section class="py-20 md:py-28">
      <div class="bg-light-surface rounded-2xl p-8 md:p-16 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div class="space-y-8">
          <div>
            <div class="inline-flex items-center gap-2 bg-forest/10 text-forest px-4 py-2 rounded-full text-sm font-bold mb-6">
              <Sparkles size={16} />
              <span>{t('hospedajePage.amenities.badge')}</span>
            </div>
            <h2 class="text-3xl md:text-4xl font-bold font-display tracking-tightest mb-4">
              {t('hospedajePage.amenities.heading')}
            </h2>
            <p class="text-secondary-gray text-lg">
              {t('hospedajePage.amenities.subtitle')}
            </p>
          </div>

          <ul class="space-y-4">
            {amenities.map((item) => (
              <li class="flex items-center gap-4 text-lg font-medium">
                <CheckCircle2 className="text-forest shrink-0" size={24} />
                <span>{item}</span>
              </li>
            ))}
          </ul>

          <div class="flex items-center gap-4 p-6 bg-lotus-white rounded-2xl border border-sacred-sand shadow-airbnb">
            <Info className="text-rausch shrink-0" size={32} />
            <p class="text-sm text-secondary-gray">
              {t('hospedajePage.amenities.note')}
            </p>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <img
            src="/api/images/1785288086939-amenities-yoga.webp"
            class="rounded-3xl shadow-md aspect-3/4 object-cover"
            alt={t('hospedajePage.amenities.yogaImageAlt')}
            referrerpolicy="no-referrer"
            loading="lazy"
          />
          <img
            src="/api/images/1785288152134-amenities-food.webp"
            class="rounded-3xl shadow-md mt-8 aspect-3/4 object-cover"
            alt={t('hospedajePage.amenities.foodImageAlt')}
            referrerpolicy="no-referrer"
            loading="lazy"
          />
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section id="faq" class="max-w-3xl mx-auto pb-20 space-y-12">
      <div class="text-center">
        <div class="inline-flex items-center gap-2 bg-rausch/10 text-rausch px-4 py-2 rounded-full text-sm font-bold mb-6">
          <Info size={16} />
          <span>{t('hospedajePage.faq.badge')}</span>
        </div>
        <h2 class="text-3xl md:text-4xl font-bold font-display tracking-tightest mb-4">
          {t('hospedajePage.faq.heading')}
        </h2>
        <p class="text-secondary-gray text-lg">
          {t('hospedajePage.faq.subtitle')}
        </p>
      </div>

      <div class="space-y-6">
        {faqs.map((faq) => (
          <div class="border-b border-sacred-sand pb-6">
            <h4 class="font-bold text-lg mb-2 font-display tracking-tightest">{faq.question}</h4>
            <p class="text-secondary-gray leading-relaxed">{faq.answer}</p>
          </div>
        ))}
      </div>

      <div class="text-center pt-8">
        <p class="text-secondary-gray mb-4">{t('hospedajePage.faq.otherQuestion')}</p>
        <a
          href={l('/contacto')}
          class="inline-flex items-center gap-2 border-2 border-near-black px-8 py-4 rounded-2xl font-bold text-lg hover:bg-gray-50 transition-colors"
        >
          {t('hospedajePage.faq.cta')}
          <ChevronRight size={20} />
        </a>
      </div>
    </section>
  </main>

</Layout>

<style>
  h1, h2, h3, h4 {
    letter-spacing: -0.02em;
  }
</style>
