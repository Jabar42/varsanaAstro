---
import { getLocale, useTranslations, localizePath, formatCOP } from '@/src/i18n/utils';
import { es as dict } from '@/src/i18n/dictionaries/hospedajePage';

import Layout from '@/src/layouts/Layout.astro';
import PageBanner from '@/src/components/PageBanner.astro';
import { getCollection } from 'astro:content';

const locale = getLocale(Astro);
const t = useTranslations(locale);
const l = (path: string) => localizePath(locale, path);

import {
  Home,
  CheckCircle2,
  Info,
  Sparkles,
  ChevronRight,
  Users,
} from 'lucide-react';

/** "$140,000" → 140000 (null si no es numérico). */
function parsePrice(raw: string): number | null {
  const n = Number(raw.replace(/[^\d]/g, ''));
  return Number.isFinite(n) && n > 0 ? n : null;
}

const allHospedajes = await getCollection('hospedaje');
const rooms = allHospedajes
  .sort((a, b) => a.data.orden - b.data.orden)
  .map((h) => {
    const price = parsePrice(h.data.valor_por_persona_noche);
    return {
      slug: h.id,
      name: h.data.nombre,
      description: h.data.descripcion,
      image: h.data.fotos?.[0] ?? 'https://picsum.photos/seed/default/800/600',
      capacity: h.data.num_huespedes,
      features: h.data.servicios_incluidos?.slice(0, 3) ?? [],
      priceLabel: price !== null ? formatCOP(price, locale) : h.data.valor_por_persona_noche,
      icon: Home,
      accent: 'forest' as const,
    };
  });

// Las listas se iteran por índice para que t() resuelva cada cadena en el idioma actual.
const amenities = dict.amenities.items.map((_, i) => t(`hospedajePage.amenities.items.${i}`));
const faqs = dict.faq.items.map((_, i) => ({
  question: t(`hospedajePage.faq.items.${i}.question`),
  answer: t(`hospedajePage.faq.items.${i}.answer`),
}));

const accentStyles: Record<string, { iconBg: string; iconText: string; border: string; btn: string; topBorder: string }> = {
  saffron: {
    iconBg: 'bg-saffron/10',
    iconText: 'text-saffron-deep',
    border: 'border-saffron/30',
    btn: 'bg-saffron text-white',
    topBorder: 'border-t-saffron/20',
  },
  rausch: {
    iconBg: 'bg-forest/10',
    iconText: 'text-forest-deep',
    border: 'border-forest/30',
    btn: 'bg-forest-dark text-white',
    topBorder: 'border-t-forest/20',
  },
  forest: {
    iconBg: 'bg-forest/10',
    iconText: 'text-forest-deep',
    border: 'border-forest/30',
    btn: 'bg-forest-dark text-white',
    topBorder: 'border-t-forest/20',
  },
};
---

<Layout title={t('hospedajePage.metaTitle')} description={t('hospedajePage.metaDescription')}>

  <main class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 pt-6 md:pt-8 pb-12">
    <!-- Page Banner -->
    <PageBanner
      title={t('hospedajePage.banner.title')}
      subtitle={t('hospedajePage.banner.subtitle')}
      badge={t('hospedajePage.banner.badge')}
      image="/api/images/1785281965958-banner-habitaciones.webp"
      imageAlt={t('hospedajePage.banner.imageAlt')}
      breadcrumb={[
        { label: t('hospedajePage.breadcrumb.home'), url: l('/') },
        { label: t('hospedajePage.breadcrumb.hospedaje'), url: l('/hospedaje') },
      ]}
    />

    <!-- CTA row -->
    <div class="flex flex-wrap gap-4 mt-8">
      <a href="#habitaciones" class="btn btn-lg btn-arrow">
        {t('hospedajePage.cta.rooms')}
      </a>
      <a href="#faq" class="btn btn-lg btn-outline">
        {t('hospedajePage.cta.info')}
      </a>
    </div>

    <!-- Room Cards Grid -->
    <section id="habitaciones" class="py-20 md:py-28 scroll-mt-24">
      <div class="grid lg:grid-cols-12 gap-y-6 gap-x-12 items-end mb-12 md:mb-16" data-reveal-group>
        <div class="lg:col-span-7">
          <span class="rule-saffron mb-8" data-reveal="draw" aria-hidden="true"></span>
          <h2 class="display-lg font-bold font-display text-near-black">
            {t('hospedajePage.rooms.heading')}
          </h2>
        </div>
        <p class="lg:col-span-5 lg:pb-2 text-lg md:text-xl text-secondary-gray leading-relaxed">
          {t('hospedajePage.rooms.subtitle')}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" data-reveal-group>
        {rooms.map((room) => {
          const styles = accentStyles[room.accent] ?? accentStyles.forest;
          return (
            <a href={l(`/hospedaje/${room.slug}`)} class="bg-lotus-white rounded-3xl ring-1 ring-near-black/5 overflow-hidden flex flex-col h-full group hover:shadow-airbnb transition-shadow duration-500 cursor-pointer no-underline text-inherit">
              <div class="aspect-4/3 overflow-hidden relative bg-sand-deep">
                <img
                  src={room.image}
                  alt={room.name}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                  referrerpolicy="no-referrer"
                  loading="lazy"
                />
                <div
                  class="absolute top-4 left-4 flex items-center gap-2 bg-lotus-white/90 backdrop-blur-sm px-3 py-1.5 rounded-full text-xs font-bold"
                  aria-label={t('hospedajePage.rooms.capacityLabel', { n: room.capacity })}
                >
                  <Users size={14} />
                  <span>{room.capacity}</span>
                </div>
              </div>

              <div class="p-6 md:p-7 flex flex-col grow gap-4">
                <h3 class="text-2xl font-bold font-display">{room.name}</h3>

                <p class="text-secondary-gray text-sm leading-relaxed grow">{room.description}</p>

                <div class={`border-t pt-4 space-y-2 ${styles.topBorder}`}>
                  <ul class="space-y-1.5">
                    {room.features.map((feat) => (
                      <li class="flex items-center gap-2 text-sm text-secondary-gray">
                        <CheckCircle2 size={14} className={`${styles.iconText} shrink-0`} />
                        <span>{feat}</span>
                      </li>
                    ))}
                  </ul>

                  <div class="pt-4 flex flex-wrap items-end justify-between gap-x-4 gap-y-3">
                    <div>
                      <p class="text-xs text-secondary-gray">{t('hospedajePage.rooms.from')}</p>
                      <p class="text-2xl font-bold font-display whitespace-nowrap">
                        {room.priceLabel}
                        <span class="text-sm font-normal font-sans text-secondary-gray">{t('hospedajePage.rooms.perNight')}</span>
                      </p>
                    </div>
                    <span class="btn btn-sm btn-arrow shrink-0">
                      {t('hospedajePage.rooms.viewMore')}
                    </span>
                  </div>
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </section>

    <!-- Amenities Section -->
    <section class="bleed on-dark py-20 md:py-28">
      <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 grid grid-cols-1 lg:grid-cols-12 gap-x-12 gap-y-14 items-center">
        <div class="lg:col-span-6 space-y-10" data-reveal-group>
          <div>
            <p class="eyebrow mb-5">{t('hospedajePage.amenities.badge')}</p>
            <h2 class="display-lg font-bold font-display mb-6">
              {t('hospedajePage.amenities.heading')}
            </h2>
            <p class="text-sacred-sand/75 text-lg md:text-xl leading-relaxed">
              {t('hospedajePage.amenities.subtitle')}
            </p>
          </div>

          <ul class="divide-y divide-sacred-sand/15 border-y border-sacred-sand/15">
            {amenities.map((item) => (
              <li class="flex items-center gap-4 py-4 text-lg font-medium">
                <CheckCircle2 className="text-saffron shrink-0" size={22} />
                <span>{item}</span>
              </li>
            ))}
          </ul>

          <div class="flex items-start gap-4">
            <Info className="text-saffron shrink-0 mt-0.5" size={22} />
            <p class="text-sm text-sacred-sand/75 leading-relaxed">
              {t('hospedajePage.amenities.note')}
            </p>
          </div>
        </div>

        <div class="lg:col-span-5 lg:col-start-8">
              <div class="relative pb-10 md:pb-14">
            <div class="arch parallax aspect-4/5 w-[88%] ml-auto bg-forest-night" data-reveal="mask">
              <img
                src="/api/images/1785288086939-amenities-yoga.webp"
                class="w-full h-full object-cover"
                alt={t('hospedajePage.amenities.yogaImageAlt')}
                referrerpolicy="no-referrer"
                loading="lazy"
              />
            </div>
            <img
              src="/api/images/1785288152134-amenities-food.webp"
              class="absolute bottom-0 left-0 w-[42%] aspect-3/4 object-cover rounded-3xl ring-8 ring-forest-night"
              alt={t('hospedajePage.amenities.foodImageAlt')}
              referrerpolicy="no-referrer"
              loading="lazy"
              data-reveal
            />
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section id="faq" class="py-20 md:py-28 scroll-mt-24 grid grid-cols-1 lg:grid-cols-12 gap-x-12 gap-y-12">
      <div class="lg:col-span-5">
        <div class="lg:sticky lg:top-32" data-reveal-group>
          <p class="eyebrow mb-5">{t('hospedajePage.faq.badge')}</p>
          <h2 class="display-md font-bold font-display mb-5">
            {t('hospedajePage.faq.heading')}
          </h2>
          <p class="text-secondary-gray text-lg leading-relaxed">
            {t('hospedajePage.faq.subtitle')}
          </p>
          <div class="hidden lg:block mt-10 pt-8 border-t border-near-black/10">
            <p class="text-secondary-gray mb-5">{t('hospedajePage.faq.otherQuestion')}</p>
            <a href={l('/contacto')} class="btn btn-outline btn-arrow">
              {t('hospedajePage.faq.cta')}
            </a>
          </div>
        </div>
      </div>

      <div class="lg:col-span-7">
        <div class="border-t border-near-black/10" data-reveal-group>
          {faqs.map((faq) => (
            <div class="border-b border-near-black/10 py-7">
              <h4 class="font-bold text-xl mb-3 font-display">{faq.question}</h4>
              <p class="text-secondary-gray leading-relaxed">{faq.answer}</p>
            </div>
          ))}
        </div>

        <div class="lg:hidden pt-10">
          <p class="text-secondary-gray mb-5">{t('hospedajePage.faq.otherQuestion')}</p>
          <a href={l('/contacto')} class="btn btn-outline btn-block btn-arrow">
            {t('hospedajePage.faq.cta')}
          </a>
        </div>
      </div>
    </section>
  </main>

</Layout>

