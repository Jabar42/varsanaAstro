---

import Layout from '@/src/layouts/Layout.astro';
import PageBanner from '@/src/components/PageBanner.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getCollection } from 'astro:content';

const locale = (Astro.locals as any)?.locale ?? Astro.currentLocale ?? 'es';
const l = (path: string) => getRelativeLocaleUrl(locale, path);

import {
  Home,
  CheckCircle2,
  Info,
  Sparkles,
  ChevronRight,
  Users,
} from 'lucide-react';

const allHospedajes = await getCollection('hospedaje');
const rooms = allHospedajes
  .sort((a, b) => a.data.orden - b.data.orden)
  .map((h) => ({
    slug: h.id,
    name: h.data.nombre,
    description: h.data.descripcion,
    image: h.data.fotos?.[0] ?? 'https://picsum.photos/seed/default/800/600',
    capacity: h.data.num_huespedes,
    features: h.data.servicios_incluidos?.slice(0, 3) ?? [],
    price: h.data.valor_por_persona_noche.replace('$', '').replace(',', ''),
    icon: Home,
    accent: 'forest' as const,
  }));

const amenities = [
  'Agua caliente con energía solar',
  'Alimentación vegetariana consciente (3 comidas)',
  'Clases diarias de yoga y meditación',
  'Senderos ecológicos señalizados',
  'Estacionamiento privado',
  'Wi-Fi en áreas comunes',
  'Ropa de cama y toallas orgánicas',
  'Productos de aseo biodegradables',
];

const faqs = [
  {
    question: '¿Cuál es el horario de llegada y salida?',
    answer: 'El check-in es a partir de las 3:00 p. m. y el check-out antes de las 1:00 p. m. No llegues fuera del horario de atención de lo contrario no podremos atenderte. Si necesitas flexibilidad, contáctanos y haremos lo posible por acomodarte.',
  },
  {
    question: '¿Se permiten mascotas para hospedaje?',
    answer: 'Por respeto a la fauna local y a la tranquilidad de nuestros huéspedes, no permitimos animales de compañía para hospedajes.',
  },
  {
    question: '¿La alimentación está incluida en la tarifa?',
    answer: 'Sí, todas nuestras tarifas incluyen tres comidas vegetarianas conscientes al día, preparadas con ingredientes de nuestra huerta orgánica.',
  },
  {
    question: '¿Cuál es la política de cancelación?',
    answer: 'No hacemos devoluciones de dinero por reservas de hospedaje u otros servicios. (NO SHOW). Te damos un plazo de 15 días para consumir el pago realizado en caso de la no asistencia que se contarán a partir del día en que tenías planeada tu llegada a la Eco Yoga Aldea el cual puedes usar en cualquier actividad realizada por nosotros mismos, en servicios como: Restaurante, Boutique, Terapias, Clases de Yoga online o presencial, Pasadías, Retiros o Eventos. La cancelación o cambio de la reserva se podrá realizar con una anticipación de 3 días antes de la fecha programada, en el caso de reservas individuales. Cuando se trate de reservas de grupos (reservas de más de 10 personas) la cancelación o modificación deberá realizarse con 15 días de anticipación a la fecha de ingreso, de lo contrario se tomará como si hubieses asistido.',
  },
  {
    question: '¿Cómo llegar a Varsana desde Bogotá?',
    answer: 'Estamos ubicados a 40 minutos de Bogotá, Kilómetro 28 vía a Girardot en el municipio de Granada, Cundinamarca. Frente al puente peatonal de Granada.',
  },
];

const accentStyles: Record<string, { iconBg: string; iconText: string; border: string; btn: string; topBorder: string }> = {
  saffron: {
    iconBg: 'bg-saffron/10',
    iconText: 'text-saffron',
    border: 'border-saffron/30',
    btn: 'bg-saffron text-white',
    topBorder: 'border-t-saffron/20',
  },
  rausch: {
    iconBg: 'bg-rausch/10',
    iconText: 'text-rausch',
    border: 'border-rausch/30',
    btn: 'bg-rausch text-white',
    topBorder: 'border-t-rausch/20',
  },
  forest: {
    iconBg: 'bg-forest/10',
    iconText: 'text-forest',
    border: 'border-forest/30',
    btn: 'bg-forest text-white',
    topBorder: 'border-t-forest/20',
  },
};
---

<Layout title="Hospedaje Ecológico | Varsana Eco Yoga Aldea">

  <main class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 pt-6 md:pt-8 pb-12">
    <!-- Page Banner -->
    <PageBanner
      title="Hospedaje Ecológico en Varsana"
      subtitle="Despierta entre montañas, respira aire puro y descansa en espacios diseñados para la paz interior. Cada habitación es un refugio donde la naturaleza y la espiritualidad se encuentran."
      badge="Eco-alojamiento consciente"
      breadcrumb={[
        { label: 'Inicio', url: '/' },
        { label: 'Hospedaje', url: '/hospedaje' },
      ]}
    />

    <!-- CTA row -->
    <div class="flex flex-wrap justify-center gap-4 mt-8 mb-20">
      <a href="#habitaciones" class="bg-rausch text-white px-8 py-4 rounded-2xl font-bold text-lg hover:bg-rausch-dark hover:scale-105 transition-all duration-300 shadow-lg inline-flex items-center gap-2">
        Ver habitaciones
        <ChevronRight size={20} />
      </a>
      <a href="#faq" class="border-2 border-near-black px-8 py-4 rounded-2xl font-bold text-lg hover:bg-gray-50 transition-colors">
        Más información
      </a>
    </div>

    <!-- Room Cards Grid -->
    <section id="habitaciones" class="py-20 md:py-28">
      <div class="mb-14 text-center max-w-2xl mx-auto">
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold font-display tracking-tightest mb-4">
          Nuestras Habitaciones
        </h2>
        <p class="text-secondary-gray text-lg leading-relaxed">
          Siete espacios únicos donde la arquitectura sostenible se funde con el paisaje de Cundinamarca. Cada uno tiene su propia personalidad.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {rooms.map((room) => {
          const styles = accentStyles[room.accent] ?? accentStyles.forest;
          return (
            <a href={l(`/hospedaje/${room.slug}`)} class="bg-lotus-white rounded-[24px] shadow-airbnb overflow-hidden flex flex-col h-full group hover:scale-[1.02] transition-all duration-600 cursor-pointer no-underline text-inherit">
              <div class="aspect-4/3 overflow-hidden relative">
                <img
                  src={room.image}
                  alt={room.name}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                  referrerpolicy="no-referrer"
                  loading="lazy"
                />
                <div class="absolute top-4 left-4 flex items-center gap-2 bg-lotus-white/90 backdrop-blur-sm px-3 py-1.5 rounded-full text-xs font-bold shadow-sm">
                  <Users size={14} />
                  <span>{room.capacity}</span>
                </div>
              </div>

              <div class="p-6 flex flex-col grow space-y-4">
                <div class="flex items-center gap-3">
                  <div class={`w-10 h-10 ${styles.iconBg} rounded-xl flex items-center justify-center ${styles.iconText} border ${styles.border}`}>
                    <Home size={20} />
                  </div>
                  <h3 class="text-xl font-bold font-display tracking-tightest">{room.name}</h3>
                </div>

                <p class="text-secondary-gray text-sm leading-relaxed grow">{room.description}</p>

                <div class={`border-t pt-4 space-y-2 ${styles.topBorder}`}>
                  <ul class="space-y-1.5">
                    {room.features.map((feat) => (
                      <li class="flex items-center gap-2 text-sm text-secondary-gray">
                        <CheckCircle2 size={14} class="text-forest shrink-0" />
                        <span>{feat}</span>
                      </li>
                    ))}
                  </ul>

                  <div class="pt-3 flex items-end justify-between">
                    <div>
                      <p class="text-xs text-secondary-gray">Desde</p>
                      <p class="text-2xl font-bold tracking-tightest">
                        ${room.price}
                        <span class="text-sm font-normal text-secondary-gray"> COP / noche</span>
                      </p>
                    </div>
                    <span
                      class={`${styles.btn} px-5 py-2.5 rounded-xl font-bold text-sm hover:brightness-90 transition-all duration-300 shadow-sm inline-flex items-center gap-1.5`}
                    >
                      Ver más
                      <ChevronRight size={14} />
                    </span>
                  </div>
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </section>

    <!-- Amenities Section -->
    <section class="py-20 md:py-28">
      <div class="bg-light-surface rounded-2xl p-8 md:p-16 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div class="space-y-8">
          <div>
            <div class="inline-flex items-center gap-2 bg-forest/10 text-forest px-4 py-2 rounded-full text-sm font-bold mb-6">
              <Sparkles size={16} />
              <span>Servicios incluidos</span>
            </div>
            <h2 class="text-3xl md:text-4xl font-bold font-display tracking-tightest mb-4">
              Todo lo que necesitas para una estancia plena
            </h2>
            <p class="text-secondary-gray text-lg">
              Cada detalle está pensado para tu comodidad, sin perder la esencia de la vida consciente y sostenible.
            </p>
          </div>

          <ul class="space-y-4">
            {amenities.map((item) => (
              <li class="flex items-center gap-4 text-lg font-medium">
                <CheckCircle2 class="text-forest shrink-0" size={24} />
                <span>{item}</span>
              </li>
            ))}
          </ul>

          <div class="flex items-center gap-4 p-6 bg-lotus-white rounded-2xl border border-sacred-sand shadow-airbnb">
            <Info class="text-rausch shrink-0" size={32} />
            <p class="text-sm text-secondary-gray">
              Todos nuestros espacios son libres de humo, alcohol y sustancias. Mantenemos un ambiente de respeto, silencio y espiritualidad.
            </p>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <img
            src="https://picsum.photos/seed/yoga-room/600/800"
            class="rounded-3xl shadow-md aspect-3/4 object-cover"
            alt="Sala de yoga en Varsana"
            referrerpolicy="no-referrer"
            loading="lazy"
          />
          <img
            src="https://picsum.photos/seed/huerta-food/600/800"
            class="rounded-3xl shadow-md mt-8 aspect-3/4 object-cover"
            alt="Alimentación vegetariana en Varsana"
            referrerpolicy="no-referrer"
            loading="lazy"
          />
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section id="faq" class="max-w-3xl mx-auto pb-20 space-y-12">
      <div class="text-center">
        <div class="inline-flex items-center gap-2 bg-rausch/10 text-rausch px-4 py-2 rounded-full text-sm font-bold mb-6">
          <Info size={16} />
          <span>Preguntas frecuentes</span>
        </div>
        <h2 class="text-3xl md:text-4xl font-bold font-display tracking-tightest mb-4">
          Información para tu visita
        </h2>
        <p class="text-secondary-gray text-lg">
          Resolvemos las dudas más comunes para que solo te preocupes por disfrutar.
        </p>
      </div>

      <div class="space-y-6">
        {faqs.map((faq) => (
          <div class="border-b border-sacred-sand pb-6">
            <h4 class="font-bold text-lg mb-2 font-display tracking-tightest">{faq.question}</h4>
            <p class="text-secondary-gray leading-relaxed">{faq.answer}</p>
          </div>
        ))}
      </div>

      <div class="text-center pt-8">
        <p class="text-secondary-gray mb-4">¿Tienes una pregunta diferente?</p>
        <a
          href={l('/contacto')}
          class="inline-flex items-center gap-2 border-2 border-near-black px-8 py-4 rounded-2xl font-bold text-lg hover:bg-gray-50 transition-colors"
        >
          Escríbenos
          <ChevronRight size={20} />
        </a>
      </div>
    </section>
  </main>

</Layout>

<style>
  h1, h2, h3, h4 {
    letter-spacing: -0.02em;
  }
</style>
