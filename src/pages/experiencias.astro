---
import { getLocale, useTranslations, localizePath, formatDate, formatCOP } from '@/src/i18n/utils';
import Layout from '@/src/layouts/Layout.astro';
import PageBanner from '@/src/components/PageBanner.astro';
import { getCollection } from 'astro:content';
import { Calendar, Users, Clock, ArrowRight } from 'lucide-react';
import { es as expEs, en as expEn } from '@/src/i18n/dictionaries/experienciasPage';

const locale = getLocale(Astro);
const t = useTranslations(locale);
const l = (path: string) => localizePath(locale, path);
const dict = locale === 'en' ? expEn : expEs;

// --- Hospedaje: primeras 3 habitaciones ---
const allHospedajes = await getCollection('hospedaje');
const hospedajes = allHospedajes
  .sort((a, b) => a.data.orden - b.data.orden)
  .slice(0, 3)
  .map((h) => ({
    slug: h.id,
    name: h.data.nombre,
    description: h.data.descripcion,
    image: h.data.fotos?.[0] ?? 'https://picsum.photos/seed/default/800/600',
    capacity: h.data.num_huespedes,
    price: h.data.valor_por_persona_noche,
  }));

// --- Eventos: próximos 3 ---
const allEvents = await getCollection('events');
const now = new Date();
const eventos = allEvents
  .filter((e) => new Date(e.data.event_start) >= now)
  .sort((a, b) => new Date(a.data.event_start).getTime() - new Date(b.data.event_start).getTime())
  .slice(0, 3)
  .map((e) => ({
    slug: e.id,
    title: e.data.title,
    image: e.data.image,
    date: e.data.event_start,
    price: e.data.prices?.[0]?.amount
      ? formatCOP(e.data.prices[0].amount, locale)
      : t('experienciasPage.consult'),
  }));

// --- Pasadías: primeros 3 ---
const allPasadias = await getCollection('pasadias');
const pasadias = allPasadias.slice(0, 3).map((p) => ({
  slug: p.id,
  title: p.data.title,
  description: p.data.description,
  image: p.data.image,
  duration: p.data.duration,
  price: p.data.prices?.[0]?.amount
    ? formatCOP(p.data.prices[0].amount, locale)
    : t('experienciasPage.consult'),
}));

// --- Experiencias fijas y otras secciones (desde el diccionario) ---
const experienciasFijas = dict.experienciasFijas;
const otrasSecciones = dict.otrasSecciones.map((sec) => ({ ...sec, href: l(sec.path) }));
---

<Layout title={t('experienciasPage.metaTitle')} description={t('experienciasPage.metaDescription')}>
  <main>
    <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 pt-6 md:pt-8">
      <PageBanner
        title={t('experienciasPage.bannerTitle')}
        subtitle={t('experienciasPage.bannerSubtitle')}
        breadcrumb={[
          { label: t('experienciasPage.breadcrumbHome'), url: l('/') },
          { label: t('experienciasPage.breadcrumbExperiencias'), url: l('/experiencias') },
        ]}
      />
    </div>

    <!-- ========== HOSPEDAJE ========== -->
    <section class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 py-16 md:py-20">
      <div class="flex items-end justify-between gap-8 mb-10 md:mb-14" data-reveal-group>
        <div>
          <p class="eyebrow mb-4">{t('experienciasPage.hospedaje.badge')}</p>
          <h2 class="display-md font-bold font-display text-near-black">{t('experienciasPage.hospedaje.heading')}</h2>
        </div>
        <a href={l('/hospedaje')} class="hidden sm:inline-flex items-center gap-1 shrink-0 text-rausch font-semibold underline underline-offset-4 decoration-rausch/30 hover:decoration-rausch transition-colors duration-300">
          {t('experienciasPage.viewAll')} <ArrowRight size={16} />
        </a>
      </div>

      <!-- La primera habitación abre como pieza grande; las demás, en fila -->
      <div class="grid grid-cols-1 lg:grid-cols-12 lg:auto-rows-fr gap-6" data-reveal-group>
        {hospedajes.map((h, i) => (
          <a
            href={l(`/hospedaje/${h.slug}`)}
            class:list={[
              'group flex flex-col bg-lotus-white rounded-3xl ring-1 ring-near-black/5 overflow-hidden hover:shadow-airbnb transition-shadow duration-300 no-underline text-inherit',
              i === 0 ? 'lg:col-span-7 lg:row-span-2' : 'lg:col-span-5 sm:flex-row',
            ]}
          >
            <div class:list={['overflow-hidden shrink-0', i === 0 ? 'aspect-4/3 lg:aspect-auto lg:flex-1 lg:min-h-80' : 'aspect-4/3 sm:aspect-auto sm:w-2/5']}>
              <img src={h.image} alt={h.name} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" loading="lazy" referrerpolicy="no-referrer" />
            </div>
            <div class:list={['flex flex-col justify-center gap-3', i === 0 ? 'p-6 md:p-8' : 'p-6']}>
              <div class="flex items-center gap-2 text-sm text-secondary-gray">
                <Users size={14} /> <span>{h.capacity}</span>
              </div>
              <h3 class:list={['font-bold font-display', i === 0 ? 'text-2xl md:text-3xl' : 'text-xl']}>{h.name}</h3>
              <p class="text-sm text-secondary-gray leading-relaxed line-clamp-2">{h.description}</p>
              <p class="text-xl font-bold font-display">{h.price} <span class="text-sm font-normal font-sans text-secondary-gray">{t('experienciasPage.hospedaje.perNight')}</span></p>
            </div>
          </a>
        ))}
      </div>
      <div class="mt-8 sm:hidden">
        <a href={l('/hospedaje')} class="btn btn-outline btn-block">
          {t('experienciasPage.viewAll')}
        </a>
      </div>
    </section>

    <!-- ========== EVENTOS ========== -->
    <section class="bg-sand-deep py-16 md:py-20">
      <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20">
      <div class="flex items-end justify-between gap-8 mb-10 md:mb-14" data-reveal-group>
        <div>
          <p class="eyebrow mb-4">{t('experienciasPage.eventos.badge')}</p>
          <h2 class="display-md font-bold font-display text-near-black">{t('experienciasPage.eventos.heading')}</h2>
        </div>
        <a href={l('/events')} class="hidden sm:inline-flex items-center gap-1 shrink-0 text-rausch font-semibold underline underline-offset-4 decoration-rausch/30 hover:decoration-rausch transition-colors duration-300">
          {t('experienciasPage.viewAll')} <ArrowRight size={16} />
        </a>
      </div>

      {eventos.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6" data-reveal-group>
          {eventos.map((e) => (
            <a href={l(`/events/${e.slug}`)} class="group flex flex-col bg-lotus-white rounded-3xl ring-1 ring-near-black/5 overflow-hidden hover:shadow-airbnb transition-shadow duration-300 no-underline text-inherit">
              <div class="aspect-video overflow-hidden">
                <img src={e.image} alt={e.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" loading="lazy" referrerpolicy="no-referrer" />
              </div>
              <div class="p-6 flex flex-col gap-3 flex-1">
                <div class="flex items-center gap-2 text-sm text-secondary-gray">
                  <Calendar size={14} /> <span>{formatDate(e.date, locale)}</span>
                </div>
                <h3 class="text-xl font-bold font-display">{e.title}</h3>
                <p class="mt-auto pt-2 text-xl font-bold font-display">{e.price}</p>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div class="bg-lotus-white rounded-3xl ring-1 ring-near-black/5 p-10 md:p-14 flex flex-col md:flex-row md:items-center md:justify-between gap-6" data-reveal>
          <p class="text-near-black font-display text-xl md:text-2xl">{t('experienciasPage.eventos.empty')}</p>
          <a href={l('/contacto')} class="btn btn-arrow shrink-0 self-start md:self-auto">
            {t('experienciasPage.eventos.emptyCta')}
          </a>
        </div>
      )}
      <div class="mt-8 sm:hidden">
        <a href={l('/events')} class="btn btn-outline btn-block">
          {t('experienciasPage.viewAll')}
        </a>
      </div>
      </div>
    </section>

    <!-- ========== PASADÍAS ========== -->
    <section class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 py-16 md:py-20">
      <div class="flex items-end justify-between gap-8 mb-10 md:mb-14" data-reveal-group>
        <div>
          <p class="eyebrow mb-4">{t('experienciasPage.pasadias.badge')}</p>
          <h2 class="display-md font-bold font-display text-near-black">{t('experienciasPage.pasadias.heading')}</h2>
        </div>
        <a href={l('/pasadias')} class="hidden sm:inline-flex items-center gap-1 shrink-0 text-rausch font-semibold underline underline-offset-4 decoration-rausch/30 hover:decoration-rausch transition-colors duration-300">
          {t('experienciasPage.viewAll')} <ArrowRight size={16} />
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6" data-reveal-group>
        {pasadias.map((p) => (
          <a href={l(`/pasadias/${p.slug}`)} class="group flex flex-col bg-lotus-white rounded-3xl ring-1 ring-near-black/5 overflow-hidden hover:shadow-airbnb transition-shadow duration-300 no-underline text-inherit">
            <div class="aspect-video overflow-hidden">
              <img src={p.image} alt={p.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" loading="lazy" referrerpolicy="no-referrer" />
            </div>
            <div class="p-6 flex flex-col gap-3 flex-1">
              <div class="flex items-center gap-2 text-sm text-secondary-gray">
                <Clock size={14} /> <span>{p.duration}</span>
              </div>
              <h3 class="text-xl font-bold font-display">{p.title}</h3>
              <p class="text-sm text-secondary-gray leading-relaxed line-clamp-2">{p.description}</p>
              <p class="mt-auto pt-2 text-xl font-bold font-display">{p.price}</p>
            </div>
          </a>
        ))}
      </div>
      <div class="mt-8 sm:hidden">
        <a href={l('/pasadias')} class="btn btn-outline btn-block">
          {t('experienciasPage.viewAll')}
        </a>
      </div>
    </section>

    <!-- ========== EXPERIENCIAS FIJAS ========== -->
    <section class="on-dark dome-top py-16 md:py-20">
      <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20">
      <div class="flex items-end justify-between gap-8 mb-10 md:mb-14" data-reveal-group>
        <div>
          <p class="eyebrow mb-4">{t('experienciasPage.fijas.badge')}</p>
          <h2 class="display-md font-bold font-display text-white">{t('experienciasPage.fijas.heading')}</h2>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 border-t border-sacred-sand/15 lg:border-t-0" data-reveal-group>
        {experienciasFijas.map((exp) => (
          <a href={l(`/experiencias/${exp.slug}`)} class="fija group flex flex-col gap-4 py-8 lg:px-8 border-b border-sacred-sand/15 lg:border-b-0 lg:border-l no-underline text-inherit">
            <div class="w-14 h-14 rounded-2xl bg-saffron/10 flex items-center justify-center text-2xl">{exp.icon}</div>
            <h3 class="font-bold font-display text-xl text-white group-hover:text-saffron transition-colors duration-300">{exp.titulo}</h3>
            <p class="text-sm text-sacred-sand/75 leading-relaxed">{exp.descripcion}</p>
            <span class="btn-arrow inline-flex mt-auto pt-2 text-saffron" aria-hidden="true"></span>
          </a>
        ))}
      </div>
      </div>
    </section>

    <!-- ========== OTRAS SECCIONES ========== -->
    <section class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 pt-20 md:pt-28 pb-4 md:pb-8">
      <div class="flex items-end justify-between gap-8 mb-10 md:mb-14" data-reveal-group>
        <div>
          <p class="eyebrow mb-4">{t('experienciasPage.otras.badge')}</p>
          <h2 class="display-md font-bold font-display text-near-black">{t('experienciasPage.otras.heading')}</h2>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6" data-reveal-group>
        {otrasSecciones.map((sec) => (
          <a href={sec.href} class="group flex items-center lg:items-start lg:flex-col gap-4 p-6 bg-lotus-white rounded-3xl ring-1 ring-near-black/5 hover:shadow-airbnb transition-shadow duration-300 no-underline text-inherit">
            <div class="w-12 h-12 rounded-xl bg-forest/10 flex items-center justify-center text-xl shrink-0">{sec.icon}</div>
            <div class="min-w-0">
              <h3 class="font-bold font-display text-lg group-hover:text-forest-deep transition-colors duration-300">{sec.titulo}</h3>
              <p class="mt-1 text-sm text-secondary-gray leading-relaxed line-clamp-2">{sec.descripcion}</p>
            </div>
          </a>
        ))}
      </div>
    </section>
  </main>
</Layout>
