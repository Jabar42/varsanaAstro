---
import Layout from '@/src/layouts/Layout.astro';
import PageBanner from '@/src/components/PageBanner.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';

const locale = (Astro.locals as any)?.locale ?? Astro.currentLocale ?? 'es';
const l = (path: string) => getRelativeLocaleUrl(locale, path);

const cards = [
  {
    titulo: 'Temazcal',
    descripcion: 'Ceremonia ancestral de purificación con cantos, tambores y vapor de hierbas medicinales.',
    href: l('/experiencias/temazcal'),
    icon: '🔥',
    color: 'saffron',
  },
  {
    titulo: 'Yoga',
    descripcion: 'Clases diarias para todos los niveles en medio de la naturaleza del Sumapaz.',
    href: l('/experiencias/yoga'),
    icon: '🧘',
    color: 'rausch',
  },
  {
    titulo: 'Alimentación Consciente',
    descripcion: 'Comida vegetariana preparada con ingredientes frescos de nuestra huerta orgánica.',
    href: l('/experiencias/alimentacion'),
    icon: '🥗',
    color: 'forest',
  },
  {
    titulo: 'Huerta Orgánica',
    descripcion: 'Aprende sobre permacultura y cultivo sostenible en nuestra huerta ecológica.',
    href: l('/huerta'),
    icon: '🌱',
    color: 'forest',
  },
  {
    titulo: 'Cuevas de Meditación',
    descripcion: 'Espacios subterráneos para la introspección profunda y el silencio interior.',
    href: l('/experiencias/cuevas'),
    icon: '🕯️',
    color: 'rausch',
  },
  {
    titulo: 'Hospedaje',
    descripcion: 'Seis espacios únicos donde la arquitectura sostenible se funde con el paisaje.',
    href: l('/hospedaje'),
    icon: '🏡',
    color: 'saffron',
  },
  {
    titulo: 'Eventos y Retiros',
    descripcion: 'Calendario de retiros, ceremonias y encuentros para el crecimiento interior.',
    href: l('/events'),
    icon: '📅',
    color: 'rausch',
  },
  {
    titulo: 'Pasadías',
    descripcion: 'Experiencias de un día: relajación, detox, constelaciones y más.',
    href: l('/pasadias'),
    icon: '☀️',
    color: 'saffron',
  },
  {
    titulo: 'Voluntariado',
    descripcion: 'Vive la ecoaldea como voluntario y contribuye con tus habilidades.',
    href: l('/voluntariado'),
    icon: '🤝',
    color: 'forest',
  },
  {
    titulo: 'Práctica Espiritual',
    descripcion: 'Los cuatro principios esenciales que guían la vida en comunidad.',
    href: l('/practica-espiritual'),
    icon: '🙏',
    color: 'rausch',
  },
  {
    titulo: 'Restaurante Campestre',
    descripcion: 'Cocina vegetariana consciente abierta a visitantes, con productos de la huerta.',
    href: l('/restaurante-campestre'),
    icon: '🍽️',
    color: 'forest',
  },
  {
    titulo: 'Parador El Elefante',
    descripcion: 'Tienda de productos artesanales, recuerdos y especialidades de la región.',
    href: l('/parador-el-elefante'),
    icon: '🛍️',
    color: 'saffron',
  },
];

const colorMap: Record<string, { bg: string; text: string; border: string }> = {
  saffron: { bg: 'bg-saffron/10', text: 'text-saffron', border: 'border-saffron/30' },
  rausch: { bg: 'bg-rausch/10', text: 'text-rausch', border: 'border-rausch/30' },
  forest: { bg: 'bg-forest/10', text: 'text-forest', border: 'border-forest/30' },
};
---

<Layout title="Experiencias | Varsana Eco Yoga Aldea">
  <main class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 pt-6 md:pt-8 pb-12">
    <PageBanner
      title="Experiencias en Varsana"
      subtitle="Descubre todas las formas de vivir, compartir y transformarte en nuestra ecoaldea. Desde ceremonias ancestrales hasta retiros de silencio, cada experiencia es una invitación a reconectar."
      breadcrumb={[
        { label: 'Inicio', url: '/' },
        { label: 'Experiencias', url: l('/experiencias') },
      ]}
    />

    <section class="py-16 md:py-24">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {cards.map((card) => {
          const c = colorMap[card.color] ?? colorMap.forest;
          return (
            <a
              href={card.href}
              class="bg-lotus-white rounded-[24px] p-6 shadow-airbnb flex flex-col gap-4 group hover:scale-[1.02] transition-all duration-300 cursor-pointer no-underline text-inherit border border-transparent hover:border-sacred-sand"
            >
              <div class={`w-12 h-12 ${c.bg} ${c.border} border rounded-2xl flex items-center justify-center text-2xl`}>
                {card.icon}
              </div>
              <div class="space-y-2">
                <h3 class="text-lg font-bold font-display tracking-tightest group-hover:text-rausch transition-colors">
                  {card.titulo}
                </h3>
                <p class="text-secondary-gray text-sm leading-relaxed">{card.descripcion}</p>
              </div>
              <div class={`mt-auto pt-3 border-t ${c.border}`}>
                <span class={`text-sm font-bold ${c.text} inline-flex items-center gap-1`}>
                  Explorar →
                </span>
              </div>
            </a>
          );
        })}
      </div>
    </section>
  </main>
</Layout>

<style>
  h1, h2, h3 {
    letter-spacing: -0.02em;
  }
</style>
