---
import { getLocale, useTranslations, localizePath } from '@/src/i18n/utils';
import { es as dict } from '@/src/i18n/dictionaries/alimentacionPage';

import Layout from '@/src/layouts/Layout.astro';
import PageBanner from '@/src/components/PageBanner.astro';

const locale = getLocale(Astro);
const t = useTranslations(locale);
const l = (path: string) => localizePath(locale, path);

import {
  Sprout,
  Leaf,
  Heart,
  Sun,
  Moon,
  Flower2,
  Coffee,
  ChefHat,
  Sparkles,
  ChevronRight,
} from 'lucide-react';

type Accent = 'forest' | 'saffron' | 'rausch';

const philosophy: { key: string; icon: typeof Sprout; accent: Accent }[] = [
  { key: 'huerta', icon: Sprout, accent: 'forest' },
  { key: 'vegetariana', icon: Leaf, accent: 'saffron' },
  { key: 'nutricion', icon: Heart, accent: 'rausch' },
];

const philosophyItems = philosophy.map((p) => ({
  ...p,
  title: t(`alimentacionPage.philosophy.items.${p.key}.title`),
  description: t(`alimentacionPage.philosophy.items.${p.key}.description`),
}));

const meals: { key: string; icon: typeof Sun; accent: Accent }[] = [
  { key: 'desayuno', icon: Sun, accent: 'saffron' },
  { key: 'almuerzo', icon: Flower2, accent: 'forest' },
  { key: 'cena', icon: Moon, accent: 'rausch' },
  { key: 'bebidas', icon: Coffee, accent: 'saffron' },
];

const mealItems = meals.map((m) => ({
  ...m,
  name: t(`alimentacionPage.meals.items.${m.key}.name`),
  time: t(`alimentacionPage.meals.items.${m.key}.time`),
  description: t(`alimentacionPage.meals.items.${m.key}.description`),
}));

const principles: { key: string; icon: typeof Sprout }[] = [
  { key: 'organicos', icon: Sprout },
  { key: 'sinProcesados', icon: ChefHat },
  { key: 'sazon', icon: Sparkles },
];

const principleItems = principles.map((p) => ({
  ...p,
  title: t(`alimentacionPage.principles.items.${p.key}.title`),
  description: t(`alimentacionPage.principles.items.${p.key}.description`),
}));

// Las categorías de la huerta se iteran por índice para que t() resuelva cada cadena.
const huertaCategories = dict.huerta.categories.map((_, i) => ({
  title: t(`alimentacionPage.huerta.categories.${i}.title`),
  items: t(`alimentacionPage.huerta.categories.${i}.items`),
}));

const accentStyles: Record<Accent, { iconBg: string; iconText: string; topBorder: string }> = {
  saffron: { iconBg: 'bg-saffron/10', iconText: 'text-saffron-deep', topBorder: 'border-t-saffron/20' },
  rausch: { iconBg: 'bg-forest/10', iconText: 'text-forest-deep', topBorder: 'border-t-forest/20' },
  forest: { iconBg: 'bg-forest/10', iconText: 'text-forest-deep', topBorder: 'border-t-forest/20' },
};
---

<Layout title={t('alimentacionPage.metaTitle')} description={t('alimentacionPage.metaDescription')}>

  <main class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 pt-6 md:pt-8 pb-12">
    <!-- Page Banner -->
    <PageBanner
      title={t('alimentacionPage.banner.title')}
      subtitle={t('alimentacionPage.banner.subtitle')}
      badge={t('alimentacionPage.banner.badge')}
      breadcrumb={[
        { label: t('alimentacionPage.breadcrumb.home'), url: l('/') },
        { label: t('alimentacionPage.breadcrumb.alimentacion'), url: l('/alimentacion') },
      ]}
    />

    <!-- CTA row -->
    <div class="flex flex-wrap gap-4 mt-8">
      <a href={l('/restaurante-campestre')} class="btn btn-lg btn-arrow">
        {t('alimentacionPage.cta.restaurante')}
      </a>
      <a href={l('/parador-el-elefante')} class="btn btn-lg btn-outline">
        {t('alimentacionPage.cta.parador')}
      </a>
    </div>

    <!-- Philosophy Cards -->
    <section id="filosofia" class="py-16 md:py-20 scroll-mt-24">
      <div class="grid lg:grid-cols-12 gap-y-6 gap-x-12 items-end mb-12 md:mb-16" data-reveal-group>
        <div class="lg:col-span-7">
          <span class="rule-saffron mb-8" data-reveal="draw" aria-hidden="true"></span>
          <h2 class="display-lg font-bold font-display text-near-black">
            {t('alimentacionPage.philosophy.heading')}
          </h2>
        </div>
        <p class="lg:col-span-5 lg:pb-2 text-lg md:text-xl text-secondary-gray leading-relaxed">
          {t('alimentacionPage.philosophy.subtitle')}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8" data-reveal-group>
        {philosophyItems.map((item) => {
          const s = accentStyles[item.accent];
          return (
            <div class="bg-lotus-white rounded-3xl ring-1 ring-near-black/5 p-8 md:p-10 flex flex-col gap-5">
              <div class={`w-14 h-14 ${s.iconBg} rounded-2xl flex items-center justify-center ${s.iconText}`}>
                <item.icon size={28} />
              </div>
              <h3 class="text-2xl font-bold font-display mt-4">{item.title}</h3>
              <p class="text-secondary-gray leading-relaxed">{item.description}</p>
            </div>
          );
        })}
      </div>
    </section>

    <!-- La Huerta -->
    <section id="huerta" class="bleed bg-sand-deep py-16 md:py-20 scroll-mt-24">
      <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 grid grid-cols-1 lg:grid-cols-12 gap-x-12 gap-y-14 items-center">
        <div class="lg:col-span-5 order-last lg:order-none">
          <div class="relative pb-10 md:pb-14">
            <div class="arch parallax aspect-4/5 w-[88%] mr-auto bg-forest-night" data-reveal="mask">
              <img
                src="https://picsum.photos/seed/huerta-veggies/600/800"
                class="w-full h-full object-cover"
                alt={t('alimentacionPage.huerta.veggiesImageAlt')}
                referrerpolicy="no-referrer"
                loading="lazy"
              />
            </div>
            <img
              src="https://picsum.photos/seed/huerta-harvest/600/800"
              class="absolute bottom-0 right-0 w-[42%] aspect-3/4 object-cover rounded-3xl ring-8 ring-sand-deep"
              alt={t('alimentacionPage.huerta.harvestImageAlt')}
              referrerpolicy="no-referrer"
              loading="lazy"
              data-reveal
            />
          </div>
        </div>

        <div class="lg:col-span-6 lg:col-start-7 space-y-10" data-reveal-group>
          <div>
            <p class="eyebrow mb-5">{t('alimentacionPage.huerta.badge')}</p>
            <h2 class="display-lg font-bold font-display mb-6">
              {t('alimentacionPage.huerta.heading')}
            </h2>
            <p class="text-secondary-gray text-lg md:text-xl leading-relaxed">
              {t('alimentacionPage.huerta.text')}
            </p>
          </div>

          <div class="divide-y divide-near-black/10 border-y border-near-black/10">
            {huertaCategories.map((cat) => (
              <div class="py-5 grid sm:grid-cols-3 gap-x-6 gap-y-1">
                <h3 class="font-bold font-display text-lg text-forest-deep">{cat.title}</h3>
                <p class="sm:col-span-2 text-secondary-gray leading-relaxed">{cat.items}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Qué esperar (meals) -->
    <section class="py-16 md:py-20 grid grid-cols-1 lg:grid-cols-12 gap-x-12 gap-y-12">
      <div class="lg:col-span-5">
        <div class="lg:sticky lg:top-32" data-reveal-group>
          <span class="rule-saffron mb-8" data-reveal="draw" aria-hidden="true"></span>
          <h2 class="display-lg font-bold font-display mb-6">
            {t('alimentacionPage.meals.heading')}
          </h2>
          <p class="text-secondary-gray text-lg md:text-xl leading-relaxed">
            {t('alimentacionPage.meals.subtitle')}
          </p>
        </div>
      </div>

      <div class="lg:col-span-7 border-t border-near-black/10" data-reveal-group>
        {mealItems.map((meal) => {
          const s = accentStyles[meal.accent];
          return (
            <div class="border-b border-near-black/10 py-7 flex gap-5 items-start">
              <div class={`w-12 h-12 ${s.iconBg} rounded-2xl flex items-center justify-center ${s.iconText} shrink-0`}>
                <meal.icon size={22} />
              </div>
              <div class="grow">
                <div class="flex items-baseline justify-between gap-3 flex-wrap mb-2">
                  <h3 class="text-xl md:text-2xl font-bold font-display">{meal.name}</h3>
                  <span class="eyebrow">{meal.time}</span>
                </div>
                <p class="text-secondary-gray leading-relaxed">{meal.description}</p>
              </div>
            </div>
          );
        })}
      </div>
    </section>

    <!-- Principios -->
    <section class="pb-20 md:pb-28">
      <div class="mb-12 md:mb-16 max-w-3xl" data-reveal-group>
        <p class="eyebrow mb-5">{t('alimentacionPage.principles.badge')}</p>
        <h2 class="display-md font-bold font-display">
          {t('alimentacionPage.principles.heading')}
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-x-10 gap-y-10" data-reveal-group>
        {principleItems.map((p) => (
          <div class="border-t-2 border-forest-dark pt-6 space-y-3">
            <p.icon size={28} className="text-forest-deep" />
            <h3 class="text-xl font-bold font-display pt-2">{p.title}</h3>
            <p class="text-secondary-gray leading-relaxed">{p.description}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- CTA -->
    <section class="on-dark arch-wide px-6 pt-24 pb-14 md:px-16 md:pt-32 md:pb-20 text-center" data-reveal-group>
      <h2 class="display-lg font-bold font-display max-w-3xl mx-auto">
        {t('alimentacionPage.finalCta.heading')}
      </h2>
      <p class="text-sacred-sand/75 text-lg md:text-xl leading-relaxed max-w-2xl mx-auto mt-6">
        {t('alimentacionPage.finalCta.text')}
      </p>
      <div class="flex flex-wrap gap-4 justify-center mt-10">
        <a href={l('/events')} class="btn btn-lg btn-light btn-arrow">
          {t('alimentacionPage.finalCta.events')}
        </a>
        <a href={l('/voluntariado')} class="btn btn-lg btn-outline border-sacred-sand/40 text-sacred-sand">
          {t('alimentacionPage.finalCta.volunteer')}
        </a>
      </div>
    </section>
  </main>

</Layout>

