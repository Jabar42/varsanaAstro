---
import { getLocale, useTranslations, localizePath } from '@/src/i18n/utils';
import { es as dict } from '@/src/i18n/dictionaries/alimentacionPage';

import Layout from '@/src/layouts/Layout.astro';
import PageBanner from '@/src/components/PageBanner.astro';

const locale = getLocale(Astro);
const t = useTranslations(locale);
const l = (path: string) => localizePath(locale, path);

import {
  Sprout,
  Leaf,
  Heart,
  Sun,
  Moon,
  Flower2,
  Coffee,
  ChefHat,
  Sparkles,
  ChevronRight,
} from 'lucide-react';

type Accent = 'forest' | 'saffron' | 'rausch';

const philosophy: { key: string; icon: typeof Sprout; accent: Accent }[] = [
  { key: 'huerta', icon: Sprout, accent: 'forest' },
  { key: 'vegetariana', icon: Leaf, accent: 'saffron' },
  { key: 'nutricion', icon: Heart, accent: 'rausch' },
];

const philosophyItems = philosophy.map((p) => ({
  ...p,
  title: t(`alimentacionPage.philosophy.items.${p.key}.title`),
  description: t(`alimentacionPage.philosophy.items.${p.key}.description`),
}));

const meals: { key: string; icon: typeof Sun; accent: Accent }[] = [
  { key: 'desayuno', icon: Sun, accent: 'saffron' },
  { key: 'almuerzo', icon: Flower2, accent: 'forest' },
  { key: 'cena', icon: Moon, accent: 'rausch' },
  { key: 'bebidas', icon: Coffee, accent: 'saffron' },
];

const mealItems = meals.map((m) => ({
  ...m,
  name: t(`alimentacionPage.meals.items.${m.key}.name`),
  time: t(`alimentacionPage.meals.items.${m.key}.time`),
  description: t(`alimentacionPage.meals.items.${m.key}.description`),
}));

const principles: { key: string; icon: typeof Sprout }[] = [
  { key: 'organicos', icon: Sprout },
  { key: 'sinProcesados', icon: ChefHat },
  { key: 'sazon', icon: Sparkles },
];

const principleItems = principles.map((p) => ({
  ...p,
  title: t(`alimentacionPage.principles.items.${p.key}.title`),
  description: t(`alimentacionPage.principles.items.${p.key}.description`),
}));

// Las categorías de la huerta se iteran por índice para que t() resuelva cada cadena.
const huertaCategories = dict.huerta.categories.map((_, i) => ({
  title: t(`alimentacionPage.huerta.categories.${i}.title`),
  items: t(`alimentacionPage.huerta.categories.${i}.items`),
}));

const accentStyles: Record<Accent, { iconBg: string; iconText: string; topBorder: string }> = {
  saffron: { iconBg: 'bg-saffron/10', iconText: 'text-saffron', topBorder: 'border-t-saffron/20' },
  rausch: { iconBg: 'bg-rausch/10', iconText: 'text-rausch', topBorder: 'border-t-rausch/20' },
  forest: { iconBg: 'bg-forest/10', iconText: 'text-forest', topBorder: 'border-t-forest/20' },
};
---

<Layout title={t('alimentacionPage.metaTitle')} description={t('alimentacionPage.metaDescription')}>

  <main class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 pt-6 md:pt-8 pb-12">
    <!-- Page Banner -->
    <PageBanner
      title={t('alimentacionPage.banner.title')}
      subtitle={t('alimentacionPage.banner.subtitle')}
      badge={t('alimentacionPage.banner.badge')}
      breadcrumb={[
        { label: t('alimentacionPage.breadcrumb.home'), url: l('/') },
        { label: t('alimentacionPage.breadcrumb.alimentacion'), url: l('/alimentacion') },
      ]}
    />

    <!-- CTA row -->
    <div class="flex flex-wrap justify-center gap-4 mt-8 mb-24">
      <a href={l('/restaurante-campestre')} class="bg-forest text-white px-8 py-4 rounded-2xl font-bold text-lg hover:bg-forest-dark hover:scale-105 transition-all duration-300 shadow-lg inline-flex items-center gap-2">
        {t('alimentacionPage.cta.restaurante')}
        <ChevronRight size={20} />
      </a>
      <a href={l('/parador-el-elefante')} class="border-2 border-near-black px-8 py-4 rounded-2xl font-bold text-lg hover:bg-gray-50 transition-colors">
        {t('alimentacionPage.cta.parador')}
      </a>
    </div>

    <!-- Philosophy Cards -->
    <section id="filosofia" class="mb-24">
      <div class="mb-14 text-center max-w-2xl mx-auto">
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold font-display tracking-tightest mb-4">
          {t('alimentacionPage.philosophy.heading')}
        </h2>
        <p class="text-secondary-gray text-lg leading-relaxed">
          {t('alimentacionPage.philosophy.subtitle')}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {philosophyItems.map((item) => {
          const s = accentStyles[item.accent];
          return (
            <div class="bg-lotus-white rounded-[24px] shadow-airbnb p-8 text-center space-y-4 hover:scale-[1.02] transition-all duration-600 group">
              <div class={`w-14 h-14 ${s.iconBg} rounded-2xl flex items-center justify-center ${s.iconText} mx-auto group-hover:scale-110 transition-transform duration-300`}>
                <item.icon size={28} />
              </div>
              <h3 class="text-xl font-bold font-display tracking-tightest">{item.title}</h3>
              <p class="text-secondary-gray text-sm leading-relaxed">{item.description}</p>
            </div>
          );
        })}
      </div>
    </section>

    <!-- La Huerta -->
    <section id="huerta" class="mb-24 bg-light-surface rounded-2xl p-8 md:p-16 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div class="space-y-8">
        <div>
          <div class="inline-flex items-center gap-2 bg-forest/10 text-forest px-4 py-2 rounded-full text-sm font-bold mb-6">
            <Sprout size={16} />
            <span>{t('alimentacionPage.huerta.badge')}</span>
          </div>
          <h2 class="text-3xl md:text-4xl font-bold font-display tracking-tightest mb-4">
            {t('alimentacionPage.huerta.heading')}
          </h2>
          <p class="text-secondary-gray text-lg leading-relaxed">
            {t('alimentacionPage.huerta.text')}
          </p>
        </div>

        <div class="space-y-4">
          {huertaCategories.map((cat) => (
            <div>
              <h3 class="font-bold text-forest mb-2">{cat.title}</h3>
              <p class="text-secondary-gray">{cat.items}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <img
          src="https://picsum.photos/seed/huerta-veggies/600/800"
          class="rounded-3xl shadow-md aspect-3/4 object-cover"
          alt={t('alimentacionPage.huerta.veggiesImageAlt')}
          referrerpolicy="no-referrer"
          loading="lazy"
        />
        <img
          src="https://picsum.photos/seed/huerta-harvest/600/800"
          class="rounded-3xl shadow-md mt-8 aspect-3/4 object-cover"
          alt={t('alimentacionPage.huerta.harvestImageAlt')}
          referrerpolicy="no-referrer"
          loading="lazy"
        />
      </div>
    </section>

    <!-- Qué esperar (meals) -->
    <section class="mb-24">
      <div class="mb-14 text-center max-w-2xl mx-auto">
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold font-display tracking-tightest mb-4">
          {t('alimentacionPage.meals.heading')}
        </h2>
        <p class="text-secondary-gray text-lg leading-relaxed">
          {t('alimentacionPage.meals.subtitle')}
        </p>
      </div>

      <div class="max-w-3xl mx-auto space-y-4">
        {mealItems.map((meal) => {
          const s = accentStyles[meal.accent];
          return (
            <div class={`bg-lotus-white rounded-[20px] shadow-airbnb p-6 flex gap-5 items-start hover:scale-[1.01] transition-all duration-600 group border-t-2 ${s.topBorder}`}>
              <div class={`w-12 h-12 ${s.iconBg} rounded-xl flex items-center justify-center ${s.iconText} shrink-0 group-hover:scale-110 transition-transform duration-300`}>
                <meal.icon size={22} />
              </div>
              <div class="space-y-1 grow">
                <div class="flex items-center gap-3 flex-wrap">
                  <h3 class="text-lg font-bold font-display tracking-tightest">{meal.name}</h3>
                  <span class="text-xs text-secondary-gray bg-sacred-sand px-2.5 py-0.5 rounded-full font-medium">{meal.time}</span>
                </div>
                <p class="text-secondary-gray text-sm leading-relaxed">{meal.description}</p>
              </div>
            </div>
          );
        })}
      </div>
    </section>

    <!-- Principios -->
    <section class="mb-24">
      <div class="mb-14 text-center max-w-2xl mx-auto">
        <div class="inline-flex items-center gap-2 bg-rausch/10 text-rausch px-4 py-2 rounded-full text-sm font-bold mb-6">
          <Sparkles size={16} />
          <span>{t('alimentacionPage.principles.badge')}</span>
        </div>
        <h2 class="text-3xl md:text-4xl font-bold font-display tracking-tightest mb-4">
          {t('alimentacionPage.principles.heading')}
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {principleItems.map((p) => (
          <div class="bg-lotus-white rounded-[24px] shadow-airbnb p-8 text-center space-y-4 hover:scale-[1.02] transition-all duration-600">
            <div class="w-14 h-14 bg-forest/10 rounded-2xl flex items-center justify-center text-forest mx-auto">
              <p.icon size={28} />
            </div>
            <h3 class="text-xl font-bold font-display tracking-tightest">{p.title}</h3>
            <p class="text-secondary-gray text-sm leading-relaxed">{p.description}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- CTA -->
    <section class="mb-16 bg-near-black rounded-2xl p-10 md:p-16 text-center space-y-6">
      <h2 class="text-3xl md:text-4xl font-bold font-display tracking-tightest text-white">
        {t('alimentacionPage.finalCta.heading')}
      </h2>
      <p class="text-gray-400 text-lg max-w-2xl mx-auto">
        {t('alimentacionPage.finalCta.text')}
      </p>
      <div class="flex flex-wrap gap-4 justify-center pt-4">
        <a href={l('/events')} class="bg-rausch text-white px-8 py-4 rounded-2xl font-bold text-lg hover:bg-rausch-dark hover:scale-105 transition-all duration-300 shadow-lg inline-flex items-center gap-2">
          {t('alimentacionPage.finalCta.events')}
          <ChevronRight size={20} />
        </a>
        <a href={l('/voluntariado')} class="border-2 border-white/20 text-white px-8 py-4 rounded-2xl font-bold text-lg hover:border-white/40 hover:bg-white/5 transition-all">
          {t('alimentacionPage.finalCta.volunteer')}
        </a>
      </div>
    </section>
  </main>

</Layout>

<style>
  h1, h2, h3 {
    letter-spacing: -0.02em;
  }
</style>
