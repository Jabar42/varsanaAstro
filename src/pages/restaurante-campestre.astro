---
import { getLocale, useTranslations, localizePath } from '@/src/i18n/utils';
import { es as dict } from '@/src/i18n/dictionaries/restaurantePage';

import Layout from '@/src/layouts/Layout.astro';
import PageBanner from '@/src/components/PageBanner.astro';
import { ChefHat, MapPin, CheckCircle2 } from 'lucide-react';

const locale = getLocale(Astro);
const t = useTranslations(locale);
const l = (path: string) => localizePath(locale, path);

// Se itera por índice para que t() resuelva cada servicio en el idioma actual.
const servicios = dict.services.map((_, i) => t(`restaurantePage.services.${i}`));
---

<Layout title={t('restaurantePage.metaTitle')} description={t('restaurantePage.metaDescription')}>

  <main class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 pt-6 md:pt-8 pb-12">
    <PageBanner
      title={t('restaurantePage.banner.title')}
      subtitle={t('restaurantePage.banner.subtitle')}
      badge={t('restaurantePage.banner.badge')}
      breadcrumb={[
        { label: t('restaurantePage.breadcrumb.home'), url: l('/') },
        { label: t('restaurantePage.breadcrumb.alimentacion'), url: l('/alimentacion') },
        { label: t('restaurantePage.breadcrumb.restaurante'), url: l('/restaurante-campestre') },
      ]}
    />

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-x-12 gap-y-14 items-center py-20 md:py-28">
      <div class="lg:col-span-5 space-y-10" data-reveal-group>
        <div>
          <p class="eyebrow mb-5">{t('restaurantePage.sectionBadge')}</p>
          <h2 class="display-lg font-bold font-display mb-6">
            {t('restaurantePage.heading')}
          </h2>
          <p class="text-secondary-gray text-lg md:text-xl leading-relaxed">
            {t('restaurantePage.text')}
          </p>
        </div>

        <ul class="divide-y divide-near-black/10 border-y border-near-black/10">
          {servicios.map((s) => (
            <li class="flex items-center gap-4 py-4 text-lg font-medium">
              <CheckCircle2 className="text-forest-deep shrink-0" size={22} />
              <span>{s}</span>
            </li>
          ))}
        </ul>

        <div class="flex items-center gap-3 text-secondary-gray">
          <MapPin size={18} className="text-saffron-deep shrink-0" />
          <span>{t('restaurantePage.location')}</span>
        </div>
      </div>

      <div class="lg:col-span-6 lg:col-start-7">
        <div class="relative pb-10 md:pb-14">
          <div class="arch parallax aspect-4/5 w-[86%] ml-auto bg-forest-night" data-reveal="mask">
            <img
              src="https://picsum.photos/seed/restaurante-1/600/800"
              class="w-full h-full object-cover"
              alt={t('restaurantePage.image1Alt')}
              referrerpolicy="no-referrer"
              loading="lazy"
            />
          </div>
          <img
            src="https://picsum.photos/seed/restaurante-2/600/800"
            class="absolute bottom-0 left-0 w-[42%] aspect-3/4 object-cover rounded-3xl ring-8 ring-sacred-sand"
            alt={t('restaurantePage.image2Alt')}
            referrerpolicy="no-referrer"
            loading="lazy"
            data-reveal
          />
        </div>
      </div>
    </div>
  </main>

</Layout>

