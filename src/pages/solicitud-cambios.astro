---
/**
 * Formulario interno de solicitudes de cambio al sitio.
 * Ruta NO enlazada en la navegación (se comparte por WhatsApp al equipo) y
 * marcada noindex. Envía a POST /api/change-requests, que guarda en D1 y
 * avisa al chat del equipo por Telegram.
 */
import Layout from '@/src/layouts/Layout.astro';
import PageBanner from '@/src/components/PageBanner.astro';
import { getLocale, useTranslations, localizePath } from '@/src/i18n/utils';
import { ClipboardList, Paperclip, Send, Sparkles } from 'lucide-react';

const locale = getLocale(Astro);
const t = useTranslations(locale);
const l = (p: string) => localizePath(locale, p);

// Valores de los <select> — el vocabulario cerrado vive en src/lib/change-requests.ts
// (TYPES / PRIORITIES). Si se agrega uno, debe existir también en el diccionario.
const AREAS = ['direccion', 'hospedaje', 'cocina', 'eventos', 'huerta', 'comunicaciones', 'mantenimiento', 'otra'];
const TYPES = ['contenido', 'correccion', 'imagen', 'precio_fechas', 'evento', 'funcionalidad', 'error', 'otro'];
const PRIORITIES: Array<{ value: string; key: string }> = [
  { value: 'baja', key: 'priorityLow' },
  { value: 'media', key: 'priorityMedium' },
  { value: 'alta', key: 'priorityHigh' },
  { value: 'urgente', key: 'priorityUrgent' },
];

// value = ruta real del sitio; así la solicitud llega accionable al equipo.
const PAGES: Array<{ key: string; value: string }> = [
  { key: 'home', value: '/' },
  { key: 'nosotros', value: '/nosotros' },
  { key: 'historia', value: '/nuestra-historia' },
  { key: 'practica', value: '/practica-espiritual' },
  { key: 'experiencias', value: '/experiencias' },
  { key: 'temazcal', value: '/experiencias/temazcal' },
  { key: 'yoga', value: '/experiencias/yoga' },
  { key: 'events', value: '/events' },
  { key: 'pasadias', value: '/pasadias' },
  { key: 'hospedaje', value: '/hospedaje' },
  { key: 'alimentacion', value: '/alimentacion' },
  { key: 'restaurante', value: '/restaurante-campestre' },
  { key: 'parador', value: '/parador-el-elefante' },
  { key: 'red', value: '/red-eco-aldeas' },
  { key: 'blog', value: '/blog' },
  { key: 'voluntariado', value: '/voluntariado' },
  { key: 'contacto', value: '/contacto' },
  { key: 'donar', value: '/donar' },
  { key: 'tienda', value: '/tienda' },
  { key: 'otra', value: 'otra' },
];

const field =
  'w-full rounded-xl border border-sacred-sand px-4 py-3 bg-sacred-sand/50 text-near-black placeholder:text-secondary-gray focus:outline-none focus:border-rausch focus:ring-2 focus:ring-rausch/10 transition-all';
const label = 'text-sm font-bold text-near-black';
---

<Layout title={t('solicitudCambios.pageTitle')} description={t('solicitudCambios.pageDescription')} noindex>

  <main class="max-w-5xl mx-auto px-6 md:px-12 pt-6 md:pt-8 pb-12">
    <PageBanner
      title={t('solicitudCambios.heading')}
      subtitle={t('solicitudCambios.subtitle')}
      badge={t('solicitudCambios.badge')}
      breadcrumb={[
        { label: t('solicitudCambios.breadcrumbHome'), url: l('/') },
        { label: t('solicitudCambios.breadcrumbThis'), url: l('/solicitud-cambios') },
      ]}
    />

    <section class="mb-24 max-w-3xl mx-auto">
      <div class="text-center mb-10">
        <div class="inline-flex items-center gap-2 bg-rausch/10 text-rausch px-4 py-2 rounded-full text-sm font-bold mb-6">
          <Sparkles size={16} />
          <span>{t('solicitudCambios.badge')}</span>
        </div>
        <h2 class="text-3xl md:text-4xl font-bold font-display tracking-tightest mb-4">
          {t('solicitudCambios.heading')}
        </h2>
        <p class="text-secondary-gray text-lg">{t('solicitudCambios.subtitle')}</p>
      </div>

      <form
        id="change-request-form"
        class="relative bg-lotus-white rounded-[24px] shadow-airbnb p-8 md:p-12 space-y-6"
        novalidate
        data-msg-sending={t('solicitudCambios.sending')}
        data-msg-success={t('solicitudCambios.success')}
        data-msg-error-prefix={t('solicitudCambios.errorPrefix')}
        data-msg-generic-error={t('solicitudCambios.genericError')}
        data-msg-connection-error={t('solicitudCambios.connectionError')}
        data-msg-submit={t('solicitudCambios.submit')}
      >
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="space-y-2">
            <label for="requester_name" class={label}>{t('solicitudCambios.requesterName')} *</label>
            <input
              type="text"
              id="requester_name"
              name="requester_name"
              required
              maxlength="120"
              autocomplete="name"
              placeholder={t('solicitudCambios.requesterNamePlaceholder')}
              class={field}
            />
          </div>
          <div class="space-y-2">
            <label for="requester_contact" class={label}>{t('solicitudCambios.contact')} *</label>
            <input
              type="text"
              id="requester_contact"
              name="requester_contact"
              required
              maxlength="160"
              placeholder={t('solicitudCambios.contactPlaceholder')}
              class={field}
            />
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="space-y-2">
            <label for="area" class={label}>{t('solicitudCambios.area')}</label>
            <select id="area" name="area" class={field}>
              <option value="">{t('solicitudCambios.areaPlaceholder')}</option>
              {AREAS.map((a) => <option value={a}>{t(`solicitudCambios.areas.${a}`)}</option>)}
            </select>
          </div>
          <div class="space-y-2">
            <label for="type" class={label}>{t('solicitudCambios.type')} *</label>
            <select id="type" name="type" required class={field}>
              <option value="">{t('solicitudCambios.typePlaceholder')}</option>
              {TYPES.map((v) => <option value={v}>{t(`solicitudCambios.types.${v}`)}</option>)}
            </select>
          </div>
          <div class="space-y-2">
            <label for="priority" class={label}>{t('solicitudCambios.priority')} *</label>
            <select id="priority" name="priority" required class={field}>
              {PRIORITIES.map((p) => (
                <option value={p.value} selected={p.value === 'media'}>{t(`solicitudCambios.${p.key}`)}</option>
              ))}
            </select>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="space-y-2">
            <label for="page" class={label}>{t('solicitudCambios.page')} *</label>
            <select id="page" name="page" required class={field}>
              <option value="">{t('solicitudCambios.pagePlaceholder')}</option>
              {PAGES.map((p) => <option value={p.value}>{t(`solicitudCambios.pages.${p.key}`)}</option>)}
            </select>
          </div>
          <div class="space-y-2">
            <label for="page_detail" class={label}>{t('solicitudCambios.pageDetail')}</label>
            <input
              type="text"
              id="page_detail"
              name="page_detail"
              maxlength="200"
              placeholder={t('solicitudCambios.pageDetailPlaceholder')}
              class={field}
            />
          </div>
        </div>

        <div class="space-y-2">
          <label for="title" class={label}>{t('solicitudCambios.formTitle')} *</label>
          <input
            type="text"
            id="title"
            name="title"
            required
            maxlength="160"
            placeholder={t('solicitudCambios.titlePlaceholder')}
            class={field}
          />
        </div>

        <div class="space-y-2">
          <label for="description" class={label}>{t('solicitudCambios.formDescription')} *</label>
          <textarea
            id="description"
            name="description"
            rows={6}
            required
            maxlength="4000"
            placeholder={t('solicitudCambios.descriptionPlaceholder')}
            class={`${field} resize-y`}
          ></textarea>
          <p class="text-xs text-secondary-gray">{t('solicitudCambios.descriptionHint')}</p>
        </div>

        <!-- Adjuntos: fotos de ejemplo o PDF. El tipo real se valida por bytes
             en el servidor; acá solo se filtra por MIME para dar feedback rápido. -->
        <div class="space-y-2">
          <span class={label}>{t('solicitudCambios.files')}</span>
          <label
            for="files"
            id="files-drop"
            class="flex items-center justify-center gap-3 w-full rounded-xl border-2 border-dashed border-sacred-sand bg-sacred-sand/30 px-4 py-6 cursor-pointer hover:border-rausch hover:bg-rausch/5 transition-all text-secondary-gray"
          >
            <Paperclip size={20} />
            <span class="font-bold text-near-black">{t('solicitudCambios.filesCta')}</span>
            <input
              type="file"
              id="files"
              name="files"
              multiple
              accept="image/jpeg,image/png,image/webp,image/gif,image/avif,application/pdf"
              class="sr-only"
              data-msg-too-many={t('solicitudCambios.filesErrorCount')}
              data-msg-too-big={t('solicitudCambios.filesErrorSize')}
              data-msg-too-heavy={t('solicitudCambios.filesErrorTotal')}
              data-msg-bad-type={t('solicitudCambios.filesErrorType')}
              data-msg-remove={t('solicitudCambios.filesRemove')}
            />
          </label>
          <p class="text-xs text-secondary-gray">{t('solicitudCambios.filesHint')}</p>
          <ul id="files-list" class="hidden space-y-1 text-sm"></ul>
          <p id="files-error" class="hidden text-sm font-bold text-red-500" role="alert"></p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="space-y-2">
            <label for="deadline" class={label}>{t('solicitudCambios.deadline')}</label>
            <input type="date" id="deadline" name="deadline" class={field} />
          </div>
          <div class="space-y-2">
            <label for="reference_url" class={label}>{t('solicitudCambios.reference')}</label>
            <input
              type="url"
              id="reference_url"
              name="reference_url"
              maxlength="500"
              placeholder={t('solicitudCambios.referencePlaceholder')}
              class={field}
            />
          </div>
        </div>

        <!-- Honeypot anti-spam: invisible para personas, los bots lo rellenan. -->
        <div class="absolute -left-[9999px] w-px h-px overflow-hidden" aria-hidden="true">
          <label for="website">{t('solicitudCambios.honeypotLabel')}</label>
          <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
        </div>

        <p class="text-xs text-secondary-gray">{t('solicitudCambios.requiredHint')}</p>
        <p id="form-msg" class="hidden text-sm font-bold text-center" role="status" aria-live="polite"></p>

        <button
          type="submit"
          id="submit-btn"
          class="bg-rausch text-white px-10 py-4 rounded-2xl font-bold text-lg hover:bg-rausch-dark hover:scale-105 transition-all duration-300 shadow-lg inline-flex items-center gap-2"
        >
          <ClipboardList size={18} />
          <span data-submit-label>{t('solicitudCambios.submit')}</span>
          <Send size={18} />
        </button>
      </form>
    </section>
  </main>

</Layout>

<script>
  // Límites espejo de src/lib/change-requests.ts (ATTACHMENTS). Si cambian allá,
  // cambian acá: el servidor es la autoridad, esto es solo feedback inmediato.
  const MAX_FILES = 3;
  const MAX_FILE_BYTES = 8 * 1024 * 1024;
  const MAX_TOTAL_BYTES = 20 * 1024 * 1024;
  const ALLOWED_TYPES = new Set([
    'image/jpeg',
    'image/png',
    'image/webp',
    'image/gif',
    'image/avif',
    'application/pdf',
  ]);

  function initChangeRequestForm(): void {
    const form = document.getElementById('change-request-form') as HTMLFormElement | null;
    const msg = document.getElementById('form-msg') as HTMLParagraphElement | null;
    const btn = document.getElementById('submit-btn') as HTMLButtonElement | null;
    if (!form || !msg || !btn || form.dataset.bound === 'true') return;
    form.dataset.bound = 'true';

    const labelEl = btn.querySelector<HTMLSpanElement>('[data-submit-label]');
    const texts = {
      sending: form.dataset.msgSending ?? '…',
      success: form.dataset.msgSuccess ?? '',
      errorPrefix: form.dataset.msgErrorPrefix ?? '',
      genericError: form.dataset.msgGenericError ?? '',
      connectionError: form.dataset.msgConnectionError ?? '',
      submit: form.dataset.msgSubmit ?? '',
    };
    const setLabel = (text: string) => {
      if (labelEl) labelEl.textContent = text;
      else btn.textContent = text;
    };

    // --- Adjuntos -------------------------------------------------------
    const input = document.getElementById('files') as HTMLInputElement | null;
    const list = document.getElementById('files-list') as HTMLUListElement | null;
    const fileError = document.getElementById('files-error') as HTMLParagraphElement | null;
    // El input no deja borrar un archivo suelto: la lista vive acá y se vuelca
    // al input con un DataTransfer en cada cambio.
    let selected: File[] = [];

    const fileTexts = {
      tooMany: input?.dataset.msgTooMany ?? 'Máximo 3 archivos.',
      tooBig: input?.dataset.msgTooBig ?? 'Cada archivo máximo 8 MB.',
      tooHeavy: input?.dataset.msgTooHeavy ?? 'Los archivos suman más de 20 MB.',
      badType: input?.dataset.msgBadType ?? 'Solo fotos o PDF.',
      remove: input?.dataset.msgRemove ?? 'Quitar',
    };

    const humanSize = (n: number) =>
      n >= 1024 * 1024 ? `${(n / 1024 / 1024).toFixed(1)} MB` : `${Math.max(1, Math.round(n / 1024))} KB`;

    const syncInput = () => {
      if (!input) return;
      const dt = new DataTransfer();
      selected.forEach((f) => dt.items.add(f));
      input.files = dt.files;
    };

    const showFileError = (text: string) => {
      if (!fileError) return;
      fileError.textContent = text;
      fileError.className = text ? 'text-sm font-bold text-red-500' : 'hidden';
    };

    const validateFiles = (): boolean => {
      const total = selected.reduce((sum, f) => sum + f.size, 0);
      let error = '';
      if (selected.length > MAX_FILES) error = fileTexts.tooMany;
      else if (selected.some((f) => !ALLOWED_TYPES.has(f.type))) error = fileTexts.badType;
      else if (selected.some((f) => f.size > MAX_FILE_BYTES)) error = fileTexts.tooBig;
      else if (total > MAX_TOTAL_BYTES) error = fileTexts.tooHeavy;
      showFileError(error);
      return error === '';
    };

    const render = () => {
      if (list) {
        list.innerHTML = '';
        list.classList.toggle('hidden', selected.length === 0);
        selected.forEach((file, index) => {
          const li = document.createElement('li');
          li.className = 'flex items-center justify-between gap-3 bg-sacred-sand/60 rounded-lg px-3 py-2';
          const name = document.createElement('span');
          name.className = 'truncate text-near-black';
          name.textContent = `${file.name} · ${humanSize(file.size)}`;
          const remove = document.createElement('button');
          remove.type = 'button';
          remove.className = 'text-rausch text-xs font-bold shrink-0 hover:underline';
          remove.textContent = fileTexts.remove;
          remove.setAttribute('aria-label', `${fileTexts.remove}: ${file.name}`);
          remove.addEventListener('click', () => {
            selected.splice(index, 1);
            syncInput();
            render();
            validateFiles();
          });
          li.appendChild(name);
          li.appendChild(remove);
          list.appendChild(li);
        });
      }
      validateFiles();
    };

    input?.addEventListener('change', () => {
      // Al elegir de nuevo, se acumula (salvo duplicados exactos).
      const incoming = Array.from(input.files ?? []);
      for (const file of incoming) {
        const dup = selected.some((f) => f.name === file.name && f.size === file.size);
        if (!dup) selected.push(file);
      }
      if (selected.length > MAX_FILES) selected = selected.slice(0, MAX_FILES + 1);
      syncInput();
      render();
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!validateFiles()) return;

      // multipart: los archivos viajan en el mismo POST (sin subidas huérfanas).
      const data = new FormData(form);
      const page = String(data.get('page') ?? '');
      const detail = String(data.get('page_detail') ?? '').trim();
      data.set('page', page === 'otra' ? detail : detail ? `${page} — ${detail}` : page);
      data.delete('page_detail');

      btn.disabled = true;
      setLabel(texts.sending);
      msg.className = 'hidden';

      try {
        const res = await fetch('/api/change-requests', { method: 'POST', body: data });
        const json = (await res.json()) as {
          success: boolean;
          message?: string;
          code?: string;
          attachments?: number;
        };

        if (json.success) {
          const extra = json.attachments ? ` · ${json.attachments} adjunto(s)` : '';
          msg.textContent = json.code ? `${texts.success} (${json.code}${extra})` : texts.success;
          msg.className = 'text-sm font-bold text-center text-forest';
          form.reset();
          selected = [];
          syncInput();
          render();
        } else {
          msg.textContent = texts.errorPrefix + (json.message || texts.genericError);
          msg.className = 'text-sm font-bold text-center text-red-500';
        }
      } catch {
        msg.textContent = texts.connectionError;
        msg.className = 'text-sm font-bold text-center text-red-500';
      } finally {
        btn.disabled = false;
        setLabel(texts.submit);
      }
    });
  }

  document.addEventListener('astro:page-load', initChangeRequestForm);
</script>

<style>
  h1, h2, h3, h4 {
    letter-spacing: -0.02em;
  }
</style>
