---
import Layout from '@/src/layouts/Layout.astro';
import PageBanner from '@/src/components/PageBanner.astro';
import { getLocale, useTranslations, localizePath } from '@/src/i18n/utils';
import {
  Send,
  MessageCircle,
  Mail,
  MapPin,
  ChevronRight,
  Clock,
  Car,
  Bus,
} from 'lucide-react';

const locale = getLocale(Astro);
const t = useTranslations(locale);
const l = (p: string) => localizePath(locale, p);
---

<Layout title={t('contacto.title')} description={t('contacto.subtitle')}>

  <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 pt-6 md:pt-8">
    <!-- Page Banner -->
    <PageBanner
      title={t('contacto.heading')}
      subtitle={t('contacto.subtitle')}
      badge={t('contacto.badge')}
      breadcrumb={[
        { label: t('nav.home'), url: l('/') },
        { label: t('nav.contact'), url: l('/contacto') },
      ]}
    />

    <!-- Contact Info Cards -->
    <section class="pt-12 md:pt-16 grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
      <!-- WhatsApp -->
      <a
        href="https://wa.me/573214538242"
        target="_blank"
        rel="noopener noreferrer"
        class="channel group"
      >
        <div class="channel__icon bg-forest/10 text-forest-deep">
          <MessageCircle size={24} />
        </div>
        <h3 class="text-xl font-bold font-display">{t('contacto.whatsapp')}</h3>
        <p class="text-secondary-gray text-sm leading-relaxed">{t('contacto.whatsappDesc')}</p>
        <p class="channel__value">+57 321 4538242</p>
        <span class="channel__cta text-rausch">
          {t('contacto.whatsappCta')}
          <ChevronRight size={14} />
        </span>
      </a>

      <!-- Email -->
      <a
        href="mailto:contacto@varsana.com"
        class="channel group"
      >
        <div class="channel__icon bg-forest/10 text-forest-deep">
          <Mail size={24} />
        </div>
        <h3 class="text-xl font-bold font-display">{t('contacto.emailLabel')}</h3>
        <p class="text-secondary-gray text-sm leading-relaxed">{t('contacto.emailDesc')}</p>
        <p class="channel__value">contacto@varsana.com</p>
        <span class="channel__cta text-rausch">
          {t('contacto.emailCta')}
          <ChevronRight size={14} />
        </span>
      </a>

      <!-- Location -->
      <div class="channel channel--static">
        <div class="channel__icon bg-saffron/10 text-saffron-deep">
          <MapPin size={24} />
        </div>
        <h3 class="text-xl font-bold font-display">{t('contacto.visit')}</h3>
        <p class="text-secondary-gray text-sm leading-relaxed">{t('contacto.visitDesc')}</p>
        <p class="channel__value leading-relaxed">
          {t('contactoPage.addressLine1')}<br />{t('contactoPage.addressLine2')}
        </p>
        <span class="channel__cta text-forest-deep">
          {t('contacto.visitCountry')}
        </span>
      </div>
    </section>

    <!-- Google Maps -->
    <section class="pt-6 lg:pt-8">
      <div class="aspect-4/3 md:aspect-21/9 rounded-3xl overflow-hidden ring-1 ring-near-black/5 bg-sand-deep">
        <iframe
          src="https://maps.google.com/maps?ll=4.5255247,-74.3549159&q=Varsana+Eco+Yoga+Village+Granada+Cundinamarca&z=15&output=embed"
          width="100%"
          height="100%"
          style="border:0"
          loading="lazy"
          allowfullscreen
          title={t('contactoPage.mapTitle')}
        ></iframe>
      </div>
    </section>

    <!-- Contact Form -->
    <section class="py-20 md:py-28 grid lg:grid-cols-12 gap-y-10 gap-x-12 items-start">
      <div class="lg:col-span-5 lg:sticky lg:top-32" data-reveal-group>
        <span class="rule-saffron mb-8" data-reveal="draw" aria-hidden="true"></span>
        <p class="eyebrow mb-4">{t('contacto.formBadge')}</p>
        <h2 class="display-lg font-bold font-display text-near-black">
          {t('contacto.formHeading')}
        </h2>
        <p class="mt-6 text-secondary-gray text-lg md:text-xl leading-relaxed max-w-md">
          {t('contacto.formSubtitle')}
        </p>
      </div>

      <form
        id="contact-form"
        class="lg:col-span-7 relative bg-lotus-white rounded-3xl ring-1 ring-near-black/5 p-6 md:p-10 lg:p-12 space-y-6"
        data-msg-sending={t('contactoPage.sending')}
        data-msg-success={t('contactoPage.success')}
        data-msg-error-prefix={t('contactoPage.errorPrefix')}
        data-msg-generic-error={t('contactoPage.genericError')}
        data-msg-connection-error={t('contactoPage.connectionError')}
        data-msg-submit={t('contacto.formSubmit')}
      >
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="space-y-2">
            <label for="nombre" class="block text-sm font-semibold text-near-black">{t('contacto.formName')}</label>
            <input
              type="text"
              id="nombre"
              name="nombre"
              required
              placeholder={t('contacto.formNamePlaceholder')}
              class="w-full rounded-2xl border border-near-black/15 px-4 py-3.5 bg-sacred-sand/60 text-near-black placeholder:text-secondary-gray focus:outline-none focus:border-forest-dark focus:ring-2 focus:ring-forest/30 transition-colors duration-300"
            />
          </div>
          <div class="space-y-2">
            <label for="email" class="block text-sm font-semibold text-near-black">{t('contacto.formEmail')}</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              placeholder={t('contacto.formEmailPlaceholder')}
              class="w-full rounded-2xl border border-near-black/15 px-4 py-3.5 bg-sacred-sand/60 text-near-black placeholder:text-secondary-gray focus:outline-none focus:border-forest-dark focus:ring-2 focus:ring-forest/30 transition-colors duration-300"
            />
          </div>
        </div>
        <div class="space-y-2">
          <label for="mensaje" class="block text-sm font-semibold text-near-black">{t('contacto.formMessage')}</label>
          <textarea
            id="mensaje"
            name="mensaje"
            rows={5}
            placeholder={t('contacto.formMessagePlaceholder')}
            class="w-full rounded-2xl border border-near-black/15 px-4 py-3.5 bg-sacred-sand/60 text-near-black placeholder:text-secondary-gray focus:outline-none focus:border-forest-dark focus:ring-2 focus:ring-forest/30 transition-colors duration-300 resize-y"
          ></textarea>
        </div>

        <!-- Honeypot anti-spam: oculto para personas, los bots suelen rellenarlo. El servidor descarta el envío si llega lleno. -->
        <div class="absolute -left-[9999px] w-px h-px overflow-hidden" aria-hidden="true">
          <label for="website">{t('contactoPage.honeypotLabel')}</label>
          <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
        </div>

        <p id="form-msg" class="hidden text-sm font-bold text-center" role="status" aria-live="polite"></p>
        <button
          type="submit"
          id="submit-btn"
          class="btn btn-lg w-full sm:w-auto"
        >
          <span data-submit-label>{t('contacto.formSubmit')}</span>
          <Send size={18} />
        </button>
      </form>
    </section>
  </div>

  <!-- How to Get Here -->
  <section class="bg-sand-deep py-20 md:py-28 -mb-20">
    <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 grid grid-cols-1 lg:grid-cols-12 gap-y-14 gap-x-12 lg:gap-x-20 items-center">
      <div class="lg:col-span-7">
        <div data-reveal-group>
          <p class="eyebrow mb-4">{t('contacto.howToBadge')}</p>
          <h2 class="display-md font-bold font-display text-near-black">
            {t('contacto.howToHeading')}
          </h2>
          <p class="mt-5 text-secondary-gray text-lg md:text-xl leading-relaxed max-w-xl">
            {t('contacto.howToSubtitle')}
          </p>
        </div>

        <div class="mt-10 border-t border-near-black/10" data-reveal-group>
          <div class="route">
            <div class="route__icon bg-forest/10 text-forest-deep">
              <Car size={20} />
            </div>
            <div>
              <h4 class="font-bold text-lg font-display mb-1">{t('contacto.byCar')}</h4>
              <p class="text-secondary-gray leading-relaxed">
                {t('contacto.byCarDesc')}
              </p>
            </div>
          </div>

          <div class="route">
            <div class="route__icon bg-forest/10 text-forest-deep">
              <Bus size={20} />
            </div>
            <div>
              <h4 class="font-bold text-lg font-display mb-1">{t('contacto.byBus')}</h4>
              <p class="text-secondary-gray leading-relaxed">
                {t('contacto.byBusDesc')}
              </p>
            </div>
          </div>

          <div class="route">
            <div class="route__icon bg-saffron/10 text-saffron-deep">
              <Clock size={20} />
            </div>
            <div>
              <h4 class="font-bold text-lg font-display mb-1">{t('contacto.arrivalTime')}</h4>
              <p class="text-secondary-gray leading-relaxed">
                {t('contacto.arrivalTimeDesc')}
              </p>
            </div>
          </div>
        </div>
      </div>

      <div class="lg:col-span-5">
        <div class="arch parallax shimmer aspect-4/5 w-full max-w-sm lg:max-w-none mx-auto" data-reveal="mask">
          <img
            src="https://picsum.photos/seed/road-varsana/800/1067"
            alt={t('contactoPage.roadImageAlt')}
            class="w-full h-full object-cover"
            referrerpolicy="no-referrer"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

</Layout>

<script>
  // Con <ClientRouter /> este módulo se ejecuta una sola vez por sesión:
  // la inicialización va en `astro:page-load` y se marca el form para no
  // registrar listeners duplicados.
  function initContactForm(): void {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const msg = document.getElementById('form-msg') as HTMLParagraphElement | null;
    const btn = document.getElementById('submit-btn') as HTMLButtonElement | null;
    if (!form || !msg || !btn || form.dataset.bound === 'true') return;
    form.dataset.bound = 'true';

    const label = btn.querySelector<HTMLSpanElement>('[data-submit-label]');
    const texts = {
      sending: form.dataset.msgSending ?? 'Enviando...',
      success: form.dataset.msgSuccess ?? '',
      errorPrefix: form.dataset.msgErrorPrefix ?? '',
      genericError: form.dataset.msgGenericError ?? '',
      connectionError: form.dataset.msgConnectionError ?? '',
      submit: form.dataset.msgSubmit ?? '',
    };

    const setLabel = (text: string) => {
      if (label) label.textContent = text;
      else btn.textContent = text;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      btn.disabled = true;
      setLabel(texts.sending);
      msg.className = 'hidden';

      try {
        const formData = new FormData(form);
        // El honeypot `website` viaja en el cuerpo; el servidor descarta el envío si viene lleno.
        if (!formData.has('website')) formData.set('website', '');

        const res = await fetch('/api/contact', { method: 'POST', body: formData });
        const data = (await res.json()) as { success: boolean; message?: string };

        if (data.success) {
          msg.textContent = texts.success;
          msg.className = 'text-sm font-bold text-center text-forest';
          form.reset();
        } else {
          msg.textContent = texts.errorPrefix + (data.message || texts.genericError);
          msg.className = 'text-sm font-bold text-center text-red-500';
        }
      } catch {
        msg.textContent = texts.connectionError;
        msg.className = 'text-sm font-bold text-center text-red-500';
      } finally {
        btn.disabled = false;
        setLabel(texts.submit);
      }
    });
  }

  document.addEventListener('astro:page-load', initContactForm);
</script>

<style>
  h3, h4 {
    letter-spacing: -0.02em;
  }

  /* Canales de contacto: misma familia que las tarjetas del sitio
     (24px, borde sutil, hover que eleva). */
  .channel {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    height: 100%;
    padding: 2rem;
    border-radius: var(--radius-md);
    background: var(--color-lotus-white);
    box-shadow: 0 0 0 1px rgb(34 34 34 / 0.06);
    transition: transform 0.5s var(--ease-out), box-shadow 0.5s var(--ease-out);
  }

  a.channel:hover {
    transform: translateY(-6px);
    box-shadow: 0 0 0 1px rgb(34 34 34 / 0.06), 0 28px 48px -28px rgb(23 35 15 / 0.45);
  }

  .channel__icon,
  .route__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
    border-radius: var(--radius-DEFAULT);
  }

  .channel__icon {
    width: 3.25rem;
    height: 3.25rem;
    margin-bottom: 0.75rem;
  }

  .channel__value {
    margin-top: auto;
    padding-top: 0.75rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.125rem;
    color: var(--color-near-black);
    overflow-wrap: anywhere;
  }

  .channel__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .channel__cta :global(svg) {
    transition: transform 0.3s var(--ease-out);
  }

  a.channel:hover .channel__cta :global(svg) {
    transform: translateX(4px);
  }

  /* Cómo llegar: filas separadas por una línea, no tarjetas. */
  .route {
    display: flex;
    gap: 1.25rem;
    padding-block: 1.5rem;
    border-bottom: 1px solid rgb(34 34 34 / 0.1);
  }

  .route__icon {
    width: 2.75rem;
    height: 2.75rem;
    margin-top: 0.125rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .channel,
    .channel__cta :global(svg) {
      transition: none;
    }
    a.channel:hover,
    a.channel:hover .channel__cta :global(svg) {
      transform: none;
    }
  }
</style>
