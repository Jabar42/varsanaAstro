---
import Layout from '@/src/layouts/Layout.astro';
import PageBanner from '@/src/components/PageBanner.astro';
import { getLocale, useTranslations, localizePath } from '@/src/i18n/utils';
import {
  Send,
  MessageCircle,
  Mail,
  MapPin,
  ChevronRight,
  Sparkles,
  Clock,
  Car,
  Bus,
} from 'lucide-react';

const locale = getLocale(Astro);
const t = useTranslations(locale);
const l = (p: string) => localizePath(locale, p);
---

<Layout title={t('contacto.title')} description={t('contacto.subtitle')}>

  <main class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 pt-6 md:pt-8 pb-12">
    <!-- Page Banner -->
    <PageBanner
      title={t('contacto.heading')}
      subtitle={t('contacto.subtitle')}
      badge={t('contacto.badge')}
      breadcrumb={[
        { label: t('nav.home'), url: l('/') },
        { label: t('nav.contact'), url: l('/contacto') },
      ]}
    />

    <!-- Contact Info Cards -->
    <section class="mt-8 mb-24 grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- WhatsApp -->
      <a
        href="https://wa.me/573214538242"
        target="_blank"
        rel="noopener noreferrer"
        class="bg-lotus-white rounded-[24px] shadow-airbnb p-8 text-center space-y-4 hover:scale-[1.02] transition-all duration-600 group"
      >
        <div class="w-14 h-14 bg-saffron/10 rounded-2xl flex items-center justify-center text-saffron mx-auto group-hover:bg-saffron group-hover:text-white transition-colors duration-300">
          <MessageCircle size={28} />
        </div>
        <h3 class="text-xl font-bold font-display tracking-tightest">{t('contacto.whatsapp')}</h3>
        <p class="text-secondary-gray text-sm">{t('contacto.whatsappDesc')}</p>
        <p class="text-near-black font-bold font-display">+57 321 4538242</p>
        <span class="inline-flex items-center gap-1 text-saffron text-sm font-bold group-hover:gap-2 transition-all">
          {t('contacto.whatsappCta')}
          <ChevronRight size={14} />
        </span>
      </a>

      <!-- Email -->
      <a
        href="mailto:contacto@varsana.com"
        class="bg-lotus-white rounded-[24px] shadow-airbnb p-8 text-center space-y-4 hover:scale-[1.02] transition-all duration-600 group"
      >
        <div class="w-14 h-14 bg-rausch/10 rounded-2xl flex items-center justify-center text-rausch mx-auto group-hover:bg-rausch group-hover:text-white transition-colors duration-300">
          <Mail size={28} />
        </div>
        <h3 class="text-xl font-bold font-display tracking-tightest">{t('contacto.emailLabel')}</h3>
        <p class="text-secondary-gray text-sm">{t('contacto.emailDesc')}</p>
        <p class="text-near-black font-bold font-display">contacto@varsana.com</p>
        <span class="inline-flex items-center gap-1 text-rausch text-sm font-bold group-hover:gap-2 transition-all">
          {t('contacto.emailCta')}
          <ChevronRight size={14} />
        </span>
      </a>

      <!-- Location -->
      <div class="bg-lotus-white rounded-[24px] shadow-airbnb p-8 text-center space-y-4 hover:scale-[1.02] transition-all duration-600 group">
        <div class="w-14 h-14 bg-forest/10 rounded-2xl flex items-center justify-center text-forest mx-auto group-hover:bg-forest group-hover:text-white transition-colors duration-300">
          <MapPin size={28} />
        </div>
        <h3 class="text-xl font-bold font-display tracking-tightest">{t('contacto.visit')}</h3>
        <p class="text-secondary-gray text-sm">{t('contacto.visitDesc')}</p>
        <p class="text-near-black font-bold font-display leading-relaxed">
          {t('contactoPage.addressLine1')}<br />{t('contactoPage.addressLine2')}
        </p>
        <span class="inline-flex items-center gap-1 text-forest text-sm font-bold">
          {t('contacto.visitCountry')}
        </span>
      </div>
    </section>

    <!-- Google Maps -->
    <section class="mb-24">
      <div class="aspect-2/1 rounded-[32px] overflow-hidden shadow-airbnb">
        <iframe
          src="https://maps.google.com/maps?ll=4.5255247,-74.3549159&q=Varsana+Eco+Yoga+Village+Granada+Cundinamarca&z=15&output=embed"
          width="100%"
          height="100%"
          style="border:0"
          loading="lazy"
          allowfullscreen
          title={t('contactoPage.mapTitle')}
        ></iframe>
      </div>
    </section>

    <!-- Contact Form -->
    <section class="mb-24 max-w-2xl mx-auto">
      <div class="text-center mb-10">
        <div class="inline-flex items-center gap-2 bg-rausch/10 text-rausch px-4 py-2 rounded-full text-sm font-bold mb-6">
          <Sparkles size={16} />
          <span>{t('contacto.formBadge')}</span>
        </div>
        <h2 class="text-3xl md:text-4xl font-bold font-display tracking-tightest mb-4">
          {t('contacto.formHeading')}
        </h2>
        <p class="text-secondary-gray text-lg">
          {t('contacto.formSubtitle')}
        </p>
      </div>

      <form
        id="contact-form"
        class="relative bg-lotus-white rounded-[24px] shadow-airbnb p-8 md:p-12 space-y-6"
        data-msg-sending={t('contactoPage.sending')}
        data-msg-success={t('contactoPage.success')}
        data-msg-error-prefix={t('contactoPage.errorPrefix')}
        data-msg-generic-error={t('contactoPage.genericError')}
        data-msg-connection-error={t('contactoPage.connectionError')}
        data-msg-submit={t('contacto.formSubmit')}
      >
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="space-y-2">
            <label for="nombre" class="text-sm font-bold text-near-black">{t('contacto.formName')}</label>
            <input
              type="text"
              id="nombre"
              name="nombre"
              required
              placeholder={t('contacto.formNamePlaceholder')}
              class="w-full rounded-xl border border-sacred-sand px-4 py-3 bg-sacred-sand/50 text-near-black placeholder:text-secondary-gray focus:outline-none focus:border-rausch focus:ring-2 focus:ring-rausch/10 transition-all"
            />
          </div>
          <div class="space-y-2">
            <label for="email" class="text-sm font-bold text-near-black">{t('contacto.formEmail')}</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              placeholder={t('contacto.formEmailPlaceholder')}
              class="w-full rounded-xl border border-sacred-sand px-4 py-3 bg-sacred-sand/50 text-near-black placeholder:text-secondary-gray focus:outline-none focus:border-rausch focus:ring-2 focus:ring-rausch/10 transition-all"
            />
          </div>
        </div>
        <div class="space-y-2">
          <label for="mensaje" class="text-sm font-bold text-near-black">{t('contacto.formMessage')}</label>
          <textarea
            id="mensaje"
            name="mensaje"
            rows={5}
            placeholder={t('contacto.formMessagePlaceholder')}
            class="w-full rounded-xl border border-sacred-sand px-4 py-3 bg-sacred-sand/50 text-near-black placeholder:text-secondary-gray focus:outline-none focus:border-rausch focus:ring-2 focus:ring-rausch/10 transition-all resize-y"
          ></textarea>
        </div>

        <!-- Honeypot anti-spam: oculto para personas, los bots suelen rellenarlo. El servidor descarta el envío si llega lleno. -->
        <div class="absolute -left-[9999px] w-px h-px overflow-hidden" aria-hidden="true">
          <label for="website">{t('contactoPage.honeypotLabel')}</label>
          <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
        </div>

        <p id="form-msg" class="hidden text-sm font-bold text-center" role="status" aria-live="polite"></p>
        <button
          type="submit"
          id="submit-btn"
          class="bg-rausch text-white px-10 py-4 rounded-2xl font-bold text-lg hover:bg-rausch-dark hover:scale-105 transition-all duration-300 shadow-lg inline-flex items-center gap-2"
        >
          <span data-submit-label>{t('contacto.formSubmit')}</span>
          <Send size={18} />
        </button>
      </form>
    </section>

    <!-- How to Get Here -->
    <section class="mb-16 bg-light-surface rounded-2xl p-8 md:p-16 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div class="space-y-8">
        <div>
          <div class="inline-flex items-center gap-2 bg-forest/10 text-forest px-4 py-2 rounded-full text-sm font-bold mb-6">
            <MapPin size={16} />
            <span>{t('contacto.howToBadge')}</span>
          </div>
          <h2 class="text-3xl md:text-4xl font-bold font-display tracking-tightest mb-4">
            {t('contacto.howToHeading')}
          </h2>
          <p class="text-secondary-gray text-lg">
            {t('contacto.howToSubtitle')}
          </p>
        </div>

        <div class="space-y-6">
          <div class="flex gap-4">
            <div class="w-10 h-10 rounded-xl bg-forest/10 flex items-center justify-center text-forest shrink-0 mt-1">
              <Car size={20} />
            </div>
            <div>
              <h4 class="font-bold text-lg font-display tracking-tightest mb-1">{t('contacto.byCar')}</h4>
              <p class="text-secondary-gray leading-relaxed">
                {t('contacto.byCarDesc')}
              </p>
            </div>
          </div>

          <div class="flex gap-4">
            <div class="w-10 h-10 rounded-xl bg-saffron/10 flex items-center justify-center text-saffron shrink-0 mt-1">
              <Bus size={20} />
            </div>
            <div>
              <h4 class="font-bold text-lg font-display tracking-tightest mb-1">{t('contacto.byBus')}</h4>
              <p class="text-secondary-gray leading-relaxed">
                {t('contacto.byBusDesc')}
              </p>
            </div>
          </div>

          <div class="flex gap-4">
            <div class="w-10 h-10 rounded-xl bg-rausch/10 flex items-center justify-center text-rausch shrink-0 mt-1">
              <Clock size={20} />
            </div>
            <div>
              <h4 class="font-bold text-lg font-display tracking-tightest mb-1">{t('contacto.arrivalTime')}</h4>
              <p class="text-secondary-gray leading-relaxed">
                {t('contacto.arrivalTimeDesc')}
              </p>
            </div>
          </div>
        </div>
      </div>

      <div class="relative aspect-3/4 rounded-[32px] overflow-hidden shadow-airbnb">
        <img
          src="https://picsum.photos/seed/road-varsana/800/1067"
          alt={t('contactoPage.roadImageAlt')}
          class="w-full h-full object-cover"
          referrerpolicy="no-referrer"
          loading="lazy"
        />
      </div>
    </section>
  </main>

</Layout>

<script>
  // Con <ClientRouter /> este módulo se ejecuta una sola vez por sesión:
  // la inicialización va en `astro:page-load` y se marca el form para no
  // registrar listeners duplicados.
  function initContactForm(): void {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const msg = document.getElementById('form-msg') as HTMLParagraphElement | null;
    const btn = document.getElementById('submit-btn') as HTMLButtonElement | null;
    if (!form || !msg || !btn || form.dataset.bound === 'true') return;
    form.dataset.bound = 'true';

    const label = btn.querySelector<HTMLSpanElement>('[data-submit-label]');
    const texts = {
      sending: form.dataset.msgSending ?? 'Enviando...',
      success: form.dataset.msgSuccess ?? '',
      errorPrefix: form.dataset.msgErrorPrefix ?? '',
      genericError: form.dataset.msgGenericError ?? '',
      connectionError: form.dataset.msgConnectionError ?? '',
      submit: form.dataset.msgSubmit ?? '',
    };

    const setLabel = (text: string) => {
      if (label) label.textContent = text;
      else btn.textContent = text;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      btn.disabled = true;
      setLabel(texts.sending);
      msg.className = 'hidden';

      try {
        const formData = new FormData(form);
        // El honeypot `website` viaja en el cuerpo; el servidor descarta el envío si viene lleno.
        if (!formData.has('website')) formData.set('website', '');

        const res = await fetch('/api/contact', { method: 'POST', body: formData });
        const data = (await res.json()) as { success: boolean; message?: string };

        if (data.success) {
          msg.textContent = texts.success;
          msg.className = 'text-sm font-bold text-center text-forest';
          form.reset();
        } else {
          msg.textContent = texts.errorPrefix + (data.message || texts.genericError);
          msg.className = 'text-sm font-bold text-center text-red-500';
        }
      } catch {
        msg.textContent = texts.connectionError;
        msg.className = 'text-sm font-bold text-center text-red-500';
      } finally {
        btn.disabled = false;
        setLabel(texts.submit);
      }
    });
  }

  document.addEventListener('astro:page-load', initContactForm);
</script>

<style>
  h1, h2, h3, h4 {
    letter-spacing: -0.02em;
  }
</style>
