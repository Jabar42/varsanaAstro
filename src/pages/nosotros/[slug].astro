---
import Layout from '@/src/layouts/Layout.astro';
import { getEntry, render } from 'astro:content';
import { Instagram, Twitter, Linkedin, Facebook, Youtube, Mail, Phone, Globe, ArrowLeft } from 'lucide-react';
import { getLocale, useTranslations, localizePath } from '@/src/i18n/utils';

const locale = getLocale(Astro);
const t = useTranslations(locale);
const l = (p: string) => localizePath(locale, p);

const { slug } = Astro.params;
const member = slug ? await getEntry('nosotros', slug) : undefined;
if (!member) return Astro.redirect(l('/404'));

const { nombre, rol, descripcion, imagen, enlaces_sociales, correo, telefono, categorias } = member.data;
const { Content } = await render(member);

const getSocialIcon = (platform: string) => {
  const normalized = platform.toLowerCase();
  switch (normalized) {
    case 'instagram': return Instagram;
    case 'twitter': case 'x': return Twitter;
    case 'linkedin': return Linkedin;
    case 'facebook': return Facebook;
    case 'youtube': return Youtube;
    default: return Globe;
  }
};

const canonicalURL = new URL(Astro.originPathname, Astro.site || 'https://varsana.com');
---

<Layout title={`${nombre} | ${t('memberDetail.titleSuffix')}`} description={descripcion}>
  <Fragment slot="head">
    <meta property="og:type" content="profile" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={nombre} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:image" content={imagen} />
    <meta name="twitter:card" content="summary_large_image" />
  </Fragment>

  <article class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 pt-8 md:pt-12">
    <!-- Back link -->
    <a href={l('/nosotros')} class="inline-flex items-center gap-2 text-secondary-gray hover:text-rausch transition-colors duration-300 mb-10 md:mb-14 text-sm font-medium">
      <ArrowLeft size={16} />
      {t('memberDetail.backToTeam')}
    </a>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-y-12 gap-x-12 lg:gap-x-20 items-start">
      <!-- Photo Column: el retrato se mira a través del arco -->
      <div class="lg:col-span-5 lg:sticky lg:top-28">
        <div class="arch shimmer aspect-4/5 w-full max-w-sm lg:max-w-none mx-auto bg-sand-deep">
          <img
            src={imagen}
            alt={nombre}
            class="portrait w-full h-full object-cover"
            referrerpolicy="no-referrer"
          />
        </div>
      </div>

      <!-- Content Column -->
      <div class="lg:col-span-7 lg:pt-10">
        <!-- Categories -->
        {categorias && categorias.length > 0 && (
          <div class="mb-6 flex flex-wrap gap-2">
            {categorias.map(cat => (
              <span class="px-3 py-1.5 bg-saffron/10 text-saffron-deep text-xs font-semibold rounded-full uppercase tracking-[0.14em]">
                {cat}
              </span>
            ))}
          </div>
        )}

        <h1 class="display-xl font-bold font-display text-near-black">{nombre}</h1>
        <p class="mt-5 text-lg md:text-xl text-saffron-deep font-medium leading-snug max-w-2xl">{rol}</p>
        <span class="rule-saffron mt-8" aria-hidden="true"></span>

        <!-- Full description from body -->
        <div class="member-body mt-8 max-w-2xl text-lg md:text-xl text-secondary-gray leading-relaxed">
          <Content />
        </div>

        <div class="mt-12 pt-8 border-t border-near-black/10 flex flex-wrap items-start justify-between gap-8">
          <!-- Contact -->
          <div class="space-y-3">
            <h3 class="eyebrow mb-4">{t('memberDetail.contact')}</h3>
            {telefono && (
              <a href={`tel:${telefono}`} class="flex items-center gap-3 text-near-black font-medium hover:text-forest-deep transition-colors duration-300">
                <Phone size={16} className="text-saffron-deep shrink-0" />
                <span>{telefono}</span>
              </a>
            )}
            {correo && (
              <a href={`mailto:${correo}`} class="flex items-center gap-3 text-near-black font-medium hover:text-forest-deep transition-colors duration-300 break-all">
                <Mail size={16} className="text-saffron-deep shrink-0" />
                <span>{correo}</span>
              </a>
            )}
          </div>

          <!-- Social Links -->
          {enlaces_sociales && enlaces_sociales.length > 0 && (
            <div class="flex items-center gap-3">
              {enlaces_sociales.map((enlace) => {
                const Icon = getSocialIcon(enlace.plataforma);
                return (
                  <a
                    href={enlace.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="w-11 h-11 rounded-full bg-forest/10 flex items-center justify-center text-forest-deep hover:bg-forest-dark hover:text-white transition-colors duration-300"
                    title={enlace.plataforma}
                  >
                    <Icon size={18} />
                  </a>
                );
              })}
            </div>
          )}
        </div>
      </div>
    </div>
  </article>
</Layout>

<style>
  .portrait {
    object-position: center top;
  }

  /* El cuerpo llega como párrafos sin clases. */
  .member-body :global(p + p) {
    margin-top: 1.25rem;
  }
  .member-body :global(a) {
    color: var(--color-rausch);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .member-body :global(strong) {
    color: var(--color-near-black);
  }
</style>
