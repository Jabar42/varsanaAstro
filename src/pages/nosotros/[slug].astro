---
import Layout from '@/src/layouts/Layout.astro';
import { getEntry, render } from 'astro:content';
import { Instagram, Twitter, Linkedin, Facebook, Youtube, Mail, Phone, Globe, ArrowLeft } from 'lucide-react';

const { slug } = Astro.params;
const member = await getEntry('nosotros', slug!);
if (!member) return Astro.redirect('/404');

const { nombre, rol, descripcion, imagen, enlaces_sociales, correo, telefono, categorias } = member.data;
const { Content } = await render(member);

const getSocialIcon = (platform: string) => {
  const normalized = platform.toLowerCase();
  switch (normalized) {
    case 'instagram': return Instagram;
    case 'twitter': case 'x': return Twitter;
    case 'linkedin': return Linkedin;
    case 'facebook': return Facebook;
    case 'youtube': return Youtube;
    default: return Globe;
  }
};

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://varsana.co');
---

<Layout title={`${nombre} | Equipo Varsana`} description={descripcion}>
  <Fragment slot="head">
    <meta property="og:type" content="profile" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={nombre} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:image" content={imagen} />
    <meta name="twitter:card" content="summary_large_image" />
  </Fragment>

  <main class="max-w-4xl mx-auto px-6 md:px-12 lg:px-20 py-8 md:py-12">
    <!-- Back link -->
    <a href="/nosotros" class="inline-flex items-center gap-2 text-secondary-gray hover:text-rausch transition-colors mb-8 text-sm font-medium">
      <ArrowLeft size={16} />
      Volver al equipo
    </a>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-12">
      <!-- Photo Column -->
      <div class="md:col-span-1">
        <div class="aspect-square rounded-2xl overflow-hidden shadow-airbnb bg-sacred-sand">
          <img
            src={imagen}
            alt={nombre}
            class="w-full h-full object-cover"
            referrerpolicy="no-referrer"
          />
        </div>

        <!-- Categories -->
        {categorias && categorias.length > 0 && (
          <div class="mt-6 flex flex-wrap gap-2">
            {categorias.map(cat => (
              <span class="px-3 py-1.5 bg-saffron/10 text-saffron text-xs font-semibold rounded-full uppercase tracking-wider">
                {cat}
              </span>
            ))}
          </div>
        )}

        <!-- Contact -->
        <div class="mt-6 space-y-3 p-5 bg-lotus-white rounded-2xl border border-sacred-sand">
          <h3 class="text-sm font-bold uppercase tracking-wider text-secondary-gray mb-3">Contacto</h3>
          {telefono && (
            <a href={`tel:${telefono}`} class="flex items-center gap-3 text-sm text-secondary-gray hover:text-saffron transition-colors">
              <Phone size={16} class="text-saffron shrink-0" />
              <span>{telefono}</span>
            </a>
          )}
          {correo && (
            <a href={`mailto:${correo}`} class="flex items-center gap-3 text-sm text-secondary-gray hover:text-saffron transition-colors">
              <Mail size={16} class="text-saffron shrink-0" />
              <span>{correo}</span>
            </a>
          )}
        </div>

        <!-- Social Links -->
        {enlaces_sociales && enlaces_sociales.length > 0 && (
          <div class="mt-4 flex items-center gap-3">
            {enlaces_sociales.map((enlace) => {
              const Icon = getSocialIcon(enlace.plataforma);
              return (
                <a
                  href={enlace.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-10 h-10 rounded-full bg-sacred-sand flex items-center justify-center text-secondary-gray hover:bg-saffron hover:text-white transition-colors"
                  title={enlace.plataforma}
                >
                  <Icon size={18} />
                </a>
              );
            })}
          </div>
        )}
      </div>

      <!-- Content Column -->
      <div class="md:col-span-2 space-y-8">
        <div class="border-b border-sacred-sand pb-6">
          <h1 class="text-4xl md:text-5xl font-bold tracking-tightest font-display mb-3">{nombre}</h1>
          <p class="text-xl text-saffron font-semibold">{rol}</p>
        </div>

        <!-- Full description from body -->
        <div class="prose prose-lg max-w-none text-secondary-gray leading-relaxed">
          <Content />
        </div>
      </div>
    </div>
  </main>
</Layout>

<style>
  h1, h2, h3 {
    letter-spacing: -0.02em;
  }
</style>
