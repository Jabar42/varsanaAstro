---
export const prerender = true;

import Layout from '@/src/layouts/Layout.astro';
import HeroBanner from '@/src/components/HeroBanner.astro';
import EventCard from '@/src/components/EventCard.astro';
import PhotoGallery from '@/src/components/PhotoGallery.astro';
import { ArrowUpRight } from 'lucide-react';
import { getUpcomingEvents } from '@/src/lib/events';
import { getFeaturedItems } from '@/src/lib/slider';

const upcomingEvents = await getUpcomingEvents();
const featuredEvents = upcomingEvents.slice(0, 3);

const featuredItems = await getFeaturedItems({
  collections: ['events', 'pasadias'],
});

const aboutVideoUrl = "https://www.youtube.com/embed/PLACEHOLDER";

const discoveryCards = [
  { title: 'Temazcal', slug: 'temazcal' },
  { title: 'Yoga', slug: 'yoga' },
  { title: 'Alimentación', slug: 'alimentacion' },
  { title: 'Huerta', slug: 'huerta' },
  { title: 'Cuevas', slug: 'cuevas' },
];
---

<Layout title="Varsana Eco Yoga Aldea | Eventos y Retiros">

  <HeroBanner items={featuredItems} />

  <main class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 pb-8">

    <!-- Brand Message -->
    <section class="py-20 md:py-28 text-center">
      <h2 class="text-3xl md:text-5xl lg:text-6xl font-bold font-display text-near-black leading-tight max-w-4xl mx-auto px-4">
        Mas que un lugar, <span class="text-saffron">es una forma de habitar el mundo</span>
      </h2>
      <p class="mt-6 text-lg md:text-xl text-gray-500 max-w-2xl mx-auto">
        Un espacio donde la naturaleza, la conciencia y la comunidad se encuentran.
      </p>
      <a
        href="/nosotros"
        class="mt-10 inline-block bg-rausch text-white px-10 py-4 rounded-2xl font-bold text-lg hover:bg-rausch-dark transition-all duration-300 hover:scale-105"
      >
        Conoce nuestra comunidad
      </a>
    </section>

    <!-- Discovery Cards -->
    <section class="py-20 md:py-28">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold font-display text-near-black text-center">
        Descubre Varsana
      </h2>
      <p class="text-lg text-gray-500 text-center mt-3 mb-10 md:mb-14">
        Experiencias que transforman
      </p>

      <!-- Mobile: horizontal slider -->
      <div class="flex sm:hidden overflow-x-auto snap-x snap-mandatory gap-4 no-scrollbar -mx-6 px-6 py-2 overscroll-x-contain">
        {discoveryCards.map((card) => (
          <a
            href={`/experiencias/${card.slug}`}
            draggable="false"
            class="group w-[40vw] flex-shrink-0 snap-start select-none"
          >
            <div class="aspect-[1/2] overflow-hidden rounded-lg relative shadow-airbnb transition-shadow duration-500">
              <img
                src={`https://picsum.photos/seed/${card.slug}/400/800`}
                alt={card.title}
                draggable="false"
                class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-in-out"
              />
              <div class="absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-black/60 to-transparent pointer-events-none rounded-b-lg" />
              <div class="absolute bottom-0 left-0 right-0 p-3 flex items-end justify-between">
                <span class="text-white font-bold text-sm">{card.title}</span>
                <ArrowUpRight color="white" size={18} strokeWidth={2.5} />
              </div>
            </div>
          </a>
        ))}
      </div>

      <!-- Tablet/Desktop: responsive grid -->
      <div class="hidden sm:grid grid-cols-3 lg:grid-cols-5 gap-4 md:gap-6">
        {discoveryCards.map((card) => (
          <a
            href={`/experiencias/${card.slug}`}
            class="group block"
          >
            <div class="aspect-[1/2] overflow-hidden rounded-2xl relative">
              <img
                src={`https://picsum.photos/seed/${card.slug}/400/800`}
                alt={card.title}
                class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition-transform duration-700 ease-in-out"
              />
              <div class="absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-black/60 to-transparent pointer-events-none rounded-b-2xl" />
              <div class="absolute bottom-0 left-0 right-0 p-4 flex items-end justify-between">
                <span class="text-white font-bold text-lg">{card.title}</span>
                <ArrowUpRight color="white" size={20} strokeWidth={2.5} />
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>



    <!-- Featured Events Grid -->
    <section class="mb-20">
      <div class="flex items-end justify-between mb-10">
        <div class="space-y-2">
          <h2 class="text-4xl md:text-5xl font-bold tracking-tightest font-display">Próximas Experiencias</h2>
          <p class="text-gray-500 text-lg">Los eventos más cercanos para tu transformación.</p>
        </div>
        <a href="/events" class="hidden md:block text-near-black font-semibold underline underline-offset-4 hover:text-rausch transition-colors">
          Ver todos los eventos
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {featuredEvents.map((event) => (
          <EventCard {...event.data} slug={event.id} />
        ))}
      </div>

      <div class="mt-12 text-center md:hidden">
        <a href="/events" class="inline-block w-full py-4 border border-near-black rounded-xl font-bold hover:bg-gray-50 transition-colors">
          Ver todos los eventos
        </a>
      </div>
    </section>

    <!-- About Video Section -->
    <section class="py-20 md:py-28">
      <div class="flex flex-col lg:flex-row items-center gap-12 lg:gap-16">
        <!-- Video -->
        <div class="w-full lg:w-7/12 bg-white rounded-[32px] shadow-airbnb p-3 hover:scale-[1.02] transition-all duration-700 ease-in-out">
          <div class="aspect-video rounded-2xl overflow-hidden">
            <iframe
              src={aboutVideoUrl}
              title="Sobre Varsana"
              class="w-full h-full"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            ></iframe>
          </div>
        </div>

        <!-- Text -->
        <div class="w-full lg:w-5/12 space-y-6 lg:space-y-8">
          <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold font-display text-near-black leading-tight">
            Más que un lugar, una forma de vivir
          </h2>
          <p class="text-lg text-gray-500 leading-relaxed max-w-lg">
            Varsana es una ecoaldea dedicada al bienestar integral, la vida conciente y la conexión espiritual. Aquí cultivamos la tierra, el cuerpo, la mente y el alma.
          </p>
          <a
            href="/nosotros"
            class="inline-block bg-rausch text-white px-10 py-4 rounded-2xl font-bold text-lg hover:bg-rausch-dark transition-all duration-300 hover:scale-105"
          >
            Conoce nuestra historia
          </a>
        </div>
      </div>
    </section>

    <!-- Huerta Split Banner -->
    <section class="-mx-6 md:-mx-12 lg:-mx-20">
      <div class="grid grid-cols-1 lg:grid-cols-2">
        <!-- Text Panel -->
        <div class="bg-forest/10 px-6 md:px-12 lg:px-20 py-16 lg:py-20 flex items-center">
          <div class="space-y-6 max-w-lg">
            <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold font-display text-near-black leading-tight">
              Cultivamos alimentos,<br />cultivamos conciencia
            </h2>
            <p class="text-secondary-gray text-lg leading-relaxed">
              En nuestra huerta orgánica producimos alimentos frescos, con prácticas sostenibles que cuidan la tierra y nuestra comunidad.
            </p>
            <a
              href="/huerta"
              class="inline-block bg-forest text-white px-10 py-4 rounded-2xl font-bold text-lg hover:bg-forest-dark transition-all duration-300 hover:scale-105"
            >
              Ver la Huerta
            </a>
          </div>
        </div>

        <!-- Image Panel -->
        <div class="aspect-[4/3] lg:aspect-auto lg:min-h-[500px] overflow-hidden">
          <img
            src="https://picsum.photos/seed/huerta/1200/900"
            alt="Huerta orgánica de Varsana"
            class="w-full h-full object-cover"
          />
        </div>
      </div>
    </section>

    <!-- Photo Gallery Section -->
    <PhotoGallery />

    <!-- Call to Action -->
    <section class="mt-24 bg-near-black rounded-[32px] md:rounded-lg p-8 md:p-16 lg:p-24 text-white flex flex-col lg:flex-row items-center justify-between gap-12 overflow-hidden relative shadow-airbnb text-center lg:text-left">
      <div class="space-y-8 z-10 max-w-2xl">
        <h1 class="text-3xl md:text-5xl lg:text-6xl font-bold leading-tight tracking-tightest">
          ¿Listo para tu transformación?
        </h1>
        <p class="text-gray-400 text-lg md:text-xl leading-relaxed">
          Únete a cientos de personas que han encontrado paz y propósito en nuestra aldea. Tu viaje comienza aquí.
        </p>
        <div class="flex flex-wrap gap-4 md:gap-6 justify-center lg:justify-start">
          <button class="w-full sm:w-auto bg-rausch hover:bg-rausch-dark text-white px-8 md:px-10 py-4 md:py-5 rounded-2xl font-bold text-lg transition-all hover:shadow-lg active:scale-95">
            Reservar ahora
          </button>
          <button class="w-full sm:w-auto bg-white/10 hover:bg-white/20 text-white border border-white/20 px-8 md:px-10 py-4 md:py-5 rounded-2xl font-bold text-lg transition-all">
            Contactar guía
          </button>
        </div>
      </div>
      <div class="relative w-full lg:w-1/2 aspect-video rounded-3xl overflow-hidden shadow-airbnb rotate-0 lg:rotate-2 hover:rotate-0 transition-transform duration-500">
        <img 
          src="https://picsum.photos/seed/meditation-cta/1200/750" 
          alt="Meditación" 
          class="w-full h-full object-cover"
          referrerpolicy="no-referrer"
        />
      </div>
    </section>
  </main>
</Layout>
