---

import Layout from '@/src/layouts/Layout.astro';
import HeroBanner from '@/src/components/HeroBanner.astro';
import SplitSection from '@/src/components/SplitSection.astro';
import EventCard from '@/src/components/EventCard.astro';
import { ArrowUpRight } from 'lucide-react';
import { getUpcomingEvents } from '@/src/lib/events';
import { getFeaturedItems } from '@/src/lib/slider';
import { useTranslations, getLocale, localizePath } from '@/src/i18n/utils';

const locale = getLocale(Astro);
const t = useTranslations(locale);
const l = (path: string) => localizePath(locale, path);

const upcomingEvents = await getUpcomingEvents(locale);
const featuredEvents = upcomingEvents.slice(0, 3);

const featuredItems = await getFeaturedItems({
  collections: ['events', 'pasadias'],
  locale,
});

// Tarjetas de descubrimiento. Alimentación apunta a la página completa /alimentacion
// (la ruta /experiencias/alimentacion es solo un placeholder "Próximamente").
const discoveryCards = [
  { title: t('home.cards.temazcal'), href: l('/experiencias/temazcal'), image: '/api/images/1783043616931-Temazcal.webp' },
  { title: t('home.cards.yoga'), href: l('/experiencias/yoga'), image: '/api/images/1783043619441-Yoga.webp' },
  { title: t('home.cards.alimentacion'), href: l('/alimentacion'), image: '/api/images/1783043620669-Alimentacion.webp' },
  { title: t('home.cards.huerta'), href: l('/experiencias/huerta'), image: '/api/images/1783043621950-Huerta.webp' },
  { title: t('home.cards.cuevas'), href: l('/experiencias/cuevas'), image: '/api/images/1783043618248-Cuevas.webp' },
];
---

<Layout title={t('home.pageTitle')} description={t('home.metaDescription')}>

  <HeroBanner items={featuredItems} />

  <!-- Brand Message -->
  <section class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 py-24 md:py-36">
    <div class="grid lg:grid-cols-12 gap-y-10 gap-x-12 items-end" data-reveal-group>
      <div class="lg:col-span-8">
        <span class="rule-saffron mb-8" data-reveal="draw" aria-hidden="true"></span>
        <h2 class="display-lg font-bold font-display text-near-black">
          {t('home.taglinePart1')} <span class="accent">{t('home.taglinePart2')}</span>
        </h2>
      </div>
      <div class="lg:col-span-4 lg:pb-2">
        <p class="text-lg md:text-xl text-secondary-gray leading-relaxed">
          {t('home.subtitle')}
        </p>
        <a href={l('/nosotros')} class="btn btn-lg btn-arrow mt-8">
          {t('home.ctaCommunity')}
        </a>
      </div>
    </div>
  </section>

  <!-- Discovery: columnata de arcos -->
  <section class="bg-sand-deep py-16 md:py-20 overflow-hidden">
    <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20">
      <div class="mb-12 md:mb-16" data-reveal-group>
        <p class="eyebrow mb-4">{t('home.discoverSubtitle')}</p>
        <h2 class="display-lg font-bold font-display text-near-black">
          {t('home.discoverTitle')}
        </h2>
      </div>

      <div class="colonnade no-scrollbar" data-reveal-group>
        {discoveryCards.map((card) => (
          <a href={card.href} draggable="false" class="colonnade__arch arch group">
            <img
              src={card.image}
              alt={card.title}
              draggable="false"
              loading="lazy"
              decoding="async"
            />
            <span class="colonnade__label">
              <span>{card.title}</span>
              <ArrowUpRight color="white" size={20} strokeWidth={2.25} />
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Featured Events Grid -->
  {featuredEvents.length > 0 && (
    <section class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 py-16 md:py-20">
      <div class="flex items-end justify-between gap-8 mb-12" data-reveal-group>
        <div>
          <h2 class="display-md font-bold font-display text-near-black">{t('home.upcomingTitle')}</h2>
          <p class="mt-3 text-secondary-gray text-lg">{t('home.upcomingSubtitle')}</p>
        </div>
        <a href={l('/events')} class="hidden md:block shrink-0 text-rausch font-semibold underline underline-offset-4 decoration-rausch/30 hover:decoration-rausch transition-colors duration-300">
          {t('home.viewAllEvents')}
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" data-reveal-group>
        {featuredEvents.map((event) => (
          <div><EventCard {...event.data} slug={event.id} /></div>
        ))}
      </div>

      <div class="mt-10 md:hidden">
        <a href={l('/events')} class="btn btn-outline btn-block">
          {t('home.viewAllEvents')}
        </a>
      </div>
    </section>
  )}

  <!-- About Video Section -->
  <SplitSection
    title={t('home.aboutTitle')}
    description={t('home.aboutText')}
    ctaLabel={t('home.aboutCta')}
    ctaUrl={l('/nosotros')}
    videoUrl="https://www.youtube.com/watch?v=2TXMwJ7FHgY"
    imageAlt={t('home.aboutVideoAlt')}
    tone="dark"
    reversed
  />

  <!-- Huerta Split Banner -->
  <SplitSection
    title={t('home.huertaTitle')}
    description={t('home.huertaText')}
    ctaLabel={t('home.huertaCta')}
    ctaUrl={l('/huerta')}
    imageSrc="/api/images/1785287604008-huerta-section.webp"
    imageAlt={t('home.huertaImageAlt')}
    background="bg-forest/10"
    reversed
  />

  <!-- Call to Action: el sitio se cierra con otro arco, pegado al footer
       (-mb-20 anula el margen superior del footer). -->
  <section class="final-cta pt-20 md:pt-28 -mb-20">
    <div class="final-cta__arch">
      <img
        src="/api/images/1785287866166-cta-transformacion.webp"
        alt={t('home.ctaImageAlt')}
        loading="lazy"
        decoding="async"
        referrerpolicy="no-referrer"
      />
      <div class="final-cta__content" data-reveal-group>
        <h1 class="display-lg font-bold font-display text-white">
          {t('home.ctaFinalTitle')}
        </h1>
        <p class="mt-6 text-sacred-sand/85 text-lg md:text-xl leading-relaxed max-w-xl mx-auto">
          {t('home.ctaFinalText')}
        </p>
        <a href={l('/contacto')} class="btn btn-lg btn-light btn-arrow mt-10">
          {t('home.ctaContact')}
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ── Columnata ───────────────────────────────────────────────
     Móvil: carrusel con snap. Escritorio: cinco arcos que ceden
     espacio al que recibe el cursor o el foco. */
  .colonnade {
    display: flex;
    gap: 0.875rem;
    margin-inline: -1.5rem;
    padding-inline: 1.5rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 1.5rem;
    overscroll-behavior-x: contain;
  }

  .colonnade__arch {
    position: relative;
    flex: 0 0 62vw;
    max-width: 17rem;
    height: clamp(22rem, 105vw, 28rem);
    scroll-snap-align: start;
    user-select: none;
    background: var(--color-forest-night);
  }

  .colonnade__arch img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--ease-out);
  }

  .colonnade__arch::after {
    content: "";
    position: absolute;
    inset: 45% 0 0;
    background: linear-gradient(to top, rgb(23 35 15 / 0.85), rgb(23 35 15 / 0));
    pointer-events: none;
  }

  .colonnade__label {
    position: absolute;
    inset: auto 0 0;
    z-index: 1;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 1.25rem;
    color: white;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .colonnade__label :global(svg) {
    flex: none;
    transition: transform 0.3s var(--ease-out);
  }

  .colonnade__arch:hover .colonnade__label :global(svg),
  .colonnade__arch:focus-visible .colonnade__label :global(svg) {
    transform: translate(3px, -3px);
  }

  .colonnade__arch:hover img,
  .colonnade__arch:focus-visible img {
    transform: scale(1.06);
  }

  @media (min-width: 768px) {
    .colonnade {
      gap: 1.25rem;
      margin-inline: 0;
      padding-inline: 0;
      overflow: visible;
    }

    .colonnade__arch {
      flex: 1 1 0;
      min-width: 0;
      max-width: none;
      height: clamp(24rem, 40vw, 34rem);
    }

    /* El reveal (html.js [data-reveal]) pisa `transition` en estos arcos:
       se repite acá, con más especificidad, junto al ensanche del hover. */
    .colonnade .colonnade__arch {
      transition:
        flex-grow 0.7s var(--ease-out),
        opacity 0.9s var(--ease-out) var(--rd, 0ms),
        transform 0.9s var(--ease-out) var(--rd, 0ms);
    }

    .colonnade__arch:hover,
    .colonnade__arch:focus-visible {
      flex-grow: 1.7;
    }
  }

  /* ── Cierre ─────────────────────────────────────────────────── */
  .final-cta {
    background: linear-gradient(to bottom, var(--color-sacred-sand) 50%, var(--color-forest-night) 50%);
  }

  .final-cta__arch {
    position: relative;
    display: grid;
    place-items: end center;
    min-height: clamp(34rem, 88svh, 46rem);
    margin-inline: clamp(0.75rem, 4vw, 4rem);
    overflow: hidden;
    border-radius: 50vw 50vw 0 0;
    background: var(--color-forest-night);
  }

  .final-cta__arch img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .final-cta__arch::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(23 35 15) 0%, rgb(23 35 15 / 0.7) 38%, rgb(23 35 15 / 0.15) 75%);
  }

  .final-cta__content {
    position: relative;
    z-index: 1;
    max-width: 46rem;
    padding: 0 1.5rem 4.5rem;
    text-align: center;
  }

  @media (prefers-reduced-motion: reduce) {
    .colonnade .colonnade__arch,
    .colonnade__arch img {
      transition: none;
    }
  }
</style>
