---
import '@/src/styles/global.css';
import { inject } from '@vercel/analytics';
import Header from '@/src/components/Header.astro';
import CategoryBar from '@/src/components/CategoryBar.astro';
import EventCard from '@/src/components/EventCard.astro';
import PhotoGallery from '@/src/components/PhotoGallery.astro';
import Footer from '@/src/components/Footer.astro';
import { getUpcomingEvents } from '@/src/lib/events';

inject();

const upcomingEvents = await getUpcomingEvents();
const featuredEvents = upcomingEvents.slice(0, 3);
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Varsana Eco Yoga Aldea | Eventos y Retiros</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
		<script>
			window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };
		</script>
		<script defer src="/_vercel/insights/script.js"></script>
	</head>
	<body class="bg-white text-near-black font-sans antialiased">
    <Header />
    <CategoryBar />

		<main class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 py-8">
      <!-- Hero Section -->
      <section class="mb-16 relative rounded-[32px] overflow-hidden h-[450px] md:h-[550px] shadow-airbnb">
        <img 
          src="https://picsum.photos/seed/varsana-hero/1920/1080" 
          alt="Varsana Eco Yoga Aldea" 
          class="w-full h-full object-cover"
          referrerpolicy="no-referrer"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/20 to-transparent flex flex-col items-center justify-center text-center p-6">
          <h1 class="text-white text-5xl md:text-8xl font-bold tracking-tightest mb-6 drop-shadow-xl font-display">
            Vive la experiencia Varsana
          </h1>
          <p class="text-white/90 text-xl md:text-2xl font-medium mb-10 max-w-2xl drop-shadow-md">
            Retiros, talleres y festivales diseñados para elevar tu consciencia.
          </p>
          <a href="/events" class="bg-rausch text-white px-10 py-4 rounded-full font-bold text-lg hover:scale-105 transition-transform shadow-2xl">
            Ver calendario completo
          </a>
        </div>
      </section>

      <!-- Featured Events Section -->
      <section class="mb-20">
        <div class="flex items-end justify-between mb-10">
          <div class="space-y-2">
            <h2 class="text-4xl md:text-5xl font-bold tracking-tightest font-display">Próximas Experiencias</h2>
            <p class="text-gray-500 text-lg">Los eventos más cercanos para tu transformación.</p>
          </div>
          <a href="/events" class="hidden md:block text-near-black font-semibold underline underline-offset-4 hover:text-rausch transition-colors">
            Ver todos los eventos
          </a>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {featuredEvents.map((event) => (
            <EventCard {...event.data} slug={event.id} />
          ))}
        </div>

        <div class="mt-12 text-center md:hidden">
          <a href="/events" class="inline-block w-full py-4 border border-near-black rounded-xl font-bold hover:bg-gray-50 transition-colors">
            Ver todos los eventos
          </a>
        </div>
      </section>

      <!-- Photo Gallery Section -->
      <PhotoGallery />

      <!-- Call to Action -->
      <section class="mt-24 bg-near-black rounded-[32px] md:rounded-[40px] p-8 md:p-16 lg:p-24 text-white flex flex-col lg:flex-row items-center justify-between gap-12 overflow-hidden relative shadow-2xl text-center lg:text-left">
        <div class="space-y-8 z-10 max-w-2xl">
          <h2 class="text-3xl md:text-5xl lg:text-6xl font-bold leading-tight tracking-tightest">
            ¿Listo para tu transformación?
          </h2>
          <p class="text-gray-400 text-lg md:text-xl leading-relaxed">
            Únete a cientos de personas que han encontrado paz y propósito en nuestra aldea. Tu viaje comienza aquí.
          </p>
          <div class="flex flex-wrap gap-4 md:gap-6 justify-center lg:justify-start">
            <button class="w-full sm:w-auto bg-rausch hover:bg-[#e00b41] text-white px-8 md:px-10 py-4 md:py-5 rounded-2xl font-bold text-lg transition-all hover:shadow-lg active:scale-95">
              Reservar ahora
            </button>
            <button class="w-full sm:w-auto bg-white/10 hover:bg-white/20 text-white border border-white/20 px-8 md:px-10 py-4 md:py-5 rounded-2xl font-bold text-lg transition-all">
              Contactar guía
            </button>
          </div>
        </div>
        <div class="relative w-full lg:w-1/2 aspect-video rounded-3xl overflow-hidden shadow-2xl rotate-0 lg:rotate-2 hover:rotate-0 transition-transform duration-500">
          <img 
            src="https://picsum.photos/seed/meditation-cta/1200/750" 
            alt="Meditación" 
            class="w-full h-full object-cover"
            referrerpolicy="no-referrer"
          />
        </div>
      </section>
		</main>

    <Footer />
	</body>
</html>
