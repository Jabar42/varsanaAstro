---
import Layout from '@/src/layouts/Layout.astro';
import { getEntry, render } from 'astro:content';
import { Calendar, User } from 'lucide-react';

const { slug } = Astro.params;
const post = await getEntry('blog', slug!);
if (!post) return Astro.redirect('/404');

const { title, description, image, date, author, tags = [] } = post.data;
const { Content } = await render(post);

const formattedDate = date.toLocaleDateString('es-ES', {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  year: 'numeric'
});

// SEO Data
const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://varsana.com');
---

<Layout title={`${title} | Varsana Eco Yoga Aldea`} description={description}>
  <Fragment slot="head">
    <!-- SEO / OpenGraph -->
    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="article:published_time" content={date.toISOString()} />
    {author && <meta property="article:author" content={author} />}
  </Fragment>

  <main class="max-w-7xl mx-auto px-0 md:px-12 lg:px-20 py-0 md:py-8">
    <!-- Hero Image -->
    <div class="md:rounded-[24px] overflow-hidden relative h-75 md:h-100 lg:h-125 shadow-airbnb">
      <img
        src={image}
        alt={title}
        class="w-full h-full object-cover"
        referrerpolicy="no-referrer"
      />
    </div>

    <div class="px-6 md:px-0 mt-8 grid grid-cols-1 lg:grid-cols-3 gap-12">
      <!-- Main Content -->
      <div class="lg:col-span-2 space-y-8">
        <div class="border-b border-sacred-sand pb-8">
          <h1 class="text-4xl md:text-5xl font-bold tracking-tightest mb-4 font-display">{title}</h1>
          <div class="flex flex-wrap gap-6 text-sm font-medium text-gray-500">
            <div class="flex items-center gap-2">
              <Calendar size={18} class="text-saffron" />
              <span>{formattedDate}</span>
            </div>
            <div class="flex items-center gap-2">
              <User size={18} class="text-saffron" />
              <span>{author}</span>
            </div>
          </div>
        </div>

        {tags.length > 0 && (
          <div class="flex flex-wrap gap-2">
            {tags.map((tag: string) => (
              <span class="bg-sacred-sand text-rausch text-sm px-4 py-1.5 rounded-full font-medium">
                {tag}
              </span>
            ))}
          </div>
        )}

        <!-- Article Body -->
        <div class="prose prose-zinc max-w-none text-gray-700 leading-relaxed text-lg">
          <Content />
        </div>
      </div>

      <!-- Sidebar -->
      <div class="relative">
        <div class="sticky top-28 bg-lotus-white border border-sacred-sand rounded-[24px] p-6 shadow-airbnb space-y-4">
          <h3 class="font-bold text-lg">Sobre el autor</h3>
          <div class="flex items-center gap-3">
            <div class="w-12 h-12 bg-gray-100 rounded-full flex items-center justify-center overflow-hidden">
              <img src="https://picsum.photos/seed/author/100/100" alt={author} class="w-full h-full object-cover" />
            </div>
            <div>
              <p class="font-bold text-sm">{author}</p>
              <p class="text-gray-500 text-xs">Comunidad Varsana</p>
            </div>
          </div>

          <div class="border-t border-sacred-sand pt-4">
            <p class="text-gray-500 text-sm">
              Historias, sabiduría y noticias de nuestra comunidad consciente en Granada, Cundinamarca.
            </p>
          </div>

          <a href={`${Astro.url.origin}/blog`} class="block text-center text-rausch font-bold text-sm underline mt-4">
            ← Volver al blog
          </a>
        </div>
      </div>
    </div>
  </main>
</Layout>

<style>
  h1, h2, h3, h4 {
    letter-spacing: -0.02em;
  }
</style>
