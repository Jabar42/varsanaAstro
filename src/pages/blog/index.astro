---
import Layout from '@/src/layouts/Layout.astro';
import BlogCard from '@/src/components/BlogCard.astro';
import { getAllPosts } from '@/src/lib/blog';
import { useTranslations } from '@/src/i18n/utils';

const locale = (Astro.locals as any)?.locale ?? Astro.currentLocale ?? 'es';
const t = useTranslations(locale);

const posts = await getAllPosts(locale);
---

<Layout title={t('blog.heading') + ' | Varsana Eco Yoga Aldea'}>
  <main class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 py-16">
    <div class="mb-12">
      <h1 class="text-5xl font-bold tracking-tightest mb-4">{t('blog.heading')}</h1>
      <p class="text-gray-500 text-xl">{t('blog.subtitle')}</p>
    </div>

    {posts.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-12">
        {posts.map((post) => (
          <BlogCard {...post.data} slug={post.id} />
        ))}
      </div>
    ) : (
      <div class="py-20 text-center bg-gray-50 rounded-3xl">
        <p class="text-2xl font-medium text-gray-400">{t('blog.noPosts')}</p>
        <a href="/" class="mt-6 inline-block text-rausch font-bold underline">{t('blog.backHome')}</a>
      </div>
    )}
  </main>
</Layout>
