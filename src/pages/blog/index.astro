---
import Layout from '@/src/layouts/Layout.astro';
import PageBanner from '@/src/components/PageBanner.astro';
import BlogCard from '@/src/components/BlogCard.astro';
import { getAllPosts } from '@/src/lib/blog';
import { useTranslations, getLocale, localizePath } from '@/src/i18n/utils';

const locale = getLocale(Astro);
const t = useTranslations(locale);
const l = (p: string) => localizePath(locale, p);

const posts = await getAllPosts(locale);
---

<Layout title={t('blog.heading') + ' | Varsana Eco Yoga Aldea'} description={t('blog.subtitle')}>
  <main class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 pt-6 md:pt-8 pb-4">
    <PageBanner
      title={t('blog.heading')}
      subtitle={t('blog.subtitle')}
      breadcrumb={[
        { label: t('nav.home'), url: l('/') },
        { label: t('nav.blog'), url: l('/blog') },
      ]}
    />

    {posts.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8 pt-12 md:pt-16" data-reveal-group>
        {posts.map((post, i) => {
          // Con tres o más entradas, la primera es la protagonista.
          const featured = i === 0 && posts.length >= 3;
          return (
            <div class:list={[featured && 'md:col-span-2 lg:row-span-2']}>
              <BlogCard {...post.data} slug={post.id} featured={featured} />
            </div>
          );
        })}
      </div>
    ) : (
      <div class="mt-12 py-20 px-6 text-center bg-sand-deep rounded-3xl">
        <p class="text-2xl font-medium font-display text-secondary-gray">{t('blog.noPosts')}</p>
        <a href={l('/')} class="mt-6 inline-block text-rausch font-semibold underline underline-offset-4 decoration-rausch/30 hover:decoration-rausch transition-colors duration-300">{t('blog.backHome')}</a>
      </div>
    )}
  </main>
</Layout>
