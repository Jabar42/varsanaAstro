---
import Layout from '@/src/layouts/Layout.astro';
import PageBanner from '@/src/components/PageBanner.astro';
import BlogCard from '@/src/components/BlogCard.astro';
import { getAllPosts } from '@/src/lib/blog';
import { useTranslations, getLocale, localizePath } from '@/src/i18n/utils';

const locale = getLocale(Astro);
const t = useTranslations(locale);
const l = (p: string) => localizePath(locale, p);

const posts = await getAllPosts(locale);
---

<Layout title={t('blog.heading') + ' | Varsana Eco Yoga Aldea'} description={t('blog.subtitle')}>
  <main class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 pt-6 md:pt-8 pb-16">
    <PageBanner
      title={t('blog.heading')}
      subtitle={t('blog.subtitle')}
      breadcrumb={[
        { label: t('nav.home'), url: l('/') },
        { label: t('nav.blog'), url: l('/blog') },
      ]}
    />

    {posts.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-12 mt-12">
        {posts.map((post) => (
          <BlogCard {...post.data} slug={post.id} />
        ))}
      </div>
    ) : (
      <div class="py-20 text-center bg-gray-50 rounded-3xl">
        <p class="text-2xl font-medium text-gray-400">{t('blog.noPosts')}</p>
        <a href={l('/')} class="mt-6 inline-block text-rausch font-bold underline">{t('blog.backHome')}</a>
      </div>
    )}
  </main>
</Layout>
