---
import Layout from '@/src/layouts/Layout.astro';
import { getLocale, useTranslations, localizePath } from '@/src/i18n/utils';
import { es as sitemapEs, en as sitemapEn } from '@/src/i18n/dictionaries/sitemapPage';
import {
  House,
  Users,
  Sparkles,
  Tent,
  Salad,
  Megaphone,
  Send,
  Store,
  Heart,
  Leaf,
  MapPin,
  Info,
  ArrowUpRight,
} from 'lucide-react';

const locale = getLocale(Astro);
const t = useTranslations(locale);
const l = (path: string) => localizePath(locale, path);

/** href e icono de cada enlace, en el mismo orden que el diccionario `sitemapPage.groups`. */
const linkMeta: { href: string; icon: typeof House }[][] = [
  [
    { href: '/', icon: House },
    { href: '/nosotros', icon: Users },
    { href: '/contacto', icon: Send },
  ],
  [
    { href: '/events', icon: Sparkles },
    { href: '/pasadias', icon: Leaf },
    { href: '/voluntariado', icon: Heart },
  ],
  [
    { href: '/hospedaje', icon: Tent },
    { href: '/alimentacion', icon: Salad },
    { href: '/tienda', icon: Store },
  ],
  [
    { href: '/donar', icon: Heart },
    { href: '/blog', icon: Megaphone },
    { href: '/design-system', icon: Info },
  ],
];

const groups = (locale === 'en' ? sitemapEn : sitemapEs).groups.map((group, gi) => ({
  heading: group.heading,
  links: group.links.map((link, li) => {
    const meta = linkMeta[gi]?.[li] ?? { href: '/', icon: Info };
    return { ...link, href: l(meta.href), icon: meta.icon };
  }),
}));
---

<Layout title={t('sitemap.title')} description={t('sitemap.subtitle')}>

  <main class="max-w-3xl mx-auto px-6 md:px-12 lg:px-20 py-12">
    <!-- Hero -->
    <section class="mb-16 text-center">
      <div class="inline-flex items-center gap-2 bg-saffron/10 text-saffron px-4 py-2 rounded-full text-sm font-bold mb-6">
        <MapPin size={16} />
        <span>{t('sitemap.badge')}</span>
      </div>
      <h1 class="text-4xl md:text-5xl font-bold tracking-tightest leading-tight mb-4">
        {t('sitemap.heading')}
      </h1>
      <p class="text-secondary-gray text-lg">
        {t('sitemap.subtitle')}
      </p>
    </section>

    <!-- Link Groups -->
    <section class="space-y-16 pb-20">
      {groups.map((group) => (
        <div>
          <h2 class="text-2xl font-bold font-display tracking-tightest mb-6 text-near-black">
            {group.heading}
          </h2>
          <div class="space-y-3">
            {group.links.map((link) => (
              <a
                href={link.href}
                class="flex items-center gap-5 bg-lotus-white rounded-[20px] shadow-airbnb px-6 py-5 hover:scale-[1.01] transition-all duration-300 group"
              >
                <div class="w-10 h-10 bg-rausch/10 rounded-xl flex items-center justify-center text-rausch shrink-0 group-hover:bg-rausch group-hover:text-white transition-colors duration-300">
                  <link.icon size={20} />
                </div>
                <div class="grow min-w-0">
                  <h3 class="font-bold font-display tracking-tightest text-near-black group-hover:text-rausch transition-colors">
                    {link.label}
                  </h3>
                  <p class="text-sm text-secondary-gray truncate">{link.description}</p>
                </div>
                <ArrowUpRight size={18} className="text-secondary-gray shrink-0 group-hover:text-rausch transition-colors" />
              </a>
            ))}
          </div>
        </div>
      ))}
    </section>
  </main>

</Layout>

<style>
  h1, h2, h3 {
    letter-spacing: -0.02em;
  }
</style>
