---
import Layout from '@/src/layouts/Layout.astro';
import { getLocale, useTranslations, localizePath } from '@/src/i18n/utils';
import { es as sitemapEs, en as sitemapEn } from '@/src/i18n/dictionaries/sitemapPage';
import {
  House,
  Users,
  Sparkles,
  Tent,
  Salad,
  Megaphone,
  Send,
  Store,
  Heart,
  Leaf,
  Info,
  ArrowUpRight,
} from 'lucide-react';

const locale = getLocale(Astro);
const t = useTranslations(locale);
const l = (path: string) => localizePath(locale, path);

/** href e icono de cada enlace, en el mismo orden que el diccionario `sitemapPage.groups`. */
const linkMeta: { href: string; icon: typeof House }[][] = [
  [
    { href: '/', icon: House },
    { href: '/nosotros', icon: Users },
    { href: '/contacto', icon: Send },
  ],
  [
    { href: '/events', icon: Sparkles },
    { href: '/pasadias', icon: Leaf },
    { href: '/voluntariado', icon: Heart },
  ],
  [
    { href: '/hospedaje', icon: Tent },
    { href: '/alimentacion', icon: Salad },
    { href: '/tienda', icon: Store },
  ],
  [
    { href: '/donar', icon: Heart },
    { href: '/blog', icon: Megaphone },
    { href: '/design-system', icon: Info },
  ],
];

const groups = (locale === 'en' ? sitemapEn : sitemapEs).groups.map((group, gi) => ({
  heading: group.heading,
  links: group.links.map((link, li) => {
    const meta = linkMeta[gi]?.[li] ?? { href: '/', icon: Info };
    return { ...link, href: l(meta.href), icon: meta.icon };
  }),
}));
---

<Layout title={t('sitemap.title')} description={t('sitemap.subtitle')}>

  <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 pt-14 md:pt-20 pb-4">
    <!-- Hero -->
    <section class="grid lg:grid-cols-12 gap-y-8 gap-x-12 items-end pb-14 md:pb-20">
      <div class="lg:col-span-8">
        <p class="eyebrow mb-5">{t('sitemap.badge')}</p>
        <h1 class="display-xl font-bold font-display text-near-black">
          {t('sitemap.heading')}
        </h1>
      </div>
      <div class="lg:col-span-4 lg:pb-3">
        <span class="rule-saffron mb-6" aria-hidden="true"></span>
        <p class="text-secondary-gray text-lg md:text-xl leading-relaxed">
          {t('sitemap.subtitle')}
        </p>
      </div>
    </section>

    <!-- Link Groups: índice en dos columnas, filas separadas por una línea -->
    <section class="grid grid-cols-1 md:grid-cols-2 gap-x-12 lg:gap-x-20 gap-y-14 md:gap-y-20">
      {groups.map((group) => (
        <div data-reveal>
          <h2 class="text-2xl md:text-3xl font-bold font-display mb-5 text-near-black">
            {group.heading}
          </h2>
          <div class="border-t border-near-black/15">
            {group.links.map((link) => (
              <a href={link.href} class="index-row group">
                <div class="index-row__icon">
                  <link.icon size={20} />
                </div>
                <div class="grow min-w-0">
                  <h3 class="index-row__label font-bold font-display text-lg text-near-black">
                    {link.label}
                  </h3>
                  <p class="text-sm text-secondary-gray">{link.description}</p>
                </div>
                <ArrowUpRight size={18} className="index-row__arrow shrink-0" />
              </a>
            ))}
          </div>
        </div>
      ))}
    </section>
  </div>

</Layout>

<style>
  h2, h3 {
    letter-spacing: -0.02em;
  }

  .index-row {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1.125rem 0.25rem;
    border-bottom: 1px solid rgb(34 34 34 / 0.1);
    transition: padding 0.4s var(--ease-out);
  }

  .index-row__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-DEFAULT);
    background: rgb(119 155 5 / 0.1);
    color: var(--color-forest-deep);
    transition: background-color 0.3s var(--ease-out), color 0.3s var(--ease-out);
  }

  .index-row__label {
    transition: color 0.3s var(--ease-out);
  }

  .index-row :global(.index-row__arrow) {
    color: var(--color-secondary-gray);
    transition: transform 0.3s var(--ease-out), color 0.3s var(--ease-out);
  }

  .index-row:hover .index-row__icon,
  .index-row:focus-visible .index-row__icon {
    background: var(--color-forest-dark);
    color: var(--color-lotus-white);
  }

  .index-row:hover .index-row__label,
  .index-row:focus-visible .index-row__label {
    color: var(--color-forest-deep);
  }

  .index-row:hover :global(.index-row__arrow),
  .index-row:focus-visible :global(.index-row__arrow) {
    color: var(--color-forest-deep);
    transform: translate(3px, -3px);
  }

  @media (prefers-reduced-motion: reduce) {
    .index-row :global(.index-row__arrow) {
      transition: none;
    }
    .index-row:hover :global(.index-row__arrow) {
      transform: none;
    }
  }
</style>
