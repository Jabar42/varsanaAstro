---
export const prerender = true;

import Layout from '@/src/layouts/Layout.astro';
import {
  Globe,
  Sun,
  TreePine,
  Mountain,
  Droplets,
  Flower2,
  Wind,
  MapPin,
  CheckCircle2,
  Sparkles,
} from 'lucide-react';

const aldeas = [
  {
    name: 'Aldea Solar',
    icon: Sun,
    location: 'Sierra Nevada de Santa Marta, Colombia',
    image: 'https://picsum.photos/seed/aldea-solar/800/600',
    description: 'Comunidad autosuficiente que vive con energía solar y agricultura biodinámica. Referente de permacultura en la región caribe.',
    features: ['Energía solar', 'Permacultura', 'Retiros de yoga'],
    accent: 'saffron',
  },
  {
    name: 'Tierra Viva',
    icon: TreePine,
    location: 'Valle de Sibundoy, Putumayo, Colombia',
    image: 'https://picsum.photos/seed/tierra-viva/800/600',
    description: 'Aldea indígena y mestiza dedicada a la preservación de plantas medicinales amazónicas y saberes ancestrales.',
    features: ['Medicina ancestral', 'Reforestación', 'Trueque comunitario'],
    accent: 'forest',
  },
  {
    name: 'Monte Sagrado',
    icon: Mountain,
    location: 'Cajamarca, Perú',
    image: 'https://picsum.photos/seed/monte-sagrado/800/600',
    description: 'Santuario ecológico enclavado en los Andes. Protegen más de 200 hectáreas de bosque nativo y fuentes de agua.',
    features: ['Reserva natural', 'Agua de manantial', 'Temazcal'],
    accent: 'rausch',
  },
  {
    name: 'Raíces del Agua',
    icon: Droplets,
    location: 'Guatapé, Antioquia, Colombia',
    image: 'https://picsum.photos/seed/raices-agua/800/600',
    description: 'Proyecto agroecológico a orillas del embalse. Cultivan alimentos orgánicos y realizan formación en bioconstrucción.',
    features: ['Bioconstrucción', 'Huerta orgánica', 'Cursos y talleres'],
    accent: 'saffron',
  },
  {
    name: 'Casa Gaia',
    icon: Flower2,
    location: 'Vilcabamba, Ecuador',
    image: 'https://picsum.photos/seed/casa-gaia/800/600',
    description: 'Comunidad internacional que integra alimentación viva, arte terapia y diseño regenerativo en el valle de la longevidad.',
    features: ['Alimentación viva', 'Arte terapia', 'Diseño regenerativo'],
    accent: 'forest',
  },
  {
    name: 'Semillas del Viento',
    icon: Wind,
    location: 'La Guajira, Colombia',
    image: 'https://picsum.photos/seed/semillas-viento/800/600',
    description: 'Iniciativa wayuu de soberanía alimentaria que combina técnicas tradicionales de cultivo en el desierto con energía eólica.',
    features: ['Soberanía alimentaria', 'Energía eólica', 'Cultura wayuu'],
    accent: 'rausch',
  },
];

const accentStyles: Record<string, { iconBg: string; iconText: string; badge: string; topBorder: string }> = {
  saffron: { iconBg: 'bg-saffron/10', iconText: 'text-saffron', badge: 'bg-saffron/10 text-saffron', topBorder: 'border-t-saffron/20' },
  rausch: { iconBg: 'bg-rausch/10', iconText: 'text-rausch', badge: 'bg-rausch/10 text-rausch', topBorder: 'border-t-rausch/20' },
  forest: { iconBg: 'bg-forest/10', iconText: 'text-forest', badge: 'bg-forest/10 text-forest', topBorder: 'border-t-forest/20' },
};
---

<Layout title="Red de Eco Aldeas | Varsana Eco Yoga Aldea">

  <main class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 py-12">
    <!-- Hero -->
    <section class="mb-20 text-center max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 bg-saffron/10 text-saffron px-4 py-2 rounded-full text-sm font-bold mb-6">
        <Globe size={16} />
        <span>Red de eco aldeas</span>
      </div>
      <h1 class="text-4xl md:text-6xl font-bold tracking-tightest leading-tight mb-6">
        Red de Eco Aldeas
      </h1>
      <p class="text-secondary-gray text-xl leading-relaxed">
        Comunidades hermanas que comparten nuestra visión de un mundo más consciente, sostenible y conectado con la tierra. Descubre espacios donde florece una nueva forma de habitar el planeta.
      </p>
    </section>

    <!-- Eco-village Cards Grid -->
    <section class="mb-16">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {aldeas.map((aldea) => {
          const s = accentStyles[aldea.accent] ?? accentStyles.forest;
          return (
            <div class="bg-lotus-white rounded-[24px] shadow-airbnb overflow-hidden flex flex-col h-full group hover:scale-[1.02] transition-all duration-600 cursor-pointer">
              <div class="aspect-[4/3] overflow-hidden relative">
                <img
                  src={aldea.image}
                  alt={aldea.name}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                  referrerpolicy="no-referrer"
                  loading="lazy"
                />
                <div class="absolute top-4 left-4 flex items-center gap-1.5 bg-lotus-white/90 backdrop-blur-sm px-3 py-1.5 rounded-full text-xs font-bold shadow-sm">
                  <MapPin size={12} class="text-rausch" />
                  <span class="text-secondary-gray truncate max-w-[180px]">{aldea.location}</span>
                </div>
              </div>

              <div class="p-6 flex flex-col flex-grow space-y-4">
                <div class="flex items-center gap-3">
                  <div class={`w-10 h-10 ${s.iconBg} rounded-xl flex items-center justify-center ${s.iconText}`}>
                    <aldea.icon size={20} />
                  </div>
                  <h3 class="text-xl font-bold font-display tracking-tightest">{aldea.name}</h3>
                </div>

                <p class="text-secondary-gray text-sm leading-relaxed flex-grow">{aldea.description}</p>

                <div class={`border-t pt-4 space-y-2 ${s.topBorder}`}>
                  <ul class="space-y-1.5">
                    {aldea.features.map((feat) => (
                      <li class="flex items-center gap-2 text-sm text-secondary-gray">
                        <CheckCircle2 size={14} class="text-forest shrink-0" />
                        <span>{feat}</span>
                      </li>
                    ))}
                  </ul>

                  <span class={`inline-flex items-center gap-1.5 mt-3 px-3 py-1.5 rounded-full text-xs font-bold ${s.badge}`}>
                    <Sparkles size={12} />
                    Eco aldea
                  </span>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </section>

    <!-- Info note -->
    <section class="text-center pb-12">
      <p class="text-secondary-gray text-sm italic">
        Próximamente: conoce más eco aldeas, filtra por región y descubre cómo visitarlas o colaborar con ellas.
      </p>
    </section>
  </main>

</Layout>

<style>
  h1, h2, h3 {
    letter-spacing: -0.02em;
  }
</style>
