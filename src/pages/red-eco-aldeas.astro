---
import Layout from '@/src/layouts/Layout.astro';
import { getLocale, useTranslations } from '@/src/i18n/utils';
import { es as redEs, en as redEn } from '@/src/i18n/dictionaries/redPage';
import {
  Globe,
  Sun,
  TreePine,
  Mountain,
  Droplets,
  Flower2,
  Wind,
  MapPin,
  CheckCircle2,
  Sparkles,
} from 'lucide-react';

const locale = getLocale(Astro);
const t = useTranslations(locale);

type Accent = 'saffron' | 'forest' | 'rausch';

/** Datos no traducibles de cada aldea, en el mismo orden que el diccionario `redPage.aldeas`. */
const aldeaMeta: { icon: typeof Sun; image: string; accent: Accent }[] = [
  { icon: Sun, image: 'https://picsum.photos/seed/aldea-solar/800/600', accent: 'saffron' },
  { icon: TreePine, image: 'https://picsum.photos/seed/tierra-viva/800/600', accent: 'forest' },
  { icon: Mountain, image: 'https://picsum.photos/seed/monte-sagrado/800/600', accent: 'rausch' },
  { icon: Droplets, image: 'https://picsum.photos/seed/raices-agua/800/600', accent: 'saffron' },
  { icon: Flower2, image: 'https://picsum.photos/seed/casa-gaia/800/600', accent: 'forest' },
  { icon: Wind, image: 'https://picsum.photos/seed/semillas-viento/800/600', accent: 'rausch' },
];

const aldeas = (locale === 'en' ? redEn : redEs).aldeas.map((aldea, i) => ({
  ...aldea,
  ...(aldeaMeta[i] ?? { icon: Globe, image: '', accent: 'forest' as Accent }),
}));

const accentStyles: Record<Accent, { iconBg: string; iconText: string; badge: string; topBorder: string }> = {
  saffron: { iconBg: 'bg-saffron/10', iconText: 'text-saffron', badge: 'bg-saffron/10 text-saffron', topBorder: 'border-t-saffron/20' },
  rausch: { iconBg: 'bg-rausch/10', iconText: 'text-rausch', badge: 'bg-rausch/10 text-rausch', topBorder: 'border-t-rausch/20' },
  forest: { iconBg: 'bg-forest/10', iconText: 'text-forest', badge: 'bg-forest/10 text-forest', topBorder: 'border-t-forest/20' },
};
---

<Layout title={t('red.title')} description={t('red.subtitle')}>

  <main class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 py-12">
    <!-- Hero -->
    <section class="mb-20 text-center max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 bg-saffron/10 text-saffron px-4 py-2 rounded-full text-sm font-bold mb-6">
        <Globe size={16} />
        <span>{t('red.badge')}</span>
      </div>
      <h1 class="text-4xl md:text-6xl font-bold tracking-tightest leading-tight mb-6">
        {t('red.heading')}
      </h1>
      <p class="text-secondary-gray text-xl leading-relaxed">
        {t('red.subtitle')}
      </p>
    </section>

    <!-- Eco-village Cards Grid -->
    <section class="mb-16">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {aldeas.map((aldea) => {
          const s = accentStyles[aldea.accent] ?? accentStyles.forest;
          return (
            <div class="bg-lotus-white rounded-[24px] shadow-airbnb overflow-hidden flex flex-col h-full group hover:scale-[1.02] transition-all duration-600 cursor-pointer">
              <div class="aspect-4/3 overflow-hidden relative">
                <img
                  src={aldea.image}
                  alt={aldea.name}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                  referrerpolicy="no-referrer"
                  loading="lazy"
                />
                <div class="absolute top-4 left-4 flex items-center gap-1.5 bg-lotus-white/90 backdrop-blur-sm px-3 py-1.5 rounded-full text-xs font-bold shadow-sm">
                  <MapPin size={12} className="text-rausch" />
                  <span class="text-secondary-gray truncate max-w-45">{aldea.location}</span>
                </div>
              </div>

              <div class="p-6 flex flex-col grow space-y-4">
                <div class="flex items-center gap-3">
                  <div class={`w-10 h-10 ${s.iconBg} rounded-xl flex items-center justify-center ${s.iconText}`}>
                    <aldea.icon size={20} />
                  </div>
                  <h3 class="text-xl font-bold font-display tracking-tightest">{aldea.name}</h3>
                </div>

                <p class="text-secondary-gray text-sm leading-relaxed grow">{aldea.description}</p>

                <div class={`border-t pt-4 space-y-2 ${s.topBorder}`}>
                  <ul class="space-y-1.5">
                    {aldea.features.map((feat) => (
                      <li class="flex items-center gap-2 text-sm text-secondary-gray">
                        <CheckCircle2 size={14} className="text-forest shrink-0" />
                        <span>{feat}</span>
                      </li>
                    ))}
                  </ul>

                  <span class={`inline-flex items-center gap-1.5 mt-3 px-3 py-1.5 rounded-full text-xs font-bold ${s.badge}`}>
                    <Sparkles size={12} />
                    {t('red.ecoAldeaBadge')}
                  </span>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </section>

    <!-- Info note -->
    <section class="text-center pb-12">
      <p class="text-secondary-gray text-sm italic">
        {t('red.upcomingNote')}
      </p>
    </section>
  </main>

</Layout>

<style>
  h1, h2, h3 {
    letter-spacing: -0.02em;
  }
</style>
