---
import Layout from '@/src/layouts/Layout.astro';
import { getLocale, useTranslations } from '@/src/i18n/utils';
import { es as redEs, en as redEn } from '@/src/i18n/dictionaries/redPage';
import {
  Globe,
  Sun,
  TreePine,
  Mountain,
  Droplets,
  Flower2,
  Wind,
  MapPin,
  CheckCircle2,
  Sparkles,
} from 'lucide-react';

const locale = getLocale(Astro);
const t = useTranslations(locale);

type Accent = 'saffron' | 'forest' | 'rausch';

/** Datos no traducibles de cada aldea, en el mismo orden que el diccionario `redPage.aldeas`. */
const aldeaMeta: { icon: typeof Sun; image: string; accent: Accent }[] = [
  { icon: Sun, image: 'https://picsum.photos/seed/aldea-solar/800/600', accent: 'saffron' },
  { icon: TreePine, image: 'https://picsum.photos/seed/tierra-viva/800/600', accent: 'forest' },
  { icon: Mountain, image: 'https://picsum.photos/seed/monte-sagrado/800/600', accent: 'rausch' },
  { icon: Droplets, image: 'https://picsum.photos/seed/raices-agua/800/600', accent: 'saffron' },
  { icon: Flower2, image: 'https://picsum.photos/seed/casa-gaia/800/600', accent: 'forest' },
  { icon: Wind, image: 'https://picsum.photos/seed/semillas-viento/800/600', accent: 'rausch' },
];

const aldeas = (locale === 'en' ? redEn : redEs).aldeas.map((aldea, i) => ({
  ...aldea,
  ...(aldeaMeta[i] ?? { icon: Globe, image: '', accent: 'forest' as Accent }),
}));

const accentStyles: Record<Accent, { iconBg: string; iconText: string; badge: string; topBorder: string }> = {
  saffron: { iconBg: 'bg-saffron/10', iconText: 'text-saffron-deep', badge: 'bg-saffron/10 text-saffron-deep', topBorder: 'border-t-near-black/10' },
  rausch: { iconBg: 'bg-forest/10', iconText: 'text-forest-deep', badge: 'bg-forest/10 text-forest-deep', topBorder: 'border-t-near-black/10' },
  forest: { iconBg: 'bg-forest/10', iconText: 'text-forest-deep', badge: 'bg-forest/10 text-forest-deep', topBorder: 'border-t-near-black/10' },
};
---

<Layout title={t('red.title')} description={t('red.subtitle')}>

  <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 pt-14 md:pt-20 pb-4">
    <!-- Hero -->
    <section class="grid lg:grid-cols-12 gap-y-8 gap-x-12 items-end pb-14 md:pb-20">
      <div class="lg:col-span-8">
        <p class="eyebrow mb-5">{t('red.badge')}</p>
        <h1 class="display-xl font-bold font-display text-near-black">
          {t('red.heading')}
        </h1>
      </div>
      <div class="lg:col-span-4 lg:pb-3">
        <span class="rule-saffron mb-6" aria-hidden="true"></span>
        <p class="text-secondary-gray text-lg md:text-xl leading-relaxed">
          {t('red.subtitle')}
        </p>
      </div>
    </section>

    <!-- Eco-village Cards Grid -->
    <section>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8" data-reveal-group>
        {aldeas.map((aldea) => {
          const s = accentStyles[aldea.accent] ?? accentStyles.forest;
          return (
            <div class="bg-lotus-white rounded-3xl ring-1 ring-near-black/5 overflow-hidden flex flex-col h-full group">
              <div class="aspect-4/3 overflow-hidden relative shimmer">
                <img
                  src={aldea.image}
                  alt={aldea.name}
                  class="aldea-image w-full h-full object-cover"
                  referrerpolicy="no-referrer"
                  loading="lazy"
                />
                <div class="absolute top-4 left-4 flex items-center gap-1.5 bg-lotus-white px-3 py-1.5 rounded-full text-xs font-bold">
                  <MapPin size={12} className="text-forest-deep" />
                  <span class="text-forest-deep truncate max-w-45">{aldea.location}</span>
                </div>
              </div>

              <div class="p-6 md:p-7 flex flex-col grow space-y-4">
                <div class="flex items-center gap-3">
                  <div class={`w-11 h-11 ${s.iconBg} rounded-2xl flex items-center justify-center shrink-0 ${s.iconText}`}>
                    <aldea.icon size={20} />
                  </div>
                  <h3 class="text-2xl font-bold font-display leading-tight">{aldea.name}</h3>
                </div>

                <p class="text-secondary-gray text-sm leading-relaxed grow">{aldea.description}</p>

                <div class={`border-t pt-4 space-y-2 ${s.topBorder}`}>
                  <ul class="space-y-1.5">
                    {aldea.features.map((feat) => (
                      <li class="flex items-center gap-2 text-sm text-secondary-gray">
                        <CheckCircle2 size={14} className="text-forest-dark shrink-0" />
                        <span>{feat}</span>
                      </li>
                    ))}
                  </ul>

                  <span class={`inline-flex items-center gap-1.5 mt-3 px-3 py-1.5 rounded-full text-xs font-bold ${s.badge}`}>
                    <Sparkles size={12} />
                    {t('red.ecoAldeaBadge')}
                  </span>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </section>

    <!-- Info note -->
    <section class="pt-14 md:pt-16 flex items-center gap-5">
      <span class="rule-saffron shrink-0" aria-hidden="true"></span>
      <p class="text-secondary-gray text-sm italic">
        {t('red.upcomingNote')}
      </p>
    </section>
  </div>

</Layout>

<style>
  h3 {
    letter-spacing: -0.02em;
  }

  .aldea-image {
    transition: transform 1.2s var(--ease-out);
  }

  .group:hover .aldea-image {
    transform: scale(1.06);
  }

  @media (prefers-reduced-motion: reduce) {
    .aldea-image {
      transition: none;
    }
    .group:hover .aldea-image {
      transform: none;
    }
  }
</style>
