---

import Layout from '@/src/layouts/Layout.astro';
import PageBanner from '@/src/components/PageBanner.astro';
import { Leaf, Users, Heart, Coffee, Home, Info, CheckCircle2 } from 'lucide-react';

const activities = [
  { title: "Agricultura Orgánica", description: "Participa en la siembra, cuidado y cosecha de alimentos saludables en nuestra huerta.", icon: Leaf },
  { title: "Cocina Vegetariana", description: "Aprende el arte de la cocina consciente y saludable preparando alimentos para la community.", icon: Coffee },
  { title: "Mantenimiento y Bioconstrucción", description: "Ayuda en el mejoramiento de las instalaciones usando técnicas sostenibles.", icon: Home },
  { title: "Proyectos Especiales", description: "Si tienes habilidades en diseño, comunicaciones o artes, puedes aportar a la visibilidad de la aldea.", icon: Heart },
];

const includes = [
  "Alojamiento en la eco-aldea",
  "Alimentación vegetariana completa (3 comidas al día)",
  "Participación en programas de yoga y meditación",
  "Conexión profunda con la naturaleza",
  "Descubrimiento de nuevas habilidades sostenibles",
];
---

<Layout title="Programa de Voluntariado | Varsana Eco Yoga Aldea">

  <main class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 pt-6 md:pt-8 pb-12">
    <!-- Page Banner -->
    <PageBanner
      title="Programa de Voluntariado Cerca a Bogotá"
      subtitle="Una experiencia especial para quienes desean vivir en una eco-aldea, conectar con la naturaleza y descubrir nuevas habilidades."
      breadcrumb={[
        { label: 'Inicio', url: '/' },
        { label: 'Voluntariado', url: '/voluntariado' },
      ]}
    />

    <!-- CTA row -->
    <div class="flex flex-wrap justify-center gap-4 mt-8 mb-16">
      <button class="bg-rausch text-white px-8 py-4 rounded-2xl font-bold text-lg hover:scale-105 transition-transform shadow-lg">
        Inscribirme ahora
      </button>
      <button class="border border-near-black px-8 py-4 rounded-2xl font-bold text-lg hover:bg-gray-50 transition-colors">
        Ver actividades
      </button>
    </div>

    <!-- Activities Grid -->
    <section class="mb-24">
      <div class="mb-12">
        <h2 class="text-3xl font-bold tracking-tightest mb-4">¿Qué harás como voluntario?</h2>
        <p class="text-gray-500 text-lg">Participa en actividades sostenibles y descubre el ritmo de la vida consciente.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        {activities.map((act) => (
          <div class="p-8 bg-lotus-white border border-sacred-sand rounded-[24px] shadow-airbnb hover:shadow-airbnb-hover transition-shadow space-y-4">
            <div class="w-12 h-12 bg-rausch/10 rounded-xl flex items-center justify-center text-rausch">
              <act.icon size={24} />
            </div>
            <h3 class="text-xl font-bold tracking-tightest">{act.title}</h3>
            <p class="text-gray-500 text-sm leading-relaxed">{act.description}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- What's Included -->
    <section class="mb-24 bg-light-surface rounded-lg p-8 md:p-16 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div class="space-y-8">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tightest">Tu estancia incluye</h2>
        <ul class="space-y-4">
          {includes.map((item) => (
            <li class="flex items-center gap-4 text-lg font-medium">
              <CheckCircle2 className="text-rausch shrink-0" size={24} />
              <span>{item}</span>
            </li>
          ))}
        </ul>
        <div class="pt-4">
          <div class="flex items-center gap-4 p-6 bg-lotus-white rounded-2xl border border-sacred-sand shadow-airbnb">
            <Info className="text-rausch shrink-0" size={32} />
            <p class="text-sm text-gray-600">
              Buscamos voluntarios comprometidos, con ganas de aprender y compartir en un ambiente de respeto y espiritualidad.
            </p>
          </div>
        </div>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <img src="https://picsum.photos/seed/garden2/600/800" class="rounded-3xl shadow-md" alt="Huerta" referrerpolicy="no-referrer" />
        <img src="https://picsum.photos/seed/community2/600/800" class="rounded-3xl shadow-md mt-8" alt="Comunidad" referrerpolicy="no-referrer" />
      </div>
    </section>

    <!-- FAQ / Info Section -->
    <section class="max-w-3xl mx-auto mb-24 space-y-12">
      <div class="text-center">
        <h2 class="text-3xl font-bold tracking-tightest mb-4">Preguntas Frecuentes</h2>
        <p class="text-gray-500">Todo lo que necesitas saber antes de venir.</p>
      </div>
      <div class="space-y-6">
        <div class="border-b border-sacred-sand pb-6">
          <h4 class="font-bold text-lg mb-2">¿Qué debo traer?</h4>
          <p class="text-gray-600">Ropa cómoda para trabajo de campo, botas de caucho, linterna, artículos de aseo personal biodegradables y muchas ganas de aprender.</p>
        </div>
        <div class="border-b border-sacred-sand pb-6">
          <h4 class="font-bold text-lg mb-2">¿Hay requisitos de alimentación?</h4>
          <p class="text-gray-600">En Varsana seguimos una dieta vegetariana consciente. No se permite el consumo de carne, huevos, alcohol ni tabaco dentro de la aldea.</p>
        </div>
        <div class="border-b border-sacred-sand pb-6">
          <h4 class="font-bold text-lg mb-2">¿Cuál es la duración mínima?</h4>
          <p class="text-gray-600">Recomendamos una estancia mínima de una semana para poder integrarte plenamente en las actividades y el ritmo de la comunidad.</p>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  h1, h2, h3, h4 {
    letter-spacing: -0.02em;
  }
</style>
