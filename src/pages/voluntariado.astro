---
import { getLocale, useTranslations, localizePath, formatCOP } from '@/src/i18n/utils';
import Layout from '@/src/layouts/Layout.astro';
import PageBanner from '@/src/components/PageBanner.astro';
import { Info, CheckCircle2, Clock, Wallet, Backpack, Sun } from 'lucide-react';
import { es as volEs, en as volEn } from '@/src/i18n/dictionaries/voluntariadoPage';

const locale = getLocale(Astro);
const t = useTranslations(locale);
const l = (path: string) => localizePath(locale, path);
const dict = locale === 'en' ? volEn : volEs;

const BANNER_IMAGE = '/api/images/1786983811308-banner-voluntariado.webp';
const IMG_INTRO = '/api/images/1786983824550-carrusel-1-voluntariado.webp';
const IMG_ACTIVIDADES = '/api/images/1786983825916-carrusel-2-voluntariado.webp';
const IMG_INCLUYE = '/api/images/1786983827093-carrusel-3-voluntariado.webp';
const IMG_APORTE = '/api/images/1786983828963-carrusel-5-voluntariado.webp';
const IMG_PRACTICA = '/api/images/1786983828296-carrusel-4-voluntariado.webp';

const introParagraphs = dict.introParagraphs;
const activities = dict.activities.items;
const includes = dict.includes.items;
const priceTiers = dict.aporte.tiers.map((tier) => ({
  range: tier.range,
  price: formatCOP(tier.amount, locale),
  per: dict.aporte.perNight,
}));
const recommendations = dict.recommendations.items;
const faqs = dict.faq.items;
---

<Layout title={t('voluntariadoPage.metaTitle')} description={t('voluntariadoPage.metaDescription')}>

  <main class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 pt-6 md:pt-8 pb-12">
    <!-- Page Banner -->
    <PageBanner
      title={t('voluntariadoPage.bannerTitle')}
      subtitle={t('voluntariadoPage.bannerSubtitle')}
      image={BANNER_IMAGE}
      breadcrumb={[
        { label: t('voluntariadoPage.breadcrumbHome'), url: l('/') },
        { label: t('voluntariadoPage.breadcrumbVoluntariado'), url: l('/voluntariado') },
      ]}
    />

    <!-- CTA row -->
    <div class="flex flex-wrap justify-center gap-4 mt-8 mb-16">
      <a href={l('/contacto')} class="bg-rausch text-white px-8 py-4 rounded-2xl font-bold text-lg hover:scale-105 transition-transform shadow-lg inline-block">
        {t('voluntariadoPage.ctaInscribe')}
      </a>
      <a href="#actividades" class="border border-near-black px-8 py-4 rounded-2xl font-bold text-lg hover:bg-gray-50 transition-colors inline-block">
        {t('voluntariadoPage.ctaActivities')}
      </a>
    </div>

    <!-- Introducción -->
    <section class="mb-24 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div class="space-y-5">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tightest mb-6">{t('voluntariadoPage.introHeading')}</h2>
        {introParagraphs.map((p) => (
          <p class="text-gray-600 text-lg leading-relaxed">{p}</p>
        ))}
      </div>
      <img
        src={IMG_INTRO}
        alt={t('voluntariadoPage.introImageAlt')}
        class="rounded-[32px] shadow-airbnb w-full aspect-square object-cover"
        decoding="async"
      />
    </section>

    <!-- Qué harás como voluntario -->
    <section id="actividades" class="mb-24">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <img
          src={IMG_ACTIVIDADES}
          alt={t('voluntariadoPage.activities.imageAlt')}
          class="rounded-[32px] shadow-airbnb w-full aspect-square object-cover order-2 lg:order-1"
          decoding="async"
        />
        <div class="order-1 lg:order-2">
          <h2 class="text-3xl md:text-4xl font-bold tracking-tightest mb-4">{t('voluntariadoPage.activities.heading')}</h2>
          <p class="text-gray-500 text-lg mb-6">
            {t('voluntariadoPage.activities.subtitle')}
          </p>
          <ul class="space-y-4">
            {activities.map((item) => (
              <li class="flex items-start gap-4 text-lg font-medium">
                <CheckCircle2 className="text-rausch shrink-0 mt-1" size={24} />
                <span>{item}</span>
              </li>
            ))}
          </ul>
          <div class="pt-6">
            <div class="flex items-start gap-4 p-6 bg-light-surface rounded-2xl border border-sacred-sand">
              <Info className="text-rausch shrink-0 mt-1" size={24} />
              <p class="text-sm text-gray-600">
                {t('voluntariadoPage.activities.note')}
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Incluye -->
    <section class="mb-24 bg-light-surface rounded-[32px] p-8 md:p-16 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div class="space-y-8">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tightest">{t('voluntariadoPage.includes.heading')}</h2>
        <ul class="space-y-4">
          {includes.map((item) => (
            <li class="flex items-start gap-4 text-lg font-medium">
              <CheckCircle2 className="text-rausch shrink-0 mt-1" size={24} />
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="space-y-4">
        <img
          src={IMG_INCLUYE}
          alt={t('voluntariadoPage.includes.imageAlt')}
          class="rounded-[32px] shadow-airbnb w-full aspect-square object-cover"
          decoding="async"
        />
      </div>
    </section>

    <!-- Aporte de manutención -->
    <section class="mb-24 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div class="space-y-8">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tightest">{t('voluntariadoPage.aporte.heading')}</h2>
        <p class="text-gray-600 text-lg leading-relaxed">
          {t('voluntariadoPage.aporte.text')}
        </p>
        <div class="space-y-4">
          {priceTiers.map((tier) => (
            <div class="flex items-center justify-between gap-4 p-6 bg-lotus-white rounded-2xl border border-sacred-sand shadow-airbnb">
              <div class="flex items-center gap-4">
                <div class="w-12 h-12 bg-rausch/10 rounded-xl flex items-center justify-center text-rausch shrink-0">
                  <Wallet size={24} />
                </div>
                <span class="font-bold text-lg">{tier.range}</span>
              </div>
              <div class="text-right">
                <span class="block font-bold text-rausch text-lg">{tier.price}</span>
                <span class="text-sm text-gray-500">{tier.per}</span>
              </div>
            </div>
          ))}
        </div>
        <div class="flex items-start gap-4 p-6 bg-lotus-white rounded-2xl border border-sacred-sand">
          <Clock className="text-rausch shrink-0 mt-1" size={24} />
          <div>
            <p class="font-bold text-lg mb-1">{t('voluntariadoPage.aporte.checkinTitle')}</p>
            <p class="text-gray-600">{t('voluntariadoPage.aporte.checkinText')}</p>
          </div>
        </div>
      </div>
      <img
        src={IMG_APORTE}
        alt={t('voluntariadoPage.aporte.imageAlt')}
        class="rounded-[32px] shadow-airbnb w-full aspect-square object-cover"
        decoding="async"
      />
    </section>

    <!-- Recomendaciones -->
    <section class="mb-24 bg-light-surface rounded-[32px] p-8 md:p-16">
      <div class="max-w-3xl mx-auto mb-12 text-center">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tightest mb-4">{t('voluntariadoPage.recommendations.heading')}</h2>
        <p class="text-gray-500 text-lg">
          {t('voluntariadoPage.recommendations.subtitle')}
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-4 max-w-4xl mx-auto">
        {recommendations.map((item) => (
          <div class="flex items-start gap-3">
            <Backpack className="text-saffron shrink-0 mt-1" size={22} />
            <span class="text-lg font-medium">{item}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- Práctica y vida en Varsana -->
    <section class="mb-24 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div class="space-y-5">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tightest mb-6">{t('voluntariadoPage.practica.heading')}</h2>
        <p class="text-gray-600 text-lg leading-relaxed">
          {t('voluntariadoPage.practica.paragraph1')}
        </p>
        <p class="text-gray-600 text-lg leading-relaxed">
          {t('voluntariadoPage.practica.paragraph2')}
        </p>
        <div class="flex items-start gap-4 p-6 bg-lotus-white rounded-2xl border border-sacred-sand shadow-airbnb pt-4">
          <Sun className="text-saffron shrink-0 mt-1" size={24} />
          <p class="text-sm text-gray-600">
            {t('voluntariadoPage.practica.note')}
          </p>
        </div>
      </div>
      <img
        src={IMG_PRACTICA}
        alt={t('voluntariadoPage.practica.imageAlt')}
        class="rounded-[32px] shadow-airbnb w-full aspect-square object-cover"
        decoding="async"
      />
    </section>

    <!-- FAQ -->
    <section class="max-w-3xl mx-auto mb-24 space-y-12">
      <div class="text-center">
        <h2 class="text-3xl font-bold tracking-tightest mb-4">{t('voluntariadoPage.faq.heading')}</h2>
        <p class="text-gray-500">{t('voluntariadoPage.faq.subtitle')}</p>
      </div>
      <div class="space-y-6">
        {faqs.map((faq) => (
          <div class="border-b border-sacred-sand pb-6">
            <h4 class="font-bold text-lg mb-2">{faq.question}</h4>
            <p class="text-gray-600">{faq.answer}</p>
            {faq.bullets.length > 0 && (
              <ul class="mt-4 space-y-3">
                {faq.bullets.map((b) => (
                  <li class="flex items-start gap-3">
                    <CheckCircle2 className="text-rausch shrink-0 mt-1.5" size={18} />
                    <span class="text-gray-600">{b}</span>
                  </li>
                ))}
              </ul>
            )}
          </div>
        ))}
      </div>
    </section>

    <!-- CTA final -->
    <section class="mb-24 bg-rausch rounded-[32px] p-10 md:p-16 text-center text-white shadow-airbnb">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tightest mb-4">{t('voluntariadoPage.final.heading')}</h2>
      <p class="text-white/80 text-lg mb-8 max-w-2xl mx-auto">
        {t('voluntariadoPage.final.text')}
      </p>
      <a href={l('/contacto')} class="inline-block bg-white text-rausch px-8 py-4 rounded-2xl font-bold text-lg hover:scale-105 transition-transform shadow-lg">
        {t('voluntariadoPage.final.cta')}
      </a>
    </section>

    <!-- Nota legal -->
    <p class="text-sm text-gray-400 text-center max-w-2xl mx-auto">
      {t('voluntariadoPage.legalNote')}
    </p>
  </main>
</Layout>

<style>
  h1, h2, h3, h4 {
    letter-spacing: -0.02em;
  }
</style>
