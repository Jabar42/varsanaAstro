---
import '@/src/styles/global.css';
import { inject } from '@vercel/analytics';
import Header from '@/src/components/Header.astro';
import EventCard from '@/src/components/EventCard.astro';
import Footer from '@/src/components/Footer.astro';
import { getUpcomingEvents } from '@/src/lib/events';

inject();

const upcomingEvents = await getUpcomingEvents();
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Calendario de Eventos | Varsana Eco Yoga Aldea</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
		<script>
			window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };
		</script>
		<script defer src="/_vercel/insights/script.js"></script>
	</head>
	<body class="bg-white text-near-black font-sans antialiased">
    <Header />

		<main class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 py-16">
      <div class="mb-12">
        <h1 class="text-5xl font-bold tracking-tightest mb-4">Calendario de Eventos</h1>
        <p class="text-gray-500 text-xl">Explora todas nuestras próximas actividades y retiros.</p>
      </div>
      
      {upcomingEvents.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-12">
          {upcomingEvents.map((event) => (
            <EventCard {...event.data} slug={event.id} />
          ))}
        </div>
      ) : (
        <div class="py-20 text-center bg-gray-50 rounded-3xl">
          <p class="text-2xl font-medium text-gray-400">No hay eventos programados por ahora.</p>
          <a href="/" class="mt-6 inline-block text-rausch font-bold underline">Volver al inicio</a>
        </div>
      )}
		</main>

    <Footer />
	</body>
</html>
