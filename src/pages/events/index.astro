---

import Layout from '@/src/layouts/Layout.astro';
import EventCard from '@/src/components/EventCard.astro';
import { getUpcomingEvents } from '@/src/lib/events';
import { useTranslations } from '@/src/i18n/utils';

const locale = (Astro.locals as any)?.locale ?? Astro.currentLocale ?? 'es';
const t = useTranslations(locale);

const upcomingEvents = await getUpcomingEvents(locale);
---

<Layout title="Calendario de Eventos | Varsana Eco Yoga Aldea">
  <main class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 py-16">
    <div class="mb-12">
      <h1 class="text-5xl font-bold tracking-tightest mb-4">{t('events.heading')}</h1>
      <p class="text-gray-500 text-xl">{t('events.subtitle')}</p>
    </div>
    
    {upcomingEvents.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-12">
        {upcomingEvents.map((event) => (
          <EventCard {...event.data} slug={event.id} />
        ))}
      </div>
    ) : (
      <div class="py-20 text-center bg-gray-50 rounded-3xl">
        <p class="text-2xl font-medium text-gray-400">{t('events.noEvents')}</p>
        <a href="/" class="mt-6 inline-block text-rausch font-bold underline">{t('events.backHome')}</a>
      </div>
    )}
  </main>
</Layout>
