---

import Layout from '@/src/layouts/Layout.astro';
import PageBanner from '@/src/components/PageBanner.astro';
import EventCard from '@/src/components/EventCard.astro';
import { getUpcomingEvents } from '@/src/lib/events';
import { useTranslations, getLocale, localizePath } from '@/src/i18n/utils';

const locale = getLocale(Astro);
const t = useTranslations(locale);
const l = (p: string) => localizePath(locale, p);

const upcomingEvents = await getUpcomingEvents(locale);
---

<Layout title={t('eventsPage.metaTitle')} description={t('eventsPage.metaDescription')}>
  <main class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 pt-6 md:pt-8 pb-16">
    <PageBanner
      title={t('events.heading')}
      subtitle={t('events.subtitle')}
      breadcrumb={[
        { label: t('nav.home'), url: l('/') },
        { label: t('nav.events'), url: l('/events') },
      ]}
    />

    {upcomingEvents.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-12 py-16 md:py-24" data-reveal-group>
        {upcomingEvents.map((event) => (
          <div><EventCard {...event.data} slug={event.id} /></div>
        ))}
      </div>
    ) : (
      <div class="my-16 md:my-24 on-dark arch-wide px-6 pt-28 pb-16 md:pt-36 md:pb-20 text-center">
        <p class="display-md font-display font-bold max-w-2xl mx-auto">{t('events.noEvents')}</p>
        <a href={l('/')} class="btn btn-light btn-arrow mt-8">{t('events.backHome')}</a>
      </div>
    )}
  </main>
</Layout>
