---

import Layout from '@/src/layouts/Layout.astro';
import { getEntry, render } from 'astro:content';
import { getAvailablePrices, getBasePrice } from '@/src/lib/events';
import BoldPaymentButton from '@/src/components/BoldPaymentButton';
import { Calendar, MapPin } from 'lucide-react';

const { slug } = Astro.params;
const event = await getEntry('events', slug!);
if (!event) return Astro.redirect('/404');

const { title, description, event_start, event_end, image, prices, stock_max, location, host_name, host_tagline, host_image } = event.data;
const { Content } = await render(event);

const availablePrices = getAvailablePrices(prices, event_start);
const basePrice = getBasePrice(availablePrices);

const formattedStart = event_start.toLocaleDateString('es-ES', {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  year: 'numeric'
});

const formattedEnd = event_end?.toLocaleDateString('es-ES', {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  year: 'numeric'
});

// SEO Data
const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://varsana.com');
---

<Layout title={`${title} | Varsana Eco Yoga Aldea`} description={description}>
  <Fragment slot="head">
    <!-- SEO / OpenGraph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
  </Fragment>

  <div class="max-w-7xl mx-auto px-0 md:px-12 lg:px-20 py-0 md:py-8">
    <!-- Photography-first Header -->
    <div class="md:rounded-[24px] overflow-hidden relative h-75 md:h-125 lg:h-150 shadow-airbnb">
      <img 
        src={image} 
        alt={title} 
        class="w-full h-full object-cover"
        referrerpolicy="no-referrer"
      />
    </div>

    <div class="px-6 md:px-0 mt-8 grid grid-cols-1 lg:grid-cols-3 gap-12">
      <!-- Main Content Column -->
      <div class="lg:col-span-2 space-y-8">
        <div class="border-b border-sacred-sand pb-8">
          <h1 class="text-4xl md:text-6xl font-bold tracking-tightest mb-4 font-display">{title}</h1>
          <div class="flex flex-wrap gap-6 text-sm font-medium">
            <div class="flex items-center gap-2">
              <Calendar size={18} className="text-saffron" />
              <span>{formattedStart}{formattedEnd ? ` — ${formattedEnd}` : ''}</span>
            </div>
            <div class="flex items-center gap-2">
              <MapPin size={18} className="text-saffron" />
              <span>{location}</span>
            </div>
          </div>
        </div>

        <!-- Countdown -->
        <div class="border-b border-sacred-sand pb-8" id="event-countdown" data-event-date={event_start.toISOString()} style="display:none">
          <p class="text-sm font-semibold text-secondary-gray mb-2">Tiempo restante</p>
          <div class="flex gap-4 text-center">
            <div><span class="text-3xl font-bold font-display text-rausch" id="cd-days">00</span><p class="text-xs text-secondary-gray">días</p></div>
            <span class="text-2xl font-bold text-sacred-sand">:</span>
            <div><span class="text-3xl font-bold font-display text-rausch" id="cd-hours">00</span><p class="text-xs text-secondary-gray">horas</p></div>
            <span class="text-2xl font-bold text-sacred-sand">:</span>
            <div><span class="text-3xl font-bold font-display text-rausch" id="cd-mins">00</span><p class="text-xs text-secondary-gray">mins</p></div>
            <span class="text-2xl font-bold text-sacred-sand">:</span>
            <div><span class="text-3xl font-bold font-display text-rausch" id="cd-secs">00</span><p class="text-xs text-secondary-gray">segs</p></div>
          </div>
        </div>

        <!-- Host Info -->
        <div class="flex items-center justify-between border-b border-sacred-sand pb-8">
          <div class="space-y-1">
            <h2 class="text-2xl font-bold font-display">Experiencia organizada por {host_name}</h2>
            <p class="text-secondary-gray text-sm">{host_tagline}</p>
          </div>
          <div class="w-14 h-14 bg-sacred-sand rounded-full flex items-center justify-center overflow-hidden">
             <img src={host_image || '/logo/LogoPrincipal.svg'} alt={host_name} class="w-full h-full object-cover" />
          </div>
        </div>

        <!-- Description -->
        <div class="max-w-none">
          <Content />
        </div>

      </div>

      <!-- Sticky Price Card Column -->
      <div class="relative">
        <div class="sticky top-28 bg-lotus-white border border-sacred-sand rounded-[24px] p-6 shadow-airbnb space-y-6">
          <div>
            <span class="text-3xl font-bold tracking-tightest font-display">${basePrice ? basePrice.amount.toLocaleString('es-CO') : '—'}</span>
            <span class="text-secondary-gray text-base font-normal"> / persona</span>
          </div>

          <!-- Booking Details Box -->
          <div class="border border-sacred-sand rounded-xl overflow-hidden">
            <div class="grid grid-cols-2 border-b border-sacred-sand">
              <div class="p-3 border-r border-sacred-sand">
                <p class="text-xs font-bold uppercase">Fecha</p>
                <p class="text-sm">{event_start.toLocaleDateString('es-ES')}</p>
              </div>
              <div class="p-3">
                <p class="text-xs font-bold uppercase">Cupos</p>
                <p class="text-sm">{stock_max} personas</p>
              </div>
            </div>
          </div>

          <!-- Payment Button -->
          <BoldPaymentButton
            client:load
            contentType="event"
            contentId={event.id}
            prices={availablePrices}
            fixedDate={event_start.toISOString().slice(0, 10)}
          />

          <p class="text-center text-secondary-gray text-xs">Asegura tu cupo con anticipación</p>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  const el = document.getElementById('event-countdown');
  if (el) {
    const target = new Date(el.dataset.eventDate).getTime();
    const now = Date.now();
    if (target > now && (target - now) < 90 * 24 * 60 * 60 * 1000) {
      el.style.display = '';
      const days = document.getElementById('cd-days');
      const hours = document.getElementById('cd-hours');
      const mins = document.getElementById('cd-mins');
      const secs = document.getElementById('cd-secs');
      function tick() {
        const diff = target - Date.now();
        if (diff <= 0) { el.style.display = 'none'; return; }
        const d = Math.floor(diff / 86400000);
        const h = Math.floor((diff % 86400000) / 3600000);
        const m = Math.floor((diff % 3600000) / 60000);
        const s = Math.floor((diff % 60000) / 1000);
        days.textContent = String(d).padStart(2, '0');
        hours.textContent = String(h).padStart(2, '0');
        mins.textContent = String(m).padStart(2, '0');
        secs.textContent = String(s).padStart(2, '0');
      }
      tick();
      setInterval(tick, 1000);
    }
  }
</script>

<style>
  h1, h2, h3, h4 {
    letter-spacing: -0.02em;
  }
</style>
