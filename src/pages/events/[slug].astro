---

import Layout from '@/src/layouts/Layout.astro';
import { getEntry, render } from 'astro:content';
import { getAvailablePrices, getBasePrice } from '@/src/lib/events';
import BoldPaymentButton from '@/src/components/BoldPaymentButton';
import { Calendar, MapPin } from 'lucide-react';
import { getLocale, useTranslations, formatDate } from '@/src/i18n/utils';

const locale = getLocale(Astro);
const t = useTranslations(locale);

const { slug } = Astro.params;
const event = await getEntry('events', slug!);
if (!event) return Astro.redirect('/404');

const { title, description, event_start, event_end, image, prices, stock_max, location, host_name, host_tagline, host_image } = event.data;
const { Content } = await render(event);

const availablePrices = getAvailablePrices(prices, event_start);
const basePrice = getBasePrice(availablePrices);

const longDate: Intl.DateTimeFormatOptions = {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  year: 'numeric'
};

const formattedStart = formatDate(event_start, locale, longDate);
const formattedEnd = event_end ? formatDate(event_end, locale, longDate) : undefined;
const shortStart = formatDate(event_start, locale, { day: 'numeric', month: 'numeric', year: 'numeric' });
const numberLocale = locale === 'en' ? 'en-US' : 'es-CO';

// SEO Data
const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://varsana.com');
---

<Layout title={t('eventDetail.metaTitle', { title })} description={description}>
  <Fragment slot="head">
    <!-- SEO / OpenGraph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
  </Fragment>

  <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 pt-6 md:pt-10 pb-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 lg:grid-rows-[auto_1fr] gap-x-12 xl:gap-x-16 gap-y-10">
      <!-- Photography-first Header: la foto se mira a través del arco -->
      <div class="lg:col-start-8 lg:col-span-5 lg:row-start-1">
        <div class="arch shimmer aspect-4/5 max-h-[34rem] w-full mx-auto bg-forest-night">
          <img
            src={image}
            alt={title}
            class="w-full h-full object-cover"
            referrerpolicy="no-referrer"
          />
        </div>
      </div>

      <!-- Main Content Column -->
      <div class="lg:col-start-1 lg:col-span-7 lg:row-start-1 lg:row-span-2 space-y-10">
        <div class="lg:pt-10">
          <span class="rule-saffron mb-8" aria-hidden="true"></span>
          <h1 class="display-xl font-bold font-display text-near-black">{title}</h1>
          <div class="mt-8 flex flex-wrap gap-x-8 gap-y-3 text-sm font-medium">
            <div class="flex items-center gap-2">
              <Calendar size={18} className="text-saffron-deep shrink-0" />
              <span>{formattedStart}{formattedEnd ? ` — ${formattedEnd}` : ''}</span>
            </div>
            <div class="flex items-center gap-2">
              <MapPin size={18} className="text-saffron-deep shrink-0" />
              <span>{location}</span>
            </div>
          </div>
        </div>

        <!-- Countdown -->
        <div class="bg-sand-deep rounded-3xl p-6 md:p-8" id="event-countdown" data-event-date={event_start.toISOString()} data-locale={locale} style="display:none">
          <p class="eyebrow mb-4">{t('eventDetail.countdownTitle')}</p>
          <div class="flex gap-4 md:gap-6 text-center">
            <div><span class="text-3xl md:text-4xl font-bold font-display text-forest-deep tabular-nums" id="cd-days">00</span><p class="text-xs text-secondary-gray mt-1">{t('eventDetail.days')}</p></div>
            <span class="text-2xl md:text-3xl font-bold text-near-black/20">:</span>
            <div><span class="text-3xl md:text-4xl font-bold font-display text-forest-deep tabular-nums" id="cd-hours">00</span><p class="text-xs text-secondary-gray mt-1">{t('eventDetail.hours')}</p></div>
            <span class="text-2xl md:text-3xl font-bold text-near-black/20">:</span>
            <div><span class="text-3xl md:text-4xl font-bold font-display text-forest-deep tabular-nums" id="cd-mins">00</span><p class="text-xs text-secondary-gray mt-1">{t('eventDetail.mins')}</p></div>
            <span class="text-2xl md:text-3xl font-bold text-near-black/20">:</span>
            <div><span class="text-3xl md:text-4xl font-bold font-display text-forest-deep tabular-nums" id="cd-secs">00</span><p class="text-xs text-secondary-gray mt-1">{t('eventDetail.secs')}</p></div>
          </div>
        </div>

        <!-- Host Info -->
        <div class="flex items-center justify-between gap-6 border-y border-near-black/10 py-6">
          <div class="space-y-1">
            <h2 class="text-xl md:text-2xl font-bold font-display">{t('eventDetail.organizedBy', { host: host_name })}</h2>
            <p class="text-secondary-gray text-sm">{host_tagline}</p>
          </div>
          <div class="w-14 h-14 shrink-0 bg-sand-deep rounded-full flex items-center justify-center overflow-hidden">
             <img src={host_image || '/logo/LogoPrincipal.svg'} alt={t('eventDetail.hostImageAlt', { host: host_name })} class="w-full h-full object-cover" />
          </div>
        </div>

        <!-- Description -->
        <div class="max-w-none">
          <Content />
        </div>

      </div>

      <!-- Sticky Price Card Column -->
      <div class="relative lg:col-start-8 lg:col-span-5 lg:row-start-2">
        <div class="sticky top-28 bg-lotus-white ring-1 ring-near-black/5 rounded-3xl p-6 md:p-8 space-y-6">
          <div>
            <span class="text-3xl md:text-4xl font-bold font-display">${basePrice ? basePrice.amount.toLocaleString(numberLocale) : '—'}</span>
            <span class="text-secondary-gray text-base font-normal">{t('events.perPerson')}</span>
          </div>

          <!-- Booking Details Box -->
          <div class="border border-near-black/10 rounded-2xl overflow-hidden">
            <div class="grid grid-cols-2">
              <div class="p-4 border-r border-near-black/10">
                <p class="text-xs font-bold uppercase tracking-wide text-secondary-gray">{t('events.date')}</p>
                <p class="text-sm mt-1">{shortStart}</p>
              </div>
              <div class="p-4">
                <p class="text-xs font-bold uppercase tracking-wide text-secondary-gray">{t('events.spots')}</p>
                <p class="text-sm mt-1">{t('eventDetail.people', { n: stock_max })}</p>
              </div>
            </div>
          </div>

          <!-- Payment Button -->
          <BoldPaymentButton
            client:load
            locale={locale}
            contentType="event"
            contentId={event.id}
            prices={availablePrices}
            fixedDate={event_start.toISOString().slice(0, 10)}
          />

          <p class="text-center text-secondary-gray text-xs">{t('events.secureSpot')}</p>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  // Con <ClientRouter /> este módulo corre una sola vez por sesión:
  // inicializamos en astro:page-load y limpiamos el intervalo en astro:before-swap.
  let countdownTimer: ReturnType<typeof setInterval> | null = null;

  function stopCountdown() {
    if (countdownTimer !== null) {
      clearInterval(countdownTimer);
      countdownTimer = null;
    }
  }

  function initCountdown() {
    stopCountdown();
    const el = document.getElementById('event-countdown') as HTMLElement | null;
    if (!el || !el.dataset.eventDate) return;

    const target = new Date(el.dataset.eventDate).getTime();
    if (Number.isNaN(target)) return;

    const now = Date.now();
    if (!(target > now && (target - now) < 90 * 24 * 60 * 60 * 1000)) return;

    el.style.display = '';
    const days = document.getElementById('cd-days') as HTMLElement | null;
    const hours = document.getElementById('cd-hours') as HTMLElement | null;
    const mins = document.getElementById('cd-mins') as HTMLElement | null;
    const secs = document.getElementById('cd-secs') as HTMLElement | null;
    if (!days || !hours || !mins || !secs) return;

    const tick = () => {
      const diff = target - Date.now();
      if (diff <= 0) {
        el.style.display = 'none';
        stopCountdown();
        return;
      }
      const d = Math.floor(diff / 86400000);
      const h = Math.floor((diff % 86400000) / 3600000);
      const m = Math.floor((diff % 3600000) / 60000);
      const s = Math.floor((diff % 60000) / 1000);
      days.textContent = String(d).padStart(2, '0');
      hours.textContent = String(h).padStart(2, '0');
      mins.textContent = String(m).padStart(2, '0');
      secs.textContent = String(s).padStart(2, '0');
    };

    tick();
    countdownTimer = setInterval(tick, 1000);
  }

  document.addEventListener('astro:page-load', initCountdown);
  document.addEventListener('astro:before-swap', stopCountdown);
</script>

