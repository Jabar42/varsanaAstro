---
import { getLocale, useTranslations, localizePath } from '@/src/i18n/utils';
import Layout from '@/src/layouts/Layout.astro';
import PageBanner from '@/src/components/PageBanner.astro';
import SplitSection from '@/src/components/SplitSection.astro';
import TextSection from '@/src/components/TextSection.astro';
import Timeline from '@/src/components/Timeline.astro';

const locale = getLocale(Astro);
const t = useTranslations(locale);
const l = (path: string) => localizePath(locale, path);
---

<Layout title={t('historiaPage.metaTitle')} description={t('historiaPage.metaDescription')}>
  <main class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 pt-6 md:pt-8">
    <PageBanner
      title={t('historiaPage.bannerTitle')}
      subtitle={t('historiaPage.bannerSubtitle')}
      image="/api/images/1785285453165-banner-historia.webp"
      breadcrumb={[
        { label: t('historiaPage.breadcrumbHome'), url: l('/') },
        { label: t('historiaPage.breadcrumbHistoria'), url: l('/nuestra-historia') },
      ]}
    />
    <TextSection text={t('historiaPage.introText')} />
    <Timeline />
  </main>

  <main class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20">
    <SplitSection
      title={t('historiaPage.principios.title')}
      description={t('historiaPage.principios.description')}
      videoUrl="https://www.youtube.com/watch?v=O6WYfE--_k8"
    />
  </main>

  <SplitSection
    title={t('historiaPage.inspiracion.title')}
    description={t('historiaPage.inspiracion.description')}
    ctaLabel={t('historiaPage.inspiracion.ctaLabel')}
    ctaUrl={l('/practica-espiritual')}
    imageSrc="/api/images/1785285876570-inspiracion-practica.webp"
    imageAlt={t('historiaPage.inspiracion.imageAlt')}
    reversed
    background="bg-light-surface"
  />

  <main class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20">
    <SplitSection
      title={t('historiaPage.ecosistema.title')}
      description={t('historiaPage.ecosistema.description')}
      ctaLabel={t('historiaPage.ecosistema.ctaLabel')}
      ctaUrl={l('/hospedaje')}
      imageSrc="/api/images/1785285937737-ecosistema-vida.webp"
      imageAlt={t('historiaPage.ecosistema.imageAlt')}
      ctaVariant="forest"
    />
  </main>
</Layout>

<style>
  h1 {
    letter-spacing: -0.02em;
  }
</style>
