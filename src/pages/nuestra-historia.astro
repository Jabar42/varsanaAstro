---
import Layout from '@/src/layouts/Layout.astro';
import PageBanner from '@/src/components/PageBanner.astro';
import SplitSection from '@/src/components/SplitSection.astro';
import TextSection from '@/src/components/TextSection.astro';
import Timeline from '@/src/components/Timeline.astro';

const text = "En Varsana Ecoaldea converge la vida, es un lugar de dialogo e integracion de las emociones, es un proyecto enfocado en la espiritualidad y ecologia. Esta ubicado en las estribaciones del paramo de Sumapaz, a menos de dos horas de Bogota. En un terreno de siete hectareas, en Granada – Cundinamarca, es un area concebida como una aldea sostenible inspirada en la sabiduria ancestral y milenaria de la india, para recuperar la relacion con la naturaleza y la conciencia interior.";
---

<Layout title="Nuestra Historia | Varsana Eco Yoga Aldea">
  <main class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 pt-6 md:pt-8">
    <PageBanner
      title="Nuestra Historia"
      subtitle="Conoce el origen y la esencia de Varsana Eco Yoga Aldea"
      breadcrumb={[
        { label: 'Inicio', url: '/' },
        { label: 'Nuestra Historia', url: '/nuestra-historia' },
      ]}
    />
    <TextSection text={text} />
    <Timeline />
  </main>

  <SplitSection
    title="Un lugar guiado por principios"
    description="En sus jardines se vive una filosofia de vida basada en la no violencia, el respeto por todos los seres vivos y el cuidado del planeta. Las huertas organicas, los sistemas de permacultura, el uso responsable del agua, los espacios de descanso y contemplacion reflejan un compromiso con la sostenibilidad y el bienestar."
    imageSrc="https://picsum.photos/seed/varsana-principios/1200/900"
    imageAlt="Huerta organica y jardines en Varsana"
  />

  <SplitSection
    title="Inspiracion y practica"
    description="Inspirada en el Bhakti Yoga, una filosofia ancestral que promueve la conexion consciente a traves de la meditacion, el canto de mantras, la contemplacion y una vida en armonia con la naturaleza. Mas que un lugar de retiro, Varsana es un espacio para cultivar equilibrio interior, comunidad y bienestar consciente."
    ctaLabel="Conocer practicas"
    ctaUrl="/events"
    imageSrc="https://picsum.photos/seed/varsana-practica/1200/900"
    imageAlt="Practica de yoga y meditacion en Varsana"
    reversed
    background="bg-light-surface"
  />

  <SplitSection
    title="Ecosistema de vida consciente"
    description="Varsana es un refugio donde la naturaleza, la vida consciente y la espiritualidad conviven en armonia. Entre montanas, jardines ecologicos y espacios de contemplacion, cada experiencia invita a detenerse, respirar y reconectar con lo esencial."
    ctaLabel="Hospedajes"
    ctaUrl="/hospedaje"
    imageSrc="https://picsum.photos/seed/varsana-ecosistema/1200/900"
    imageAlt="Hospedaje ecologico en Varsana"
    ctaVariant="forest"
  />
</Layout>

<style>
  h1 {
    letter-spacing: -0.02em;
  }
</style>
