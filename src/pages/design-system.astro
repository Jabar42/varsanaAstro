        Usamos <strong class="text-near-black">Lucide-react</strong> exclusivamente. Preferir formas orgánicas y naturales sobre las geométricas o técnicas. Los íconos son un acento, no el protagonista.
      </p>

      <!-- Approved Icon Categories -->
      <h3 class="text-xl font-semibold font-display text-near-black mb-6">Biblioteca de íconos</h3>
      <div class="space-y-8 mb-14">
        <!-- Navigation / Actions -->
        <div class="bg-lotus-white rounded-lg shadow-airbnb p-6">
          <p class="text-sm font-semibold text-near-black mb-4">Navegación y acciones</p>
          <div class="flex flex-wrap gap-6">
            {([
              { Icon: House, label: 'House' },
              { Icon: Leaf, label: 'Leaf' },
              { Icon: Flower2, label: 'Flower2' },
              { Icon: Sun, label: 'Sun' },
              { Icon: Moon, label: 'Moon' },
              { Icon: Heart, label: 'Heart' },
              { Icon: Star, label: 'Star' },
              { Icon: Compass, label: 'Compass' },
              { Icon: Map, label: 'Map' },
              { Icon: Send, label: 'Send' },
            ]).map(({ Icon, label }) => (
              <div class="flex flex-col items-center gap-2 w-16">
                <Icon size={24} strokeWidth={1.5} class="text-near-black" />
                <span class="text-xs font-mono text-secondary-gray text-center">{label}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- UI Controls -->
        <div class="bg-lotus-white rounded-lg shadow-airbnb p-6">
          <p class="text-sm font-semibold text-near-black mb-4">Controles de interfaz</p>
          <div class="flex flex-wrap gap-6">
            {([
              { Icon: ChevronDown, label: 'ChevronDown' },
              { Icon: ChevronRight, label: 'ChevronRight' },
              { Icon: X, label: 'X' },
              { Icon: Menu, label: 'Menu' },
              { Icon: Search, label: 'Search' },
              { Icon: ArrowUpRight, label: 'ArrowUpRight' },
              { Icon: ArrowLeft, label: 'ArrowLeft' },
            ]).map(({ Icon, label }) => (
              <div class="flex flex-col items-center gap-2 w-16">
                <Icon size={24} strokeWidth={1.5} class="text-near-black" />
                <span class="text-xs font-mono text-secondary-gray text-center">{label}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- Status / Info -->
        <div class="bg-lotus-white rounded-lg shadow-airbnb p-6">
          <p class="text-sm font-semibold text-near-black mb-4">Estado e información</p>
          <div class="flex flex-wrap gap-6">
            {([
              { Icon: Clock, label: 'Clock' },
              { Icon: MapPin, label: 'MapPin' },
              { Icon: Calendar, label: 'Calendar' },
              { Icon: Users, label: 'Users' },
              { Icon: Info, label: 'Info' },
              { Icon: CheckCircle2, label: 'CheckCircle2' },
              { Icon: Check, label: 'Check' },
            ]).map(({ Icon, label }) => (
              <div class="flex flex-col items-center gap-2 w-16">
                <Icon size={24} strokeWidth={1.5} class="text-near-black" />
                <span class="text-xs font-mono text-secondary-gray text-center">{label}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- Social -->
        <div class="bg-lotus-white rounded-lg shadow-airbnb p-6">
          <p class="text-sm font-semibold text-near-black mb-4">Redes sociales</p>
          <div class="flex flex-wrap gap-6">
            {([
              { Icon: Instagram, label: 'Instagram' },
              { Icon: Facebook, label: 'Facebook' },
              { Icon: Youtube, label: 'Youtube' },
              { Icon: Globe, label: 'Globe' },
              { Icon: Mail, label: 'Mail' },
              { Icon: Phone, label: 'Phone' },
            ]).map(({ Icon, label }) => (
              <div class="flex flex-col items-center gap-2 w-16">
                <Icon size={24} strokeWidth={1.5} class="text-near-black" />
                <span class="text-xs font-mono text-secondary-gray text-center">{label}</span>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Sizing Scale -->
