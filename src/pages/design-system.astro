            <div class="flex items-center gap-2">
              <Clock size={18} class="text-saffron" />
              <span class="text-sm text-near-black">4 días · 3 noches</span>
            </div>
          </div>
        </div>

        <!-- Standalone in features -->
        <div class="bg-lotus-white rounded-lg shadow-airbnb p-6 space-y-4">
