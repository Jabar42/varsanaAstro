              <span class="text-xs font-medium text-near-black">Inicio</span>
            </div>
            <div class="flex flex-col items-center gap-0.5">
              <Users size={20} strokeWidth={1.5} class="text-near-black" />
              <span class="text-xs font-medium text-near-black">Nosotros</span>
            </div>
            <div class="flex flex-col items-center gap-0.5">
              <Leaf size={20} strokeWidth={1.5} class="text-near-black" />
              <span class="text-xs font-medium text-near-black">Voluntariado</span>
            </div>
          </div>
        </div>

        <!-- Inline with metadata -->
        <div class="bg-lotus-white rounded-lg shadow-airbnb p-6 space-y-4">
          <p class="text-sm font-semibold text-near-black">Inline con metadatos</p>
          <p class="text-xs text-secondary-gray">Tarjetas de eventos y pasadías</p>
          <div class="space-y-2 pt-2">
            <div class="flex items-center gap-2">
              <Calendar size={18} class="text-saffron" />
