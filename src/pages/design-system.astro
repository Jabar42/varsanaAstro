            </div>
            <div class="flex items-start gap-3">
              <CheckCircle2 size={24} class="text-rausch shrink-0 mt-0.5" />
              <span class="text-sm text-near-black">Alimentación vegetariana incluida</span>
            </div>
          </div>
        </div>

        <!-- Inside buttons -->
        <div class="bg-lotus-white rounded-lg shadow-airbnb p-6 space-y-4">
          <p class="text-sm font-semibold text-near-black">Dentro de botones</p>
          <p class="text-xs text-secondary-gray">CTAs con ícono de flecha</p>
          <div class="flex flex-wrap gap-4 pt-2">
            <button class="bg-rausch text-lotus-white font-semibold font-sans rounded-[16px] px-6 py-3 text-base leading-tight inline-flex items-center gap-2 cursor-pointer">
              Reservar ahora
              <ArrowUpRight size={18} strokeWidth={2.5} />
