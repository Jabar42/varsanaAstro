            <span class="break-words">䷀ 600ms card hover</span>
          </div>
          <span class="text-xs font-mono text-secondary-gray break-words">Transición 600ms — tarjetas e imágenes</span>
        </div>
        <div class="flex flex-wrap items-center gap-6">
          <div class="w-40 h-16 bg-lotus-white rounded-lg shadow-airbnb transition-all duration-700 ease-in-out hover:scale-110 shrink-0 flex items-center justify-center text-xs text-near-black cursor-pointer font-medium">
            <span class="break-words">䷀ 700ms image zoom</span>
          </div>
          <span class="text-xs font-mono text-secondary-gray break-words">Transición 700ms — zoom de imagen al hover</span>
        </div>
      </div>
    </section>



