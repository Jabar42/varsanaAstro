---
import Layout from '@/src/layouts/Layout.astro';
import { useTranslations, getLocale, localizePath } from '@/src/i18n/utils';
import { CheckCircle, XCircle, Clock, Search, ArrowLeft } from 'lucide-react';
import { env } from 'cloudflare:workers';
import { getDB } from '@/src/lib/d1';

const locale = getLocale(Astro);
const t = useTranslations(locale);
const l = (p: string) => localizePath(locale, p);


const boldOrderId = Astro.url.searchParams.get('bold-order-id');

type OrderRow = {
  status: 'pending' | 'paid' | 'failed' | 'refunded';
  amount: number;
  customer_name: string;
  bold_order_id: string;
};

let orderStatus: OrderRow['status'] | 'not_found' | 'no_id' = 'no_id';
let orderRow: OrderRow | null = null;

if (boldOrderId) {
  const db = getDB(env);
  const row = await db
    .prepare('SELECT status, amount, customer_name, bold_order_id FROM orders WHERE bold_order_id = ?')
    .bind(boldOrderId)
    .first<OrderRow>();

  if (row) {
    orderRow = row;
    orderStatus = row.status;
  } else {
    orderStatus = 'not_found';
  }
}

type UIConfig = {
  icon: typeof CheckCircle;
  title: string;
  message: string;
  color: string;
  bgColor: string;
  borderColor: string;
  showRetry: boolean;
};

function getUIConfig(status: string): UIConfig {
  switch (status) {
    case 'paid':
      return {
        icon: CheckCircle,
        title: t('payment.successTitle'),
        message: t('payment.successMessage'),
        color: 'text-green-700',
        bgColor: 'bg-green-50',
        borderColor: 'border-green-200',
        showRetry: false,
      };
    case 'failed':
    case 'refunded':
      return {
        icon: XCircle,
        title: t('payment.failedTitle'),
        message: t('payment.failedMessage'),
        color: 'text-red-700',
        bgColor: 'bg-red-50',
        borderColor: 'border-red-200',
        showRetry: true,
      };
    case 'pending':
      return {
        icon: Clock,
        title: t('payment.confirmingTitle'),
        message: t('payment.confirmingMessage'),
        color: 'text-amber-700',
        bgColor: 'bg-amber-50',
        borderColor: 'border-amber-200',
        showRetry: false,
      };
    case 'not_found':
      return {
        icon: Search,
        title: t('payment.searchingTitle'),
        message: t('payment.searchingMessage'),
        color: 'text-gray-500',
        bgColor: 'bg-gray-50',
        borderColor: 'border-gray-200',
        showRetry: false,
      };
    default: // no_id
      return {
        icon: Search,
        title: t('payment.searchingTitle'),
        message: t('payment.noInfo'),
        color: 'text-gray-500',
        bgColor: 'bg-gray-50',
        borderColor: 'border-gray-200',
        showRetry: false,
      };
  }
}

const config = getUIConfig(orderStatus);
const ResultIcon = config.icon;
const isPending = orderStatus === 'pending';
---

<Layout title={t('paymentPage.metaTitle')} description={t('paymentPage.metaDescription')}>
  <main class="min-h-[70vh] flex items-center justify-center px-4 py-16">
    <div
      id="payment-result"
      data-locale={locale}
      data-order-id={isPending && boldOrderId ? boldOrderId : undefined}
      class={`w-full max-w-md rounded-[24px] border ${config.borderColor} ${config.bgColor} p-8 shadow-airbnb text-center space-y-6`}
    >

      <!-- Icon -->
      <div class="flex justify-center">
        {
          isPending ? (
            <svg class="h-14 w-14 animate-spin text-amber-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" role="img" aria-label={t('payment.processing')}>
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" />
            </svg>
          ) : (
            <ResultIcon size={56} className={config.color} strokeWidth={1.5} aria-label={t('paymentPage.statusIconAlt')} />
          )
        }
      </div>

      <!-- Title -->
      <h1 class={`text-2xl font-bold font-display ${config.color}`}>
        {config.title}
      </h1>

      <!-- Message -->
      <p class="text-gray-600 text-sm leading-relaxed">
        {config.message}
      </p>

      <!-- Order Reference -->
      {orderRow && (
        <div class="border-t border-sacred-sand pt-4">
          <p class="text-xs text-gray-400 uppercase tracking-wide font-semibold">{t('payment.reference')}</p>
          <p class="text-sm font-mono text-gray-600 mt-1 break-all">{orderRow.bold_order_id}</p>
        </div>
      )}

      {boldOrderId && orderStatus === 'not_found' && (
        <div class="border-t border-sacred-sand pt-4">
          <p class="text-xs text-gray-400 uppercase tracking-wide font-semibold">{t('payment.reference')}</p>
          <p class="text-sm font-mono text-gray-600 mt-1 break-all">{boldOrderId}</p>
        </div>
      )}

      <!-- CTA Buttons -->
      <div class="space-y-3 pt-2">
        {config.showRetry && (
          <a
            href="javascript:history.back()"
            class="block w-full rounded-xl bg-sacred-900 px-4 py-3 font-semibold text-white text-center transition-colors hover:bg-sacred-900/90"
          >
            {t('payment.retry')}
          </a>
        )}
        <a
          href={l('/')}
          class="flex items-center justify-center gap-2 w-full rounded-xl border border-sacred-sand px-4 py-3 font-medium text-sacred-900 transition-colors hover:bg-sacred-sand/50"
        >
          <ArrowLeft size={16} aria-hidden="true" />
          {t('payment.backHome')}
        </a>
      </div>
    </div>
  </main>
</Layout>

<!-- Polling: only when the order exists but is still pending (webhook not arrived yet).
     The order id is read from data-order-id, which is only rendered in that case. -->
<script>
  // Con <ClientRouter /> este módulo corre una sola vez por sesión:
  // inicializamos en astro:page-load y limpiamos el intervalo en astro:before-swap.
  let pollTimer: ReturnType<typeof setInterval> | null = null;

  function stopPolling() {
    if (pollTimer !== null) {
      clearInterval(pollTimer);
      pollTimer = null;
    }
  }

  function startPolling() {
    stopPolling();
    const root = document.getElementById('payment-result') as HTMLElement | null;
    const orderId = root?.dataset.orderId;
    if (!orderId) return;

    let attempts = 0;
    const maxAttempts = 6;

    pollTimer = setInterval(async () => {
      attempts++;
      try {
        const res = await fetch('/api/order-status?bold-order-id=' + encodeURIComponent(orderId));
        if (res.ok) {
          const data = (await res.json()) as { status?: string };
          if (data.status && data.status !== 'pending') {
            stopPolling();
            window.location.reload();
            return;
          }
        }
      } catch {
        // Network hiccup — keep polling until maxAttempts
      }
      if (attempts >= maxAttempts) {
        stopPolling();
      }
    }, 2000);
  }

  document.addEventListener('astro:page-load', startPolling);
  document.addEventListener('astro:before-swap', stopPolling);
</script>
