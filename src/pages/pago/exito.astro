---
import Layout from '@/src/layouts/Layout.astro';
import { useTranslations } from '@/src/i18n/utils';
import { CheckCircle, XCircle, Clock, ArrowLeft } from 'lucide-react';

const t = useTranslations((Astro.locals as any)?.locale ?? Astro.currentLocale ?? 'es');

const boldOrderId = Astro.url.searchParams.get('bold-order-id');
const boldTxStatus = Astro.url.searchParams.get('bold-tx-status');

interface ResultConfig {
  icon: typeof CheckCircle;
  title: string;
  message: string;
  color: string;
  bgColor: string;
  borderColor: string;
}

const resultConfigs: Record<string, ResultConfig> = {
  approved: {
    icon: CheckCircle,
    title: t('payment.successTitle'),
    message: t('payment.successMessage'),
    color: 'text-green-700',
    bgColor: 'bg-green-50',
    borderColor: 'border-green-200',
  },
  declined: {
    icon: XCircle,
    title: t('payment.declinedTitle'),
    message: t('payment.declinedMessage'),
    color: 'text-red-700',
    bgColor: 'bg-red-50',
    borderColor: 'border-red-200',
  },
  failed: {
    icon: XCircle,
    title: t('payment.failedTitle'),
    message: t('payment.failedMessage'),
    color: 'text-red-700',
    bgColor: 'bg-red-50',
    borderColor: 'border-red-200',
  },
  pending: {
    icon: Clock,
    title: t('payment.pendingTitle'),
    message: t('payment.pendingMessage'),
    color: 'text-amber-700',
    bgColor: 'bg-amber-50',
    borderColor: 'border-amber-200',
  },
};

const config: ResultConfig | null = boldTxStatus ? resultConfigs[boldTxStatus] ?? null : null;

const ResultIcon = config?.icon || Clock;
---

<Layout title="Resultado del pago | Varsana Eco Yoga Aldea" description="Resultado de tu transacción de pago">
  <main class="min-h-[70vh] flex items-center justify-center px-4 py-16">
    <div class={`w-full max-w-md rounded-[24px] border ${config?.borderColor || 'border-sacred-sand'} ${config?.bgColor || 'bg-lotus-white'} p-8 shadow-airbnb text-center space-y-6`}>
      
      <!-- Icon -->
      <div class="flex justify-center">
        <ResultIcon size={56} className={config?.color || 'text-gray-400'} strokeWidth={1.5} />
      </div>

      <!-- Title -->
      <h1 class={`text-2xl font-bold font-display ${config?.color || 'text-gray-800'}`}>
        {config?.title || (boldOrderId ? t('payment.processing') : t('payment.noInfo'))}
      </h1>

      <!-- Message -->
      <p class="text-gray-600 text-sm leading-relaxed">
        {config?.message || (
          boldOrderId
            ? t('payment.unknownMessage')
            : t('payment.unknownFallback')
        )}
      </p>

      <!-- Order Reference -->
      {boldOrderId && (
        <div class="border-t border-sacred-sand pt-4">
          <p class="text-xs text-gray-400 uppercase tracking-wide font-semibold">{t('payment.reference')}</p>
          <p class="text-sm font-mono text-gray-600 mt-1 break-all">{boldOrderId}</p>
        </div>
      )}

      <!-- CTA Buttons -->
      <div class="space-y-3 pt-2">
        {(!boldTxStatus || boldTxStatus === 'declined' || boldTxStatus === 'failed') && (
          <a
            href="javascript:history.back()"
            class="block w-full rounded-xl bg-sacred-900 px-4 py-3 font-semibold text-white text-center transition-colors hover:bg-sacred-900/90"
          >
            {t('payment.retry')}
          </a>
        )}
        <a
          href="/"
          class="flex items-center justify-center gap-2 w-full rounded-xl border border-sacred-sand px-4 py-3 font-medium text-sacred-900 transition-colors hover:bg-sacred-sand/50"
        >
          <ArrowLeft size={16} />
          {t('payment.backHome')}
        </a>
      </div>
    </div>
  </main>
</Layout>

<!-- Verify payment status with backend — fallback in case webhook hasn't arrived yet -->
{boldOrderId && boldTxStatus && (
  <script>
    (async function verifyPayment() {
      const orderId = '{boldOrderId}';
      const txStatus = '{boldTxStatus}';
      try {
        await fetch('/api/verify-payment', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ boldOrderId: orderId, boldTxStatus: txStatus }),
        });
      } catch (err) {
        // Silently fail — webhook will eventually update the order
        console.error('Payment verification fallback failed:', err);
      }
    })();
  </script>
)}
