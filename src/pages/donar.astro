---
import { getLocale, useTranslations, localizePath } from '@/src/i18n/utils';
import { es as donarEs, en as donarEn } from '@/src/i18n/dictionaries/donarPage';

import Layout from '@/src/layouts/Layout.astro';
import PageBanner from '@/src/components/PageBanner.astro';

import { Heart, Sprout, Home } from 'lucide-react';

const locale = getLocale(Astro);
const t = useTranslations(locale);
const l = (path: string) => localizePath(locale, path);

const impactIcons = [Sprout, Home, Heart];
const impactAreas = (locale === 'en' ? donarEn : donarEs).impactAreas.map((area, i) => ({
  ...area,
  icon: impactIcons[i] ?? Heart,
}));
---

<Layout title={t('donar.title')} description={t('donar.subtitle')}>

  <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 pt-6 md:pt-8">

    <!-- Page Banner -->
    <PageBanner
      title={t('donar.heading')}
      subtitle={t('donar.subtitle')}
      breadcrumb={[
        { label: t('nav.home'), url: l('/') },
        { label: t('nav.donate'), url: l('/donar') },
      ]}
    />

    <!-- What Donations Support -->
    <section class="py-16 md:py-20">
      <div class="grid lg:grid-cols-12 gap-y-8 gap-x-12 items-end">
        <div class="lg:col-span-7">
          <span class="rule-saffron mb-8" aria-hidden="true"></span>
          <h2 class="display-lg font-bold font-display text-near-black">{t('donar.impactHeading')}</h2>
        </div>
        <div class="lg:col-span-5 lg:pb-2">
          <p class="text-secondary-gray text-lg md:text-xl leading-relaxed">{t('donar.impactSubtitle')}</p>
          <!-- CTA row -->
          <div class="flex flex-wrap gap-3 mt-8">
            <a href="#donar" class="btn btn-lg">
              {t('donar.ctaDonate')}
            </a>
            <a href={l('/nosotros')} class="btn btn-lg btn-outline btn-arrow">
              {t('donar.ctaAbout')}
            </a>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8 mt-14 md:mt-20" data-reveal-group>
        {impactAreas.map((area) => (
          <div class="p-8 bg-lotus-white rounded-3xl ring-1 ring-near-black/5">
            <div class="w-13 h-13 bg-forest/10 rounded-2xl flex items-center justify-center text-forest-deep mb-6">
              <area.icon size={24} />
            </div>
            <h3 class="text-xl md:text-2xl font-bold font-display mb-3">{area.title}</h3>
            <p class="text-secondary-gray leading-relaxed">{area.description}</p>
          </div>
        ))}
      </div>
    </section>
  </div>

  <!-- Image + Text Split -->
  <section class="bg-sand-deep py-16 md:py-20">
    <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 grid grid-cols-1 lg:grid-cols-12 gap-y-14 gap-x-12 lg:gap-x-20 items-center">
      <div class="lg:col-span-6 story-media">
        <div class="story-media__arch arch parallax shimmer" data-reveal="mask">
          <img
            src="https://picsum.photos/seed/huerta-donar/600/800"
            alt={t('donarPage.huertaImageAlt')}
            class="w-full h-full object-cover"
            referrerpolicy="no-referrer"
            loading="lazy"
          />
        </div>
        <div class="story-media__inset shimmer" data-reveal>
          <img
            src="https://picsum.photos/seed/templo-donar/600/800"
            alt={t('donarPage.temploImageAlt')}
            class="w-full h-full object-cover"
            referrerpolicy="no-referrer"
            loading="lazy"
          />
        </div>
      </div>

      <div class="lg:col-span-6" data-reveal-group>
        <span class="rule-saffron mb-8" data-reveal="draw" aria-hidden="true"></span>
        <h2 class="display-md font-bold font-display text-near-black">
          {t('donarPage.storyHeadingLine1')}<br />{t('donarPage.storyHeadingLine2')}
        </h2>
        <p class="mt-6 text-lg md:text-xl text-secondary-gray leading-relaxed max-w-lg">
          {t('donar.storyText1')}
        </p>
        <p class="mt-4 text-lg md:text-xl text-secondary-gray leading-relaxed max-w-lg">
          {t('donar.storyText2')}
        </p>
      </div>
    </div>
  </section>

  <!-- CTA Banner: sección oscura pegada al footer (-mb-20 anula su margen) -->
  <section id="donar" class="on-dark -mb-20 pt-20 md:pt-28 overflow-hidden scroll-mt-24">
    <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 grid grid-cols-1 lg:grid-cols-12 gap-y-14 gap-x-12 items-end">
      <div class="lg:col-span-7 pb-0 lg:pb-28">
        <h2 class="display-lg font-bold font-display text-white">
          {t('donar.ctaBannerTitle')}
        </h2>
        <p class="mt-6 text-sacred-sand/75 text-lg md:text-xl leading-relaxed max-w-xl">
          {t('donar.ctaBannerText')}
        </p>
        <div class="flex flex-wrap gap-3 mt-10">
          <a
            href={import.meta.env.PUBLIC_DONATION_URL || '#'}
            class="btn btn-lg btn-light btn-arrow w-full sm:w-auto"
          >
            {t('donar.ctaBannerDonate')}
          </a>
          <a
            href={l('/nosotros')}
            class="btn btn-lg btn-outline btn-outline-light w-full sm:w-auto"
          >
            {t('donar.ctaBannerMore')}
          </a>
        </div>
      </div>

      <div class="lg:col-span-5">
        <div class="arch shimmer aspect-4/5 w-full max-w-xs lg:max-w-sm mx-auto lg:ml-auto lg:mr-0">
          <img
            src="https://picsum.photos/seed/donar-cta/1200/750"
            alt={t('donarPage.comunidadImageAlt')}
            class="w-full h-full object-cover"
            referrerpolicy="no-referrer"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
  h3 {
    letter-spacing: -0.02em;
  }

  /* Arco protagonista + una foto menor que se le apoya: reemplaza la
     pareja de fotos desfasadas. */
  .story-media {
    position: relative;
    padding: 0 3rem 3rem 0;
    max-width: 30rem;
    width: 100%;
    margin-inline: auto;
  }

  .story-media__arch {
    aspect-ratio: 4 / 5;
  }

  .story-media__inset {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 44%;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border-radius: var(--radius-md);
    box-shadow: 0 0 0 6px var(--color-sand-deep);
  }

  /* Secundario sobre fondo oscuro: no existe en el sistema compartido. */
  .btn-outline-light {
    border-color: rgb(250 249 246 / 0.4);
    color: var(--color-sacred-sand);
  }
  .btn-outline-light:hover,
  .btn-outline-light:active {
    background: var(--color-lotus-white);
    border-color: var(--color-lotus-white);
    color: var(--color-forest-night);
  }
  .btn-outline-light:focus-visible {
    outline-color: var(--color-lotus-white);
  }
</style>
