---

import Layout from '@/src/layouts/Layout.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';

const locale = (Astro.locals as any)?.locale ?? Astro.currentLocale ?? 'es';
const l = (path: string) => getRelativeLocaleUrl(locale, path);

import { Heart, Sprout, Home } from 'lucide-react';

const supportAreas = [
  {
    title: "Huerta Orgánica",
    description: "Expandimos nuestra huerta para producir alimentos frescos y saludables que nutren a la comunidad y protegen la tierra.",
    icon: Sprout,
  },
  {
    title: "Templo y Espiritualidad",
    description: "Mantenemos el templo como un espacio sagrado para la práctica de yoga, meditación y ceremonias que elevan la conciencia.",
    icon: Home,
  },
  {
    title: "Comunidad Consciente",
    description: "Fortalecemos los lazos entre voluntarios, visitantes y residentes creando un tejido social basado en el respeto y el servicio.",
    icon: Heart,
  },
];
---

<Layout title="Donar | Varsana Eco Yoga Aldea">

  <main class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 py-12">

    <!-- Hero Section -->
    <section class="mb-24 grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <div class="space-y-6">
        <h1 class="text-4xl md:text-6xl font-bold tracking-tightest leading-tight">
          Apoya Nuestra Misión
        </h1>
        <p class="text-gray-500 text-xl leading-relaxed">
          Tu donación sostiene los proyectos de la eco-aldea: la huerta orgánica, el templo, y los espacios que hacen posible una vida más consciente y conectada con la naturaleza.
        </p>
        <p class="text-gray-500 text-lg leading-relaxed">
          Cada aporte, grande o pequeño, siembra una semilla de transformación en Varsana.
        </p>
        <div class="flex flex-wrap gap-4 pt-4">
          <a
            href="#donar"
            class="bg-rausch text-white px-10 py-4 rounded-2xl font-bold text-lg hover:scale-105 transition-all duration-300 shadow-lg inline-block"
          >
            Hacer una Donación
          </a>
          <a
            href={l('/nosotros')}
            class="border border-near-black px-10 py-4 rounded-2xl font-bold text-lg hover:bg-gray-50 transition-colors inline-block"
          >
            Conócenos
          </a>
        </div>
      </div>

      <div class="relative aspect-[4/3] rounded-[32px] overflow-hidden shadow-airbnb hover:scale-[1.02] transition-transform duration-700 ease-in-out">
        <img
          src="https://picsum.photos/seed/donar-hero/1200/900"
          alt="Comunidad en Varsana"
          class="w-full h-full object-cover"
          referrerpolicy="no-referrer"
        />
      </div>
    </section>

    <!-- What Donations Support -->
    <section class="mb-24">
      <div class="mb-12">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tightest mb-4">¿Qué haces posible?</h2>
        <p class="text-gray-500 text-lg">Tres pilares que tu generosidad ayuda a sostener.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {supportAreas.map((area) => (
          <div class="p-8 bg-lotus-white border border-sacred-sand rounded-[24px] shadow-airbnb hover:shadow-airbnb-hover hover:scale-[1.02] transition-all duration-600 ease-in-out space-y-4">
            <div class="w-12 h-12 bg-rausch/10 rounded-xl flex items-center justify-center text-rausch">
              <area.icon size={24} />
            </div>
            <h3 class="text-xl font-bold tracking-tightest">{area.title}</h3>
            <p class="text-gray-500 text-sm leading-relaxed">{area.description}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Image + Text Split -->
    <section class="mb-24 flex flex-col lg:flex-row items-center gap-12 lg:gap-16">
      <div class="w-full lg:w-1/2 grid grid-cols-2 gap-4">
        <img
          src="https://picsum.photos/seed/huerta-donar/600/800"
          alt="Huerta orgánica"
          class="rounded-3xl shadow-airbnb w-full h-full object-cover aspect-[3/4]"
          referrerpolicy="no-referrer"
        />
        <img
          src="https://picsum.photos/seed/templo-donar/600/800"
          alt="Templo Varsana"
          class="rounded-3xl shadow-airbnb w-full h-full object-cover aspect-[3/4] mt-8"
          referrerpolicy="no-referrer"
        />
      </div>

      <div class="w-full lg:w-1/2 space-y-6 lg:space-y-8">
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold font-display text-near-black leading-tight">
          Una aldea que se cultiva<br />con amor colectivo
        </h2>
        <p class="text-lg text-gray-500 leading-relaxed max-w-lg">
          Varsana no es solo un lugar — es un proyecto vivo que crece gracias a quienes creen en una forma distinta de habitar el mundo. Cada donación riega las raíces de esta comunidad.
        </p>
        <p class="text-lg text-gray-500 leading-relaxed max-w-lg">
          Desde las semillas en la huerta hasta las velas del templo, tu apoyo se traduce en acciones concretas que cuidan la tierra, el cuerpo y el espíritu.
        </p>
      </div>
    </section>

    <!-- CTA Banner -->
    <section id="donar" class="bg-near-black rounded-[32px] md:rounded-[40px] p-8 md:p-16 lg:p-24 text-white flex flex-col lg:flex-row items-center justify-between gap-12 overflow-hidden relative shadow-airbnb text-center lg:text-left">
      <div class="space-y-8 z-10 max-w-2xl">
        <h2 class="text-3xl md:text-5xl lg:text-6xl font-bold leading-tight tracking-tightest">
          Tu generosidad transforma vidas
        </h2>
        <p class="text-gray-400 text-lg md:text-xl leading-relaxed">
          Cada aporte nutre este sueño colectivo. Dona hoy y sé parte de la familia que hace posible Varsana.
        </p>
        <div class="flex flex-wrap gap-4 md:gap-6 justify-center lg:justify-start">
          <a
            href="https://donar.varsana.co"
            class="w-full sm:w-auto bg-rausch hover:bg-rausch-dark text-white px-8 md:px-10 py-4 md:py-5 rounded-2xl font-bold text-lg transition-all duration-300 hover:shadow-lg active:scale-95 inline-block text-center"
          >
            Hacer una Donación
          </a>
          <a
            href={l('/nosotros')}
            class="w-full sm:w-auto bg-white/10 hover:bg-white/20 text-white border border-white/20 px-8 md:px-10 py-4 md:py-5 rounded-2xl font-bold text-lg transition-all duration-300 inline-block text-center"
          >
            Conoce más
          </a>
        </div>
      </div>

      <div class="relative w-full lg:w-1/2 aspect-video rounded-3xl overflow-hidden shadow-airbnb rotate-0 lg:rotate-2 hover:rotate-0 transition-transform duration-500">
        <img
          src="https://picsum.photos/seed/donar-cta/1200/750"
          alt="Comunidad Varsana"
          class="w-full h-full object-cover"
          referrerpolicy="no-referrer"
        />
      </div>
    </section>

  </main>
</Layout>

<style>
  h1, h2, h3 {
    letter-spacing: -0.02em;
  }
</style>
