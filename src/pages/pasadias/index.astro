---

import Layout from '@/src/layouts/Layout.astro';
import PageBanner from '@/src/components/PageBanner.astro';
import PasadiaCard from '@/src/components/PasadiaCard.astro';
import { getAllPasadias } from '@/src/lib/pasadias';
import { useTranslations } from '@/src/i18n/utils';

const locale = (Astro.locals as any)?.locale ?? Astro.currentLocale ?? 'es';
const t = useTranslations(locale);

const allPasadias = await getAllPasadias(locale);
---

<Layout title="Pasadías | Varsana Eco Yoga Aldea">
  <main class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 pt-6 md:pt-8 pb-16">
    <PageBanner
      title={t('pasadias.heading')}
      subtitle={t('pasadias.subtitle')}
      breadcrumb={[
        { label: 'Inicio', url: '/' },
        { label: t('nav.pasadias'), url: '/pasadias' },
      ]}
    />

    {allPasadias.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-12 mt-12">
        {allPasadias.map((pasadia) => (
          <PasadiaCard {...pasadia.data} slug={pasadia.id} />
        ))}
      </div>
    ) : (
      <div class="py-20 text-center bg-gray-50 rounded-3xl">
        <p class="text-2xl font-medium text-gray-400">{t('pasadias.noPasadias')}</p>
        <a href="/" class="mt-6 inline-block text-rausch font-bold underline">{t('pasadias.backHome')}</a>
      </div>
    )}
  </main>
</Layout>
