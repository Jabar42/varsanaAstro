---

import Layout from '@/src/layouts/Layout.astro';
import PageBanner from '@/src/components/PageBanner.astro';
import PasadiaCard from '@/src/components/PasadiaCard.astro';
import { getAllPasadias } from '@/src/lib/pasadias';
import { useTranslations, getLocale, localizePath } from '@/src/i18n/utils';

const locale = getLocale(Astro);
const t = useTranslations(locale);
const l = (p: string) => localizePath(locale, p);

const allPasadias = await getAllPasadias(locale);
---

<Layout title={t('pasadiasPage.metaTitle')} description={t('pasadiasPage.metaDescription')}>
  <main class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 pt-6 md:pt-8 pb-16">
    <PageBanner
      title={t('pasadias.heading')}
      subtitle={t('pasadias.subtitle')}
      breadcrumb={[
        { label: t('nav.home'), url: l('/') },
        { label: t('nav.pasadias'), url: l('/pasadias') },
      ]}
    />

    {allPasadias.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-12 py-16 md:py-24" data-reveal-group>
        {allPasadias.map((pasadia) => (
          <div><PasadiaCard {...pasadia.data} slug={pasadia.id} /></div>
        ))}
      </div>
    ) : (
      <div class="my-16 md:my-24 on-dark arch-wide px-6 pt-28 pb-16 md:pt-36 md:pb-20 text-center">
        <p class="display-md font-display font-bold max-w-2xl mx-auto">{t('pasadias.noPasadias')}</p>
        <a href={l('/')} class="btn btn-light btn-arrow mt-8">{t('pasadias.backHome')}</a>
      </div>
    )}
  </main>
</Layout>
