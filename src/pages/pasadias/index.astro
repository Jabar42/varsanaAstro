---
export const prerender = true;

import Layout from '@/src/layouts/Layout.astro';
import PasadiaCard from '@/src/components/PasadiaCard.astro';
import { getAllPasadias } from '@/src/lib/pasadias';

const allPasadias = await getAllPasadias();
---

<Layout title="Pasadías | Varsana Eco Yoga Aldea">
  <main class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 py-16">
    <div class="mb-12">
      <h1 class="text-5xl font-bold tracking-tightest mb-4">Pasadías</h1>
      <p class="text-gray-500 text-xl">Descubre nuestras experiencias de día completo en contacto con la naturaleza y la espiritualidad.</p>
    </div>
    
    {allPasadias.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-12">
        {allPasadias.map((pasadia) => (
          <PasadiaCard {...pasadia.data} slug={pasadia.id} />
        ))}
      </div>
    ) : (
      <div class="py-20 text-center bg-gray-50 rounded-3xl">
        <p class="text-2xl font-medium text-gray-400">No hay pasadías disponibles en este momento.</p>
        <a href="/" class="mt-6 inline-block text-rausch font-bold underline">Volver al inicio</a>
      </div>
    )}
  </main>
</Layout>
