---

import Layout from '@/src/layouts/Layout.astro';
import { getEntry, render } from 'astro:content';
import { getCurrentPrice } from '@/src/lib/pasadias';
import BoldPaymentButton from '@/src/components/BoldPaymentButton';
import { Clock, MapPin, Check } from 'lucide-react';

const { slug } = Astro.params;
const pasadia = await getEntry('pasadias', slug!);
if (!pasadia) return Astro.redirect('/404');

const { title, description, image, prices, stock_max, duration, meeting_point, category, included_services, location, host_name, host_tagline, host_image } = pasadia.data;
const { Content } = await render(pasadia);

const currentPrice = getCurrentPrice(prices);

// SEO Data
const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://varsana.com');
---

<Layout title={`${title} | Varsana Eco Yoga Aldea`} description={description}>
  <Fragment slot="head">
    <!-- SEO / OpenGraph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
  </Fragment>

  <div class="max-w-7xl mx-auto px-0 md:px-12 lg:px-20 py-0 md:py-8">
    <!-- Photography-first Header -->
    <div class="md:rounded-[24px] overflow-hidden relative h-75 md:h-125 lg:h-150 shadow-airbnb">
      <img 
        src={image} 
        alt={title} 
        class="w-full h-full object-cover"
        referrerpolicy="no-referrer"
      />
    </div>

    <div class="px-6 md:px-0 mt-8 grid grid-cols-1 lg:grid-cols-3 gap-12">
      <!-- Main Content Column -->
      <div class="lg:col-span-2 space-y-8">
        <div class="border-b border-sacred-sand pb-8">
          <h1 class="text-4xl md:text-6xl font-bold tracking-tightest mb-4 font-display">{title}</h1>
          <div class="flex flex-wrap gap-6 text-sm font-medium">
            <div class="flex items-center gap-2">
              <Clock size={18} className="text-saffron" />
              <span>{duration}</span>
            </div>
            <div class="flex items-center gap-2">
              <MapPin size={18} className="text-saffron" />
              <span>{meeting_point}</span>
            </div>
          </div>
        </div>

        <!-- Host Info -->
        <div class="flex items-center justify-between border-b border-sacred-sand pb-8">
          <div class="space-y-1">
            <h2 class="text-2xl font-bold font-display">Experiencia organizada por {host_name}</h2>
            <p class="text-secondary-gray text-sm">{host_tagline}</p>
          </div>
          <div class="w-14 h-14 bg-sacred-sand rounded-full flex items-center justify-center overflow-hidden">
             <img src={host_image || '/logo/LogoPrincipal.svg'} alt={host_name} class="w-full h-full object-cover" />
          </div>
        </div>

        <!-- Description -->
        <div class="max-w-none">
          <Content />
        </div>

        <!-- Included Services -->
        {included_services && included_services.length > 0 && (
          <div class="border-t border-sacred-sand pt-8">
            <h3 class="text-2xl font-bold mb-6 font-display">Servicios incluidos</h3>
            <ul class="grid grid-cols-1 md:grid-cols-2 gap-4">
              {included_services.map((service, idx) => (
                <li class="flex items-center gap-3">
                  <Check size={18} className="text-saffron shrink-0" />
                  <span>{service}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

      </div>

      <!-- Sticky Price Card Column -->
      <div class="relative">
        <div class="sticky top-28 bg-lotus-white border border-sacred-sand rounded-[24px] p-6 shadow-airbnb space-y-6">
          <div>
            <span class="text-3xl font-bold tracking-tightest font-display">${currentPrice?.amount.toLocaleString('es-CO')}</span>
            <span class="text-secondary-gray text-base font-normal"> / persona</span>
          </div>

          <!-- Booking Details Box -->
          <div class="border border-sacred-sand rounded-xl overflow-hidden">
            <div class="grid grid-cols-2 border-b border-sacred-sand">
              <div class="p-3 border-r border-sacred-sand">
                <p class="text-xs font-bold uppercase">Duración</p>
                <p class="text-sm">{duration}</p>
              </div>
              <div class="p-3">
                <p class="text-xs font-bold uppercase">Cupos por día</p>
                <p class="text-sm">{stock_max} personas</p>
              </div>
            </div>
            <div class="p-3">
              <p class="text-xs font-bold uppercase">Tipo de Entrada</p>
              <p class="text-sm font-medium text-saffron">{currentPrice?.label || 'General'}</p>
            </div>
          </div>

          <!-- Payment Button -->
          <BoldPaymentButton
            client:load
            contentType="pasadia"
            contentId={pasadia.id}
            prices={prices}
          />

          <p class="text-center text-secondary-gray text-xs">Asegura tu cupo con anticipación</p>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  h1, h2, h3, h4 {
    letter-spacing: -0.02em;
  }
</style>
