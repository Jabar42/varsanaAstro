---

import Layout from '@/src/layouts/Layout.astro';
import { getEntry, render } from 'astro:content';
import { getCurrentPrice } from '@/src/lib/pasadias';
import BoldPaymentButton from '@/src/components/BoldPaymentButton';
import { Clock, MapPin, Check } from 'lucide-react';
import { getLocale, useTranslations } from '@/src/i18n/utils';

const locale = getLocale(Astro);
const t = useTranslations(locale);

const { slug } = Astro.params;
const pasadia = await getEntry('pasadias', slug!);
if (!pasadia) return Astro.redirect('/404');

const { title, description, image, prices, stock_max, duration, meeting_point, included_services, host_name, host_tagline, host_image } = pasadia.data;
const { Content } = await render(pasadia);

const currentPrice = getCurrentPrice(prices);
const numberLocale = locale === 'en' ? 'en-US' : 'es-CO';

// SEO Data
const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://varsana.com');
---

<Layout title={t('pasadiaDetail.metaTitle', { title })} description={description}>
  <Fragment slot="head">
    <!-- SEO / OpenGraph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
  </Fragment>

  <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 pt-6 md:pt-10 pb-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 lg:grid-rows-[auto_1fr] gap-x-12 xl:gap-x-16 gap-y-10">
      <!-- Photography-first Header: la foto se mira a través del arco -->
      <div class="lg:col-start-8 lg:col-span-5 lg:row-start-1">
        <div class="arch shimmer aspect-4/5 max-h-[34rem] w-full mx-auto bg-forest-night">
          <img
            src={image}
            alt={title}
            class="w-full h-full object-cover"
            referrerpolicy="no-referrer"
          />
        </div>
      </div>

      <!-- Main Content Column -->
      <div class="lg:col-start-1 lg:col-span-7 lg:row-start-1 lg:row-span-2 space-y-10">
        <div class="lg:pt-10">
          <span class="rule-saffron mb-8" aria-hidden="true"></span>
          <h1 class="display-xl font-bold font-display text-near-black">{title}</h1>
          <div class="mt-8 flex flex-wrap gap-x-8 gap-y-3 text-sm font-medium">
            <div class="flex items-center gap-2">
              <Clock size={18} className="text-saffron-deep shrink-0" />
              <span>{duration}</span>
            </div>
            <div class="flex items-center gap-2">
              <MapPin size={18} className="text-saffron-deep shrink-0" />
              <span>{meeting_point}</span>
            </div>
          </div>
        </div>

        <!-- Host Info -->
        <div class="flex items-center justify-between gap-6 border-y border-near-black/10 py-6">
          <div class="space-y-1">
            <h2 class="text-xl md:text-2xl font-bold font-display">{t('pasadiaDetail.organizedBy', { host: host_name })}</h2>
            <p class="text-secondary-gray text-sm">{host_tagline}</p>
          </div>
          <div class="w-14 h-14 shrink-0 bg-sand-deep rounded-full flex items-center justify-center overflow-hidden">
             <img src={host_image || '/logo/LogoPrincipal.svg'} alt={t('pasadiaDetail.hostImageAlt', { host: host_name })} class="w-full h-full object-cover" />
          </div>
        </div>

        <!-- Description -->
        <div class="max-w-none">
          <Content />
        </div>

        <!-- Included Services -->
        {included_services && included_services.length > 0 && (
          <div class="border-t border-near-black/10 pt-10">
            <h3 class="display-md font-bold mb-8 font-display">{t('pasadias.includedServices')}</h3>
            <ul class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-4">
              {included_services.map((service) => (
                <li class="flex items-start gap-3">
                  <Check size={18} className="text-forest-deep shrink-0 mt-1" />
                  <span>{service}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

      </div>

      <!-- Sticky Price Card Column -->
      <div class="relative lg:col-start-8 lg:col-span-5 lg:row-start-2">
        <div class="sticky top-28 bg-lotus-white ring-1 ring-near-black/5 rounded-3xl p-6 md:p-8 space-y-6">
          <div>
            <span class="text-3xl md:text-4xl font-bold font-display">${currentPrice ? currentPrice.amount.toLocaleString(numberLocale) : '—'}</span>
            <span class="text-secondary-gray text-base font-normal">{t('pasadias.perPerson')}</span>
          </div>

          <!-- Booking Details Box -->
          <div class="border border-near-black/10 rounded-2xl overflow-hidden">
            <div class="grid grid-cols-2 border-b border-near-black/10">
              <div class="p-4 border-r border-near-black/10">
                <p class="text-xs font-bold uppercase tracking-wide text-secondary-gray">{t('pasadias.duration')}</p>
                <p class="text-sm mt-1">{duration}</p>
              </div>
              <div class="p-4">
                <p class="text-xs font-bold uppercase tracking-wide text-secondary-gray">{t('pasadias.spotsPerDay')}</p>
                <p class="text-sm mt-1">{t('pasadiaDetail.people', { n: stock_max })}</p>
              </div>
            </div>
            <div class="p-4">
              <p class="text-xs font-bold uppercase tracking-wide text-secondary-gray">{t('pasadias.ticketType')}</p>
              <p class="text-sm mt-1 font-medium text-saffron-deep">{currentPrice?.label || t('pasadiaDetail.ticketGeneral')}</p>
            </div>
          </div>

          <!-- Payment Button -->
          <BoldPaymentButton
            client:load
            locale={locale}
            contentType="pasadia"
            contentId={pasadia.id}
            prices={prices}
          />

          <p class="text-center text-secondary-gray text-xs">{t('pasadias.secureSpot')}</p>
        </div>
      </div>
    </div>
  </div>
</Layout>

