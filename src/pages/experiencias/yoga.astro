---
import { getLocale, useTranslations, localizePath } from '@/src/i18n/utils';
import Layout from '@/src/layouts/Layout.astro';
import PageBanner from '@/src/components/PageBanner.astro';
import {
  Leaf, Info, CheckCircle2, Wallet, Monitor,
  MessageCircle, GraduationCap, BookOpen,
} from 'lucide-react';
import { es as yogaEs, en as yogaEn } from '@/src/i18n/dictionaries/yogaPage';

const locale = getLocale(Astro);
const t = useTranslations(locale);
const l = (path: string) => localizePath(locale, path);
const dict = locale === 'en' ? yogaEn : yogaEs;

const BANNER_IMAGE = '/api/images/1786986725378-yoga-banner.webp';
const IMG_CLASE = '/api/images/1786986726696-yoga-clase.webp';
// Fotos de las dos carpetas enviadas en VC-261126-04; origen en docs/change-requests/.
const IMG_INCLUYE = '/api/images/yoga-inbound-practica-incluye-20261125.webp';
const IMG_INVERSION = '/api/images/yoga-inbound-clase-grupal-20261125.webp';

const WHATSAPP_URL = 'https://wa.me/573214538242';

const introParagraphs = dict.introParagraphs;
const locationIcons = [Leaf, BookOpen];
const locations = dict.locations.map((loc, i) => ({ ...loc, icon: locationIcons[i] ?? Leaf }));
const includes = dict.includes.items;
const faqs = dict.faq.items;
---

<Layout title={t('yogaPage.metaTitle')} description={t('yogaPage.metaDescription')}>

  <main>
    <!-- Page Banner -->
    <div id="banner" class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 pt-6 md:pt-8">
      <PageBanner
        title={t('yogaPage.bannerTitle')}
        subtitle={t('yogaPage.bannerSubtitle')}
        image={BANNER_IMAGE}
        breadcrumb={[
          { label: t('yogaPage.breadcrumbHome'), url: l('/') },
          { label: t('yogaPage.breadcrumbExperiencias'), url: l('/experiencias') },
          { label: t('yogaPage.breadcrumbYoga'), url: l('/experiencias/yoga') },
        ]}
      />
    </div>

    <!-- Introducción + CTA -->
    <section id="yoga-en-varsana" class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 py-20 md:py-28 scroll-mt-20">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-y-14 gap-x-16 items-center">
        <div class="lg:col-span-7" data-reveal-group>
          <span class="rule-saffron mb-8" data-reveal="draw" aria-hidden="true"></span>
          <h2 class="display-lg font-bold font-display text-near-black">{t('yogaPage.introHeading')}</h2>
          <div class="mt-8 space-y-5 max-w-2xl">
            {introParagraphs.map((p) => (
              <p class="lead-first text-secondary-gray text-lg leading-relaxed">{p}</p>
            ))}
          </div>
          <div class="mt-10 flex flex-wrap gap-4">
            <a href={WHATSAPP_URL} target="_blank" rel="noopener" class="btn btn-lg">
              <MessageCircle size={20} />
              {t('yogaPage.ctaWhatsapp')}
            </a>
          </div>
        </div>
        <div class="lg:col-span-5">
          <div class="arch parallax shimmer aspect-4/5 w-full max-w-md mx-auto lg:mr-0" data-reveal="mask">
            <img
              src={IMG_CLASE}
              alt={t('yogaPage.introImageAlt')}
              class="w-full h-full object-cover"
              decoding="async"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Modalidad presencial -->
    <section id="modalidad-presencial" class="bg-sand-deep py-20 md:py-28 scroll-mt-20">
      <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-y-6 gap-x-16 items-end mb-12 md:mb-16" data-reveal-group>
          <h2 class="lg:col-span-7 display-md font-bold font-display text-near-black">{t('yogaPage.modalidad.heading')}</h2>
          <p class="lg:col-span-5 lg:pb-1 text-secondary-gray text-lg leading-relaxed">
            {t('yogaPage.modalidad.subtitle')}
          </p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6" data-reveal-group>
          <div class="p-8 bg-lotus-white rounded-3xl ring-1 ring-near-black/5">
            <div class="w-12 h-12 bg-forest/10 rounded-xl flex items-center justify-center text-forest-deep">
              <!-- Lucide does not include a yoga-pose icon in the installed version. -->
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <circle cx="12" cy="4" r="2" />
                <path d="M12 8v7M8 9l-3 5H2m14-5 3 5h3M8 13l4 2 4-2M12 15l-6 2c-3 1-3 4 0 4h12c3 0 3-3 0-4l-6-2M7 21l10-3M17 21 7 18" />
              </svg>
            </div>
            <h3 class="mt-6 text-xl font-bold font-display">{t('yogaPage.modalidad.cardTitle')}</h3>
            <p class="mt-3 text-secondary-gray text-sm leading-relaxed">{t('yogaPage.modalidad.cardText')}</p>
          </div>
          {locations.map((loc) => (
            <a href={l(loc.href)} class="group block p-8 bg-lotus-white rounded-3xl ring-1 ring-near-black/5 hover:shadow-airbnb transition-shadow duration-300">
              <div class="flex items-start justify-between">
                <div class="w-12 h-12 bg-forest/10 rounded-xl flex items-center justify-center text-forest-deep">
                  <loc.icon size={24} />
                </div>
                <span class="btn-arrow inline-flex text-forest-dark mt-3" aria-hidden="true"></span>
              </div>
              <h3 class="mt-6 text-xl font-bold font-display">{loc.name}</h3>
              <p class="mt-3 text-secondary-gray text-sm leading-relaxed">{loc.address}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Qué incluye -->
    <section id="incluye" class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 py-20 md:py-28 scroll-mt-20">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-y-12 gap-x-16 items-center">
        <div class="lg:col-span-7" data-reveal-group>
          <span class="rule-saffron mb-8" data-reveal="draw" aria-hidden="true"></span>
          <h2 class="display-md font-bold font-display text-near-black">{t('yogaPage.includes.heading')}</h2>
          <p class="mt-5 text-secondary-gray text-lg leading-relaxed max-w-xl">
            {t('yogaPage.includes.text')}
          </p>
          <ul class="mt-8 border-t border-near-black/10">
            {includes.map((item) => (
              <li class="flex items-start gap-4 py-4 border-b border-near-black/10 text-lg font-medium">
                <CheckCircle2 className="text-forest-dark shrink-0 mt-0.5" size={24} />
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="lg:col-span-5" data-reveal>
          <img
            src={IMG_INCLUYE}
            alt={t('yogaPage.includes.imageAlt')}
            width="1200"
            height="1200"
            class="rounded-3xl w-full aspect-square object-cover"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </section>

    <!-- Inversión -->
    <section id="inversion" class="bg-sand-deep py-20 md:py-28 scroll-mt-20">
      <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 grid grid-cols-1 lg:grid-cols-12 gap-y-12 gap-x-16 items-center">
        <div class="lg:col-span-5" data-reveal>
          <img
            src={IMG_INVERSION}
            alt={t('yogaPage.inversion.imageAlt')}
            width="1200"
            height="901"
            class="rounded-3xl w-full aspect-4/3 lg:aspect-4/5 object-cover"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="lg:col-span-7" data-reveal-group>
          <h2 class="display-md font-bold font-display text-near-black">{t('yogaPage.inversion.heading')}</h2>
          <div class="mt-8 bg-lotus-white rounded-3xl ring-1 ring-near-black/5 divide-y divide-near-black/10">
            <div class="flex items-center justify-between gap-4 px-5 py-5 md:px-8">
              <div class="flex items-center gap-4 min-w-0">
                <div class="w-11 h-11 bg-forest/10 rounded-xl flex items-center justify-center text-forest-deep shrink-0">
                  <Wallet size={22} />
                </div>
                <span class="font-bold text-lg">{t('yogaPage.inversion.presencial')}</span>
              </div>
              <div class="text-right shrink-0">
                <span class="block font-display font-bold text-forest-deep text-xl md:text-2xl">$___</span>
              </div>
            </div>
            <div class="flex items-center justify-between gap-4 px-5 py-5 md:px-8">
              <div class="flex items-center gap-4 min-w-0">
                <div class="w-11 h-11 bg-forest/10 rounded-xl flex items-center justify-center text-forest-deep shrink-0">
                  <Monitor size={22} />
                </div>
                <span class="font-bold text-lg">{t('yogaPage.inversion.virtual')}</span>
              </div>
              <div class="text-right shrink-0">
                <span class="block font-display font-bold text-forest-deep text-xl md:text-2xl">$___</span>
              </div>
            </div>
          </div>
          <div class="mt-6 flex items-start gap-4 px-5 md:px-8">
            <Info className="text-saffron-deep shrink-0 mt-0.5" size={22} />
            <p class="text-sm text-secondary-gray leading-relaxed">
              {t('yogaPage.inversion.note')}
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section id="preguntas-frecuentes" class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 py-20 md:py-28 scroll-mt-20">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-y-10 gap-x-16 items-start">
        <div class="lg:col-span-4 lg:sticky lg:top-28" data-reveal-group>
          <span class="rule-saffron mb-8" data-reveal="draw" aria-hidden="true"></span>
          <h2 class="display-md font-bold font-display text-near-black">{t('yogaPage.faq.heading')}</h2>
          <p class="mt-4 text-secondary-gray text-lg">{t('yogaPage.faq.subtitle')}</p>
          <a href={WHATSAPP_URL} target="_blank" rel="noopener" class="mt-8 inline-flex items-center gap-2 text-rausch font-semibold underline underline-offset-4 decoration-rausch/30 hover:decoration-rausch transition-colors duration-300">
            <MessageCircle size={20} />
            {t('yogaPage.faq.cta')}
          </a>
        </div>
        <div class="lg:col-span-8 border-t border-near-black/10" data-reveal>
          {faqs.map((q, i) => (
            <div class="flex items-start gap-4 border-b border-near-black/10 py-6">
              <CheckCircle2 className="text-forest-dark shrink-0 mt-1" size={20} />
              <div class="space-y-4">
                <h3 class="text-lg md:text-xl font-display font-bold">{q}</h3>
                {i === 0 && (
                  <div class="space-y-4 text-secondary-gray leading-relaxed">
                    <p>{dict.faq.firstAnswer.text}</p>
                    <ul class="list-disc pl-6 space-y-2 marker:text-saffron-deep">
                      {dict.faq.firstAnswer.items.map((item) => <li>{item}</li>)}
                    </ul>
                  </div>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA certificación -->
    <section class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20">
      <div class="on-dark rounded-3xl px-7 py-12 md:p-16 grid grid-cols-1 lg:grid-cols-12 gap-y-8 gap-x-16 items-end" data-reveal>
        <div class="lg:col-span-7">
          <div class="w-14 h-14 bg-saffron/10 text-saffron rounded-xl flex items-center justify-center mb-8">
            <GraduationCap size={28} />
          </div>
          <h2 class="display-md font-bold font-display text-white">{t('yogaPage.certificacion.heading')}</h2>
        </div>
        <div class="lg:col-span-5">
          <p class="text-sacred-sand/75 text-lg leading-relaxed">
            {t('yogaPage.certificacion.text')}
          </p>
          <a href={l('/experiencias/yoga-terapeutico')} class="btn btn-lg btn-light btn-arrow mt-8">
            {t('yogaPage.certificacion.cta')}
          </a>
        </div>
      </div>
    </section>

    <!-- CTA final -->
    <section class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 pt-20 md:pt-28 pb-4 md:pb-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-y-8 gap-x-16 items-end" data-reveal-group>
        <div class="lg:col-span-7">
          <span class="rule-saffron mb-8" data-reveal="draw" aria-hidden="true"></span>
          <h2 class="display-lg font-bold font-display text-near-black">{t('yogaPage.final.heading')}</h2>
        </div>
        <div class="lg:col-span-5 lg:pb-2">
          <p class="text-secondary-gray text-lg md:text-xl leading-relaxed">
            {t('yogaPage.final.text')}
          </p>
          <a href={WHATSAPP_URL} target="_blank" rel="noopener" class="btn btn-lg mt-8">
            <MessageCircle size={20} />
            {t('yogaPage.final.cta')}
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  /* Entradilla: el primer párrafo abre con la tipografía de titulares */
  .lead-first:first-child {
    color: var(--color-near-black);
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1.1rem + 0.7vw, 1.5rem);
    line-height: 1.4;
    letter-spacing: -0.01em;
  }
</style>
