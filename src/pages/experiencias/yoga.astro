---
import { getLocale, useTranslations, localizePath } from '@/src/i18n/utils';
import Layout from '@/src/layouts/Layout.astro';
import PageBanner from '@/src/components/PageBanner.astro';
import {
  Leaf, Info, CheckCircle2, Wallet, Flower2, MapPin, Monitor,
  MessageCircle, GraduationCap,
} from 'lucide-react';
import { es as yogaEs, en as yogaEn } from '@/src/i18n/dictionaries/yogaPage';

const locale = getLocale(Astro);
const t = useTranslations(locale);
const l = (path: string) => localizePath(locale, path);
const dict = locale === 'en' ? yogaEn : yogaEs;

const BANNER_IMAGE = '/api/images/1786986725378-yoga-banner.webp';
const IMG_CLASE = '/api/images/1786986726696-yoga-clase.webp';
// Placeholders: reemplazar cuando lleguen las imágenes reales
const IMG_INCLUYE = '';
const IMG_INVERSION = '';

const WHATSAPP_URL = 'https://wa.me/573214538242';

const introParagraphs = dict.introParagraphs;
const locationIcons = [Leaf, MapPin];
const locations = dict.locations.map((loc, i) => ({ ...loc, icon: locationIcons[i] ?? MapPin }));
const includes = dict.includes.items;
const faqs = dict.faq.items;
---

<Layout title={t('yogaPage.metaTitle')} description={t('yogaPage.metaDescription')}>

  <main class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 pt-6 md:pt-8 pb-12">
    <!-- Page Banner -->
    <PageBanner
      title={t('yogaPage.bannerTitle')}
      subtitle={t('yogaPage.bannerSubtitle')}
      image={BANNER_IMAGE}
      breadcrumb={[
        { label: t('yogaPage.breadcrumbHome'), url: l('/') },
        { label: t('yogaPage.breadcrumbExperiencias'), url: l('/experiencias') },
        { label: t('yogaPage.breadcrumbYoga'), url: l('/experiencias/yoga') },
      ]}
    />

    <!-- CTA row -->
    <div class="flex flex-wrap justify-center gap-4 mt-8 mb-16">
      <a href={WHATSAPP_URL} target="_blank" rel="noopener" class="bg-rausch text-white px-8 py-4 rounded-2xl font-bold text-lg hover:scale-105 transition-transform shadow-lg inline-flex items-center gap-2">
        <MessageCircle size={22} />
        {t('yogaPage.ctaWhatsapp')}
      </a>
      <a href={l('/experiencias/yoga-terapeutico')} class="border border-near-black px-8 py-4 rounded-2xl font-bold text-lg hover:bg-gray-50 transition-colors inline-flex items-center gap-2">
        <GraduationCap size={22} />
        {t('yogaPage.ctaCertification')}
      </a>
    </div>

    <!-- Introducción -->
    <section class="mb-24 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div class="space-y-5">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tightest mb-6">{t('yogaPage.introHeading')}</h2>
        {introParagraphs.map((p) => (
          <p class="text-gray-600 text-lg leading-relaxed">{p}</p>
        ))}
      </div>
      <img
        src={IMG_CLASE}
        alt={t('yogaPage.introImageAlt')}
        class="rounded-[32px] shadow-airbnb w-full aspect-video object-cover"
        decoding="async"
      />
    </section>

    <!-- Modalidad y lugares -->
    <section class="mb-24 bg-light-surface rounded-[32px] p-8 md:p-16">
      <div class="max-w-3xl mx-auto mb-12 text-center">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tightest mb-4">{t('yogaPage.modalidad.heading')}</h2>
        <p class="text-gray-500 text-lg">
          {t('yogaPage.modalidad.subtitle')}
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-5xl mx-auto">
        <div class="p-8 bg-lotus-white border border-sacred-sand rounded-[24px] shadow-airbnb hover:shadow-airbnb-hover transition-shadow space-y-4">
          <div class="w-12 h-12 bg-rausch/10 rounded-xl flex items-center justify-center text-rausch">
            <Monitor size={24} />
          </div>
          <h3 class="text-xl font-bold tracking-tightest">{t('yogaPage.modalidad.cardTitle')}</h3>
          <p class="text-gray-500 text-sm leading-relaxed">{t('yogaPage.modalidad.cardText')}</p>
        </div>
        {locations.map((loc) => (
          <div class="p-8 bg-lotus-white border border-sacred-sand rounded-[24px] shadow-airbnb hover:shadow-airbnb-hover transition-shadow space-y-4">
            <div class="w-12 h-12 bg-rausch/10 rounded-xl flex items-center justify-center text-rausch">
              <loc.icon size={24} />
            </div>
            <h3 class="text-xl font-bold tracking-tightest">{loc.name}</h3>
            <p class="text-gray-500 text-sm leading-relaxed">{loc.address}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Qué incluye -->
    <section class="mb-24 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div class="space-y-8">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tightest">{t('yogaPage.includes.heading')}</h2>
        <p class="text-gray-600 text-lg leading-relaxed">
          {t('yogaPage.includes.text')}
        </p>
        <ul class="space-y-4">
          {includes.map((item) => (
            <li class="flex items-start gap-4 text-lg font-medium">
              <CheckCircle2 className="text-rausch shrink-0 mt-1" size={24} />
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
      {IMG_INCLUYE ? (
        <img
          src={IMG_INCLUYE}
          alt={t('yogaPage.includes.imageAlt')}
          class="rounded-[32px] shadow-airbnb w-full aspect-square object-cover"
          decoding="async"
        />
      ) : (
        <div class="rounded-[32px] border-2 border-dashed border-gray-300 bg-light-surface w-full aspect-square flex flex-col items-center justify-center gap-3 text-gray-400">
          <Flower2 size={48} />
          <p class="font-medium">IMG_INCLUYE</p>
          <p class="text-sm">{t('yogaPage.placeholderNote')}</p>
        </div>
      )}
    </section>

    <!-- Inversión -->
    <section class="mb-24 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      {IMG_INVERSION ? (
        <img
          src={IMG_INVERSION}
          alt={t('yogaPage.inversion.imageAlt')}
          class="rounded-[32px] shadow-airbnb w-full aspect-square object-cover"
          decoding="async"
        />
      ) : (
        <div class="rounded-[32px] border-2 border-dashed border-gray-300 bg-light-surface w-full aspect-square flex flex-col items-center justify-center gap-3 text-gray-400">
          <Flower2 size={48} />
          <p class="font-medium">IMG_INVERSION</p>
          <p class="text-sm">{t('yogaPage.placeholderNote')}</p>
        </div>
      )}
      <div class="space-y-8">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tightest">{t('yogaPage.inversion.heading')}</h2>
        <div class="space-y-4">
          <div class="flex items-center justify-between gap-4 p-6 bg-lotus-white rounded-2xl border border-sacred-sand shadow-airbnb">
            <div class="flex items-center gap-4">
              <div class="w-12 h-12 bg-rausch/10 rounded-xl flex items-center justify-center text-rausch shrink-0">
                <Wallet size={24} />
              </div>
              <span class="font-bold text-lg">{t('yogaPage.inversion.presencial')}</span>
            </div>
            <div class="text-right">
              <span class="block font-bold text-rausch text-lg">$___</span>
            </div>
          </div>
          <div class="flex items-center justify-between gap-4 p-6 bg-lotus-white rounded-2xl border border-sacred-sand shadow-airbnb">
            <div class="flex items-center gap-4">
              <div class="w-12 h-12 bg-rausch/10 rounded-xl flex items-center justify-center text-rausch shrink-0">
                <Monitor size={24} />
              </div>
              <span class="font-bold text-lg">{t('yogaPage.inversion.virtual')}</span>
            </div>
            <div class="text-right">
              <span class="block font-bold text-rausch text-lg">$___</span>
            </div>
          </div>
        </div>
        <div class="flex items-start gap-4 p-6 bg-light-surface rounded-2xl border border-sacred-sand">
          <Info className="text-rausch shrink-0 mt-1" size={24} />
          <p class="text-sm text-gray-600">
            {t('yogaPage.inversion.note')}
          </p>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="max-w-3xl mx-auto mb-24 space-y-12">
      <div class="text-center">
        <h2 class="text-3xl font-bold tracking-tightest mb-4">{t('yogaPage.faq.heading')}</h2>
        <p class="text-gray-500">{t('yogaPage.faq.subtitle')}</p>
      </div>
      <div class="space-y-6">
        {faqs.map((q) => (
          <div class="flex items-start gap-4 border-b border-sacred-sand pb-6">
            <CheckCircle2 className="text-rausch shrink-0 mt-1" size={20} />
            <span class="text-lg font-medium">{q}</span>
          </div>
        ))}
      </div>
      <div class="text-center">
        <a href={WHATSAPP_URL} target="_blank" rel="noopener" class="inline-flex items-center gap-2 text-rausch font-bold hover:underline">
          <MessageCircle size={20} />
          {t('yogaPage.faq.cta')}
        </a>
      </div>
    </section>

    <!-- CTA certificación -->
    <section class="mb-24 bg-rausch rounded-[32px] p-10 md:p-16 text-center text-white shadow-airbnb">
      <div class="w-14 h-14 bg-white/10 rounded-xl flex items-center justify-center mx-auto mb-6">
        <GraduationCap size={28} />
      </div>
      <h2 class="text-3xl md:text-4xl font-bold tracking-tightest mb-4">{t('yogaPage.certificacion.heading')}</h2>
      <p class="text-white/80 text-lg mb-8 max-w-2xl mx-auto">
        {t('yogaPage.certificacion.text')}
      </p>
      <a href={l('/experiencias/yoga-terapeutico')} class="inline-block bg-white text-rausch px-8 py-4 rounded-2xl font-bold text-lg hover:scale-105 transition-transform shadow-lg">
        {t('yogaPage.certificacion.cta')}
      </a>
    </section>

    <!-- CTA final -->
    <section class="mb-24 text-center">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tightest mb-4">{t('yogaPage.final.heading')}</h2>
      <p class="text-gray-500 text-lg mb-8 max-w-2xl mx-auto">
        {t('yogaPage.final.text')}
      </p>
      <a href={WHATSAPP_URL} target="_blank" rel="noopener" class="inline-flex items-center gap-2 bg-rausch text-white px-8 py-4 rounded-2xl font-bold text-lg hover:scale-105 transition-transform shadow-lg">
        <MessageCircle size={22} />
        {t('yogaPage.final.cta')}
      </a>
    </section>
  </main>
</Layout>

<style>
  h1, h2, h3, h4 {
    letter-spacing: -0.02em;
  }
</style>
