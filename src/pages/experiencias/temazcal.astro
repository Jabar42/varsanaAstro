---
import { getLocale, useTranslations, localizePath } from '@/src/i18n/utils';

import Layout from '@/src/layouts/Layout.astro';
import PageBanner from '@/src/components/PageBanner.astro';
import { es as tzEs, en as tzEn } from '@/src/i18n/dictionaries/temazcalPage';

const locale = getLocale(Astro);
const t = useTranslations(locale);
const l = (path: string) => localizePath(locale, path);
const dict = locale === 'en' ? tzEn : tzEs;

const benefits = dict.benefits;
---

<Layout title={t('temazcalPage.metaTitle')} description={t('temazcalPage.metaDescription')}>

  <main>
    <!-- Page Banner -->
    <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 pt-6 md:pt-8">
      <PageBanner
        title={t('temazcalPage.bannerTitle')}
        subtitle={t('temazcalPage.bannerSubtitle')}
        image="/api/images/1784659086385-Banner-Temazcal.webp"
        imageAlt={t('temazcalPage.bannerImageAlt')}
        badge={t('temazcalPage.bannerBadge')}
        breadcrumb={[
          { label: t('temazcalPage.breadcrumbHome'), url: l('/') },
          { label: t('temazcalPage.breadcrumbExperiencias'), url: l('/experiencias') },
          { label: t('temazcalPage.breadcrumbTemazcal'), url: l('/experiencias/temazcal') },
        ]}
      />
    </div>

    <!-- Contenido -->
    <section class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 py-20 md:py-28">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-y-14 gap-x-16 items-center">
        <div class="lg:col-span-7" data-reveal-group>
          <span class="rule-saffron mb-8" data-reveal="draw" aria-hidden="true"></span>
          <h2 class="display-lg font-bold font-display text-near-black">
            {t('temazcalPage.heading')}
          </h2>
          <div class="mt-8 space-y-5 max-w-2xl">
            <p class="lead-first text-secondary-gray text-lg leading-relaxed">
              {t('temazcalPage.paragraph1')}
            </p>
            <p class="text-secondary-gray text-lg leading-relaxed">
              {t('temazcalPage.paragraph2')}
            </p>
          </div>
        </div>
        <div class="lg:col-span-5">
          <!-- Imagen decorativa (la misma tarjeta de Temazcal del inicio): alt vacío -->
          <div class="arch parallax shimmer aspect-4/5 w-full max-w-md mx-auto lg:mr-0" data-reveal="mask">
            <img
              src="/api/images/1783043616931-Temazcal.webp"
              alt=""
              class="w-full h-full object-cover"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Beneficios -->
    <section class="on-dark py-20 md:py-28">
      <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 grid grid-cols-1 lg:grid-cols-12 gap-y-10 gap-x-16 items-start">
        <div class="lg:col-span-5 lg:sticky lg:top-28" data-reveal-group>
          <span class="rule-saffron mb-8" data-reveal="draw" aria-hidden="true"></span>
          <h3 class="display-md font-bold font-display text-white">
            {t('temazcalPage.benefitsHeading')}
          </h3>
        </div>
        <ul class="lg:col-span-7 border-t border-sacred-sand/15" data-reveal-group>
          {benefits.map((b) => (
            <li class="flex items-start gap-5 py-7 border-b border-sacred-sand/15">
              <span class="w-12 h-12 shrink-0 rounded-xl bg-saffron/10 text-saffron text-xl flex items-center justify-center">{b.icon}</span>
              <div>
                <strong class="block font-display font-bold text-xl text-white">{b.title}</strong>
                <p class="mt-2 text-sacred-sand/75 leading-relaxed">{b.text}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- CTA -->
    <section class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 pt-20 md:pt-28 pb-4 md:pb-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-y-8 gap-x-16 items-end" data-reveal-group>
        <div class="lg:col-span-7">
          <span class="rule-saffron mb-8" data-reveal="draw" aria-hidden="true"></span>
          <p class="font-display font-bold text-near-black text-2xl md:text-3xl leading-snug tracking-tight max-w-2xl">
            {t('temazcalPage.ctaText')}
          </p>
        </div>
        <div class="lg:col-span-5 lg:pb-2 flex flex-wrap gap-4 lg:justify-end">
          <a href={l('/agenda')} class="btn btn-lg btn-arrow">
            {t('temazcalPage.ctaAgenda')}
          </a>
          <a href={l('/contacto')} class="btn btn-lg btn-outline">
            {t('temazcalPage.ctaContact')}
          </a>
        </div>
      </div>
    </section>
  </main>

</Layout>

<style>
  /* Entradilla: el primer párrafo abre con la tipografía de titulares */
  .lead-first:first-child {
    color: var(--color-near-black);
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1.1rem + 0.7vw, 1.5rem);
    line-height: 1.4;
    letter-spacing: -0.01em;
  }
</style>
