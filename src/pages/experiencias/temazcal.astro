---

import Layout from '@/src/layouts/Layout.astro';
import PageBanner from '@/src/components/PageBanner.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';

const locale = (Astro.locals as any)?.locale ?? Astro.currentLocale ?? 'es';
const l = (path: string) => getRelativeLocaleUrl(locale, path);

---

<Layout title="Temazcal | Varsana Eco Yoga Aldea">

  <main class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 pt-6 md:pt-8 pb-12">
    <!-- Page Banner -->
    <PageBanner
      title="Temazcal"
      subtitle="Una ceremonia ancestral de purificación y renacimiento guiada por el fuego, las hierbas medicinales y el canto sagrado en el vientre de la tierra."
      image="/api/images/1784659086385-Banner-Temazcal.webp"
      imageAlt="Ceremonia de Temazcal en Varsana"
      badge="Ceremonia ancestral"
      breadcrumb={[
        { label: 'Inicio', url: '/' },
        { label: 'Experiencias', url: '/experiencias' },
        { label: 'Temazcal', url: '/experiencias/temazcal' },
      ]}
    />

    <!-- Contenido -->
    <section class="py-20 md:py-28 max-w-3xl mx-auto">
      <div class="space-y-8">
        <div>
          <h2 class="text-3xl md:text-4xl font-bold font-display tracking-tightest mb-4">
            El Vientre de la Tierra
          </h2>
          <p class="text-secondary-gray text-lg leading-relaxed mb-5">
            El temazcal es mucho más que un baño de vapor: es un viaje al interior de la Madre Tierra. En la oscuridad cálida del temazcal, el abuelo fuego calienta las piedras volcánicas mientras las hierbas medicinales liberan su esencia, creando un espacio sagrado de sanación física, emocional y espiritual.
          </p>
          <p class="text-secondary-gray text-lg leading-relaxed mb-5">
            En Varsana, nuestras ceremonias de temazcal son guiadas por facilitadores con años de tradición, en un entorno natural privilegiado. El canto sagrado, el sonido de los instrumentos ancestrales y el vapor de plantas como el eucalipto, la ruda y el romero te acompañan en este proceso de renacimiento.
          </p>
        </div>

        <div class="bg-light-surface rounded-2xl p-8 md:p-12">
          <h3 class="text-2xl font-bold font-display tracking-tightest mb-6">
            Beneficios de la ceremonia
          </h3>
          <ul class="space-y-4">
            <li class="flex items-start gap-4">
              <span class="text-saffron text-xl mt-0.5">🧹</span>
              <div>
                <strong class="font-bold">Purificación física</strong>
                <p class="text-secondary-gray">El vapor de hierbas medicinales abre los poros, elimina toxinas y fortalece el sistema respiratorio.</p>
              </div>
            </li>
            <li class="flex items-start gap-4">
              <span class="text-saffron text-xl mt-0.5">💫</span>
              <div>
                <strong class="font-bold">Renovación emocional</strong>
                <p class="text-secondary-gray">El calor y la oscuridad del temazcal crean un espacio seguro para soltar cargas emocionales y renacer con claridad.</p>
              </div>
            </li>
            <li class="flex items-start gap-4">
              <span class="text-saffron text-xl mt-0.5">🌿</span>
              <div>
                <strong class="font-bold">Conexión espiritual</strong>
                <p class="text-secondary-gray">Los cantos, el silencio y la conexión con los cuatro elementos te reconectan con la tierra y tu ser interior.</p>
              </div>
            </li>
            <li class="flex items-start gap-4">
              <span class="text-saffron text-xl mt-0.5">🤲</span>
              <div>
                <strong class="font-bold">Comunidad</strong>
                <p class="text-secondary-gray">La ceremonia se vive en círculo, recordándonos que el camino de sanación lo recorremos juntos.</p>
              </div>
            </li>
          </ul>
        </div>

        <div class="text-center pt-8">
          <p class="text-secondary-gray text-lg mb-6">
            ¿Querés vivir esta experiencia? Consultá nuestra agenda de ceremonias o contactanos para coordinar una sesión privada.
          </p>
          <div class="flex flex-wrap justify-center gap-4">
            <a
              href={l('/agenda')}
              class="bg-rausch text-white px-8 py-4 rounded-2xl font-bold text-lg hover:bg-rausch-dark hover:scale-105 transition-all duration-300 shadow-lg inline-flex items-center gap-2"
            >
              Ver agenda
            </a>
            <a
              href={l('/contacto')}
              class="border-2 border-near-black px-8 py-4 rounded-2xl font-bold text-lg hover:bg-gray-50 transition-colors"
            >
              Contactanos
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

</Layout>

<style>
  h1, h2, h3 {
    letter-spacing: -0.02em;
  }
</style>
