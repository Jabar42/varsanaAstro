---
import { getLocale, useTranslations, localizePath } from '@/src/i18n/utils';

import Layout from '@/src/layouts/Layout.astro';
import PageBanner from '@/src/components/PageBanner.astro';
import { es as tzEs, en as tzEn } from '@/src/i18n/dictionaries/temazcalPage';

const locale = getLocale(Astro);
const t = useTranslations(locale);
const l = (path: string) => localizePath(locale, path);
const dict = locale === 'en' ? tzEn : tzEs;

const benefits = dict.benefits;
---

<Layout title={t('temazcalPage.metaTitle')} description={t('temazcalPage.metaDescription')}>

  <main class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 pt-6 md:pt-8 pb-12">
    <!-- Page Banner -->
    <PageBanner
      title={t('temazcalPage.bannerTitle')}
      subtitle={t('temazcalPage.bannerSubtitle')}
      image="/api/images/1784659086385-Banner-Temazcal.webp"
      imageAlt={t('temazcalPage.bannerImageAlt')}
      badge={t('temazcalPage.bannerBadge')}
      breadcrumb={[
        { label: t('temazcalPage.breadcrumbHome'), url: l('/') },
        { label: t('temazcalPage.breadcrumbExperiencias'), url: l('/experiencias') },
        { label: t('temazcalPage.breadcrumbTemazcal'), url: l('/experiencias/temazcal') },
      ]}
    />

    <!-- Contenido -->
    <section class="py-20 md:py-28 max-w-3xl mx-auto">
      <div class="space-y-8">
        <div>
          <h2 class="text-3xl md:text-4xl font-bold font-display tracking-tightest mb-4">
            {t('temazcalPage.heading')}
          </h2>
          <p class="text-secondary-gray text-lg leading-relaxed mb-5">
            {t('temazcalPage.paragraph1')}
          </p>
          <p class="text-secondary-gray text-lg leading-relaxed mb-5">
            {t('temazcalPage.paragraph2')}
          </p>
        </div>

        <div class="bg-light-surface rounded-2xl p-8 md:p-12">
          <h3 class="text-2xl font-bold font-display tracking-tightest mb-6">
            {t('temazcalPage.benefitsHeading')}
          </h3>
          <ul class="space-y-4">
            {benefits.map((b) => (
              <li class="flex items-start gap-4">
                <span class="text-saffron text-xl mt-0.5">{b.icon}</span>
                <div>
                  <strong class="font-bold">{b.title}</strong>
                  <p class="text-secondary-gray">{b.text}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>

        <div class="text-center pt-8">
          <p class="text-secondary-gray text-lg mb-6">
            {t('temazcalPage.ctaText')}
          </p>
          <div class="flex flex-wrap justify-center gap-4">
            <a
              href={l('/agenda')}
              class="bg-rausch text-white px-8 py-4 rounded-2xl font-bold text-lg hover:bg-rausch-dark hover:scale-105 transition-all duration-300 shadow-lg inline-flex items-center gap-2"
            >
              {t('temazcalPage.ctaAgenda')}
            </a>
            <a
              href={l('/contacto')}
              class="border-2 border-near-black px-8 py-4 rounded-2xl font-bold text-lg hover:bg-gray-50 transition-colors"
            >
              {t('temazcalPage.ctaContact')}
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

</Layout>

<style>
  h1, h2, h3 {
    letter-spacing: -0.02em;
  }
</style>
