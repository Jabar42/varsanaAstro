---
import { getLocale, useTranslations, localizePath } from '@/src/i18n/utils';
import { es as dict } from '@/src/i18n/dictionaries/paradorPage';

import Layout from '@/src/layouts/Layout.astro';
import PageBanner from '@/src/components/PageBanner.astro';
import { Coffee, MapPin, CheckCircle2 } from 'lucide-react';

const locale = getLocale(Astro);
const t = useTranslations(locale);
const l = (path: string) => localizePath(locale, path);

// Se itera por índice para que t() resuelva cada servicio en el idioma actual.
const servicios = dict.services.map((_, i) => t(`paradorPage.services.${i}`));
---

<Layout title={t('paradorPage.metaTitle')} description={t('paradorPage.metaDescription')}>

  <main class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 pt-6 md:pt-8 pb-12">
    <PageBanner
      title={t('paradorPage.banner.title')}
      subtitle={t('paradorPage.banner.subtitle')}
      badge={t('paradorPage.banner.badge')}
      breadcrumb={[
        { label: t('paradorPage.breadcrumb.home'), url: l('/') },
        { label: t('paradorPage.breadcrumb.alimentacion'), url: l('/alimentacion') },
        { label: t('paradorPage.breadcrumb.parador'), url: l('/parador-el-elefante') },
      ]}
    />

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 mt-16 mb-24">
      <div class="space-y-8">
        <div>
          <div class="inline-flex items-center gap-2 bg-saffron/10 text-saffron px-4 py-2 rounded-full text-sm font-bold mb-6">
            <Coffee size={16} />
            <span>{t('paradorPage.sectionBadge')}</span>
          </div>
          <h2 class="text-3xl md:text-4xl font-bold font-display tracking-tightest mb-4">
            {t('paradorPage.heading')}
          </h2>
          <p class="text-secondary-gray text-lg leading-relaxed">
            {t('paradorPage.text')}
          </p>
        </div>

        <ul class="space-y-3">
          {servicios.map((s) => (
            <li class="flex items-center gap-3 text-lg">
              <CheckCircle2 className="text-saffron shrink-0" size={22} />
              <span>{s}</span>
            </li>
          ))}
        </ul>

        <div class="flex items-center gap-3 text-secondary-gray">
          <MapPin size={18} className="text-saffron shrink-0" />
          <span>{t('paradorPage.location')}</span>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <img
          src="https://picsum.photos/seed/parador-1/600/800"
          class="rounded-3xl shadow-md aspect-3/4 object-cover"
          alt={t('paradorPage.image1Alt')}
          referrerpolicy="no-referrer"
          loading="lazy"
        />
        <img
          src="https://picsum.photos/seed/parador-2/600/800"
          class="rounded-3xl shadow-md mt-8 aspect-3/4 object-cover"
          alt={t('paradorPage.image2Alt')}
          referrerpolicy="no-referrer"
          loading="lazy"
        />
      </div>
    </div>
  </main>

</Layout>

<style>
  h1, h2, h3 {
    letter-spacing: -0.02em;
  }
</style>
