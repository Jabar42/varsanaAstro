---
/**
 * Centro Cultural y Parador El Elefante Feliz.
 *
 * El contenido viene íntegro del documento del equipo (VC-261107-01): intro + 8
 * secciones. Aquí solo se decide la presentación; el orden y los textos viven en
 * el diccionario (paradorPage.ts), sin reinterpretarlos.
 */
import { getLocale, localizePath } from '@/src/i18n/utils';
import { es as paradorEs, en as paradorEn, type Block } from '@/src/i18n/dictionaries/paradorPage';

import Layout from '@/src/layouts/Layout.astro';
import PageBanner from '@/src/components/PageBanner.astro';
import { MapPin, Mail, Phone, Instagram, Facebook, CheckCircle2, Map } from 'lucide-react';

const locale = getLocale(Astro);
const l = (path: string) => localizePath(locale, path);
const d = locale === 'en' ? paradorEn : paradorEs;

const HERO_IMAGE = '/api/images/1794031599086-banner-parador-elefante-feliz.jpg';

const contactIcon = (label: string) => {
  const key = label.toLowerCase();
  if (key.includes('whatsapp') || key.includes('tel')) return Phone;
  if (key.includes('correo') || key.includes('mail')) return Mail;
  if (key.includes('instagram')) return Instagram;
  if (key.includes('facebook')) return Facebook;
  if (key.includes('maps')) return Map;
  return MapPin;
};

const blocksOf = (blocks: Block[]) => blocks;
---

<Layout title={d.metaTitle} description={d.metaDescription}>

  <main class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 pt-6 md:pt-8 pb-12">
    <PageBanner
      title={d.banner.title}
      subtitle={d.banner.subtitle}
      badge={d.banner.badge}
      image={HERO_IMAGE}
      imageAlt={d.banner.imageAlt}
      breadcrumb={[
        { label: d.breadcrumb.home, url: l('/') },
        { label: d.breadcrumb.alimentacion, url: l('/alimentacion') },
        { label: d.breadcrumb.parador, url: l('/parador-el-elefante') },
      ]}
    />

    <!-- Intro -->
    <section class="py-20 md:py-28 grid grid-cols-1 lg:grid-cols-12 gap-x-12 gap-y-10">
      <div class="lg:col-span-6" data-reveal-group>
        <span class="rule-saffron mb-8" data-reveal="draw" aria-hidden="true"></span>
        <h2 class="display-lg font-bold font-display text-near-black">
          {d.intro.title}
        </h2>
      </div>
      <div class="lg:col-span-6 lg:pt-12 space-y-6" data-reveal>
        {d.intro.blocks.map((block) => (
          <>
            {block.type === 'lead' && (
              <p class="text-2xl md:text-3xl font-display font-medium leading-snug text-near-black">{block.text}</p>
            )}
            {block.type === 'p' && (
              <p class="text-lg text-secondary-gray leading-relaxed">{block.text}</p>
            )}
            {block.type === 'h3' && (
              <h3 class="text-xl md:text-2xl font-bold font-display text-near-black pt-6">
                {block.text}
              </h3>
            )}
            {block.type === 'ul' && (
              <ul class="divide-y divide-near-black/10 border-y border-near-black/10">
                {block.items.map((item) => (
                  <li class="flex items-start gap-3 py-3 text-lg text-secondary-gray">
                    <CheckCircle2 className="text-forest-deep shrink-0 mt-1" size={20} />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            )}
            {block.type === 'note' && (
              <div class="rounded-3xl bg-sand-deep p-6 md:p-8 space-y-2">
                <p class="font-bold font-display text-lg text-near-black">{block.title}</p>
                <p class="text-secondary-gray leading-relaxed">{block.text}</p>
              </div>
            )}
            {block.type === 'quote' && (
              <p class="text-xl md:text-2xl font-display italic font-medium leading-snug text-near-black border-l-2 border-saffron pl-6 my-2">
                {block.text}
              </p>
            )}
          </>
        ))}
      </div>
    </section>

    <!-- Secciones del documento del equipo -->
    <div>
      {d.sections.map((section) => (
        <section class="border-t border-near-black/10 py-16 md:py-24 grid grid-cols-1 lg:grid-cols-12 gap-x-12 gap-y-8">
          <div class="lg:col-span-5">
            <div class="lg:sticky lg:top-32" data-reveal-group>
              <p class="eyebrow mb-5">{section.kicker}</p>
              <h2 class="display-md font-bold font-display text-near-black">
                {section.title}
              </h2>
            </div>
          </div>

          <div class="lg:col-span-7 space-y-6" data-reveal>
            {blocksOf(section.blocks).map((block) => (
              <>
                {block.type === 'lead' && (
                  <p class="text-2xl md:text-3xl font-display font-medium leading-snug text-near-black">{block.text}</p>
                )}
                {block.type === 'p' && (
                  <p class="text-lg text-secondary-gray leading-relaxed">{block.text}</p>
                )}
                {block.type === 'h3' && (
                  <h3 class="text-xl md:text-2xl font-bold font-display text-near-black pt-6">
                    {block.text}
                  </h3>
                )}
                {block.type === 'ul' && (
                  <ul class="divide-y divide-near-black/10 border-y border-near-black/10">
                    {block.items.map((item) => (
                      <li class="flex items-start gap-3 py-3 text-lg text-secondary-gray">
                        <CheckCircle2 className="text-forest-deep shrink-0 mt-1" size={20} />
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                )}
                {block.type === 'note' && (
                  <div class="rounded-3xl bg-sand-deep p-6 md:p-8 space-y-2">
                    <p class="font-bold font-display text-lg text-near-black">{block.title}</p>
                    <p class="text-secondary-gray leading-relaxed">{block.text}</p>
                  </div>
                )}
                {block.type === 'quote' && (
                  <p class="text-xl md:text-2xl font-display italic font-medium leading-snug text-near-black border-l-2 border-saffron pl-6 my-2">
                    {block.text}
                  </p>
                )}
              </>
            ))}

            {section.contact && (
              <div class="rounded-3xl bg-lotus-white ring-1 ring-near-black/5 p-6 md:p-8 grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-6">
                {section.contact.map((row) => {
                  const Icon = contactIcon(row.label);
                  return (
                    <div class="flex items-start gap-3 min-w-0">
                      <Icon className="text-forest-deep shrink-0 mt-1" size={20} />
                      <div class="min-w-0">
                        <p class="text-xs font-bold uppercase tracking-wide text-secondary-gray mb-1">{row.label}</p>
                        {row.href ? (
                          <a
                            href={row.href}
                            class="text-near-black break-words underline underline-offset-4 decoration-near-black/20 hover:text-rausch hover:decoration-rausch transition-colors duration-300"
                            target={row.href.startsWith('http') ? '_blank' : undefined}
                            rel={row.href.startsWith('http') ? 'noopener' : undefined}
                          >
                            {row.value}
                          </a>
                        ) : (
                          <p class="text-near-black break-words">{row.value}</p>
                        )}
                      </div>
                    </div>
                  );
                })}
              </div>
            )}
          </div>
        </section>
      ))}
    </div>
  </main>

</Layout>

