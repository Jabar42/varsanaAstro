---

import Layout from '@/src/layouts/Layout.astro';
import PageBanner from '@/src/components/PageBanner.astro';
import SplitSection from '@/src/components/SplitSection.astro';
import MemberCard from '@/src/components/MemberCard.astro';
import { getCollection } from 'astro:content';
import { useTranslations } from '@/src/i18n/utils';

const locale = (Astro.locals as any)?.locale ?? Astro.currentLocale ?? 'es';
const t = useTranslations(locale);

const allMembers = await getCollection('nosotros');
const localeMembers = allMembers.filter(m => (m.data.locale ?? 'es') === locale);
const sourceMembers = localeMembers.length > 0 ? localeMembers : allMembers.filter(m => (m.data.locale ?? 'es') === 'es');
const activeMembers = sourceMembers.filter(m => m.data.activo);
const sortedMembers = activeMembers.sort((a, b) => a.data.orden - b.data.orden);
---

<Layout title="Nuestro Equipo | Varsana Eco Yoga Aldea">

  <main class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 pt-6 md:pt-8">
    <PageBanner
      title={t('nosotros.heading')}
      subtitle={t('nosotros.subtitle')}
      breadcrumb={[
        { label: 'Inicio', url: '/' },
        { label: t('nav.about'), url: '/nosotros' },
      ]}
    />

    <SplitSection
      title={t('nosotros.storyTitle')}
      description={t('nosotros.storyText')}
      ctaLabel={t('nosotros.storyCta')}
      ctaUrl="/nuestra-historia"
      imageAlt={t('nosotros.storyImageAlt')}
    />

  </main>

  <SplitSection
    title={t('nosotros.practiceTitle')}
    description={t('nosotros.practiceText')}
    ctaLabel={t('nosotros.practiceCta')}
    ctaUrl="/experiencias"
    imageSrc="/images/practice-hero.webp"
    imageAlt={t('nosotros.practiceImageAlt')}
    reversed
    background="bg-light-surface"
  />

  <main class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20">
    <section class="py-16">
      {sortedMembers.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-12">
          {sortedMembers.map((member) => (
            <MemberCard member={member} />
          ))}
        </div>
      ) : (
        <div class="py-20 text-center bg-gray-50 rounded-3xl">
          <p class="text-2xl font-medium text-gray-400">{t('nosotros.noMembers')}</p>
          <a href="/" class="mt-6 inline-block text-rausch font-bold underline">{t('nosotros.backHome')}</a>
        </div>
      )}
    </section>


  <SplitSection
    title={t('nosotros.sustainabilityTitle')}
    description={t('nosotros.sustainabilityText')}
    imageAlt={t('nosotros.sustainabilityImageAlt')}
    reversed
  />
    </main>
</Layout>
