---

import Layout from '@/src/layouts/Layout.astro';
import PageBanner from '@/src/components/PageBanner.astro';
import SplitSection from '@/src/components/SplitSection.astro';
import MemberCard from '@/src/components/MemberCard.astro';
import { getCollection } from 'astro:content';
import { useTranslations, getLocale, localizePath } from '@/src/i18n/utils';

const locale = getLocale(Astro);
const t = useTranslations(locale);
const l = (p: string) => localizePath(locale, p);

const allMembers = await getCollection('nosotros');
const localeMembers = allMembers.filter(m => (m.data.locale ?? 'es') === locale);
const sourceMembers = localeMembers.length > 0 ? localeMembers : allMembers.filter(m => (m.data.locale ?? 'es') === 'es');
const activeMembers = sourceMembers.filter(m => m.data.activo);
const sortedMembers = activeMembers.sort((a, b) => a.data.orden - b.data.orden);
---

<Layout title={t('nosotros.heading') + ' | Varsana Eco Yoga Aldea'} description={t('nosotros.subtitle')}>

  <main class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 pt-6 md:pt-8">
    <PageBanner
      title={t('nosotros.heading')}
      subtitle={t('nosotros.subtitle')}
      image="/api/images/1785284230700-banner-nosotros.webp"
      breadcrumb={[
        { label: t('nav.home'), url: l('/') },
        { label: t('nav.about'), url: l('/nosotros') },
      ]}
    />

    <SplitSection
      title={t('nosotros.storyTitle')}
      description={t('nosotros.storyText')}
      ctaLabel={t('nosotros.storyCta')}
      ctaUrl={l('/nuestra-historia')}
      imageSrc="/api/images/1785284968082-espacio-vida-consciente.webp"
      imageAlt={t('nosotros.storyImageAlt')}
    />

  </main>

  <SplitSection
    title={t('nosotros.practiceTitle')}
    description={t('nosotros.practiceText')}
    ctaLabel={t('nosotros.practiceCta')}
    ctaUrl={l('/practica-espiritual')}
    imageSrc="/api/images/1785285103662-practica-espiritual.webp"
    imageAlt={t('nosotros.practiceImageAlt')}
    reversed
    background="bg-sand-deep"
  />

  <main class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20">
    <section class="py-16 md:py-20">
      {sortedMembers.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
          {sortedMembers.map((member) => (
            <MemberCard member={member} />
          ))}
        </div>
      ) : (
        <div class="py-20 px-6 text-center bg-sand-deep rounded-3xl">
          <p class="text-2xl font-medium font-display text-secondary-gray">{t('nosotros.noMembers')}</p>
          <a href={l('/')} class="mt-6 inline-block text-rausch font-semibold underline underline-offset-4 decoration-rausch/30 hover:decoration-rausch transition-colors duration-300">{t('nosotros.backHome')}</a>
        </div>
      )}
    </section>
  </main>

  <!-- Cierre oscuro pegado al footer (-mb-20 anula su margen superior) -->
  <div class="-mb-20">
    <SplitSection
      title={t('nosotros.sustainabilityTitle')}
      description={t('nosotros.sustainabilityText')}
      imageAlt={t('nosotros.sustainabilityImageAlt')}
      videoUrl="https://www.youtube.com/watch?v=O6WYfE--_k8"
      tone="dark"
      reversed
    />
  </div>
</Layout>
