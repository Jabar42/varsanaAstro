---
import Layout from '@/src/layouts/Layout.astro';
import CategoryBar from '@/src/components/CategoryBar.astro';
import MemberCard from '@/src/components/MemberCard.astro';
import { getCollection } from 'astro:content';

const allMembers = await getCollection('nosotros');
const activeMembers = allMembers.filter(m => m.data.activo);
const sortedMembers = activeMembers.sort((a, b) => a.data.orden - b.data.orden);
---

<Layout title="Nuestro Equipo | Varsana Eco Yoga Aldea">
  <CategoryBar />

  <main class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 py-16">
    <div class="mb-12">
      <h1 class="text-5xl font-bold tracking-tightest mb-4">Nuestro Equipo</h1>
      <p class="text-gray-500 text-xl">Conoce a las personas que hacen posible Varsana Eco Yoga Aldea.</p>
    </div>
    
    {sortedMembers.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-12">
        {sortedMembers.map((member) => (
          <MemberCard member={member} />
        ))}
      </div>
    ) : (
      <div class="py-20 text-center bg-gray-50 rounded-3xl">
        <p class="text-2xl font-medium text-gray-400">No hay miembros activos en este momento.</p>
        <a href="/" class="mt-6 inline-block text-rausch font-bold underline">Volver al inicio</a>
      </div>
    )}
  </main>
</Layout>