---
Astro.response.status = 404;

import Layout from '@/src/layouts/Layout.astro';
import { useTranslations, getLocale, localizePath } from '@/src/i18n/utils';
import {
  Compass,
  Calendar,
  Leaf,
  MessageCircle,
} from 'lucide-react';

const locale = getLocale(Astro);
const t = useTranslations(locale);
const l = (path: string) => localizePath(locale, path);
---

<Layout title={t('notFound.title')} description={t('notFound.text')}>

  <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 pt-12 md:pt-20">

    <section class="grid grid-cols-1 lg:grid-cols-12 gap-y-12 gap-x-12 lg:gap-x-20 items-center">

      <!-- El umbral vacío: el 404 dentro del arco -->
      <div class="lg:col-span-5 lg:order-2">
        <div class="threshold arch on-dark">
          <Compass size={56} className="text-saffron" strokeWidth={1} />
          <p class="threshold__number font-display font-bold select-none">
            404
          </p>
        </div>
      </div>

      <div class="lg:col-span-7 lg:order-1">
        <p class="eyebrow mb-5">{t('notFoundPage.badge')}</p>

        <h1 class="display-xl font-bold font-display text-near-black">
          {t('notFound.heading')}
        </h1>

        <p class="mt-6 text-secondary-gray text-lg md:text-xl leading-relaxed max-w-lg">
          {t('notFound.text')}
        </p>

        <a href={l('/')} class="btn btn-lg btn-arrow mt-10">
          {t('notFound.cta')}
        </a>
      </div>

    </section>

    <section class="mt-20 md:mt-28 pt-10 border-t border-near-black/10 grid lg:grid-cols-12 gap-y-6 gap-x-12 items-center">
      <h2 class="lg:col-span-5 text-xl md:text-2xl font-bold font-display text-near-black">
        {t('notFound.suggestTitle')}
      </h2>

      <div class="lg:col-span-7 flex flex-wrap gap-3 lg:justify-end">
        <a href={l('/events')} class="btn btn-outline">
          <Calendar size={18} />
          {t('nav.events')}
        </a>

        <a href={l('/pasadias')} class="btn btn-outline">
          <Leaf size={18} />
          {t('nav.pasadias')}
        </a>

        <a href={l('/contacto')} class="btn btn-outline">
          <MessageCircle size={18} />
          {t('nav.contact')}
        </a>
      </div>
    </section>

  </div>

</Layout>

<style>
  h2 {
    letter-spacing: -0.02em;
  }

  .threshold {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    gap: 1rem;
    aspect-ratio: 4 / 5;
    width: 100%;
    max-width: 15rem;
    margin-inline: auto;
    padding-bottom: 12%;
  }

  .threshold__number {
    font-size: clamp(4rem, 2rem + 8vw, 8rem);
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: var(--color-sacred-sand);
  }

  @media (min-width: 1024px) {
    .threshold {
      max-width: 26rem;
    }
  }
</style>
