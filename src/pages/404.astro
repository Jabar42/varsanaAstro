---
Astro.response.status = 404;

import Layout from '@/src/layouts/Layout.astro';
import { useTranslations } from '@/src/i18n/utils';
import { getRelativeLocaleUrl } from 'astro:i18n';
import {
  Compass,
  ArrowRight,
  Calendar,
  Leaf,
  MessageCircle,
} from 'lucide-react';

const locale = (Astro.locals as any)?.locale ?? Astro.currentLocale ?? 'es';
const t = useTranslations(locale);
const l = (path: string) => getRelativeLocaleUrl(locale, path);
---

<Layout title="Página no encontrada | Varsana Eco Yoga Aldea">

  <main class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 py-12 lg:py-20">

    <section class="grid grid-cols-1 lg:grid-cols-[1fr_auto] gap-12 lg:gap-16 items-center min-h-[60vh]">

      <div class="space-y-8 max-w-xl">
        <div class="inline-flex items-center gap-2 bg-saffron/10 text-saffron px-4 py-2 rounded-full text-sm font-bold">
          <Compass size={16} />
          <span>Error 404</span>
        </div>

        <p class="text-[8rem] md:text-[10rem] lg:text-[12rem] font-display font-bold leading-none tracking-tightest text-rausch/15 select-none">
          404
        </p>

        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold font-display tracking-tightest leading-tight text-near-black">
          {t('notFound.heading')}
        </h1>

        <p class="text-secondary-gray text-lg md:text-xl leading-relaxed max-w-lg">
          {t('notFound.text')}
        </p>

        <a
          href={l('/')}
          class="inline-flex items-center gap-3 bg-rausch text-white px-10 py-5 rounded-2xl font-bold text-lg hover:bg-rausch-dark hover:scale-105 transition-all duration-600 ease-in-out shadow-lg min-h-14"
        >
          {t('notFound.cta')}
          <ArrowRight size={20} />
        </a>
      </div>

      <div class="hidden lg:flex items-center justify-center relative w-72 h-72">
        <div class="absolute w-64 h-64 rounded-full bg-saffron/10 blur-3xl"></div>
        <Compass size={180} class="text-saffron/40 relative z-10" strokeWidth={0.8} />
      </div>

    </section>

    <section class="mt-16 lg:mt-8 max-w-3xl">
      <div class="bg-lotus-white rounded-[32px] shadow-airbnb p-8 md:p-12 space-y-6">
        <h2 class="text-xl md:text-2xl font-bold font-display tracking-tightest text-near-black">
          {t('notFound.suggestTitle')}
        </h2>

        <div class="flex flex-wrap gap-4">
          <a
            href={l('/events')}
            class="inline-flex items-center gap-3 px-6 py-4 rounded-2xl bg-sacred-sand hover:bg-saffron/10 text-near-black font-semibold transition-all duration-600 ease-in-out hover:scale-105 min-h-13"
          >
            <Calendar size={20} class="text-saffron" />
            Eventos
          </a>

          <a
            href={l('/pasadias')}
            class="inline-flex items-center gap-3 px-6 py-4 rounded-2xl bg-sacred-sand hover:bg-forest/10 text-near-black font-semibold transition-all duration-600 ease-in-out hover:scale-105 min-h-13"
          >
            <Leaf size={20} class="text-forest" />
            Pasadías
          </a>

          <a
            href={l('/contacto')}
            class="inline-flex items-center gap-3 px-6 py-4 rounded-2xl bg-sacred-sand hover:bg-rausch/10 text-near-black font-semibold transition-all duration-600 ease-in-out hover:scale-105 min-h-13"
          >
            <MessageCircle size={20} class="text-rausch" />
            Contacto
          </a>
        </div>
      </div>
    </section>

  </main>

</Layout>

<style>
  h1, h2 {
    letter-spacing: -0.02em;
  }
</style>
