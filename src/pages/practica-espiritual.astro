---
import { getLocale, useTranslations, localizePath } from '@/src/i18n/utils';
import Layout from '@/src/layouts/Layout.astro';
import PageBanner from '@/src/components/PageBanner.astro';
import SplitSection from '@/src/components/SplitSection.astro';
import { es as prEs, en as prEn } from '@/src/i18n/dictionaries/practicaPage';

const locale = getLocale(Astro);
const t = useTranslations(locale);
const l = (path: string) => localizePath(locale, path);
const dict = locale === 'en' ? prEn : prEs;

// Iconos de los cuatro principios (mismo orden que el diccionario)
const principiosImagenes = [
  '/api/images/1787359188810-icono-compasion.webp',
  '/api/images/1787359190604-icono-limpieza.webp',
  '/api/images/1787359191818-icono-austeridad.webp',
  '/api/images/1787359193004-icono-veracidad.webp',
];

const principios = dict.principios.map((p, i) => ({
  ...p,
  imagen: principiosImagenes[i] ?? principiosImagenes[0],
}));
---

<Layout title={t('practicaPage.metaTitle')} description={t('practicaPage.metaDescription')}>
  <main class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 pt-6 md:pt-8 pb-12">
    <PageBanner
      title={t('practicaPage.bannerTitle')}
      subtitle={t('practicaPage.bannerSubtitle')}
      image="/api/images/1787359606360-banner-practica-espiritual.webp"
      imageAlt={t('practicaPage.bannerImageAlt')}
      breadcrumb={[
        { label: t('practicaPage.breadcrumbHome'), url: l('/') },
        { label: t('practicaPage.breadcrumbPractica'), url: l('/practica-espiritual') },
      ]}
    />

    <!-- Cuatro principios esenciales -->
    <section class="py-20 md:py-28">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold font-display tracking-tightest text-center mb-16">
        {t('practicaPage.principiosHeading')}
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        {principios.map((p) => (
          <div class="bg-lotus-white rounded-[24px] p-8 shadow-airbnb flex flex-col items-center text-center hover:scale-[1.02] transition-all duration-300">
            <span class="bg-rausch/10 text-rausch px-4 py-1.5 rounded-full text-xs font-bold mb-6 inline-block tracking-wide">
              {p.etiqueta}
            </span>

            <div class="w-24 h-24 rounded-full bg-sacred-sand border-4 border-rausch/20 overflow-hidden mb-6 shrink-0">
              <img
                src={p.imagen}
                alt={p.titulo}
                class="w-full h-full object-cover"
                loading="lazy"
                referrerpolicy="no-referrer"
              />
            </div>

            <h3 class="text-xl font-bold font-display tracking-tightest mb-3">{p.titulo}</h3>
            <p class="text-secondary-gray text-sm leading-relaxed">{p.descripcion}</p>
          </div>
        ))}
      </div>
    </section>
  </main>

  <SplitSection
    title={t('practicaPage.split.title')}
    description={t('practicaPage.split.description')}
    ctaLabel={t('practicaPage.split.ctaLabel')}
    ctaUrl={l('/experiencias')}
    images={[
      '/api/images/1785885185063-Carrusel-1_Practicas.webp',
      '/api/images/1785885191229-Carrusel-5_Practicas.webp',
      '/api/images/1785885192783-Carrusel-6_Practicas.webp',
      '/api/images/1785885194157-Carrusel-7_Practicas.webp',
    ]}
    imageAlt={t('practicaPage.split.imageAlt')}
    reversed
    background="bg-light-surface"
  />

  <main class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 pb-20">
    <section class="py-16 md:py-24 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div class="space-y-6">
        <div class="inline-flex items-center gap-2 bg-forest/10 text-forest px-4 py-2 rounded-full text-sm font-bold">
          {t('practicaPage.comunidad.badge')}
        </div>
        <h2 class="text-3xl md:text-4xl font-bold font-display tracking-tightest">
          {t('practicaPage.comunidad.heading')}
        </h2>
        <p class="text-secondary-gray text-lg leading-relaxed">
          {t('practicaPage.comunidad.text')}
        </p>
        <a
          href={l('/voluntariado')}
          class="inline-flex items-center gap-2 bg-rausch text-white px-8 py-4 rounded-2xl font-bold text-lg hover:bg-rausch-dark hover:scale-105 transition-all duration-300 shadow-lg"
        >
          {t('practicaPage.comunidad.cta')}
        </a>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <img
          src="https://picsum.photos/seed/comunidad-1/600/800"
          alt={t('practicaPage.comunidad.image1Alt')}
          class="rounded-3xl shadow-md aspect-3/4 object-cover"
          loading="lazy"
          referrerpolicy="no-referrer"
        />
        <img
          src="https://picsum.photos/seed/comunidad-2/600/800"
          alt={t('practicaPage.comunidad.image2Alt')}
          class="rounded-3xl shadow-md mt-8 aspect-3/4 object-cover"
          loading="lazy"
          referrerpolicy="no-referrer"
        />
      </div>
    </section>
  </main>
</Layout>

<style>
  h1, h2, h3, h4 {
    letter-spacing: -0.02em;
  }
</style>
