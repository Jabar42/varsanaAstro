{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "image": {
      "type": "string"
    },
    "prices": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          },
          "deadline": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "label",
          "amount"
        ]
      }
    },
    "stock_max": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "duration": {
      "type": "string"
    },
    "meeting_point": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "included_services": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "title",
    "description",
    "image",
    "prices",
    "stock_max",
    "duration",
    "meeting_point",
    "category"
  ]
}