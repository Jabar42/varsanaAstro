{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "locale": {
      "default": "es",
      "type": "string",
      "enum": [
        "es",
        "en"
      ]
    },
    "destacado": {
      "default": false,
      "type": "boolean"
    },
    "orden": {
      "default": 0,
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "event_start": {
      "type": "string",
      "format": "date-time"
    },
    "event_end": {
      "type": "string",
      "format": "date-time"
    },
    "image": {
      "type": "string"
    },
    "stock_max": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "prices": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          },
          "deadline": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "label",
          "amount"
        ]
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "description",
    "event_start",
    "image",
    "stock_max",
    "prices"
  ]
}