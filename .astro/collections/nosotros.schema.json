{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "nombre": {
      "type": "string"
    },
    "rol": {
      "type": "string"
    },
    "descripcion": {
      "type": "string"
    },
    "imagen": {
      "type": "string"
    },
    "orden": {
      "default": 0,
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "activo": {
      "default": true,
      "type": "boolean"
    },
    "enlaces_sociales": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "plataforma": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "plataforma",
          "url"
        ]
      }
    },
    "correo": {
      "type": "string",
      "format": "email",
      "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
    },
    "telefono": {
      "type": "string"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "nombre",
    "rol",
    "descripcion",
    "imagen"
  ]
}