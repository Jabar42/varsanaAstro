# Llaves de Botón de pagos, del mismo comercio y ambiente. Completar sólo en .dev.vars.
BOLD_API_KEY=""
BOLD_SECRET_KEY=""
# production por defecto. test usa firma webhook vacía; sólo con D1/notificaciones aisladas.
BOLD_ENVIRONMENT="production"

# Site
PUBLIC_SITE_URL="https://varsana-co.iaforchange.workers.dev"

# Token para subir imágenes a R2 (POST /api/images, header Authorization: Bearer ...)
# Generar: openssl rand -hex 32  →  wrangler secret put IMAGES_UPLOAD_TOKEN
IMAGES_UPLOAD_TOKEN="cambia-este-token"


# Resend (email transaccional)
RESEND_API_KEY="re_xxxxxxxxx"
RESEND_FROM_EMAIL="reservas@varsana.com"

# Telegram notifications (admin alerts on new sales)
TELEGRAM_BOT_TOKEN="123456:ABC-DEF..."
TELEGRAM_CHAT_ID="123456789"

# Donation link
PUBLIC_DONATION_URL="https://donar.varsana.com"

# Hermes API (chat widget)
PUBLIC_HERMES_API_URL="http://localhost:8642"
PUBLIC_HERMES_API_KEY="your-hermes-api-key"
