{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "varsana-co",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-06-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "ENVIRONMENT": "staging",
    "PUBLIC_DONATION_URL": "https://donar.varsana.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "varsana-db",
      "database_id": "8ca3e0d2-1772-440c-bd96-9fea0c09582b"
    }
  ],
  "r2_buckets": [
    {
      "bucket_name": "varsana-images",
      "binding": "VARSANA_IMAGES"
    }
  ]
}
